# InstantDB
# Public app id — safe to expose to the browser (used for magic-code auth).
PUBLIC_INSTANT_APP_ID=ae65ab62-cb20-4787-b7b8-c30e4883d27f
# Admin token — SECRET. Get it from https://www.instantdb.com/dash > your app > Admin token.
# Required at Vercel BUILD time (prerendered review pages) and for /admin API routes.
# In Vercel → Project → Settings → Environment Variables: enable for Production,
# Preview, and Development (not Build-only).
INSTANT_APP_ADMIN_TOKEN=
# After editing instant.email.ts, deploy OTP branding with:
# npx instant-cli@latest auth email push

# Bootstrap: the first owner account. This email is auto-provisioned with the
# "owner" role on first login to /admin.
ADMIN_OWNER_EMAIL=

# Canonical site origin (optional override). Astro `site` is always
# https://aigirlfriend.expert — set this only if you need a different public origin.
PUBLIC_SITE_URL=

# Bunny CDN pull zone — caches static files + uploaded media globally.
# Pull zone hostname from bunny.net dashboard (Linked hostnames).
PUBLIC_CDN_URL=https://aigirlfriendpull.b-cdn.net

# For admin uploads → Bunny Storage (create a Storage Zone, link it to the pull zone above).
# Storage zone name + FTP/API password from dash.bunny.net → Storage → your zone.
BUNNY_STORAGE_ZONE=aigfexpertstorage
BUNNY_STORAGE_API_KEY=
BUNNY_CDN_HOSTNAME=aigirlfriendpull.b-cdn.net

# Pull zone origin (set in Bunny dashboard, not here): https://aigirlfriend.expert
# Migrate existing InstantDB images after storage is linked:
#   npm run migrate:media-bunny -- --dry-run
#   npm run migrate:media-bunny
# Upload /public static assets (logos, icons) to Bunny:
#   npm run upload:public-bunny

# Set to "true" to let DB content overlay static homepage/editorial data.
USE_DB_CONTENT=

# Contact form + article feedback → email inbox (Resend).
# Sign up at https://resend.com — free tier works for launch.
# CONTACT_INBOX defaults to hermanjcarter@gmail.com when unset.
CONTACT_INBOX=hermanjcarter@gmail.com
RESEND_API_KEY=
# After verifying aigirlfriend.expert in Resend, set e.g.:
# RESEND_FROM=AI Girlfriend Expert <hello@aigirlfriend.expert>
# Until then, Resend's onboarding sender works for testing:
RESEND_FROM=onboarding@resend.dev


# Vercel deploy hook — called after publishing so new review pages rebuild.
# Create in Vercel → Project → Settings → Git → Deploy Hooks, then paste URL here.
VERCEL_DEPLOY_HOOK_URL=

# Secret for Vercel cron jobs (scheduled publishing). Vercel sets this
# automatically when defined in project env vars.
CRON_SECRET=

# Sanity (Phase 5 — guides CMS). See studio/README.md for setup.
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production
# Viewer token — needed for draft previews (and private datasets).
SANITY_API_READ_TOKEN=
# Shared secret for /guides/preview (same value as the studio's
# SANITY_STUDIO_PREVIEW_SECRET).
SANITY_PREVIEW_SECRET=
# Shared secret for the Sanity webhook that feeds guide slug changes into the
# central redirect manager.
SANITY_WEBHOOK_SECRET=

# Ahrefs — server-only. Powers Market competitors data on Alternatives tab (build time).
# Get your key at https://app.ahrefs.com/api — never commit the real value.
AHREFS_API_KEY=

# OpenAI — server-only. Powers verdict suggestions, pricing screenshot import,
# and media alt-text generation. Set in Vercel project env for production.
OPENAI_API_KEY=
OPENAI_VERDICT_MODEL=gpt-4o-mini
OPENAI_PRICING_MODEL=
OPENAI_ALT_TEXT_MODEL=
AI_VERDICT_ENABLED=true
AI_PRICING_ENABLED=true
AI_ALT_TEXT_ENABLED=true
# Privacy policy document analysis (Testing → Upload privacy documents)
OPENAI_PRIVACY_MODEL=
AI_PRIVACY_ENABLED=true
AI_PRIVACY_MAX_OUTPUT_TOKENS=6000
AI_PRIVACY_MAX_TOTAL_CHARS=180000
# Result explanations (Testing → Result explanations)
AI_EXPLANATIONS_ENABLED=true
OPENAI_EXPLANATIONS_MODEL=gpt-4o
AI_EXPLANATIONS_TEMPERATURE=0.4
AI_EXPLANATIONS_USER_MAX_REQUESTS=500
AI_EXPLANATIONS_USER_WINDOW_MS=600000
AI_EXPLANATIONS_PRODUCT_COOLDOWN_MS=1000
AI_EXPLANATIONS_CONCURRENCY=5

# Subscore drawer key takeaways (defaults to explanations model/settings)
AI_SUBSCORE_TAKEAWAYS_ENABLED=true
OPENAI_SUBSCORE_TAKEAWAYS_MODEL=gpt-4o
AI_SUBSCORE_TAKEAWAYS_TEMPERATURE=0.4
AI_SUBSCORE_TAKEAWAYS_CONCURRENCY=5
# Max images per bulk alt-text request (default 100).
AI_ALT_TEXT_MAX_IMAGES=
