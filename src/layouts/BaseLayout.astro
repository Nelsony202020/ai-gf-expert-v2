---
import globalStylesUrl from '../styles/global.css?url';
import ImageLightbox from '../components/ui/ImageLightbox.astro';
import ThemeToggleInit from '../components/ui/ThemeToggleInit.astro';
import ExternalLinksInit from '../components/ui/ExternalLinksInit.astro';
import ComingSoonLayer from '../components/ui/ComingSoonLayer.astro';
import MobileNavShell from '../components/mobile/MobileNavShell.astro';
import { getMobileNavMode } from '../lib/mobile-nav/modes';
import { cdnAsset, getCdnBaseUrl } from '../lib/media/cdn';
import { optimizedImageUrl } from '../lib/media/optimize';
import { canonicalPublicUrl, resolveCanonicalUrl } from '../lib/siteOrigin';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  /** Above-the-fold image URL to preload (homepage hero, review gallery, roundup banner). */
  lcpImage?: string;
  robots?: string;
  canonical?: string;
  ogTitle?: string;
  ogDescription?: string;
}

const {
  title = 'AI Girlfriend Expert — Independent AI Companion Reviews',
  description = 'Independent, data-driven reviews of AI girlfriend and AI companion apps. Deep scoring, safety audits, and side-by-side specs.',
  image,
  lcpImage,
  robots,
  canonical: canonicalOverride,
  ogTitle,
  ogDescription,
} = Astro.props;

const canonical = canonicalOverride
  ? resolveCanonicalUrl(Astro.url.pathname, canonicalOverride, Astro.site)
  : canonicalPublicUrl(Astro.url.pathname, Astro.site);
const ogTitleResolved = ogTitle ?? title;
const ogDescriptionResolved = ogDescription ?? description;
const cdnBase = getCdnBaseUrl();
const mobileNavMode = getMobileNavMode(Astro.url.pathname);
const lcpPreload = lcpImage ? optimizedImageUrl(lcpImage, { width: 800, quality: 72, dpr: 1 }) : '';
const TEXT_FONTS_HREF =
  'https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;600;700;800&family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600;700&display=swap';
const ICON_FONTS_HREF =
  'https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@500&family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..24,300..700,0..1,0&display=swap';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <!-- Lock Safari/Chrome mobile chrome to page bg — otherwise score greens/oranges bleed into the bottom bar -->
    <meta name="theme-color" content="#f9f9f9" data-theme-color />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href={cdnAsset('/brand/herman-main-icon.svg')} />
    {cdnBase && <link rel="preconnect" href={cdnBase} crossorigin />}
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={ogTitleResolved} />
    <meta property="og:description" content={ogDescriptionResolved} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitleResolved} />
    <meta name="twitter:description" content={ogDescriptionResolved} />
    {image && <meta name="twitter:image" content={image} />}

    <!-- Fonts after first paint so Google/text is not blocked on fonts.googleapis.com. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={TEXT_FONTS_HREF} media="print" onload="this.media='all'" />
    <link rel="stylesheet" href={ICON_FONTS_HREF} media="print" onload="this.media='all'" />
    <noscript>
      <link rel="stylesheet" href={TEXT_FONTS_HREF} />
      <link rel="stylesheet" href={ICON_FONTS_HREF} />
    </noscript>
    {lcpPreload && <link rel="preload" as="image" href={lcpPreload} fetchpriority="high" />}
    <link rel="stylesheet" href={globalStylesUrl} />
    <slot name="head" />
  </head>
  <body class="bg-background text-on-surface" data-mobile-nav-mode={mobileNavMode}>
    <script is:inline>
      (function () {
        var LIGHT = '#f9f9f9';
        var DARK = '#020617';
        try {
          var dark = localStorage.getItem('theme') === 'dark';
          if (dark) document.documentElement.setAttribute('data-theme', 'dark');
          var meta = document.querySelector('meta[name="theme-color"][data-theme-color]');
          if (meta) meta.setAttribute('content', dark ? DARK : LIGHT);
        } catch (e) {}
      })();
    </script>
    <slot />
    <MobileNavShell pathname={Astro.url.pathname} />
    <ImageLightbox />
    <ThemeToggleInit />
    <ComingSoonLayer />
    <ExternalLinksInit />
    <script is:inline>
      // #region agent log
      (function () {
        function send(message, data, hypothesisId) {
          fetch('http://127.0.0.1:7312/ingest/3642bd41-13da-4f13-9a24-64f7a557b0e1', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'X-Debug-Session-Id': '5c7f40' },
            body: JSON.stringify({
              sessionId: '5c7f40',
              runId: 'psi-plan',
              hypothesisId: hypothesisId,
              location: 'BaseLayout.astro',
              message: message,
              data: data,
              timestamp: Date.now(),
            }),
          }).catch(function () {});
        }
        var htmlLen = document.documentElement.outerHTML.length;
        var imgs = document.images.length;
        var nodes = document.getElementsByTagName('*').length;
        var ids = {};
        var dupes = [];
        var all = document.querySelectorAll('[id]');
        for (var i = 0; i < all.length; i++) {
          var id = all[i].id;
          ids[id] = (ids[id] || 0) + 1;
        }
        for (var key in ids) {
          if (ids[key] > 1) dupes.push({ id: key, count: ids[key] });
        }
        var panels = {};
        var panelEls = document.querySelectorAll('[data-tab-panel]');
        for (var p = 0; p < panelEls.length; p++) {
          var name = panelEls[p].getAttribute('data-tab-panel') || 'unknown';
          panels[name] = {
            bytes: panelEls[p].innerHTML.length,
            imgs: panelEls[p].querySelectorAll('img').length,
            nodes: panelEls[p].getElementsByTagName('*').length,
            hidden: panelEls[p].classList.contains('hidden'),
          };
        }
        send(
          'page payload snapshot',
          {
            path: location.pathname,
            htmlBytes: htmlLen,
            imgCount: imgs,
            nodeCount: nodes,
            duplicateIds: dupes.slice(0, 20),
            duplicateIdCount: dupes.length,
            panels: panels,
            scriptCount: document.scripts.length,
          },
          'A',
        );
        if (window.PerformanceObserver) {
          try {
            var po = new PerformanceObserver(function (list) {
              var entries = list.getEntries();
              var last = entries[entries.length - 1];
              if (!last) return;
              var el = last.element;
              send(
                'lcp candidate',
                {
                  path: location.pathname,
                  startTime: Math.round(last.startTime),
                  size: last.size,
                  url: last.url || '',
                  tag: el ? el.tagName : '',
                  id: el ? el.id : '',
                  className: el && el.className ? String(el.className).slice(0, 80) : '',
                },
                'E',
              );
            });
            po.observe({ type: 'largest-contentful-paint', buffered: true });
          } catch (e) {}
        }
      })();
      // #endregion
    </script>
  </body>
</html>
