---
import globalStylesUrl from '../styles/global.css?url';
import homeStylesUrl from '../styles/page-home.css?url';
import reviewStylesUrl from '../styles/page-review.css?url';
import roundupStylesUrl from '../styles/page-roundup.css?url';
import directoryStylesUrl from '../styles/page-directory.css?url';
import fullStylesUrl from '../styles/page-full.css?url';
import ThemeToggleInit from '../components/ui/ThemeToggleInit.astro';
import ExternalLinksInit from '../components/ui/ExternalLinksInit.astro';
import ComingSoonLayer from '../components/ui/ComingSoonLayer.astro';
import MobileNavShell from '../components/mobile/MobileNavShell.astro';
import { getMobileNavMode } from '../lib/mobile-nav/modes';
import { cdnAsset, getCdnBaseUrl } from '../lib/media/cdn';
import { heroImageSrcSet, optimizedImageUrl } from '../lib/media/optimize';
import { canonicalPublicUrl, resolveCanonicalUrl } from '../lib/siteOrigin';
import { MATERIAL_SYMBOLS_HREF } from '../lib/ui/materialSymbols';

// Self-hosted text fonts (replaces the fonts.googleapis.com text request).
// Axis/style coverage matches what the Google request served: Hanken Grotesk,
// Inter and JetBrains Mono as wght-variable normals, Instrument Serif 400 + italic.
// @fontsource ships font-display: swap.
import '@fontsource-variable/hanken-grotesk/wght.css';
import '@fontsource-variable/inter/standard.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
// The LCP element on review pages is the <h1>, which renders in --font-display.
import headingFontUrl from '@fontsource-variable/hanken-grotesk/files/hanken-grotesk-latin-wght-normal.woff2?url';

export type PageTheme = 'core' | 'home' | 'review' | 'roundup' | 'directory' | 'full';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  /** Above-the-fold image URL to preload (homepage hero, review gallery, roundup banner). */
  lcpImage?: string;
  robots?: string;
  canonical?: string;
  ogTitle?: string;
  ogDescription?: string;
  /**
   * Extra page CSS. `core` is header/footer/tokens only.
   * Default `full` keeps existing pages styled until they opt into a slimmer bundle.
   */
  theme?: PageTheme;
}

const {
  title = 'AI Girlfriend Expert — Independent AI Companion Reviews',
  description = 'Independent, data-driven reviews of AI girlfriend and AI companion apps. Deep scoring, safety audits, and side-by-side specs.',
  image,
  lcpImage,
  robots,
  canonical: canonicalOverride,
  ogTitle,
  ogDescription,
  theme = 'full',
} = Astro.props;

const pageStylesUrl =
  theme === 'home'
    ? homeStylesUrl
    : theme === 'review'
      ? reviewStylesUrl
      : theme === 'roundup'
        ? roundupStylesUrl
        : theme === 'directory'
          ? directoryStylesUrl
          : theme === 'full'
            ? fullStylesUrl
            : '';

const canonical = canonicalOverride
  ? resolveCanonicalUrl(Astro.url.pathname, canonicalOverride, Astro.site)
  : canonicalPublicUrl(Astro.url.pathname, Astro.site);
const ogTitleResolved = ogTitle ?? title;
const ogDescriptionResolved = ogDescription ?? description;
const cdnBase = getCdnBaseUrl();
const mobileNavMode = getMobileNavMode(Astro.url.pathname);
const lcpPreloadHref = lcpImage
  ? optimizedImageUrl(lcpImage, { width: 720, quality: 80, dpr: 1, format: 'webp' })
  : '';
const lcpPreloadSrcSet = lcpImage ? heroImageSrcSet(lcpImage, [480, 640, 960, 1280], 80) : '';
// Subsetted to the icons the site actually renders — see src/lib/ui/materialSymbols.ts.
const ICON_FONTS_HREF = MATERIAL_SYMBOLS_HREF;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <!-- Lock Safari/Chrome mobile chrome to page bg — otherwise score greens/oranges bleed into the bottom bar -->
    <meta name="theme-color" content="#f9f9f9" data-theme-color />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href={cdnAsset('/brand/herman-main-icon.svg')} />
    {cdnBase && <link rel="preconnect" href={cdnBase} crossorigin />}
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={ogTitleResolved} />
    <meta property="og:description" content={ogDescriptionResolved} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitleResolved} />
    <meta name="twitter:description" content={ogDescriptionResolved} />
    {image && <meta name="twitter:image" content={image} />}

    <!-- Text fonts are self-hosted; only the icon font still comes from Google. -->
    <link rel="preload" as="font" type="font/woff2" href={headingFontUrl} crossorigin />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={ICON_FONTS_HREF} media="print" onload="this.media='all'" />
    <noscript>
      <link rel="stylesheet" href={ICON_FONTS_HREF} />
    </noscript>
    {lcpPreloadHref && (
      <link
        rel="preload"
        as="image"
        type="image/webp"
        href={lcpPreloadHref}
        imagesrcset={lcpPreloadSrcSet || undefined}
        imagesizes="(max-width: 767px) 100vw, 42vw"
        fetchpriority="high"
      />
    )}
    <link rel="stylesheet" href={globalStylesUrl} />
    {pageStylesUrl && <link rel="stylesheet" href={pageStylesUrl} />}
    <slot name="head" />
  </head>
  <body class="bg-background text-on-surface" data-mobile-nav-mode={mobileNavMode}>
    <script is:inline>
      (function () {
        var LIGHT = '#f9f9f9';
        var DARK = '#020617';
        try {
          var dark = localStorage.getItem('theme') === 'dark';
          if (dark) document.documentElement.setAttribute('data-theme', 'dark');
          var meta = document.querySelector('meta[name="theme-color"][data-theme-color]');
          if (meta) meta.setAttribute('content', dark ? DARK : LIGHT);
        } catch (e) {}
      })();
    </script>
    <slot />
    <MobileNavShell pathname={Astro.url.pathname} />
    <ThemeToggleInit />
    <ComingSoonLayer />
    <ExternalLinksInit />
  </body>
</html>
