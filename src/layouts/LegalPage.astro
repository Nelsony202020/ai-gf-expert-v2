---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LegalSidebar from '../components/legal/LegalSidebar.astro';
import Breadcrumbs, { type BreadcrumbItem } from '../components/ui/Breadcrumbs.astro';
import '../styles/roundup.css';
import '../styles/legal-hub.css';

interface Props {
  title: string;
  description?: string;
  legalSlug?: string;
  breadcrumbs?: BreadcrumbItem[];
}

const { title, description = '', legalSlug, breadcrumbs } = Astro.props;
const trail =
  breadcrumbs ??
  [
    { label: 'Home', href: '/' },
    { label: 'Legal', href: '/legal/' },
    { label: title },
  ];
---

<BaseLayout title={title} description={description || title}>
  <Header />
  <main class="legal-hub-page">
    <div class="section-container px-4 md:px-8 py-10 md:py-14 pb-16 md:pb-24">
      <div class="roundup-layout">
        <LegalSidebar currentSlug={legalSlug} />

        <article class="roundup-main max-w-3xl">
          <Breadcrumbs items={trail} />
          <h1 class="text-3xl md:text-4xl font-black text-on-surface mb-6 mt-1">{title}</h1>
          <div class="legal-prose prose prose-neutral max-w-none text-on-surface-variant leading-relaxed space-y-4">
            <slot />
          </div>
        </article>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>

<style is:global>
  .legal-prose h2 {
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    font-size: 1.25rem;
    font-weight: 900;
    color: var(--color-on-surface);
  }

  .legal-prose h3 {
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
    font-size: 1.05rem;
    font-weight: 800;
    color: var(--color-on-surface);
  }

  .legal-prose ul,
  .legal-prose ol {
    padding-left: 1.25rem;
  }

  .legal-prose li + li {
    margin-top: 0.35rem;
  }

  .legal-prose a {
    color: var(--color-accent);
    font-weight: 700;
    text-decoration: none;
  }

  .legal-prose a:hover {
    text-decoration: underline;
  }

  .legal-prose .legal-updated {
    margin: 0 0 1.25rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-tertiary);
  }
</style>
