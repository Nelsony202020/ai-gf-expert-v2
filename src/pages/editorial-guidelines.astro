---
import BaseLayout from '../layouts/BaseLayout.astro';
import StandardContentLayout from '../layouts/StandardContentLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StandardContentHero from '../components/content/StandardContentHero.astro';
import StandardContentToc from '../components/content/StandardContentToc.astro';
import { editorialGuidelinesSections } from '../data/methodology-support-content';
import { testHubUrl, toSlug } from '../lib/slugs';
import '../styles/test-hub.css';

const sections = editorialGuidelinesSections.map((section) => ({
  ...section,
  id: toSlug(section.title),
}));
---

<BaseLayout
  title="Editorial Guidelines — AI Girlfriend Expert"
  description="Our editorial independence, fact-checking standards, correction policy, affiliate disclosures, and separation between commercial relationships and product scoring."
>
  <Header />
  <StandardContentLayout pageClass="test-page">
    <StandardContentToc
      slot="sidebar"
      items={sections.map((section) => ({ id: section.id, label: section.title }))}
      topAnchor="#editorial-guidelines-top"
    />

    <StandardContentHero
      slot="hero"
      breadcrumbs={[
        { label: 'Home', href: '/' },
        { label: 'Editorial guidelines' },
      ]}
      eyebrow="Editorial standards"
      title="Editorial guidelines"
      intro="How we maintain editorial independence, verify facts, handle corrections, disclose affiliate relationships, and keep commercial interests separate from scoring."
    />

    <div id="editorial-guidelines-top">
      {
        sections.map((section) => (
          <section id={section.id} class="test-page__section scroll-mt-24">
            <h2 class="test-page__h2">{section.title}</h2>
            <p class="test-prose">{section.body}</p>
          </section>
        ))
      }

      <p class="test-prose">
        For affiliate disclosure details, see our{' '}
        <a class="test-inline-link" href="/legal/affiliate-disclosure/">affiliate disclosure</a>.
      </p>

      <a class="test-inline-link test-page__back" href={testHubUrl()}>
        <span class="material-symbols-outlined" aria-hidden="true">arrow_back</span>
        Back to how we test
      </a>
    </div>
  </StandardContentLayout>
  <Footer />
</BaseLayout>
