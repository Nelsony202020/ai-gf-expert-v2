---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import HomeHero from '../components/home/HomeHero.astro';
import HomeTrustStrip from '../components/home/HomeTrustStrip.astro';
import HomeLabNotice from '../components/home/HomeLabNotice.astro';
import HomeGuides from '../components/home/HomeGuides.astro';
import PageMobileNavSheet from '../components/mobile/PageMobileNavSheet.astro';
import { homeMeta } from '../data/homepage';
import { loadHomepageGuides } from '../lib/content/homepageLoaders';
import JsonLd from '../components/seo/JsonLd.astro';
import { buildHomepageSchema } from '../lib/seo/jsonld';
import { cdnAsset } from '../lib/media/cdn';

// Quick-fix homepage: hero + trust + lab notice + guides.
// Full composition preserved at /dev/home-full/
const featuredGuides = await loadHomepageGuides();
const jsonLdGraph = buildHomepageSchema();
const heroImage = cdnAsset('/brand/home-hero-mock.jpg');
const heroImageAlt = 'Coming soon note pinned to a corkboard';

const homeToc = [
  { id: 'home-hero', label: 'Intro' },
  { id: 'home-lab', label: 'Coming soon' },
  { id: 'home-guides', label: 'Guides' },
];
---

<BaseLayout
  title={homeMeta.title}
  description={homeMeta.description}
  image={heroImage}
  lcpImage={heroImage}
  theme="home"
>
  <JsonLd slot="head" graph={jsonLdGraph} />
  <Header />
  <main>
    <div id="home-hero">
      <HomeHero heroImage={heroImage} heroImageAlt={heroImageAlt} />
    </div>
    <HomeTrustStrip />
    <HomeLabNotice />
    <div id="home-guides" class="scroll-mt-24">
      <HomeGuides guides={featuredGuides} />
    </div>
  </main>
  <Footer />
  <PageMobileNavSheet
    sections={homeToc}
    pageTitle={homeMeta.title}
    pageUrl="https://aigirlfriend.expert/"
  />
</BaseLayout>
