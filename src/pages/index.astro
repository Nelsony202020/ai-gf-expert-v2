---
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
import HomeDesktop from '../components/home/desktop/HomeDesktop.astro';
import { homeMeta } from '../data/homepage';
import { loadDesktopHomepage } from '../lib/home/loadDesktopHomepage';
import JsonLd from '../components/seo/JsonLd.astro';
import { buildHomepageSchema } from '../lib/seo/jsonld';

const data = await loadDesktopHomepage();
const jsonLdGraph = buildHomepageSchema();
const lcpImage = '/home/v2/herman-scientist.png';
---

<BaseLayout
  title={homeMeta.title}
  description={homeMeta.description}
  image={lcpImage}
  lcpImage={lcpImage}
  theme="home"
>
  <JsonLd slot="head" graph={jsonLdGraph} />
  <main>
    <HomeDesktop data={data} />
  </main>
  <Footer />
</BaseLayout>
