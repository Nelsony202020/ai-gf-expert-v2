---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/ui/Breadcrumbs.astro';
import ArticleUtilityRail from '../components/article/ArticleUtilityRail.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import { buildWebPageSchema } from '../lib/seo/jsonld';
import { canonicalPublicUrl } from '../lib/siteOrigin';
import { loadPublishedGlossaryEntries } from '../lib/glossary/load';
import { renderGlossaryTipTapHtml } from '../lib/glossary/renderTipTap';
import { relatedGlossaryTerms } from '../lib/glossary/related';
import {
  GLOSSARY_CATEGORY_OPTIONS,
  extractPlainTextFromTipTap,
  glossaryAlsoCalledText,
} from '../lib/glossary/types';
import '../styles/glossary.css';

const entries = await loadPublishedGlossaryEntries();
const pageTitle = 'AI Girlfriend Glossary';
const metaTitle = 'AI Girlfriend Glossary: Terms & Definitions';
const description =
  'Plain-language definitions of AI girlfriend app terms — tokens, context windows, in-chat images, privacy settings, and more.';
const canonical = canonicalPublicUrl('/glossary/', Astro.site);

const usedCategories = GLOSSARY_CATEGORY_OPTIONS.filter((cat) =>
  entries.some((e) => e.category === cat),
);
const categoryCounts = Object.fromEntries(
  usedCategories.map((cat) => [cat, entries.filter((e) => e.category === cat).length]),
) as Record<string, number>;

const letterOf = (term: string) => {
  const ch = term.trim().charAt(0).toUpperCase();
  return /[A-Z]/.test(ch) ? ch : '#';
};

const alphabet = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.split('');

const byLetter = new Map<string, typeof entries>();
for (const entry of entries) {
  const letter = letterOf(entry.term);
  const list = byLetter.get(letter) ?? [];
  list.push(entry);
  byLetter.set(letter, list);
}
for (const list of byLetter.values()) {
  list.sort((a, b) => a.term.localeCompare(b.term));
}
const letterKeys = [...byLetter.keys()].sort((a, b) => {
  if (a === '#') return 1;
  if (b === '#') return -1;
  return a.localeCompare(b);
});

function restOfDefinition(html: string, tooltip: string) {
  const match = html.match(/^<p>([\s\S]*?)<\/p>\s*/i);
  if (!match) return html;
  const text = match[1]
    .replace(/<[^>]+>/g, '')
    .replace(/\s+/g, ' ')
    .trim()
    .toLowerCase();
  const tip = tooltip.replace(/\s+/g, ' ').trim().toLowerCase();
  if (!text) return html.slice(match[0].length);
  if (tip.startsWith(text) || text.startsWith(tip.slice(0, Math.min(48, tip.length)))) {
    return html.slice(match[0].length);
  }
  return html;
}

function decorateDefinitionHtml(html: string) {
  return html.replace(
    /<p>(Example(?: command)?:)\s*([\s\S]*?)<\/p>/gi,
    '<div class="glossary-term__example"><p class="glossary-term__kicker">$1</p><div class="glossary-term__example-box"><p>$2</p></div></div>',
  );
}

const jsonLdGraph = buildWebPageSchema({
  pathname: '/glossary/',
  name: pageTitle,
  description,
  breadcrumbs: [
    { label: 'Home', href: '/' },
    { label: 'Glossary' },
  ],
});
---

<BaseLayout title={metaTitle} description={description} canonical={canonical}>
  <JsonLd slot="head" graph={jsonLdGraph} />
  <Header />
  <main class="glossary-page">
    <div class="glossary-page__canvas">
      <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Glossary' }]} />

      <header class="glossary-page__hero">
        <p class="glossary-page__eyebrow">Reference</p>
        <h1 class="glossary-page__title">AI Girlfriend Glossary</h1>
        <p class="glossary-page__intro">
          Everything you need to understand the terms we use when testing AI companion apps.
        </p>
        {
          entries.length > 0 ? (
            <p class="glossary-page__meta">
              <span>
                {entries.length} {entries.length === 1 ? 'term' : 'terms'}
              </span>
              <span class="glossary-page__meta-dot" aria-hidden="true"></span>
              <span>
                {usedCategories.length} {usedCategories.length === 1 ? 'category' : 'categories'}
              </span>
            </p>
          ) : null
        }
      </header>

      {
        entries.length === 0 ? (
          <p class="glossary-page__empty">
            Glossary terms will appear here as we publish definitions. Check back soon.
          </p>
        ) : (
          <>
            <div class="glossary-page__controls" data-glossary-controls>
              <div class="glossary-search glossary-search--page">
                <span class="glossary-search__icon" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="11" cy="11" r="7"></circle>
                    <path d="m20 20-3-3"></path>
                  </svg>
                </span>
                <label class="sr-only" for="glossary-search">Search the glossary</label>
                <input
                  id="glossary-search"
                  class="glossary-search__input"
                  type="search"
                  placeholder="Search the glossary…"
                  autocomplete="off"
                  spellcheck="false"
                  data-glossary-search="page"
                />
                <span class="glossary-search__kbd" aria-hidden="true">/</span>
                <button type="button" class="glossary-search__clear" data-glossary-clear hidden>
                  Clear
                </button>
              </div>

              <div class="glossary-chips" role="group" aria-label="Filter by category" data-glossary-chip-row>
                <button type="button" class="glossary-chip is-active" data-glossary-category="all">
                  All <span class="glossary-chip__count">{entries.length}</span>
                </button>
                {usedCategories.map((cat) => (
                  <button type="button" class="glossary-chip" data-glossary-category={cat}>
                    {cat} <span class="glossary-chip__count">{categoryCounts[cat]}</span>
                  </button>
                ))}
              </div>

              <div class="glossary-az glossary-az--desktop" data-glossary-az-row>
                <p class="glossary-az__label" id="glossary-az-label">Jump to letter</p>
                <nav class="glossary-az__letters" aria-labelledby="glossary-az-label">
                  {alphabet.map((letter) => {
                    const active = byLetter.has(letter);
                    return active ? (
                      <a class="glossary-az__letter is-active" href={`#letter-${letter}`} data-glossary-az={letter}>
                        {letter}
                      </a>
                    ) : (
                      <span class="glossary-az__letter is-disabled" aria-disabled="true">
                        {letter}
                      </span>
                    );
                  })}
                </nav>
              </div>

              <div class="glossary-az glossary-az--mobile">
                <button type="button" class="glossary-az__jump" data-glossary-letter-menu>
                  Jump to letter
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="m6 9 6 6 6-6"></path>
                  </svg>
                </button>
              </div>
            </div>

            <div class="glossary-sentinel" data-glossary-sentinel aria-hidden="true"></div>

            <div class="glossary-toolbar" data-glossary-toolbar hidden>
              <div class="glossary-toolbar__inner">
                <div class="glossary-search glossary-search--compact">
                  <span class="glossary-search__icon" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="11" cy="11" r="7"></circle>
                      <path d="m20 20-3-3"></path>
                    </svg>
                  </span>
                  <label class="sr-only" for="glossary-search-sticky">Search the glossary</label>
                  <input
                    id="glossary-search-sticky"
                    class="glossary-search__input"
                    type="search"
                    placeholder="Search the glossary…"
                    autocomplete="off"
                    spellcheck="false"
                    data-glossary-search="sticky"
                  />
                  <button type="button" class="glossary-search__clear" data-glossary-clear hidden>
                    Clear
                  </button>
                </div>
                <div class="glossary-chips glossary-chips--toolbar" role="group" aria-label="Filter by category">
                  <button type="button" class="glossary-chip is-active" data-glossary-category="all">
                    All <span class="glossary-chip__count">{entries.length}</span>
                  </button>
                  {usedCategories.map((cat) => (
                    <button type="button" class="glossary-chip" data-glossary-category={cat}>
                      {cat} <span class="glossary-chip__count">{categoryCounts[cat]}</span>
                    </button>
                  ))}
                </div>
                <button type="button" class="glossary-az__compact" data-glossary-letter-menu>
                  A–Z
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="m6 9 6 6 6-6"></path>
                  </svg>
                </button>
              </div>
            </div>

            <div class="glossary-letter-panel" data-glossary-letter-panel hidden>
              <p class="glossary-letter-panel__title">Jump to letter</p>
              <div class="glossary-letter-panel__list">
                {letterKeys.filter((l) => l !== '#').map((letter) => (
                  <a href={`#letter-${letter}`} data-glossary-az={letter}>
                    {letter}
                  </a>
                ))}
              </div>
            </div>

            <div class="glossary-results" data-glossary-results hidden>
              <p class="glossary-results__header" data-glossary-results-header></p>
              <div data-glossary-results-list></div>
              <p class="glossary-results__hint">
                Press Enter or click a result to jump to that definition — it opens automatically.
              </p>
            </div>

            <div class="glossary-page__no-results" data-glossary-empty hidden>
              <p class="glossary-page__no-results-title" data-glossary-empty-title>
                No glossary terms found
              </p>
              <p>Try a different search or browse by category.</p>
              <button type="button" class="glossary-page__clear-search" data-glossary-clear>
                Clear search
              </button>
            </div>

            <div data-glossary-index>
              {letterKeys.map((letter) => (
                <section
                  class="glossary-letter"
                  id={letter === '#' ? 'letter-other' : `letter-${letter}`}
                  data-glossary-letter={letter}
                >
                  <h2 class="glossary-letter__heading">{letter === '#' ? '#' : letter}</h2>
                  {(byLetter.get(letter) ?? []).map((entry) => {
                    const bodyHtml = decorateDefinitionHtml(
                      restOfDefinition(
                        renderGlossaryTipTapHtml(entry.fullDefinition),
                        entry.tooltipDefinition,
                      ),
                    );
                    const related = relatedGlossaryTerms(entry, entries);
                    const also = glossaryAlsoCalledText(entry.term, entry.displayAliases);
                    const searchBlob = [
                      entry.term,
                      ...entry.aliases,
                      ...entry.displayAliases,
                      entry.tooltipDefinition,
                      entry.category,
                      extractPlainTextFromTipTap(entry.fullDefinition),
                    ]
                      .join(' ')
                      .toLowerCase();
                    return (
                      <article
                        class="glossary-term"
                        id={entry.anchor}
                        data-glossary-term
                        data-category={entry.category}
                        data-search={searchBlob}
                        data-term={entry.term}
                      >
                        <div class="glossary-term__summary">
                          <div class="glossary-term__head">
                            <h3 class="glossary-term__title">{entry.term}</h3>
                            <span class="glossary-term__tag">{entry.category}</span>
                          </div>
                          {also ? <p class="glossary-term__aliases">Also called: {also}</p> : null}
                          <p class="glossary-term__lede">{entry.tooltipDefinition}</p>
                          <div class="glossary-term__actions">
                            <button
                              type="button"
                              class="glossary-term__toggle"
                              data-glossary-toggle
                              aria-expanded="false"
                            >
                              <span data-glossary-toggle-label>View definition</span>
                              <svg class="glossary-term__chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="m6 9 6 6 6-6"></path>
                              </svg>
                            </button>
                            <button
                              type="button"
                              class="glossary-term__copy"
                              data-glossary-copy-link
                              data-href={`/glossary/#${entry.anchor}`}
                            >
                              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <rect x="8" y="8" width="12" height="12" rx="2"></rect>
                                <path d="M4 16V6a2 2 0 0 1 2-2h10"></path>
                              </svg>
                              <span data-glossary-copy-label>Copy link</span>
                            </button>
                          </div>
                        </div>
                        <div class="glossary-term__full" hidden data-glossary-full>
                          {bodyHtml ? (
                            <div class="glossary-term__body" set:html={bodyHtml} />
                          ) : null}
                          {related.length > 0 ? (
                            <div class="glossary-term__related">
                              <p class="glossary-term__kicker">Related terms</p>
                              <ul>
                                {related.map((rel) => (
                                  <li>
                                    <a href={`/glossary/#${rel.anchor}`} data-glossary-related={rel.anchor}>
                                      {rel.term}
                                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M5 12h14"></path>
                                        <path d="m13 6 6 6-6 6"></path>
                                      </svg>
                                    </a>
                                  </li>
                                ))}
                              </ul>
                            </div>
                          ) : null}
                          <div class="glossary-term__actions glossary-term__actions--end">
                            <button
                              type="button"
                              class="glossary-term__toggle"
                              data-glossary-toggle
                              aria-expanded="true"
                            >
                              <span>Collapse</span>
                              <svg class="glossary-term__chevron is-open" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="m6 9 6 6 6-6"></path>
                              </svg>
                            </button>
                            <button
                              type="button"
                              class="glossary-term__copy"
                              data-glossary-copy-link
                              data-href={`/glossary/#${entry.anchor}`}
                            >
                              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <rect x="8" y="8" width="12" height="12" rx="2"></rect>
                                <path d="M4 16V6a2 2 0 0 1 2-2h10"></path>
                              </svg>
                              <span data-glossary-copy-label>Copy link</span>
                            </button>
                          </div>
                        </div>
                      </article>
                    );
                  })}
                </section>
              ))}
            </div>
          </>
        )
      }
    </div>
  </main>
  <Footer />
  <ArticleUtilityRail pageTitle={pageTitle} pageUrl={canonical} mobileMinimal />
</BaseLayout>

<script>
  function initGlossaryPage() {
    const page = document.querySelector('.glossary-page');
    if (!(page instanceof HTMLElement) || page.dataset.bound === 'true') return;
    page.dataset.bound = 'true';

    function escapeHtml(value) {
      return String(value)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    const searchInputs = Array.from(document.querySelectorAll('[data-glossary-search]'));
    const chips = Array.from(document.querySelectorAll('[data-glossary-category]'));
    const terms = Array.from(document.querySelectorAll('[data-glossary-term]'));
    const letters = Array.from(document.querySelectorAll('[data-glossary-letter]'));
    const empty = document.querySelector('[data-glossary-empty]');
    const emptyTitle = document.querySelector('[data-glossary-empty-title]');
    const index = document.querySelector('[data-glossary-index]');
    const results = document.querySelector('[data-glossary-results]');
    const resultsHeader = document.querySelector('[data-glossary-results-header]');
    const resultsList = document.querySelector('[data-glossary-results-list]');
    const toolbar = document.querySelector('[data-glossary-toolbar]');
    const sentinel = document.querySelector('[data-glossary-sentinel]');
    const letterPanel = document.querySelector('[data-glossary-letter-panel]');
    const clearBtns = Array.from(document.querySelectorAll('[data-glossary-clear]'));
    let category = 'all';
    let deepLinkTimer = 0;

    function query() {
      return (searchInputs[0]?.value ?? '').trim();
    }

    function setQuery(value: string) {
      for (const input of searchInputs) input.value = value;
      for (const btn of clearBtns) {
        if (btn.classList.contains('glossary-search__clear')) btn.hidden = !value;
      }
    }

    function setCategory(next: string) {
      category = next;
      for (const chip of chips) {
        chip.classList.toggle('is-active', (chip.dataset.glossaryCategory ?? 'all') === category);
      }
    }

    function setOpen(term: HTMLElement, open: boolean, opts?: { deep?: boolean }) {
      const full = term.querySelector<HTMLElement>('[data-glossary-full]');
      if (full) full.hidden = !open;
      term.classList.toggle('is-open', open);
      for (const btn of term.querySelectorAll<HTMLButtonElement>('[data-glossary-toggle]')) {
        btn.setAttribute('aria-expanded', open ? 'true' : 'false');
        const label = btn.querySelector('[data-glossary-toggle-label]');
        if (label) label.textContent = open ? 'Collapse' : 'View definition';
      }
      if (opts?.deep) {
        term.classList.add('is-deep-link');
        window.clearTimeout(deepLinkTimer);
        deepLinkTimer = window.setTimeout(() => term.classList.remove('is-deep-link'), 4000);
      }
    }

    function termByAnchor(anchor: string) {
      const id = anchor.replace(/^#/, '');
      return terms.find((t) => t.id === id) ?? null;
    }

    function applyFilter() {
      const q = query().toLowerCase();
      const searching = q.length > 0;
      let visible: HTMLElement[] = [];
      for (const term of terms) {
        const cat = term.dataset.category ?? '';
        const blob = term.dataset.search ?? '';
        const catOk = category === 'all' || cat === category;
        const qOk = !q || blob.includes(q);
        const show = catOk && qOk;
        term.classList.toggle('is-hidden', !show);
        if (show) visible.push(term);
      }
      for (const letter of letters) {
        const hasVisible = letter.querySelector('[data-glossary-term]:not(.is-hidden)');
        letter.classList.toggle('is-hidden', !hasVisible);
      }

      if (results && resultsList && resultsHeader && index) {
        if (searching && visible.length > 0) {
          index.hidden = true;
          results.hidden = false;
          if (empty) {
            empty.hidden = true;
            empty.classList.remove('is-visible');
          }
          resultsHeader.textContent = `${visible.length} ${visible.length === 1 ? 'result' : 'results'} for “${query()}”`;
          resultsList.innerHTML = visible
            .map((term) => {
              const name = escapeHtml(term.dataset.term ?? '');
              const cat = escapeHtml(term.dataset.category ?? '');
              const lede = escapeHtml(term.querySelector('.glossary-term__lede')?.textContent ?? '');
              return `<button type="button" class="glossary-result" data-glossary-result="${term.id}">
                <span class="glossary-result__term">${name}</span>
                <span class="glossary-result__tag">${cat}</span>
                <span class="glossary-result__lede">${lede}</span>
              </button>`;
            })
            .join('');
        } else if (searching && visible.length === 0) {
          index.hidden = true;
          results.hidden = true;
          if (empty) {
            empty.hidden = false;
            empty.classList.add('is-visible');
            if (emptyTitle) emptyTitle.textContent = `No glossary terms found for “${query()}”`;
          }
        } else {
          index.hidden = false;
          results.hidden = true;
          if (empty) {
            empty.hidden = visible.length > 0;
            empty.classList.toggle('is-visible', visible.length === 0);
            if (emptyTitle) emptyTitle.textContent = 'No glossary terms found';
          }
        }
      }
    }

    function openFromHash(opts?: { deep?: boolean }) {
      const hash = window.location.hash.replace(/^#/, '');
      if (!hash || hash.startsWith('letter-')) return;
      const term = termByAnchor(hash);
      if (!term) return;
      setQuery('');
      applyFilter();
      setOpen(term, true, { deep: opts?.deep ?? true });
      term.scrollIntoView({ block: 'start' });
    }

    for (const input of searchInputs) {
      input.addEventListener('input', () => {
        setQuery(input.value);
        applyFilter();
      });
      input.addEventListener('keydown', (event) => {
        if (event.key !== 'Enter') return;
        event.preventDefault();
        const first = resultsList?.querySelector<HTMLButtonElement>('[data-glossary-result]');
        if (first) first.click();
      });
    }

    for (const chip of chips) {
      chip.addEventListener('click', () => {
        setCategory(chip.dataset.glossaryCategory ?? 'all');
        applyFilter();
      });
    }

    for (const btn of clearBtns) {
      btn.addEventListener('click', () => {
        setQuery('');
        applyFilter();
        searchInputs[0]?.focus();
      });
    }

    page.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      const toggle = target.closest<HTMLButtonElement>('[data-glossary-toggle]');
      if (toggle) {
        const term = toggle.closest<HTMLElement>('[data-glossary-term]');
        if (term) setOpen(term, !term.classList.contains('is-open'));
        return;
      }
      const copy = target.closest<HTMLButtonElement>('[data-glossary-copy-link]');
      if (copy) {
        const href = copy.getAttribute('data-href');
        if (!href) return;
        const absolute = new URL(href, window.location.origin).toString();
        void navigator.clipboard.writeText(absolute).then(() => {
          const label = copy.querySelector('[data-glossary-copy-label]');
          if (!label) return;
          label.textContent = 'Copied';
          window.setTimeout(() => {
            label.textContent = 'Copy link';
          }, 1600);
        });
        return;
      }
      const related = target.closest<HTMLAnchorElement>('[data-glossary-related]');
      if (related) {
        event.preventDefault();
        const id = related.dataset.glossaryRelated ?? '';
        history.replaceState(null, '', `#${id}`);
        const term = termByAnchor(id);
        if (term) {
          setQuery('');
          applyFilter();
          setOpen(term, true);
          term.scrollIntoView({ block: 'start' });
        }
        return;
      }
      const result = target.closest<HTMLButtonElement>('[data-glossary-result]');
      if (result) {
        const id = result.dataset.glossaryResult ?? '';
        history.replaceState(null, '', `#${id}`);
        setQuery('');
        applyFilter();
        const term = termByAnchor(id);
        if (term) {
          setOpen(term, true);
          term.scrollIntoView({ block: 'start' });
        }
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key !== '/' || event.metaKey || event.ctrlKey || event.altKey) return;
      const el = event.target;
      if (el instanceof HTMLInputElement || el instanceof HTMLTextAreaElement || (el instanceof HTMLElement && el.isContentEditable)) {
        return;
      }
      event.preventDefault();
      (toolbar?.hidden === false ? searchInputs[1] : searchInputs[0])?.focus();
    });

    if (toolbar && sentinel) {
      const observer = new IntersectionObserver(
        ([entry]) => {
          const stuck = !entry.isIntersecting && entry.boundingClientRect.top < 0;
          toolbar.hidden = !stuck;
          toolbar.classList.toggle('is-stuck', stuck);
          document.body.classList.toggle('glossary-toolbar-stuck', stuck);
        },
        { threshold: 0 },
      );
      observer.observe(sentinel);
    }

    function closeLetterPanel() {
      if (letterPanel) letterPanel.hidden = true;
    }

    for (const menuBtn of document.querySelectorAll<HTMLButtonElement>('[data-glossary-letter-menu]')) {
      menuBtn.addEventListener('click', (event) => {
        event.stopPropagation();
        if (!letterPanel) return;
        letterPanel.hidden = !letterPanel.hidden;
      });
    }
    for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-glossary-az]')) {
      link.addEventListener('click', () => {
        closeLetterPanel();
      });
    }
    document.addEventListener('click', (event) => {
      if (!(event.target instanceof Element)) return;
      if (event.target.closest('[data-glossary-letter-panel], [data-glossary-letter-menu]')) return;
      closeLetterPanel();
    });

    window.addEventListener('hashchange', () => openFromHash({ deep: true }));
    openFromHash({ deep: true });
    applyFilter();
  }

  initGlossaryPage();
  document.addEventListener('astro:page-load', initGlossaryPage);
</script>
