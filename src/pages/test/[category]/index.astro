---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import StandardContentLayout from '../../../layouts/StandardContentLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import StandardContentHero from '../../../components/content/StandardContentHero.astro';
import TestHubSidebar from '../../../components/test/TestHubSidebar.astro';
import TestCategoryMethodologyHero from '../../../components/test/TestCategoryMethodologyHero.astro';
import TestCategoryMethodologyBody from '../../../components/test/TestCategoryMethodologyBody.astro';
import TestCategoryMobileNavSheet from '../../../components/test/TestCategoryMobileNavSheet.astro';
import TestPageBackLink from '../../../components/test/TestPageBackLink.astro';
import ArticleUtilityRail from '../../../components/article/ArticleUtilityRail.astro';
import RatingsTooltipInit from '../../../components/review/tooltips/RatingsTooltipInit.astro';
import { getTestCategories, getTestCategory } from '../../../lib/test-framework';
import { getTestCategoryMethodology } from '../../../data/test-category-methodology';
import { testHubUrl } from '../../../lib/slugs';
import '../../../styles/test-hub.css';
import '../../../styles/ratings-tooltips.css';

export function getStaticPaths() {
  return getTestCategories().map((cat) => ({
    params: { category: cat.key },
  }));
}

const { category: categoryKey } = Astro.params;
const category = getTestCategory(categoryKey!);

if (!category) {
  throw new Error(`Unknown test category: ${categoryKey}`);
}

const methodology = getTestCategoryMethodology(category.key);

const categories = getTestCategories();

const pageTitle = `${category.name} Testing Methodology — AI Girlfriend Expert`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).toString();
const introParagraphs = methodology?.intro?.length ? methodology.intro : [category.description];

const tocItems = methodology
  ? [
      {
        id: 'category-subscores',
        label: 'Subscores',
        children: category.subscores.map((sub) => ({ id: sub.slug, label: sub.name })),
      },
      { id: 'score-calculation', label: methodology.scoreCalculation.title },
      ...(methodology.whyWeTest
        ? [{ id: `why-we-test-${category.key}`, label: methodology.whyWeTest.title }]
        : []),
      { id: 'how-we-test', label: methodology.howWeTest.title },
      { id: 'limitations', label: methodology.limitations.title },
    ]
  : [
      {
        id: 'category-subscores',
        label: 'Subscores',
        children: category.subscores.map((sub) => ({ id: sub.slug, label: sub.name })),
      },
    ];
---

<BaseLayout title={pageTitle} description={introParagraphs[0] ?? category.description}>
  <Header />
  <StandardContentLayout pageClass="test-category-page">
    <TestHubSidebar
      slot="sidebar"
      categories={categories}
      tocSections={tocItems}
    />

    {
      methodology ? (
        <TestCategoryMethodologyHero
          slot="hero"
          breadcrumbs={[
            { label: 'Home', href: '/' },
            { label: 'How We Test', href: testHubUrl() },
            { label: category.name },
          ]}
          category={category}
          intro={introParagraphs}
        />
      ) : (
        <StandardContentHero
          slot="hero"
          breadcrumbs={[
            { label: 'Home', href: '/' },
            { label: 'How We Test', href: testHubUrl() },
            { label: category.name },
          ]}
          title={category.name}
          titleSub="Testing methodology"
          intro={introParagraphs}
        />
      )
    }

    {
      methodology ? (
        <TestCategoryMethodologyBody category={category} content={methodology} />
      ) : (
        <div id="test-category-top" class="test-hub__main">
          <section id="category-subscores" class="test-page__section scroll-mt-24">
            <h2 class="test-page__h2">Subscores</h2>
            <ul class="test-evidence-links">
              {
                category.subscores.map((sub) => (
                  <li>
                    <a href={sub.href}>{sub.name}</a>
                  </li>
                ))
              }
            </ul>
          </section>
          <TestPageBackLink href={testHubUrl()} label="how we test" />
        </div>
      )
    }
  </StandardContentLayout>
  <Footer />
  <TestCategoryMobileNavSheet category={category} active="how-we-test" />
  <ArticleUtilityRail pageTitle={pageTitle} pageUrl={canonical} mobileMinimal showMobileNav />
  <RatingsTooltipInit />

  <script>
    function initTestHubNav() {
      const navs = Array.from(document.querySelectorAll('[data-test-hub-nav]'));
      if (!navs.length || document.documentElement.dataset.testHubNavBound === 'true') return;
      document.documentElement.dataset.testHubNavBound = 'true';

      const sectionLinks = Array.from(
        navs[0].querySelectorAll<HTMLAnchorElement>('[data-test-hub-nav-link]'),
      );
      if (!sectionLinks.length) return;

      const sections = sectionLinks
        .map((link) => {
          const id = link.dataset.sectionId;
          return id ? document.getElementById(id) : null;
        })
        .filter((section): section is HTMLElement => section instanceof HTMLElement);

      const setActive = (id: string | null) => {
        navs.forEach((nav) => {
          nav.querySelectorAll<HTMLAnchorElement>('[data-test-hub-nav-link]').forEach((link) => {
            const active = link.dataset.sectionId === id;
            link.classList.toggle('is-active', active);
            if (active) link.setAttribute('aria-current', 'location');
            else link.removeAttribute('aria-current');
          });
        });
      };

      const scrollOffset = 24;

      navs.forEach((nav) => {
        nav.querySelectorAll<HTMLAnchorElement>('[data-test-hub-nav-link]').forEach((link) => {
          link.addEventListener('click', (event) => {
            const id = link.dataset.sectionId;
            if (!id) return;
            const section = document.getElementById(id);
            if (!section) return;
            event.preventDefault();
            const y = section.getBoundingClientRect().top + window.scrollY - scrollOffset;
            window.scrollTo({ top: Math.max(0, y), behavior: 'smooth' });
            history.pushState(null, '', `#${id}`);
            setActive(id);
          });
        });
      });

      const updateActiveSection = () => {
        const marker = window.scrollY + scrollOffset + 8;
        let currentId: string | null = sections[0]?.id ?? null;

        for (const section of sections) {
          if (section.offsetTop <= marker) currentId = section.id;
          else break;
        }

        setActive(currentId);
      };

      updateActiveSection();
      window.addEventListener('scroll', updateActiveSection, { passive: true });
      window.addEventListener('resize', updateActiveSection);
    }

    initTestHubNav();
    document.addEventListener('astro:page-load', initTestHubNav);
  </script>
</BaseLayout>
