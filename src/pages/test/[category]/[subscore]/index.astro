---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import StandardContentLayout from '../../../../layouts/StandardContentLayout.astro';
import Header from '../../../../components/Header.astro';
import Footer from '../../../../components/Footer.astro';
import TestSubscoreMethodologyBody from '../../../../components/test/TestSubscoreMethodologyBody.astro';
import TestSubscoreMethodologyHero from '../../../../components/test/TestSubscoreMethodologyHero.astro';
import TestPageBackLink from '../../../../components/test/TestPageBackLink.astro';
import TestHubSidebar from '../../../../components/test/TestHubSidebar.astro';
import ArticleUtilityRail from '../../../../components/article/ArticleUtilityRail.astro';
import { findTestSubscore, getTestCategories } from '../../../../lib/test-framework';
import { getMethodology } from '../../../../data/methodology';
import { getTestSubscoreMethodology } from '../../../../data/test-subscore-methodology';
import { getPublicEvidenceGroupDisplay } from '../../../../lib/test-subscore-public-evidence';
import { getTestCategoryMethodology } from '../../../../data/test-category-methodology';
import { buildSubscoreRelatedMethodology } from '../../../../data/test-hub-content';
import { testCategoryUrl, testHubUrl } from '../../../../lib/slugs';
import '../../../../styles/test-hub.css';

const categories = getTestCategories();

export function getStaticPaths() {
  const paths: { params: { category: string; subscore: string } }[] = [];

  for (const cat of getTestCategories()) {
    for (const sub of cat.subscores) {
      paths.push({
        params: {
          category: cat.key,
          subscore: sub.slug,
        },
      });
    }
  }

  return paths;
}

const { category, subscore } = Astro.params;
const match = findTestSubscore(category!, subscore!);

if (!match) {
  throw new Error(`Unknown subscore: ${category}/${subscore}`);
}

const { category: catNode, sub: subNode } = match;
const richContent = getTestSubscoreMethodology(category!, subscore!);
const pageTitle = `${subNode.name} — ${catNode.name} — How We Test`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).toString();

const evidenceItems = subNode.contributors.map((contributor) => ({
  id: contributor.slug,
  label: contributor.label,
  contributorSlug: contributor.slug,
}));

const categoryMethodology = getTestCategoryMethodology(catNode.key);
const subscoreWeight = categoryMethodology?.scoreCalculation.weights.find(
  (item) => item.name === subNode.name,
)?.weight;

const evidenceGroups = getPublicEvidenceGroupDisplay(category!, subscore!);

const relatedMethodology = buildSubscoreRelatedMethodology(catNode, subNode.slug);

const tocItems = richContent
  ? [
      { id: 'score-calculation', label: richContent.scoreCalculation.title },
      { id: 'why-it-matters', label: richContent.whyItMatters.title },
      { id: 'how-we-test', label: richContent.howWeTest.title },
      {
        id: 'evidence-groups',
        label: 'Evidence groups',
        children: evidenceGroups
          ? evidenceGroups.map((group) => ({ id: group.slug, label: group.label }))
          : evidenceItems.map((item) => ({ id: item.id, label: item.label })),
      },
    ]
  : [
      {
        id: 'evidence-groups',
        label: 'Evidence groups',
        children: evidenceItems.map((item) => ({ id: item.id, label: item.label })),
      },
    ];
---

<BaseLayout
  title={pageTitle}
  description={richContent?.heroIntro.join(' ') ?? subNode.description}
>
  <Header />
  <StandardContentLayout pageClass="test-category-page test-page">
    <TestHubSidebar
      slot="sidebar"
      categories={categories}
      tocSections={tocItems}
      relatedMethodology={relatedMethodology}
    />

    <TestSubscoreMethodologyHero
      slot="hero"
      breadcrumbs={[
        { label: 'Home', href: '/' },
        { label: 'How We Test', href: testHubUrl() },
        { label: catNode.name, href: testCategoryUrl(catNode.key) },
        { label: subNode.name },
      ]}
      category={catNode}
      subscore={subNode}
      intro={richContent?.heroIntro ?? [subNode.description]}
      evidenceGroupCount={evidenceGroups?.length ?? subNode.contributors.length}
      scoredTestCount={
        richContent?.evidenceSections.filter((section) => !section.referenceOnly).length ??
        richContent?.evidenceSections.length
      }
      subscoreWeight={subscoreWeight}
      evidenceHierarchy={richContent?.evidenceHierarchy}
    />

    {
      richContent ? (
        <TestSubscoreMethodologyBody
          category={catNode}
          subscore={subNode}
          content={richContent}
          subscoreWeight={subscoreWeight}
        />
      ) : (
        <div id="test-subscore-top">
          {
            evidenceItems.length > 0 && (
              <section id="evidence-groups" class="test-page__section scroll-mt-24">
                <h2 class="test-page__h2">Evidence groups</h2>
                <div class="test-evidence-list">
                  {
                    evidenceItems.map((item) => {
                      const methodology = getMethodology(category!, subscore!, item.contributorSlug);
                      return (
                        <article class="test-evidence-item scroll-mt-24" id={item.id}>
                          <div class="test-evidence-item__head">
                            <h3 class="test-evidence-item__title">{item.label}</h3>
                          </div>
                          {
                            methodology ? (
                              <>
                                <p class="test-evidence-item__lead">{methodology.measured}</p>
                                <p class="test-evidence-item__body">{methodology.howToTest}</p>
                                {methodology.resultFormat && (
                                  <p class="test-evidence-item__result">
                                    <strong>Displayed result:</strong> {methodology.resultFormat}
                                  </p>
                                )}
                              </>
                            ) : (
                              <p class="test-evidence-item__body">
                                Documentation for this scored test is being added.
                              </p>
                            )
                          }
                        </article>
                      );
                    })
                  }
                </div>
              </section>
            )
          }

          <TestPageBackLink href={catNode.href} label={catNode.name} />
        </div>
      )
    }
  </StandardContentLayout>
  <Footer />
  <ArticleUtilityRail pageTitle={pageTitle} pageUrl={canonical} mobileMinimal />

  <script>
    function initTestHubNav() {
      const navs = Array.from(document.querySelectorAll('[data-test-hub-nav]'));
      if (!navs.length || document.documentElement.dataset.testHubNavBound === 'true') return;
      document.documentElement.dataset.testHubNavBound = 'true';

      const sectionLinks = Array.from(
        navs[0].querySelectorAll<HTMLAnchorElement>('[data-test-hub-nav-link]'),
      );
      if (!sectionLinks.length) return;

      const sections = sectionLinks
        .map((link) => {
          const id = link.dataset.sectionId;
          return id ? document.getElementById(id) : null;
        })
        .filter((section): section is HTMLElement => section instanceof HTMLElement);

      const setActive = (id: string | null) => {
        navs.forEach((nav) => {
          nav.querySelectorAll<HTMLAnchorElement>('[data-test-hub-nav-link]').forEach((link) => {
            const active = link.dataset.sectionId === id;
            link.classList.toggle('is-active', active);
            if (active) link.setAttribute('aria-current', 'location');
            else link.removeAttribute('aria-current');
          });
        });
      };

      const scrollOffset = 24;

      navs.forEach((nav) => {
        nav.querySelectorAll<HTMLAnchorElement>('[data-test-hub-nav-link]').forEach((link) => {
          link.addEventListener('click', (event) => {
            const id = link.dataset.sectionId;
            if (!id) return;
            const section = document.getElementById(id);
            if (!section) return;
            event.preventDefault();
            const y = section.getBoundingClientRect().top + window.scrollY - scrollOffset;
            window.scrollTo({ top: Math.max(0, y), behavior: 'smooth' });
            history.pushState(null, '', `#${id}`);
            setActive(id);
          });
        });
      });

      const updateActiveSection = () => {
        const marker = window.scrollY + scrollOffset + 8;
        let currentId: string | null = sections[0]?.id ?? null;

        for (const section of sections) {
          if (section.offsetTop <= marker) currentId = section.id;
          else break;
        }

        setActive(currentId);
      };

      updateActiveSection();
      window.addEventListener('scroll', updateActiveSection, { passive: true });
      window.addEventListener('resize', updateActiveSection);
    }

    initTestHubNav();
    document.addEventListener('astro:page-load', initTestHubNav);
  </script>
</BaseLayout>
