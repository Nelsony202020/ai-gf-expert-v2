---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StandardContentLayout from '../../layouts/StandardContentLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import StandardContentHero from '../../components/content/StandardContentHero.astro';
import StandardContentToc from '../../components/content/StandardContentToc.astro';
import { marketDataSections } from '../../data/methodology-support-content';
import { testHubUrl, toSlug } from '../../lib/slugs';
import '../../styles/test-hub.css';

const sections = marketDataSections.map((section) => ({
  ...section,
  id: toSlug(section.title),
}));
---

<BaseLayout
  title="Market Data Methodology — AI Girlfriend Expert"
  description="How we use Google Trends, search interest, internal popularity data, and competitive comparisons — and why market data does not affect product scores."
>
  <Header />
  <StandardContentLayout pageClass="test-page">
    <StandardContentToc
      slot="sidebar"
      items={sections.map((section) => ({ id: section.id, label: section.title }))}
      topAnchor="#test-market-data-top"
    />

    <StandardContentHero
      slot="hero"
      breadcrumbs={[
        { label: 'Home', href: '/' },
        { label: 'How We Test', href: testHubUrl() },
        { label: 'Market data' },
      ]}
      eyebrow="Market context"
      title="Market data"
      titleSub="methodology"
      intro="How we collect and present Google Trends, search interest, growth, internal popularity, and competitive market data — and why none of it changes structured product scores."
    />

    <div id="test-market-data-top">
      {
        sections.map((section) => (
          <section id={section.id} class="test-page__section scroll-mt-24">
            <h2 class="test-page__h2">{section.title}</h2>
            <p class="test-prose">{section.body}</p>
          </section>
        ))
      }

      <blockquote class="test-hub__note">
        Popularity and search demand provide useful context. They do not measure how well an app performs in hands-on testing and do not affect the overall performance score.
      </blockquote>

      <a class="test-inline-link test-page__back" href={testHubUrl()}>
        <span class="material-symbols-outlined" aria-hidden="true">arrow_back</span>
        Back to how we test
      </a>
    </div>
  </StandardContentLayout>
  <Footer />
</BaseLayout>
