---
// Server-rendered so newly published reviews/roundups appear immediately,
// without waiting for a static rebuild.
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SitemapLinkCard from '../components/sitemap/SitemapLinkCard.astro';
import SitemapTestMethodology from '../components/sitemap/SitemapTestMethodology.astro';
import SitemapResourcesLegal from '../components/sitemap/SitemapResourcesLegal.astro';
import { buildFullHtmlSitemapPage, getAllSitemapEntries } from '../lib/sitemap';
import { loadPublishedProducts, loadPublishedRoundupSummaries } from '../lib/content/store';
import { getDraftedPaths } from '../lib/seo/pageOverrides';
import { products as fileProducts } from '../data/products';
import { loadSitemapMethodologyIntroStats } from '../lib/test-hub-stats';
import { getTestCategories } from '../lib/test-framework';
import { buildSitemapPageSearchIndex } from '../lib/sitemap-search';

const [publishedProducts, publishedRoundups, draftedPaths] = await Promise.all([
  loadPublishedProducts(fileProducts),
  loadPublishedRoundupSummaries(),
  getDraftedPaths(),
]);

const page = buildFullHtmlSitemapPage({
  products: publishedProducts,
  roundups: publishedRoundups,
  excludePaths: draftedPaths,
});

const methodologyPageCount = getAllSitemapEntries({
  products: publishedProducts,
  roundups: publishedRoundups,
}).filter((e) => e.sitemapSection === 'tests').length;

const methodologyStats = await loadSitemapMethodologyIntroStats(methodologyPageCount);
const categories = getTestCategories();
const sitemapSearchIndex = buildSitemapPageSearchIndex(page, categories);
const sitemapSearchJson = JSON.stringify(sitemapSearchIndex).replace(/</g, '\\u003c');

// Browsers always revalidate (publishes show up on refresh); CDN caches for
// an hour and is purged on every deploy.
Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=3600');
---

<BaseLayout title="Site Index" description="Complete index of reviews, roundups, guides, testing methodology, authors, resources, and legal pages on AI Girlfriend Expert.">
  <Header />
  <main class="sitemap-page">
    <div class="sitemap-hero">
      <div class="section-container px-4 md:px-8 sitemap-hero__inner">
        <p class="sitemap-hero__eyebrow">Site Index</p>
        <h1 class="sitemap-hero__title">Everything on AI Girlfriend Expert</h1>
        <p class="sitemap-hero__intro">
          Browse every published review, guide, roundup, and methodology page — or search the index below.
        </p>

        <div class="sitemap-search" data-sitemap-search>
          <label class="sr-only" for="sitemap-search-input">Search the site index</label>
          <span class="material-symbols-outlined sitemap-search__icon" aria-hidden="true">search</span>
          <input
            id="sitemap-search-input"
            class="sitemap-search__input"
            type="search"
            name="q"
            autocomplete="off"
            placeholder="Find a page, test, or guide…"
            data-sitemap-search-input
          />
          <div class="sitemap-search__results" data-sitemap-search-results hidden></div>
        </div>
      </div>
    </div>

    <div class="section-container px-4 md:px-8 sitemap-page__body">
      <section class="sitemap-explore" aria-labelledby="sitemap-explore-title">
        <div class="sitemap-explore__head">
          <h2 id="sitemap-explore-title" class="sitemap-explore__title">Explore AIGE</h2>
          <p class="sitemap-explore__lead">Major entry points into reviews, roundups, guides, and authors.</p>
        </div>

        <div class="sitemap-explore__grid">
          <SitemapLinkCard
            title="Reviews"
            count={page.reviews.length}
            icon="star"
            tone="amber"
            links={page.reviews}
          />
          <SitemapLinkCard
            title="Roundups"
            count={page.roundups.length}
            icon="emoji_events"
            tone="lime"
            links={page.roundups}
          />
          <SitemapLinkCard
            title="Guides"
            count={page.guides.length}
            icon="menu_book"
            tone="green"
            links={page.guides}
          />
          <SitemapLinkCard
            title="Authors"
            count={page.authors.length}
            icon="person"
            tone="amber"
            links={page.authors}
          />
        </div>
      </section>

      <SitemapTestMethodology stats={methodologyStats} />

      <SitemapResourcesLegal
        count={page.resourcesLegalCount}
        resources={page.resources}
        legal={page.legal}
      />
    </div>
  </main>
  <Footer />

  <script type="application/json" id="sitemap-search-index" set:html={sitemapSearchJson} />
</BaseLayout>

<style is:global>
  @import '../styles/sitemap.css';
</style>

<script>
  function readSitemapSearchIndex() {
    const el = document.getElementById('sitemap-search-index');
    if (!el?.textContent) return [];
    try {
      return JSON.parse(el.textContent) as { label: string; href: string; type: string; meta?: string }[];
    } catch {
      return [];
    }
  }

  function initSitemapSearch() {
    const root = document.querySelector('[data-sitemap-search]');
    const input = document.querySelector<HTMLInputElement>('[data-sitemap-search-input]');
    const results = document.querySelector<HTMLElement>('[data-sitemap-search-results]');
    if (!root || !input || !results || root.dataset.bound === 'true') return;
    root.dataset.bound = 'true';

    const index = readSitemapSearchIndex();
    let activeIndex = -1;

    function render(query: string) {
      const q = query.trim().toLowerCase();
      if (!q) {
        results.innerHTML = '';
        results.hidden = true;
        activeIndex = -1;
        return;
      }

      const matches = index
        .filter((item) => `${item.label} ${item.meta ?? ''}`.toLowerCase().includes(q))
        .slice(0, 10);

      results.hidden = false;

      if (matches.length === 0) {
        results.innerHTML = '<p class="sitemap-search__empty">No results found. Try another keyword.</p>';
        activeIndex = -1;
        return;
      }

      results.innerHTML = matches
        .map((item, i) => {
          const meta = item.meta ?? 'Page';
          return `
            <a href="${item.href}" class="sitemap-search__item${i === activeIndex ? ' is-active' : ''}" role="option">
              <span class="sitemap-search__item-label">${item.label}</span>
              <span class="sitemap-search__item-meta">${meta}</span>
            </a>
          `;
        })
        .join('');
    }

    input.addEventListener('input', () => {
      activeIndex = -1;
      render(input.value);
    });

    input.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        input.value = '';
        render('');
        input.blur();
        return;
      }

      const q = input.value.trim().toLowerCase();
      if (!q) return;
      const matches = index
        .filter((item) => `${item.label} ${item.meta ?? ''}`.toLowerCase().includes(q))
        .slice(0, 10);
      if (!matches.length) return;

      if (e.key === 'ArrowDown') {
        e.preventDefault();
        activeIndex = Math.min(activeIndex + 1, matches.length - 1);
        render(input.value);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        activeIndex = Math.max(activeIndex - 1, 0);
        render(input.value);
      } else if (e.key === 'Enter' && activeIndex >= 0) {
        e.preventDefault();
        const target = matches[activeIndex];
        if (target?.href) window.location.href = target.href;
      }
    });

    document.addEventListener('click', (e) => {
      if (!root.contains(e.target as Node)) {
        results.hidden = true;
      }
    });
  }

  initSitemapSearch();
  document.addEventListener('astro:page-load', initSitemapSearch);
</script>
