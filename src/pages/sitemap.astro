---
import Layout from "@/layouts/Layout.astro";
import { SITE_NAME } from "@/data/site";
import { getHtmlSitemapPage, buildSitemapPageSearchIndex } from "@/lib/sitemap";
import SitemapExploreColumn from "@/components/sitemap/SitemapExploreColumn.astro";
import SitemapTestMethodology from "@/components/sitemap/SitemapTestMethodology.astro";
import SitemapResourcesLegal from "@/components/sitemap/SitemapResourcesLegal.astro";

export const prerender = false;

const page = getHtmlSitemapPage();
const searchHits = buildSitemapPageSearchIndex(page);
const searchHitsJson = JSON.stringify(searchHits).replace(/</g, "\\u003c");

const chips = [
  { href: "#explore", label: "Reviews", count: page.reviewsCount },
  { href: "#rankings", label: "Rankings", count: page.rankingsCount },
  { href: "#guides", label: "Guides", count: page.guidesCount },
  { href: "#si-testing", label: "Tests", count: page.testsCount },
];
---

<Layout
  title={`Site Index | ${SITE_NAME}`}
  description="Find every review, guide, test and resource we publish."
>
  <div class="si-page">
    <section class="si-hero" aria-labelledby="si-title">
      <div class="si-hero-inner">
        <p class="si-eyebrow"><span class="si-dot" aria-hidden="true"></span>SITE INDEX</p>
        <h1 id="si-title" class="si-title">Everything on AI Girlfriend Expert</h1>
        <p class="si-lede">Find every review, guide, test and resource we publish.</p>

        <div class="si-search-wrap">
          <label class="visually-hidden" for="si-search">Search the site index</label>
          <div class="si-search">
            <svg class="si-search-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.5"></circle>
              <path d="M20 20l-3.5-3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
            </svg>
            <input
              id="si-search"
              class="si-search-input"
              type="search"
              name="q"
              placeholder="Search the site…"
              autocomplete="off"
              data-search-input
            />
            <span class="si-search-count" data-search-count hidden></span>
            <kbd class="si-kbd" data-search-slash>/</kbd>
            <button type="button" class="si-search-clear" data-search-clear hidden aria-label="Clear search">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M4 4l8 8M12 4l-8 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
              </svg>
            </button>
          </div>
        </div>

        <div class="si-chips" data-search-chips>
          {chips.map((chip) => (
            <a class="si-chip" href={chip.href}>
              <span>{chip.label}</span>
              <span class="si-chip-dot" aria-hidden="true"></span>
              <span class="si-chip-n">{chip.count}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <div class="si-body">
      <section class="si-results" data-search-results hidden>
        <div class="si-results-head">
          <h2 class="si-results-title" data-search-heading></h2>
          <button type="button" class="si-clear-link" data-search-clear-text>
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
              <path d="M3 3l8 8M11 3l-8 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
            </svg>
            <span data-clear-label>Clear search</span>
          </button>
        </div>
        <div class="si-results-list" data-search-list></div>
        <div class="si-empty" data-search-empty hidden>
          <div class="si-empty-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
              <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.5"></circle>
              <path d="M20 20l-3.5-3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
            </svg>
          </div>
          <p class="si-empty-title" data-empty-title></p>
          <p class="si-empty-copy">Try another word, or browse the index below.</p>
          <button type="button" class="si-empty-btn" data-search-clear-empty>Clear search</button>
        </div>
      </section>

      <div data-directory>
        <section class="si-explore" id="explore" aria-labelledby="si-explore-heading">
          <h2 id="si-explore-heading" class="si-h2">Explore AIGE</h2>
          <div class="si-explore-grid">
            <SitemapExploreColumn column={page.reviews} variant="reviews" />
            <SitemapExploreColumn column={page.roundups} variant="roundups" />
            <SitemapExploreColumn column={page.guides} variant="guides" />
            <SitemapExploreColumn column={page.authors} variant="authors" />
          </div>
        </section>

        <SitemapTestMethodology page={page} />
        <SitemapResourcesLegal page={page} />
      </div>
    </div>
  </div>
</Layout>

<script is:inline define:vars={{ searchHitsJson }}>
  window.__SI_HITS__ = JSON.parse(searchHitsJson);
</script>
<script>
  import type { HtmlSitemapSearchHit } from "@/types/sitemap";
  import { filterSitemapSearchHits } from "@/lib/sitemap-search";

  const hits = (window as unknown as { __SI_HITS__?: HtmlSitemapSearchHit[] }).__SI_HITS__ ?? [];
  const input = document.querySelector<HTMLInputElement>("[data-search-input]");
  const directory = document.querySelector("[data-directory]");
  const results = document.querySelector("[data-search-results]");
  const list = document.querySelector("[data-search-list]");
  const empty = document.querySelector("[data-search-empty]");
  const heading = document.querySelector("[data-search-heading]");
  const chips = document.querySelector("[data-search-chips]");
  const countEl = document.querySelector("[data-search-count]");
  const slash = document.querySelector("[data-search-slash]");
  const clearBtn = document.querySelector("[data-search-clear]");
  const lede = document.querySelector(".si-lede");
  const searchBox = document.querySelector(".si-search");
  const clearLabel = document.querySelector("[data-clear-label]");
  const emptyTitle = document.querySelector("[data-empty-title]");

  function setSearching(on: boolean) {
    searchBox?.classList.toggle("is-searching", on);
    slash?.toggleAttribute("hidden", on);
    clearBtn?.toggleAttribute("hidden", !on);
    countEl?.toggleAttribute("hidden", !on);
    lede?.toggleAttribute("hidden", on);
    chips?.toggleAttribute("hidden", on);
  }

  function render(query: string) {
    const q = query.trim();
    if (!q) {
      setSearching(false);
      results?.setAttribute("hidden", "");
      directory?.removeAttribute("hidden");
      if (list) list.innerHTML = "";
      return;
    }

    setSearching(true);
    const matched = filterSitemapSearchHits(q, hits);
    const n = matched.length;
    directory?.setAttribute("hidden", "");
    results?.removeAttribute("hidden");

    if (countEl) countEl.textContent = n ? `${n} results` : "No results";
    if (heading) heading.textContent = `${n} results for “${q}”`;
    if (clearLabel) clearLabel.textContent = window.matchMedia("(max-width: 767px)").matches ? "Clear" : "Clear search";

    if (!n) {
      list?.setAttribute("hidden", "");
      empty?.removeAttribute("hidden");
      if (emptyTitle) emptyTitle.textContent = `No pages found for “${q}”`;
      return;
    }

    empty?.setAttribute("hidden", "");
    list?.removeAttribute("hidden");
    if (!list) return;
    list.innerHTML = matched
      .map(
        (hit, i) => `
      <a class="si-hit${i === 0 ? " is-active" : ""}" href="${hit.href}">
        <span class="si-hit-kind">${hit.location}</span>
        <span class="si-hit-row">
          <span class="si-hit-title">${hit.title}</span>
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M5 3l6 5-6 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
      </a>`,
      )
      .join("");
  }

  function clearSearch() {
    if (!input) return;
    input.value = "";
    render("");
    input.focus();
  }

  input?.addEventListener("input", () => render(input.value));
  document.querySelectorAll("[data-search-clear], [data-search-clear-text], [data-search-clear-empty]").forEach((el) => {
    el.addEventListener("click", clearSearch);
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "/" && document.activeElement !== input && !(event.target instanceof HTMLInputElement) && !(event.target instanceof HTMLTextAreaElement)) {
      event.preventDefault();
      input?.focus();
    }
    if (event.key === "Escape" && input?.value) {
      clearSearch();
    }
  });

  document.querySelectorAll("[data-category-toggle]").forEach((button) => {
    button.addEventListener("click", () => {
      const cat = button.closest("[data-category]");
      const wasOpen = cat?.getAttribute("data-open") === "true";
      document.querySelectorAll("[data-category]").forEach((node) => {
        node.setAttribute("data-open", "false");
        node.classList.remove("is-open");
        node.querySelector("[data-category-toggle]")?.setAttribute("aria-expanded", "false");
        node.querySelector("[data-panel]")?.setAttribute("hidden", "");
      });
      if (!wasOpen && cat) {
        cat.setAttribute("data-open", "true");
        cat.classList.add("is-open");
        button.setAttribute("aria-expanded", "true");
        cat.querySelector("[data-panel]")?.removeAttribute("hidden");
      }
    });
  });

  document.querySelectorAll("[data-subcategory-toggle]").forEach((button) => {
    button.addEventListener("click", (event) => {
      event.preventDefault();
      event.stopPropagation();
      const expanded = button.getAttribute("aria-expanded") === "true";
      const tests = button.closest("[data-subcategory]")?.querySelector("[data-tests]");
      button.setAttribute("aria-expanded", expanded ? "false" : "true");
      tests?.toggleAttribute("hidden", expanded);
    });
  });
</script>
