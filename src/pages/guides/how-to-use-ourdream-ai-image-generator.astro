---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import OurDreamArticlePage from '../../components/guides/ourdream/OurDreamArticlePage.astro';
import { getAuthor } from '../../data/authors';
import { canonicalPublicUrl } from '../../lib/siteOrigin';
import { cdnAsset } from '../../lib/media/cdn';
import bodyHtml from '../../content/guides/ourdream-ai-image-generator.html?raw';
import '../../styles/roundup.css';
import '../../styles/glossary-tooltips.css';
import '../../styles/ourdream-article.css';
// Geist Mono is the Figma `Article/Code` face. Imported per article route rather than in
// BaseLayout so its @font-face block is not inlined into every page on the site.
import '@fontsource-variable/geist-mono/wght.css';

const h1 = 'How to Use OurDream AI Image Generator';
const title = 'How to Use OurDream AI Image Generator: Beginner Guide';
const description =
  'Learn how to use the OurDream AI image generator, including Dreamy, Vivid, Vivid 2, Free Play, presets, Remix, image editing, and chat image generation.';
const canonical = canonicalPublicUrl('/guides/how-to-use-ourdream-ai-image-generator', Astro.site);
const heroImage = cdnAsset('/guides/ourdream-ai-image-generator/generate-sidebar.webp');
const author = getAuthor('herman-carter');
const published = 'September 11, 2026';

const jsonLd: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: h1,
    description,
    datePublished: '2026-09-11',
    author: author ? { '@type': 'Person', name: author.name } : undefined,
    image: heroImage,
  },
];
---

<BaseLayout theme="core" title={title} description={description} image={heroImage} canonical={canonical}>
  <Header />
  <main>
    <OurDreamArticlePage
      title={h1}
      breadcrumbLabel="OurDream AI Image Generator"
      bodyHtml={bodyHtml}
      author={author}
      published={published}
      publishedIso="2026-09-11"
      canonical={canonical}
      currentHref="/guides/how-to-use-ourdream-ai-image-generator/"
    />
  </main>
  <Footer />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</BaseLayout>
