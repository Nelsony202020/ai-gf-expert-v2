---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import HomeIcon from '../../components/home/desktop/HomeIcon.astro';
import { loadComparisonProducts } from '../../lib/content/comparisonProducts';
import { BRAND_GUIDE_HUBS, buildBrandGuideHubView } from '../../lib/guides/brandGuideHub';
import { ourdreamHubGuides, ourdreamHubMeta } from '../../data/ourdream-guide-hub';
import { resolveBrandLogo } from '../../lib/home/brandLogos';
import { optimizedLogoUrl } from '../../lib/media/optimize';
import { buyingGuideSlug } from '../../data/buying-guide-content';
import '../../styles/listing-rows.css';

const title = 'Guides';
const description = 'How to get more out of the apps we test — organised by brand.';

const products = await loadComparisonProducts();
const bySlug = new Map(products.map((p) => [p.slug, p]));

/** Article guides only — the review link is not a guide. */
const ourdreamArticleCount = ourdreamHubGuides.filter(
  (guide) => !guide.href.startsWith('/reviews/'),
).length;

/*
 * Five brand hubs. OurDream is not in BRAND_GUIDE_HUBS (it has its own data
 * module), so it is composed here rather than special-cased downstream.
 * Counts come from the hub builders — never a hardcoded number.
 */
const brandHubs = [
  {
    name: ourdreamHubMeta.productName,
    href: '/guides/ourdream-ai/',
    logo: resolveBrandLogo('ourdream-ai', bySlug.get('ourdream-ai')?.logo),
    count: ourdreamArticleCount,
  },
  ...BRAND_GUIDE_HUBS.map((config) => {
    const view = buildBrandGuideHubView(bySlug.get(config.productSlug) ?? null, config);
    return {
      name: view.productName,
      href: `/guides/${config.hubSlug}/`,
      logo: view.logo,
      count: view.publishedGuideCount,
    };
  }),
];

/** Every published guide article on the site, newest thinking first. */
const allGuides = [
  {
    slug: buyingGuideSlug,
    title: 'How to Choose an AI Girlfriend App',
    description: 'Work out whether you are chat-first, media-first or balanced, then shortlist on tested results.',
  },
  {
    slug: 'ourdream-ai-prompt',
    title: 'OurDream AI Prompt Guide',
    description: 'Prompts for characters, images, video and roleplay — with examples and the common mistakes.',
  },
  {
    slug: 'ourdream-ai-image-prompt',
    title: 'OurDream AI Image Prompt Guide',
    description: 'Tags, weights, camera terms and negative prompts, tested on Dreamy and Vivid.',
  },
  {
    slug: 'how-to-use-ourdream-ai-image-generator',
    title: 'How to Use OurDream AI Image Generator',
    description: 'Dreamy vs Vivid, Free Play, presets, Remix, inpainting and in-chat images.',
  },
  {
    slug: 'ourdream-ai-comics',
    title: 'OurDream AI Comics: How to Use the Comic Generator',
    description: 'Characters, model sheets, layouts, editing, video — and what a comic actually costs.',
  },
];

/** Entry points, in the order a new reader should take them. */
const startHere = allGuides.slice(0, 3);
---

<BaseLayout title={title} description={description}>
  <Header>
    <>
      <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Guides' }]} />
      <h1 class="guide-hub__title">Guides</h1>
      <p class="guide-hub__lede">{description}</p>
      <div class="guide-hub__search-wrap">
        {/* Filters the lists below in place. There is no /search/ route on this
            site — the hubs filter client-side too, so this matches them. */}
        <form class="guide-hub__guide-search" role="search" data-guides-filter onsubmit="return false">
          <img src="/guides/hub/icon-search.svg" width="20" height="20" alt="" />
          <input
            type="search"
            class="guide-hub__guide-input"
            data-guides-filter-input
            placeholder="Search guides…"
            aria-label="Search guides"
            autocomplete="off"
            spellcheck="false"
          />
        </form>
      </div>
    </>
  </Header>

  <main class="listing section-container px-4 md:px-8 py-12 md:py-16 max-w-4xl">
    <section class="listing__section" aria-labelledby="guides-brands">
      <h2 class="listing__section-title" id="guides-brands">Browse by brand</h2>
      <p class="listing__section-intro">Each app has its own hub — guides, the review, and what it costs.</p>
      <ul class="listing__rows">
        {
          brandHubs.map((hub) => (
            <li>
              <a class="listing__row" href={hub.href}>
                <img
                  class="listing__logo"
                  src={optimizedLogoUrl(hub.logo, 80)}
                  alt=""
                  width="40"
                  height="40"
                  loading="lazy"
                  decoding="async"
                />
                <span class="listing__row-body">
                  <span class="listing__row-title">{hub.name}</span>
                  {hub.count > 0 ? (
                    <span class="listing__row-desc">
                      {hub.count} {hub.count === 1 ? 'guide' : 'guides'}
                    </span>
                  ) : (
                    <span class="listing__row-desc">Review and pricing</span>
                  )}
                </span>
                <span class="listing__row-arrow" aria-hidden="true">
                  <HomeIcon name="arrow-right" size={16} />
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="listing__section" aria-labelledby="guides-start">
      <h2 class="listing__section-title" id="guides-start">Start here</h2>
      <p class="listing__section-intro">If you are new, read these in this order.</p>
      <ul class="listing__rows">
        {
          startHere.map((guide, index) => (
            <li>
              <a class="listing__row" data-guide-row data-guide-text={`${guide.title} ${guide.description}`} href={`/guides/${guide.slug}/`}>
                <span class="listing__num" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                <span class="listing__row-body">
                  <span class="listing__row-title">{guide.title}</span>
                  <span class="listing__row-desc">{guide.description}</span>
                </span>
                <span class="listing__row-arrow" aria-hidden="true">
                  <HomeIcon name="arrow-right" size={16} />
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="listing__section" aria-labelledby="guides-all">
      <h2 class="listing__section-title" id="guides-all">All guides</h2>
      <ul class="listing__rows">
        {
          allGuides.map((guide) => (
            <li>
              <a class="listing__row" data-guide-row data-guide-text={`${guide.title} ${guide.description}`} href={`/guides/${guide.slug}/`}>
                <span class="listing__row-body">
                  <span class="listing__row-title">{guide.title}</span>
                  <span class="listing__row-desc">{guide.description}</span>
                </span>
                <span class="listing__row-arrow" aria-hidden="true">
                  <HomeIcon name="arrow-right" size={16} />
                </span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="listing__no-match" data-guides-no-match hidden>No guides match that.</p>
    </section>
  </main>

  <script>
    function initGuidesFilter() {
      const input = document.querySelector<HTMLInputElement>('[data-guides-filter-input]');
      if (!input || input.dataset.bound === 'true') return;
      input.dataset.bound = 'true';
      const rows = Array.from(document.querySelectorAll<HTMLElement>('[data-guide-row]'));
      const empty = document.querySelector<HTMLElement>('[data-guides-no-match]');
      input.addEventListener('input', () => {
        const q = input.value.trim().toLowerCase();
        let shown = 0;
        rows.forEach((row) => {
          const hit = !q || (row.dataset.guideText ?? '').toLowerCase().includes(q);
          row.hidden = !hit;
          if (hit) shown += 1;
        });
        if (empty) empty.hidden = shown > 0;
      });
    }
    initGuidesFilter();
    document.addEventListener('astro:page-load', initGuidesFilter);
  </script>

  <Footer />
</BaseLayout>
