---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ImageLightbox from '../../components/ui/ImageLightbox.astro';
import OurDreamArticlePage from '../../components/guides/ourdream/OurDreamArticlePage.astro';
import { getAuthor } from '../../data/authors';
import { getGuideVideo, videoObjectSchema } from '../../lib/guides/video';
import { canonicalPublicUrl } from '../../lib/siteOrigin';
import { cdnAsset } from '../../lib/media/cdn';
import bodyHtml from '../../content/guides/ourdream-ai-comics.html?raw';
import faqs from '../../content/guides/ourdream-ai-comics.faq.json';
import '../../styles/roundup.css';
import '../../styles/glossary-tooltips.css';
import '../../styles/ourdream-article.css';
// Geist Mono is the Figma `Article/Code` face. Imported per article route rather than in
// BaseLayout so its @font-face block is not inlined into every page on the site.
import '@fontsource-variable/geist-mono/wght.css';
import { guideBySlug, guideBreadcrumbLabel, guideSeoTitle } from '../../data/guides';

// Title, <title> and breadcrumb all come from the guide registry.
const guide = guideBySlug('ourdream-ai-comics');
const h1 = guide.title;
const title = guideSeoTitle(guide.slug);
const description =
  'Hands-on guide to OurDream AI Comic Studio: workflow, layouts, prompting, model sheets, editing, video, DreamCoin costs, and publishing your first AI comic.';
const canonical = canonicalPublicUrl('/guides/ourdream-ai-comics', Astro.site);
const heroImage = cdnAsset('/guides/ourdream-ai-comics/anime-art-styles.webp');
const author = getAuthor('herman-carter');

/**
 * Read at build time. This route is pre-rendered, so the lookup happens once
 * during the build and never per request. No video on this guide would mean no
 * link, no block, no lightbox and no schema.
 */
const video = getGuideVideo('ourdream-ai-comics');
const videoSchema = video ? videoObjectSchema(video, canonical) : null;
const published = 'August 25, 2026';

const jsonLd: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: h1,
    description,
    datePublished: '2026-08-25',
    author: author ? { '@type': 'Person', name: author.name } : undefined,
    image: heroImage,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.question,
      acceptedAnswer: { '@type': 'Answer', text: f.answer },
    })),
  },
  // Only when the video has everything VideoObject needs. An incomplete entry
  // is worse for the page than no entry, so videoObjectSchema returns null.
  ...(videoSchema ? [videoSchema] : []),
];
---

<BaseLayout theme="core" title={title} description={description} image={heroImage} canonical={canonical}>
  <Header />
  <main>
    <OurDreamArticlePage
      title={h1}
      breadcrumbLabel={guideBreadcrumbLabel(guide.slug)}
      bodyHtml={bodyHtml}
      author={author}
      published={published}
      publishedIso="2026-08-25"
      canonical={canonical}
      currentHref="/guides/ourdream-ai-comics/"
      video={video}
    />
  </main>
  <ImageLightbox />
  <Footer />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</BaseLayout>
