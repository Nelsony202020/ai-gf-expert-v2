---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import AffiliateLink from '../../components/ui/AffiliateLink.astro';
import HomeIcon from '../../components/home/desktop/HomeIcon.astro';
import OurDreamGuideHub from '../../components/guides/hub/OurDreamGuideHub.astro';
import { loadComparisonProducts } from '../../lib/content/comparisonProducts';
import { canonicalPublicUrl } from '../../lib/siteOrigin';
import { ourdreamHubMeta } from '../../data/ourdream-guide-hub';
import '../../styles/home-desktop.css';
import '../../styles/guide-hub.css';

const products = await loadComparisonProducts();
const product = products.find((p) => p.slug === 'ourdream-ai') ?? null;
const visitHref = ourdreamHubMeta.visitGoHref;
const productName = product?.name || ourdreamHubMeta.productName;
const canonical = canonicalPublicUrl('/guides/ourdream-ai', Astro.site);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: ourdreamHubMeta.title,
  description: ourdreamHubMeta.description,
  url: canonical,
};
---

<BaseLayout
  title={ourdreamHubMeta.seoTitle}
  description={ourdreamHubMeta.description}
  canonical={canonical}
  theme="core"
  browserThemeColor={{ light: '#141317', dark: '#141317' }}
>
  <Header />
  <div class="home-v2">
    <OurDreamGuideHub product={product} />
    <Footer />
    <aside class="guide-hub__scroll-cta" data-hub-scroll-cta aria-hidden="true">
      <div class="guide-hub__scroll-cta-inner">
        <AffiliateLink class="guide-hub__scroll-cta-btn" href={visitHref} target="_blank">
          <span class="guide-hub__scroll-cta-text">
            <span>Visit</span>
            <span>{productName}</span>
          </span>
          <HomeIcon name="arrow-up-right" size={18} />
        </AffiliateLink>
      </div>
    </aside>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</BaseLayout>
