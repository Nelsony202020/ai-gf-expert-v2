---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import OurDreamArticlePage from '../../components/guides/ourdream/OurDreamArticlePage.astro';
import { getAuthor } from '../../data/authors';
import { canonicalPublicUrl } from '../../lib/siteOrigin';
import { cdnAsset } from '../../lib/media/cdn';
import bodyHtml from '../../content/guides/ourdream-ai-prompt-guide.html?raw';
import faqs from '../../content/guides/ourdream-ai-prompt-guide.faq.json';
import '../../styles/roundup.css';
import '../../styles/glossary-tooltips.css';
import '../../styles/ourdream-article.css';
// Geist Mono is the Figma `Article/Code` face. Imported per article route rather than in
// BaseLayout so its @font-face block is not inlined into every page on the site.
import '@fontsource-variable/geist-mono/wght.css';
import { guideBySlug, guideBreadcrumbLabel, guideSeoTitle } from '../../data/guides';

// Title, <title> and breadcrumb all come from the guide registry.
const guide = guideBySlug('ourdream-ai-prompt');
const h1 = guide.title;
const title = guideSeoTitle(guide.slug);
const description =
  'Learn how to write better OurDream AI prompts for characters, images, videos, and roleplay, with examples, JSON prompts, common mistakes, and tested tips.';
const canonical = canonicalPublicUrl('/guides/ourdream-ai-prompt', Astro.site);
const heroImage = cdnAsset('/guides/ourdream-ai-prompt-guide/writing-style.webp');
const author = getAuthor('herman-carter');
const published = 'September 10, 2026';

const jsonLd: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: h1,
    description,
    datePublished: '2026-09-10',
    author: author ? { '@type': 'Person', name: author.name } : undefined,
    image: heroImage,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.question,
      acceptedAnswer: { '@type': 'Answer', text: f.answer },
    })),
  },
];
---

<BaseLayout theme="core" title={title} description={description} image={heroImage} canonical={canonical}>
  <Header />
  <main>
    <OurDreamArticlePage
      title={h1}
      breadcrumbLabel={guideBreadcrumbLabel(guide.slug)}
      bodyHtml={bodyHtml}
      author={author}
      published={published}
      publishedShort="Sep 10, 2026"
      publishedIso="2026-09-10"
      canonical={canonical}
      currentHref="/guides/ourdream-ai-prompt/"
    />
  </main>
  <Footer />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</BaseLayout>
