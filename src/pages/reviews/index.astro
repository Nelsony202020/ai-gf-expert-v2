---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import { loadComparisonProducts } from '../../lib/content/comparisonProducts';
import { megaMenuColumns } from '../../data/nav-mega-menu';
import '../../styles/legal-hub.css';

const roundupLinks = megaMenuColumns.find((col) => col.id === 'best-picks')?.links ?? [];
const reviewProducts = [...(await loadComparisonProducts())].sort((a, b) => a.name.localeCompare(b.name));
---

<BaseLayout
  title="Reviews"
  description="Independent, in-depth reviews of AI girlfriend and AI companion apps — scored with our structured testing methodology."
  theme="core"
>
  <Header />
  <main>
    <div class="section-container px-4 md:px-8 py-10 md:py-14 pb-16 md:pb-24 max-w-4xl">
      <Breadcrumbs
        items={[
          { label: 'Home', href: '/' },
          { label: 'Reviews' },
        ]}
      />

      <header class="mt-1 mb-8">
        <h1 class="text-3xl md:text-4xl font-black text-on-surface">Reviews</h1>
        <p class="legal-hub-page__intro">
          Full app reviews with overall scores, category breakdowns, evidence-backed subscores, and editorial verdicts.
        </p>
      </header>

      <section class="mb-10">
        <h2 class="text-lg font-black text-on-surface mb-3">App reviews</h2>
        <div class="category-hub-cards">
          {
            reviewProducts.map((product) => (
              <a class="category-hub-card" href={`/reviews/${product.slug}/`}>
                <span class="category-hub-card__icon" aria-hidden="true">
                  <span class="material-symbols-outlined">star</span>
                </span>
                <span>
                  <h3 class="category-hub-card__title">{product.name} Review</h3>
                  <p class="category-hub-card__desc">{product.tagline}</p>
                </span>
              </a>
            ))
          }
        </div>
      </section>

      {
        roundupLinks.length > 0 && (
          <section>
            <h2 class="text-lg font-black text-on-surface mb-3">Related roundups</h2>
            <div class="category-hub-cards">
              {
                roundupLinks.map((link) => (
                  <a class="category-hub-card" href={link.href}>
                    <span class="category-hub-card__icon" aria-hidden="true">
                      <span class="material-symbols-outlined">emoji_events</span>
                    </span>
                    <span>
                      <h3 class="category-hub-card__title">{link.label}</h3>
                      <p class="category-hub-card__desc">Ranked picks and comparison roundups.</p>
                    </span>
                  </a>
                ))
              }
            </div>
          </section>
        )
      }
    </div>
  </main>
  <Footer />
</BaseLayout>
