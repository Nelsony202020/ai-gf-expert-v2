---
export const prerender = false;

import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import ReviewHero from '../../../components/review/ReviewHero.astro';
import TabBar from '../../../components/review/TabBar.astro';
import type { Tab } from '../../../components/review/TabBar.astro';
import OverviewTab from '../../../components/review/tabs/OverviewTab.astro';
import ReviewArticleTab from '../../../components/review/tabs/ReviewArticleTab.astro';
import MarketDataTab from '../../../components/review/tabs/MarketDataTab.astro';
import AlternativesTab from '../../../components/review/tabs/AlternativesTab.astro';
import RatingsSpecsTab from '../../../components/review/tabs/RatingsSpecsTab.astro';
import PlaceholderTab from '../../../components/review/tabs/PlaceholderTab.astro';
import PhotosVideosTab from '../../../components/review/tabs/PhotosVideosTab.astro';
import PricingTab from '../../../components/review/tabs/PricingTab.astro';
import RatingsTooltipInit from '../../../components/review/tooltips/RatingsTooltipInit.astro';
import GlossaryTooltipInit from '../../../components/review/tooltips/GlossaryTooltipInit.astro';
import ReviewScrollRestore from '../../../components/review/ReviewScrollRestore.astro';
import ImageLightbox from '../../../components/ui/ImageLightbox.astro';
import ArticleUtilityRail from '../../../components/article/ArticleUtilityRail.astro';
import ReviewMobileNavSheet from '../../../components/mobile/ReviewMobileNavSheet.astro';
import { getProductFeaturedIn, loadProductPreviewBySlug } from '../../../lib/content/store';
import { loadDraftRatingsViewModel } from '../../../lib/draft-ratings/loadDraftRatingsData';
import { resolveProductPageHead } from '../../../lib/seo/productPageHead';
import {
  hasAlternativesTab,
  hasPhotosVideosTab,
  hasPricingTab,
} from '../../../lib/content/reviewDevProducts';
import { PREVIEW_COOKIE_NAME, verifyPreviewToken } from '../../../lib/previewSession';

// Previews expose unpublished products, so production requires the editor
// cookie issued by /api/admin/preview-session (set automatically on admin
// sign-in). Without it the URL behaves like any unknown page.
if (import.meta.env.PROD && !verifyPreviewToken(Astro.cookies.get(PREVIEW_COOKIE_NAME)?.value)) {
  return new Response('Not found', {
    status: 404,
    headers: { 'Content-Type': 'text/plain; charset=utf-8' },
  });
}

const { slug } = Astro.params;
const product = slug ? await loadProductPreviewBySlug(slug) : null;

if (!product) {
  return new Response('Review preview not found — check the product slug in admin.', {
    status: 404,
    headers: { 'Content-Type': 'text/plain; charset=utf-8' },
  });
}

const featuredIn = await getProductFeaturedIn(product.slug);
const ratingsModel = await loadDraftRatingsViewModel(product, { preview: true });
const head = resolveProductPageHead(product, { astroSite: Astro.site, preview: true });

const showPhotosVideosTab = hasPhotosVideosTab(product.slug);
const showAlternativesTab = hasAlternativesTab(product.slug);
const showPricingTab = hasPricingTab(product.slug);

const tabs: Tab[] = [
  { id: 'overview', label: 'Overview', tocLabel: 'Overview' },
  { id: 'ratings', label: 'Ratings', tocLabel: 'Ratings & Specs' },
  { id: 'review', label: 'Review', tocLabel: 'Review' },
  { id: 'photos', label: 'Media', tocLabel: 'Photos & Videos' },
  { id: 'pricing', label: 'Pricing', tocLabel: 'Pricing' },
  { id: 'market-data', label: 'Market Data', tocLabel: 'Market Data' },
];
if (showAlternativesTab) {
  tabs.push({ id: 'alternatives', label: 'Alternatives', tocLabel: 'Alternatives' });
}

const shareUrl = head.canonical;
---

<BaseLayout
  title={head.title}
  description={head.metaDescription}
  image={head.ogImage ?? undefined}
  canonical={head.canonical}
  ogTitle={head.ogTitle}
  ogDescription={head.ogDescription}
  robots={head.robots}
  theme="review"
>
  <Header />
  <div
    class="border-b border-amber-200 bg-amber-50 px-4 py-2 text-center text-sm text-amber-900 dark:border-amber-900/50 dark:bg-amber-950/40 dark:text-amber-200"
    role="status"
  >
    Draft preview — this page is only visible to editors. Not indexed. Publish the product for the live URL at
    <a href={`/reviews/${product.slug}/`} class="font-medium underline underline-offset-2">/reviews/{product.slug}/</a>.
  </div>
  <main id="review-top">
    <ReviewHero product={product} shareUrl={shareUrl} pageHead={head} />
    {featuredIn.length > 0 && (
      <div class="mx-auto max-w-6xl px-4 pt-3 text-sm text-white/60 hidden md:block">
        Also featured in:{' '}
        {featuredIn.map((f, i) => (
          <>
            <a href={`/best/${f.slug}`} class="text-white/80 underline decoration-dotted underline-offset-2 hover:text-white">
              {f.title}{f.position ? ` (#${f.position})` : ''}
            </a>
            {i < featuredIn.length - 1 && ', '}
          </>
        ))}
      </div>
    )}
    <TabBar tabs={tabs} active="overview" />

    <div data-panels>
      <div data-tab-panel="overview">
        <OverviewTab product={product} />
      </div>
      <div data-tab-panel="ratings" class="hidden">
        <RatingsSpecsTab
          product={product}
          preview
          ratingsModel={ratingsModel}
        />
      </div>
      <div data-tab-panel="review" class="hidden">
        <ReviewArticleTab product={product} />
      </div>
      <div data-tab-panel="photos" class="hidden">
        {
          showPhotosVideosTab ? (
            <PhotosVideosTab product={product} />
          ) : (
            <PlaceholderTab
              title="Photos & Videos"
              icon="photo_library"
              description="Screenshots and clips from our hands-on testing will be published here soon."
            />
          )
        }
      </div>
      <div data-tab-panel="pricing" class="hidden">
        {
          showPricingTab ? (
            <PricingTab product={product} />
          ) : (
            <PlaceholderTab
              title="Pricing & Plans"
              icon="sell"
              description="A detailed breakdown of every plan, what each tier unlocks, and how the value compares to competitors is coming soon."
            />
          )
        }
      </div>
      <div data-tab-panel="market-data" class="hidden">
        <MarketDataTab product={product} />
      </div>
      {
        showAlternativesTab && (
          <div data-tab-panel="alternatives" class="hidden">
            <AlternativesTab product={product} />
          </div>
        )
      }
    </div>
  </main>
  <Footer />
  <ArticleUtilityRail pageTitle={head.title} pageUrl={shareUrl} />
  <ReviewMobileNavSheet tabs={tabs} pageTitle={head.title} pageUrl={shareUrl} />
  <RatingsTooltipInit />
  <GlossaryTooltipInit />
  <ReviewScrollRestore productSlug={product.slug} />
  <ImageLightbox />
</BaseLayout>

<script>
  import {
    applyReviewRatingsHashFromLocation,
    navigateToRatingsSection,
  } from '../../../lib/review/ratingsSectionNav.client.ts';
  import { hydratePanelMedia } from '../../../lib/review/hydratePanelMedia.client.ts';
  import { subscoreSlugFromLabel } from '../../../lib/review/ratingsDeepLink.ts';

  const TABBAR_OFFSET = 52;

  function getScrollOffset() {
    const header = document.querySelector<HTMLElement>('[data-site-header]');
    const tabbar = document.querySelector<HTMLElement>('[data-tabbar]');
    const headerH = header?.offsetHeight ?? TABBAR_OFFSET;
    const tabbarH = tabbar?.offsetHeight ?? 0;
    return headerH + tabbarH;
  }

  function initReview() {
    const panelsWrap = document.querySelector<HTMLElement>('[data-panels]');
    if (!panelsWrap || panelsWrap.dataset.reviewInit === 'true') return;
    panelsWrap.dataset.reviewInit = 'true';

    const tabButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-tabbar] [data-tab]'));
    const tabTriggers = Array.from(document.querySelectorAll<HTMLElement>('[data-tab]'));
    const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-tab-panel]'));

    function setActiveTab(id: string, scroll = true, hashOverride?: string) {
      let matched = false;
      let activePanel: HTMLElement | null = null;
      panels.forEach((panel) => {
        const isMatch = panel.dataset.tabPanel === id;
        panel.classList.toggle('hidden', !isMatch);
        if (isMatch) {
          matched = true;
          activePanel = panel;
        }
      });
      if (!matched) return;
      tabButtons.forEach((btn) => btn.setAttribute('aria-current', btn.dataset.tab === id ? 'true' : 'false'));
      if (history.replaceState) history.replaceState(null, '', hashOverride ?? `#${id}`);
      if (activePanel) {
        requestAnimationFrame(() => hydratePanelMedia(activePanel));
      }
      if (scroll) {
        const y = panelsWrap.getBoundingClientRect().top + window.scrollY - getScrollOffset();
        window.scrollTo({ top: y > 0 ? y : 0, behavior: 'smooth' });
      }
    }

    function toggleAccordion(toggle: HTMLElement, force?: boolean) {
      const wrapper = toggle.closest('[data-category]');
      const content = wrapper?.querySelector<HTMLElement>('[data-accordion-content]');
      if (!content) return;

      const willOpen = force ?? content.classList.contains('hidden');

      if (willOpen) {
        document.querySelectorAll<HTMLElement>('[data-accordion-group] [data-category]').forEach((cat) => {
          if (cat === wrapper) return;
          const otherContent = cat.querySelector<HTMLElement>('[data-accordion-content]');
          const otherToggle = cat.querySelector<HTMLElement>('[data-accordion-toggle]');
          if (otherContent) otherContent.classList.add('hidden');
          if (otherToggle) otherToggle.setAttribute('aria-expanded', 'false');
        });
      }

      content.classList.toggle('hidden', !willOpen);
      wrapper?.querySelectorAll<HTMLElement>('[data-accordion-toggle]').forEach((el) => {
        el.setAttribute('aria-expanded', willOpen ? 'true' : 'false');
      });
    }

    const navDeps = {
      getScrollOffset,
      toggleAccordion,
      setActiveTab,
      isTabHash: (hash: string) => panels.some((p) => p.dataset.tabPanel === hash),
    };

    tabTriggers.forEach((trigger) => {
      trigger.addEventListener('click', () => {
        const id = trigger.dataset.tab;
        if (id) setActiveTab(id);
      });
    });

    document.querySelectorAll<HTMLElement>('[data-accordion-toggle]').forEach((toggle) => {
      toggle.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('.rt-tooltip-trigger')) return;
        toggleAccordion(toggle);
      });
      toggle.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          toggleAccordion(toggle);
        }
      });
    });

    document.addEventListener('click', (e) => {
      const viewBtn = (e.target as HTMLElement).closest<HTMLElement>('[data-view-results]');
      if (viewBtn) {
        e.preventDefault();
        e.stopPropagation();
        window.dispatchEvent(new CustomEvent('ratings-tooltip:hide'));
        const categoryKey = viewBtn.dataset.category;
        const subscoreName = viewBtn.dataset.subscore;
        const contributor = viewBtn.dataset.contributor;
        if (!categoryKey) return;

        navigateToRatingsSection(
          {
            categoryKey,
            subscoreSlug: subscoreName ? subscoreSlugFromLabel(subscoreName) : undefined,
            scroll: true,
          },
          navDeps,
        );

        if (contributor) {
          const categoryEl = document.querySelector<HTMLElement>(`[data-category="${categoryKey}"]`);
          const cards = Array.from(categoryEl?.querySelectorAll<HTMLElement>('[data-subscore-select]') ?? []);
          const match = subscoreName
            ? cards.find((c) => {
                const label = c.querySelector('[data-subscore-label]')?.textContent?.trim();
                return label?.toLowerCase() === subscoreName.toLowerCase();
              })
            : cards[0];
          const index = match?.dataset.subscoreIndex ?? '0';
          const panel = categoryEl?.querySelector<HTMLElement>(`[data-subscore-panel][data-subscore-index="${index}"]`);
          const rows = Array.from(panel?.querySelectorAll<HTMLElement>('.evidence-cat-table__row') ?? []);
          const highlightEl =
            rows.find((r) => {
              const name = r.querySelector('.evidence-cat-table__name')?.textContent?.trim();
              return name?.toLowerCase() === contributor.toLowerCase();
            }) ??
            rows.find((r) => r.textContent?.toLowerCase().includes(contributor.toLowerCase())) ??
            panel;

          const drawerId = viewBtn.dataset.ratingsOpenDrawer ?? highlightEl?.dataset.ratingsOpenDrawer;
          if (drawerId) {
            requestAnimationFrame(() => {
              (window as Window & { ratingsOpenDrawer?: (id: string, trigger?: HTMLElement) => void }).ratingsOpenDrawer?.(
                drawerId,
                viewBtn,
              );
            });
          }
        }
        return;
      }

      const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-goto-category]');
      if (!btn) return;
      if ((e.target as HTMLElement).closest('.rt-tooltip-trigger')) return;
      e.preventDefault();
      const key = btn.dataset.gotoCategory;
      if (!key) return;
      navigateToRatingsSection({ categoryKey: key, scroll: true }, navDeps);
    });

    applyReviewRatingsHashFromLocation(navDeps);
    window.addEventListener('hashchange', () => applyReviewRatingsHashFromLocation(navDeps));
  }

  initReview();
  document.addEventListener('astro:page-load', initReview);
</script>
