---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/ui/Breadcrumbs.astro';
import AppDirectory from '../components/directory/AppDirectory.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import { loadExplorerApps } from '../data/homepage';
import { buildDirectoryItemListSchema } from '../lib/seo/jsonld';

const apps = await loadExplorerApps();
const directoryPath = '/ai-girlfriend-apps';
const pageTitle = 'Explore AI Girlfriend Apps — Directory';
const pageDescription =
  'Browse and filter AI companion apps tested by our editorial team. Compare scores, pricing, features, and read full reviews.';
// Same apps array as the visible directory — default DB order (displayOrder, then name).
const jsonLdGraph = buildDirectoryItemListSchema(apps, {
  pathname: '/ai-girlfriend-apps/',
  name: pageTitle,
  description: pageDescription,
});
---

<BaseLayout title={pageTitle} description={pageDescription} theme="directory">
  {jsonLdGraph.length > 0 && <JsonLd slot="head" graph={jsonLdGraph} />}
  <Header>
    <div class="site-ink-hero__body--center">
      <Breadcrumbs
        items={[
          { label: 'Home', href: '/' },
          { label: 'AI Girlfriend Apps' },
        ]}
      />
      <h1 class="site-ink-hero__title">{pageTitle}</h1>
      <p class="site-ink-hero__lede">{pageDescription}</p>
    </div>
  </Header>
  <main>
    <AppDirectory
      apps={apps}
      basePath={directoryPath}
      hidePageHead
      title="Explore AI girlfriend apps"
      subtitle="Browse every app we have tested. Sort results or customize ranking to match what matters most to you."
    />
  </main>
  <Footer />
</BaseLayout>
