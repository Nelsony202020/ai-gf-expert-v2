---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import LegalSidebar from '../../components/legal/LegalSidebar.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import { legalPages } from '../../data/legal-pages';
import '../../styles/roundup.css';
import '../../styles/legal-hub.css';
---

<BaseLayout
  title="Legal"
  description="Privacy policy, terms of service, accessibility, affiliate disclosure, copyright, and other legal information for AI Girlfriend Expert."
  theme="core"
>
  <Header />
  <main class="legal-hub-page" id="legal-hub-top">
    <div class="section-container px-4 md:px-8 py-10 md:py-14 pb-16 md:pb-24">
      <div class="roundup-layout">
        <LegalSidebar />

        <div class="roundup-main max-w-3xl">
          <Breadcrumbs
            items={[
              { label: 'Home', href: '/' },
              { label: 'Legal' },
            ]}
          />

          <header class="mt-1">
            <h1 class="text-3xl md:text-4xl font-black text-on-surface">Legal</h1>
            <p class="legal-hub-page__intro">
              Policies, disclosures, and terms that govern how we operate AI Girlfriend Expert and how you can use the site.
            </p>
          </header>

          <div class="legal-hub-cards">
            {
              legalPages.map((page) => (
                <a class="legal-hub-card" href={page.href}>
                  <h2 class="legal-hub-card__title">{page.title}</h2>
                  <p class="legal-hub-card__desc">{page.description}</p>
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
