---
import type { HtmlSitemapExploreColumn } from "../../types/sitemap";

interface Props {
  column: HtmlSitemapExploreColumn;
  variant: "reviews" | "roundups" | "guides" | "authors";
}

const { column, variant } = Astro.props;
---

<section
  class="si-col"
  data-explore-col={variant}
  id={
    variant === "guides"
      ? "guides"
      : variant === "roundups"
        ? "rankings"
        : undefined
  }
>
  <div class="si-col-head">
    <span class="si-col-icon" aria-hidden="true">
      {variant === "reviews" ? (
        <svg viewBox="0 0 14 14" fill="none">
          <path
            d="M1.09 3.86A2.92 2.92 0 0 1 3.87 1.08a4.67 4.67 0 0 1 3.93 0 2.92 2.92 0 0 1 2.79 2.78 4.67 4.67 0 0 1 0 3.93 2.92 2.92 0 0 1-2.79 2.79 4.67 4.67 0 0 1-3.93 0 2.92 2.92 0 0 1-2.78-2.79 4.67 4.67 0 0 1 0-3.93Z"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
          <path
            d="M8.17 4.08 4.96 7.29 3.51 5.83"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      ) : variant === "roundups" ? (
        <svg viewBox="0 0 14 14" fill="none">
          <path
            d="M2.33 4.08a3.5 3.5 0 0 0 7 0V.58A.58.58 0 0 0 8.75 0H2.92a.58.58 0 0 0-.59.58v3.5ZM2.38 4.67H1.46A1.46 1.46 0 0 1 0 3.21V1.75a.58.58 0 0 1 .58-.58h1.75"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      ) : variant === "guides" ? (
        <svg viewBox="0 0 14 14" fill="none">
          <path
            d="M10.5 9.33a1.17 1.17 0 0 0 1.17-1.16V1.17A1.17 1.17 0 0 0 10.5 0L8.17.001a3.5 3.5 0 0 0-2.34 1.17A3.5 3.5 0 0 0 3.5 0H1.17A1.17 1.17 0 0 0 0 1.17v7a1.17 1.17 0 0 0 1.17 1.16H3.5a3.5 3.5 0 0 1 2.33 1.17 3.5 3.5 0 0 1 2.34-1.17h2.33Z"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      ) : (
        <svg viewBox="0 0 14 14" fill="none">
          <path
            d="M6.42 3.32a2.33 2.33 0 1 1-4.67 0 2.33 2.33 0 0 1 4.67 0Z"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      )}
    </span>
    <span class="si-col-title">{column.heading}</span>
    <span class="si-col-count">{column.count}</span>
  </div>
  <div class="si-col-rule"></div>
  <ul class="si-col-list">
    {column.links.map((item) => (
      <li>
        <a class="si-row" href={item.href}>
          <span>{item.label}</span>
          <svg class="si-chev" viewBox="0 0 5 8.5" fill="none" aria-hidden="true">
            <path d="M0 7L3.5 3.5 0 0" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      </li>
    ))}
  </ul>
</section>
