---
import HomeIcon from "../home/desktop/HomeIcon.astro";

interface Props {
  compact?: boolean;
  query?: string;
  searching?: boolean;
  resultLabel?: string;
}

const { compact = false, query = "", searching = false, resultLabel = "" } = Astro.props;
const inputId = compact ? "si-search-sticky" : "si-search";
---

<form
  class:list={["si-search", compact && "si-search--sticky", { "is-searching": searching }]}
  role="search"
  data-search-form
  data-search-surface={compact ? "sticky" : "hero"}
  onsubmit="return false"
>
  <span class="si-search-icon" aria-hidden="true">
    <HomeIcon name="search" size={compact ? 18 : 22} />
  </span>
  <label class="si-sr" for={inputId}>Search the site</label>
  <input
    id={inputId}
    class="si-search-input"
    type="search"
    name="q"
    placeholder="Search the site…"
    autocomplete="off"
    spellcheck="false"
    value={query}
    data-search-input
  />
  <span class="si-search-count" data-search-count hidden={!searching}>
    {searching ? resultLabel : ""}
  </span>
  {!compact && <kbd class="si-kbd" data-search-slash>/</kbd>}
  <button class="si-search-clear" type="button" aria-label="Clear search" data-search-clear hidden={!searching}>
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
      <path d="M18 6 6 18"></path>
      <path d="m6 6 12 12"></path>
    </svg>
  </button>
</form>
