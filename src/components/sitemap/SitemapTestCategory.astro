---
import type { HtmlSitemapTestCategory } from "../../types/sitemap";
import { testCategoryIconName } from "../../lib/test-category-icons";
import HomeIcon from "../home/desktop/HomeIcon.astro";

interface Props {
  category: HtmlSitemapTestCategory;
}

const { category } = Astro.props;
---

<article class="si-cat" data-category={category.slug}>
  <button
    class="si-cat-head"
    type="button"
    data-category-toggle={category.slug}
    aria-expanded="false"
    aria-controls={`si-cat-panel-${category.slug}`}
  >
    <span class="si-cat-icon" aria-hidden="true">
      <HomeIcon name={testCategoryIconName(category.slug)} size={16} />
    </span>
    <span class="si-cat-name">{category.label}</span>
    <span class="si-cat-count">{category.testCount} tests</span>
    <span class="si-cat-chev" aria-hidden="true">
      <HomeIcon name="chevron-down" size={16} />
    </span>
  </button>
  <div class="si-cat-panel" id={`si-cat-panel-${category.slug}`} data-panel hidden>
    {category.subcategories.map((sub) => (
      <div class="si-sub" data-subcategory={`${category.slug}-${sub.slug}`}>
        <div class="si-sub-row">
          <a class="si-sub-link" href={sub.href}>
            <span>{sub.label}</span>
          </a>
          <span class="si-sub-meta">{sub.testCount} tests</span>
          <button
            class="si-sub-toggle"
            type="button"
            data-subcategory-toggle={`${category.slug}-${sub.slug}`}
            aria-expanded="false"
            aria-controls={`si-tests-${category.slug}-${sub.slug}`}
            aria-label={`Show scored tests in ${sub.label}`}
          >
            <span class="si-sub-chev" aria-hidden="true">
              <HomeIcon name="chevron-right" size={14} />
            </span>
          </button>
        </div>
        <ul class="si-tests" id={`si-tests-${category.slug}-${sub.slug}`} data-tests hidden>
          {sub.tests.map((test) => (
            <li>
              <a class="si-test-link" href={test.href}>
                <span class="si-test-dot" aria-hidden="true"></span>
                {test.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</article>
