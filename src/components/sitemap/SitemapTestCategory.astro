---
import type { HtmlSitemapTestCategory } from "../../types/sitemap";
import { testCategoryIconHtml } from "../../lib/test-category-icons";

interface Props {
  category: HtmlSitemapTestCategory;
}

const { category } = Astro.props;
---

<article class="si-cat" data-category={category.slug}>
  <button
    class="si-cat-head"
    type="button"
    data-category-toggle={category.slug}
    aria-expanded="false"
    aria-controls={`si-cat-panel-${category.slug}`}
  >
    <span class="si-cat-icon" aria-hidden="true" set:html={testCategoryIconHtml(category.slug)} />
    <span class="si-cat-name">{category.label}</span>
    <span class="si-cat-count">{category.testCount} tests</span>
    <svg class="si-cat-chev" viewBox="0 0 9.5 5.5" fill="none" aria-hidden="true">
      <path d="M0 0L4 4 8 0" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </button>
    <div class="si-cat-panel" id={`si-cat-panel-${category.slug}`} data-panel hidden>
    {category.subcategories.map((sub) => (
      <div class="si-sub" data-subcategory={`${category.slug}-${sub.slug}`}>
        <div class="si-sub-row">
          <a class="si-sub-link" href={sub.href}>
            <span>{sub.label}</span>
            <svg class="si-sub-arrow" viewBox="0 0 10 10" fill="none" aria-hidden="true">
              <path d="M4.08 0L8.17 4.08 4.08 8.17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
          <span class="si-sub-meta">
            <span>{sub.testCount} tests</span>
            <button
              class="si-sub-toggle"
              type="button"
              data-subcategory-toggle={`${category.slug}-${sub.slug}`}
              aria-expanded="false"
              aria-controls={`si-tests-${category.slug}-${sub.slug}`}
              aria-label={`Show scored tests in ${sub.label}`}
            >
              <svg viewBox="0 0 8.5 5" fill="none" aria-hidden="true">
                <path d="M0 0L3.5 3.5 7 0" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </button>
          </span>
        </div>
        <ul class="si-tests" id={`si-tests-${category.slug}-${sub.slug}`} hidden>
          {sub.tests.map((test) => (
            <li>
              <a class="si-test-link" href={test.href}>
                <span class="si-test-dot" aria-hidden="true"></span>
                {test.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</article>
