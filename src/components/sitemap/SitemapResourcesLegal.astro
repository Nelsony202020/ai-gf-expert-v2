---
import type { HtmlSitemapFullPage } from "../../types/sitemap";
import HomeIcon from "../home/desktop/HomeIcon.astro";

interface Props {
  page: HtmlSitemapFullPage;
}

const { page } = Astro.props;
---

<div class="si-resources-wrap" id="si-resources">
<section class="si-resources">
  <h2 class="si-h2">Resources &amp; Company</h2>
  <div class="si-explore-grid">
    <section class="si-col">
      <div class="si-col-head">
        <span class="si-col-icon" aria-hidden="true">
          <HomeIcon name="info" size={14} />
        </span>
        <span class="si-col-title">{page.resources.heading}</span>
        <span class="si-col-count">{page.resources.count}</span>
      </div>
      <div class="si-col-rule"></div>
      <ul class="si-col-list">
        {page.resources.links.map((item) => (
          <li>
            <a class="si-row" href={item.href}>
              <span>{item.label}</span>
              <span class="si-chev" aria-hidden="true">
                <HomeIcon name="chevron-right" size={14} />
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="si-col">
      <div class="si-col-head">
        <span class="si-col-icon" aria-hidden="true">
          <HomeIcon name="users" size={14} />
        </span>
        <span class="si-col-title">{page.company.heading}</span>
        <span class="si-col-count">{page.company.count}</span>
      </div>
      <div class="si-col-rule"></div>
      <ul class="si-col-list">
        {page.company.links.map((item) => (
          <li>
            <a class="si-row" href={item.href}>
              <span>{item.label}</span>
              <span class="si-chev" aria-hidden="true">
                <HomeIcon name="chevron-right" size={14} />
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="si-col">
      <div class="si-col-head">
        <span class="si-col-icon" aria-hidden="true">
          <HomeIcon name="shield" size={14} />
        </span>
        <span class="si-col-title">Legal</span>
        <span class="si-col-count">{page.legal.length}</span>
      </div>
      <div class="si-col-rule"></div>
      <ul class="si-col-list">
        {page.legal.map((item) => (
          <li>
            <a class="si-row" href={item.href}>
              <span>{item.label}</span>
              <span class="si-chev" aria-hidden="true">
                <HomeIcon name="chevron-right" size={14} />
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
    <div class="si-col si-col-spacer" aria-hidden="true"></div>
  </div>
</section>
</div>
