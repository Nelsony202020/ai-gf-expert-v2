---
import type { HtmlSitemapLink } from '../../types/sitemap';

interface Props {
  count: number;
  resources: HtmlSitemapLink[];
  legal: HtmlSitemapLink[];
}

const { count, resources, legal } = Astro.props;
---

<section class="sitemap-secondary" aria-labelledby="sitemap-secondary-title">
  <div class="sitemap-secondary__head">
    <h2 id="sitemap-secondary-title" class="sitemap-secondary__title">Resources &amp; legal</h2>
    <p class="sitemap-secondary__count">{count} pages</p>
  </div>

  <div class="sitemap-secondary__grid">
    <div class="sitemap-secondary__group">
      <p class="sitemap-secondary__label">Resources</p>
      <ul class="sitemap-secondary__links">
        {
          resources.map((link) => (
            <li>
              <a href={link.href} class="sitemap-secondary__link">{link.label}</a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="sitemap-secondary__group">
      <p class="sitemap-secondary__label">Legal &amp; info</p>
      <ul class="sitemap-secondary__links">
        {
          legal.map((link) => (
            <li>
              <a href={link.href} class="sitemap-secondary__link">{link.label}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
