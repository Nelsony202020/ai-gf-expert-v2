---
import type { HtmlSitemapFullPage } from "../../types/sitemap";

interface Props {
  page: HtmlSitemapFullPage;
}

const { page } = Astro.props;
---

<div class="si-resources-wrap" id="si-resources">
<section class="si-resources">
  <h2 class="si-h2">Resources &amp; Company</h2>
  <div class="si-explore-grid">
    <section class="si-col">
      <div class="si-col-head">
        <span class="si-col-icon" aria-hidden="true">
          <svg viewBox="0 0 14 14" fill="none">
            <path
              d="M.58 0h3.5a.58.58 0 0 1 .59.58v9.33a.58.58 0 0 1-.59.59H.58A.58.58 0 0 1 0 9.91V.58A.58.58 0 0 1 .58 0ZM10.15 9.28a.58.58 0 0 1-.35.75l-1.11.41a.58.58 0 0 1-.76-.35L4.73 1.23a.58.58 0 0 1 .35-.76L6.18.06a.58.58 0 0 1 .76.35l3.21 8.87Z"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </span>
        <span class="si-col-title">{page.resources.heading}</span>
        <span class="si-col-count">{page.resources.count}</span>
      </div>
      <div class="si-col-rule"></div>
      <ul class="si-col-list">
        {page.resources.links.map((item) => (
          <li>
            <a class="si-row" href={item.href}>
              <span>{item.label}</span>
              <svg class="si-chev" viewBox="0 0 5 8.5" fill="none" aria-hidden="true">
                <path d="M0 7L3.5 3.5 0 0" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="si-col">
      <div class="si-col-head">
        <span class="si-col-icon" aria-hidden="true">
          <svg viewBox="0 0 14 14" fill="none">
            <path
              d="M9.33 6.42c0 2.91-2.04 4.37-4.47 5.22a.58.58 0 0 1-.39 0C2.04 10.79 0 9.33 0 6.42V2.33A.58.58 0 0 1 .58 1.75c1.17 0 2.63-.7 3.64-1.59A.58.58 0 0 1 4.67 0c.16 0 .32.06.44.16 1.02.89 2.47 1.59 3.64 1.59a.58.58 0 0 1 .58.58v4.09Z"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </span>
        <span class="si-col-title">{page.company.heading}</span>
        <span class="si-col-count">{page.company.count}</span>
      </div>
      <div class="si-col-rule"></div>
      <ul class="si-col-list">
        {page.company.links.map((item) => (
          <li>
            <a class="si-row" href={item.href}>
              <span>{item.label}</span>
              <svg class="si-chev" viewBox="0 0 5 8.5" fill="none" aria-hidden="true">
                <path d="M0 7L3.5 3.5 0 0" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="si-col">
      <div class="si-col-head">
        <span class="si-col-icon" aria-hidden="true">
          <svg viewBox="0 0 14 14" fill="none">
            <path
              d="M1.17 5.25h8.16A1.17 1.17 0 0 1 10.5 6.42v4.08A1.17 1.17 0 0 1 9.33 11.67H1.17A1.17 1.17 0 0 1 0 10.5V6.42A1.17 1.17 0 0 1 1.17 5.25ZM2.33 5.25V2.92A2.92 2.92 0 0 1 8.17 2.92v2.33"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </span>
        <span class="si-col-title">Legal</span>
        <span class="si-col-count">{page.legal.length}</span>
      </div>
      <div class="si-col-rule"></div>
      <ul class="si-col-list">
        {page.legal.map((item) => (
          <li>
            <a class="si-row" href={item.href}>
              <span>{item.label}</span>
              <svg class="si-chev" viewBox="0 0 5 8.5" fill="none" aria-hidden="true">
                <path d="M0 7L3.5 3.5 0 0" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </li>
        ))}
      </ul>
    </section>
    <div class="si-col si-col-spacer" aria-hidden="true"></div>
  </div>
</section>
</div>
