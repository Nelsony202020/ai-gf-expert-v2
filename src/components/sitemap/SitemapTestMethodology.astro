---
import SitemapTestCategory from "./SitemapTestCategory.astro";
import type { HtmlSitemapFullPage } from "../../types/sitemap";
import HomeIcon from "../home/desktop/HomeIcon.astro";

interface Props {
  page: HtmlSitemapFullPage;
}

const { page } = Astro.props;
---

<section class="si-testing" id="si-testing">
  <div class="si-testing-intro">
    <h2 class="si-h2">Testing &amp; Methodology</h2>
    <p class="si-testing-copy">Explore how every AIGE score is calculated.</p>
  </div>
  <div class="si-stats">
    <div class="si-stat">
      <span class="si-stat-n">{page.testingPagesCount}</span>
      <span class="si-stat-l">pages</span>
    </div>
    <div class="si-stat-rule" aria-hidden="true"></div>
    <div class="si-stat">
      <span class="si-stat-n">{page.testingCategoriesCount}</span>
      <span class="si-stat-l">categories</span>
    </div>
    <div class="si-stat-rule" aria-hidden="true"></div>
    <div class="si-stat">
      <span class="si-stat-n">{page.testingSubcategoriesCount}</span>
      <span class="si-stat-l">subcategories</span>
    </div>
    <div class="si-stat-rule" aria-hidden="true"></div>
    <div class="si-stat">
      <span class="si-stat-n">{page.scoredTestsCount}</span>
      <span class="si-stat-l">scored tests</span>
    </div>
  </div>

  <p class="si-kicker">Main methodology</p>
  <div class="si-main">
    {page.methodology.map((item, index) => (
      <a class="si-main-row" href={item.href}>
        <span class="si-main-num">{String(index + 1).padStart(2, "0")}</span>
        <span class="si-main-copy">
          <span class="si-main-title">{item.label}</span>
          {item.description ? <span class="si-main-desc">{item.description}</span> : null}
        </span>
        <span class="si-main-arrow" aria-hidden="true">
          <HomeIcon name="chevron-right" size={16} />
        </span>
      </a>
    ))}
  </div>

  <p class="si-kicker si-kicker-desk">All scored tests</p>
  <p class="si-kicker si-kicker-mob">All scored tests, by category</p>
  <div class="si-cats">
    {page.testCategories.map((category) => (
      <SitemapTestCategory category={category} />
    ))}
  </div>

  <p class="si-kicker">Supporting methodology</p>
  <div class="si-support">
    <div class="si-support-col">
      {page.supporting.slice(0, 2).map((item) => (
        <a class="si-row si-row-ruled" href={item.href}>
          <span>{item.label}</span>
          <span class="si-chev" aria-hidden="true">
            <HomeIcon name="chevron-right" size={14} />
          </span>
        </a>
      ))}
    </div>
    <div class="si-support-col">
      {page.supporting.slice(2).map((item) => (
        <a class="si-row si-row-ruled" href={item.href}>
          <span>{item.label}</span>
          <span class="si-chev" aria-hidden="true">
            <HomeIcon name="chevron-right" size={14} />
          </span>
        </a>
      ))}
    </div>
  </div>
</section>
