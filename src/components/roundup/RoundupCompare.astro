---
import type { RoundupPick } from '../../data/roundups/ai-girlfriend';
import { ROUNDUP_CATEGORY_KEYS, toRatingCategory } from '../../data/roundups/ai-girlfriend';
import { loadComparisonProducts } from '../../lib/content/comparisonProducts';
import { fmtScore } from '../../lib/scores';
import {
  COMPARE_FEATURE_IDS,
  COMPARE_PRICING_IDS,
  atGlanceLabel,
  atGlanceValue,
  comparePerfCellInnerHtml,
  compareFeatureCellInnerHtml,
  winnerPickIds,
} from '../../lib/roundup/compareTable';
import CategoryScoreTooltip from '../review/tooltips/CategoryScoreTooltip.astro';
import SubscoreScoreTooltip from '../review/tooltips/SubscoreScoreTooltip.astro';
import InfoIcon from '../ui/InfoIcon.astro';
import ComparePricingTooltip from './ComparePricingTooltip.astro';
import RoundupComparePicker from './RoundupComparePicker.astro';

interface Props {
  picks: RoundupPick[];
  defaultIds: [string, string, string];
}

const { picks, defaultIds } = Astro.props;

const comparisonProducts = await loadComparisonProducts();
const hasPublishedReview = (slug: string) => comparisonProducts.some((product) => product.slug === slug);

const categoryKeys = ROUNDUP_CATEGORY_KEYS;
const tooltipProductSlug = picks.find((p) => hasPublishedReview(p.slug))?.slug;
const referencePick = picks.find((p) => p.atGlance) ?? picks[0];

const featureRowLabels = COMPARE_FEATURE_IDS.map((id) => ({
  id,
  label: atGlanceLabel(referencePick.atGlance, 'features', id),
}));
const pricingRowLabels = COMPARE_PRICING_IDS.map((id) => ({
  id,
  label: atGlanceLabel(referencePick.atGlance, 'pricing', id),
}));

function pricingTooltip(pick: RoundupPick, id: string) {
  return pick.atGlance?.pricing?.find((row) => row.id === id)?.tooltip;
}

function featureStat(pick: RoundupPick, id: string) {
  return pick.atGlance?.features?.find((row) => row.id === id);
}

const comparePayload = picks.map((p) => ({
  id: p.id,
  slug: p.slug,
  name: p.name,
  logo: p.logo,
  image: p.gallery[0]?.full ?? p.logo,
  imageAlt: p.gallery[0]?.alt ?? `${p.name} screenshot`,
  overallScore: p.overallScore,
  affiliateUrl: p.affiliateUrl,
  reviewUrl: p.reviewUrl ?? '',
  atGlanceFeatures: Object.fromEntries(
    COMPARE_FEATURE_IDS.map((id) => {
      const row = featureStat(p, id);
      return [id, { value: atGlanceValue(p.atGlance, 'features', id), values: row?.values ?? null }];
    }),
  ),
  atGlancePricing: Object.fromEntries(
    COMPARE_PRICING_IDS.map((id) => [id, atGlanceValue(p.atGlance, 'pricing', id)]),
  ),
  atGlancePricingHasTooltip: Object.fromEntries(
    COMPARE_PRICING_IDS.map((id) => [id, Boolean(p.atGlance?.pricing?.find((row) => row.id === id)?.tooltip)]),
  ),
  categories: Object.fromEntries(
    p.categoryScores.map((c) => [
      c.key,
      {
        name: c.name,
        score: c.score,
        subscores: Object.fromEntries((c.subscores ?? []).map((s) => [s.name, s.score])),
      },
    ]),
  ),
}));

function scoreBand(score: number): 'good' | 'fair' | 'poor' {
  if (score >= 7) return 'good';
  if (score >= 5.5) return 'fair';
  return 'poor';
}

function categoryWinners(key: string, ids: string[]) {
  const scores = ids.map((id) => {
    const pick = picks.find((p) => p.id === id)!;
    const cat = pick.categoryScores.find((c) => c.key === key);
    return { id, score: cat?.score ?? 0 };
  });
  return winnerPickIds(scores);
}

function subWinners(key: string, subName: string, ids: string[]) {
  const scores = ids.map((id) => {
    const pick = picks.find((p) => p.id === id)!;
    const cat = pick.categoryScores.find((c) => c.key === key);
    const sub = cat?.subscores?.find((s) => s.name === subName);
    return { id, score: sub?.score ?? 0 };
  });
  return winnerPickIds(scores);
}
---

<section id="roundup-compare" class="roundup-compare scroll-mt-24" data-roundup-compare data-glossary-skip>
  <h2 class="roundup-compare__heading">Compare the best AI girlfriend apps</h2>

  <div class="roundup-compare__picker-row" data-compare-picker-row>
    <div class="roundup-compare__matrix-row roundup-compare__matrix-row--pickers">
      <div class="roundup-compare__matrix-label" aria-hidden="true"></div>
      <div class="roundup-compare__picker-cols">
        {
          defaultIds.map((id, slot) => {
            const pick = picks.find((p) => p.id === id)!;
            return (
              <div class="roundup-compare__col roundup-compare__col--picker" data-compare-col={pick.id}>
                <RoundupComparePicker slot={slot} pick={pick} picksList={picks} />
              </div>
            );
          })
        }
      </div>
    </div>
  </div>

  <div class="roundup-compare__hero" data-compare-hero>
    <div class="roundup-compare__matrix-row roundup-compare__matrix-row--hero">
      <div class="roundup-compare__matrix-label" aria-hidden="true"></div>
      <div class="roundup-compare__hero-cols" data-compare-grid>
        {
          defaultIds.map((id) => {
            const pick = picks.find((p) => p.id === id)!;
            const band = scoreBand(pick.overallScore);
            return (
              <div class="roundup-compare__col roundup-compare__col--image" data-compare-image-col={pick.id}>
                <div class="roundup-compare__thumb">
                  <img src={pick.gallery[0]?.full ?? pick.logo} alt={pick.gallery[0]?.alt ?? pick.name} width="240" height="150" loading="lazy" />
                  <span class={`roundup-compare__score-on-image roundup-compare__score-on-image--${band}`}>{fmtScore(pick.overallScore)}</span>
                </div>
              </div>
            );
          })
        }
      </div>
    </div>
  </div>

  <div class="roundup-compare__body" data-compare-body>
    <div class="roundup-compare__section">
      <div class="roundup-compare__section-head">
        <h3 class="roundup-compare__section-title">Key features</h3>
        <p class="roundup-compare__section-desc">What each app actually offers</p>
      </div>
      <div class="roundup-compare__matrix" data-compare-features-table>
        {
          featureRowLabels.map(({ id, label }) => (
            <div class="roundup-compare__matrix-row" data-feature-row={id}>
              <div class="roundup-compare__matrix-label">{label}</div>
              {
                defaultIds.map((pickId) => {
                  const pick = picks.find((p) => p.id === pickId)!;
                  const stat = featureStat(pick, id);
                  const val = atGlanceValue(pick.atGlance, 'features', id);
                  return (
                    <div class="roundup-compare__matrix-val" data-compare-feature-val={pickId} data-feature-id={id}>
                      <div set:html={compareFeatureCellInnerHtml(id, val, stat?.values, `${pickId}-${id}`)} />
                    </div>
                  );
                })
              }
            </div>
          ))
        }
      </div>
    </div>

    <div class="roundup-compare__section">
      <div class="roundup-compare__section-head">
        <h3 class="roundup-compare__section-title">Real-world pricing</h3>
        <p class="roundup-compare__section-desc">What you'll actually pay</p>
      </div>
      <div class="roundup-compare__matrix" data-compare-pricing-table>
        {
          pricingRowLabels.map(({ id, label }) => (
            <div class="roundup-compare__matrix-row" data-pricing-row={id}>
              <div class="roundup-compare__matrix-label">
                <span>{label}</span>
              </div>
              {
                defaultIds.map((pickId) => {
                  const pick = picks.find((p) => p.id === pickId)!;
                  const val = atGlanceValue(pick.atGlance, 'pricing', id);
                  const tooltip = pricingTooltip(pick, id);
                  return (
                    <div class="roundup-compare__matrix-val roundup-compare__matrix-val--pricing" data-compare-pricing-val={pickId} data-pricing-id={id}>
                      <span class="roundup-compare__matrix-val-text">{val}</span>
                      {tooltip && (
                        <ComparePricingTooltip
                          pickSlug={pick.slug}
                          rowId={id}
                          label={label}
                          tooltip={tooltip}
                          triggerOnly
                        />
                      )}
                    </div>
                  );
                })
              }
            </div>
          ))
        }
      </div>
    </div>

    <div class="roundup-compare__section roundup-compare__section--scores" data-compare-scores-section>
      <div class="roundup-compare__section-head">
        <h3 class="roundup-compare__section-title">Category scores</h3>
        <p class="roundup-compare__section-desc">See where each app performs best</p>
      </div>
      <div class="roundup-compare__picker-row roundup-compare__picker-row--scores" data-compare-scores-picker-row>
        <div class="roundup-compare__scores-picker-cols">
          {
            defaultIds.map((id, slot) => {
              const pick = picks.find((p) => p.id === id)!;
              return (
                <div class="roundup-compare__col roundup-compare__col--picker" data-compare-col={pick.id}>
                  <RoundupComparePicker slot={slot} pick={pick} picksList={picks} />
                </div>
              );
            })
          }
        </div>
      </div>
      <div class="roundup-compare__score-matrix" data-compare-perf-table>
        {
          categoryKeys.flatMap((key) => {
            const catItem = picks[0].categoryScores.find((c) => c.key === key)!;
            const category = toRatingCategory(catItem, tooltipProductSlug);
            const subscores = catItem.subscores ?? [];
            const winners = categoryWinners(key, defaultIds);

            const categoryRow = (
              <div
                class:list={[
                  'roundup-compare__matrix-row roundup-compare__matrix-row--category',
                  subscores.length > 0 && 'roundup-compare__matrix-row--expandable',
                ]}
                data-perf-row={key}
                data-compare-category={key}
                data-compare-category-row={key}
                {...subscores.length > 0
                  ? {
                      role: 'button',
                      tabindex: 0,
                      'aria-expanded': 'false',
                      'data-compare-category-toggle': key,
                      'aria-label': `Show ${catItem.name} subscores`,
                    }
                  : {}}
              >
                <div class="roundup-compare__matrix-label roundup-compare__matrix-label--category">
                  {
                    subscores.length > 0 && (
                      <span class="material-symbols-outlined roundup-compare__category-chevron" data-compare-category-chevron aria-hidden="true">
                        chevron_right
                      </span>
                    )
                  }
                  <span class="roundup-compare__category-name">{catItem.name}</span>
                  <span class="roundup-compare__category-info" data-compare-category-info>
                    <CategoryScoreTooltip category={category} compact compareTableOnly>
                      <InfoIcon size="xs" class="text-tertiary/50 hover:text-tertiary/80" />
                    </CategoryScoreTooltip>
                  </span>
                </div>
                {
                  defaultIds.map((pickId) => {
                    const pick = picks.find((p) => p.id === pickId)!;
                    const cat = pick.categoryScores.find((c) => c.key === key);
                    const score = cat?.score ?? 0;
                    const isWinner = winners.has(pickId);
                    return (
                      <div class="roundup-compare__matrix-val roundup-compare__matrix-val--perf" data-compare-perf-val={pickId} data-perf-key={key}>
                        <div set:html={comparePerfCellInnerHtml(score, isWinner, fmtScore(score))} />
                      </div>
                    );
                  })
                }
              </div>
            );

            const subRows = subscores.map((sub, subIndex) => {
              const fullCategory = toRatingCategory(catItem, tooltipProductSlug);
              const fullSub = fullCategory.subscores.find((s) => s.name === sub.name) ?? {
                name: sub.name,
                score: sub.score,
                weight: 33,
                description: '',
                contributors: [],
              };
              const subWinnerIds = subWinners(key, sub.name, defaultIds);
              const isLast = subIndex === subscores.length - 1;

              return (
                <div
                  class="roundup-compare__matrix-row roundup-compare__matrix-row--sub"
                  data-sub-row
                  data-perf-key={key}
                  data-sub-name={sub.name}
                  data-sub-last={isLast ? 'true' : undefined}
                >
                  <div class="roundup-compare__matrix-label roundup-compare__matrix-label--sub">
                    <span class="roundup-compare__sub-label">{sub.name}</span>
                    <span class="roundup-compare__sub-info" data-compare-sub-info>
                      <SubscoreScoreTooltip categoryKey={key} categoryName={catItem.name} sub={fullSub} compact compareTableOnly>
                        <InfoIcon size="xs" class="text-tertiary/50 hover:text-tertiary/80" />
                      </SubscoreScoreTooltip>
                    </span>
                  </div>
                  {
                    defaultIds.map((pickId) => {
                      const pick = picks.find((p) => p.id === pickId)!;
                      const cat = pick.categoryScores.find((c) => c.key === key);
                      const subScore = cat?.subscores?.find((s) => s.name === sub.name)?.score ?? 0;
                      const isWinner = subWinnerIds.has(pickId);
                      return (
                        <div
                          class="roundup-compare__matrix-val roundup-compare__matrix-val--perf roundup-compare__matrix-val--sub"
                          data-compare-sub-val={pickId}
                          data-perf-key={key}
                          data-sub-name={sub.name}
                        >
                          <div set:html={comparePerfCellInnerHtml(subScore, isWinner, fmtScore(subScore))} />
                        </div>
                      );
                    })
                  }
                </div>
              );
            });

            if (subscores.length === 0) {
              return [categoryRow];
            }

            return [
              categoryRow,
              <div class="roundup-compare__subscores" data-compare-subscores={key} hidden>
                {subRows}
              </div>,
            ];
          })
        }
      </div>
    </div>

    <div class="roundup-compare__visit-row" data-compare-visit-row>
      <div class="roundup-compare__matrix-label" aria-hidden="true"></div>
      {
        defaultIds.map((pickId) => {
          const pick = picks.find((p) => p.id === pickId)!;
          return (
            <div class="roundup-compare__visit-col" data-compare-visit-col={pickId}>
              <a
                class="roundup-compare__visit-cta bg-brand-cta"
                href={pick.affiliateUrl}
                target="_blank"
                rel="nofollow sponsored noopener"
                data-compare-visit={pickId}
              >
                <span class="roundup-compare__visit-cta-prefix">Visit </span>
                <span class="roundup-compare__visit-cta-name">{pick.name}</span>
                <span class="material-symbols-outlined roundup-compare__visit-cta-icon" aria-hidden="true">open_in_new</span>
              </a>
              {
                pick.reviewUrl && (
                  <a class="roundup-compare__review-link" href={pick.reviewUrl} data-compare-review={pickId}>
                    <span class="roundup-compare__review-brand">{pick.name}</span>
                    <span class="roundup-compare__review-word">review</span>
                  </a>
                )
              }
            </div>
          );
        })
      }
    </div>
  </div>

  <div hidden aria-hidden="true" class="roundup-compare__tooltip-templates">
    {
      picks.flatMap((pick) =>
        COMPARE_PRICING_IDS.map((id) => {
          const tooltip = pricingTooltip(pick, id);
          const label = atGlanceLabel(referencePick.atGlance, 'pricing', id);
          if (!tooltip) return null;
          return <ComparePricingTooltip pickSlug={pick.slug} rowId={id} label={label} tooltip={tooltip} templateOnly />;
        }),
      )
    }
  </div>
</section>

<script define:vars={{ comparePayload, defaultIds, categoryKeys, featureRowLabels, pricingRowLabels }}>
  import { compareFeatureCellInnerHtml } from '../../lib/roundup/compareTable';
  import { initMultiValuePopovers } from '../../lib/ui/multiValueDisplay.client.ts';

  function fmtScoreClient(n) {
    return Number(n).toFixed(1);
  }

  function getBand(score) {
    if (score >= 7.0) return 'good';
    if (score >= 5.5) return 'fair';
    return 'poor';
  }

  function fillClass(score) {
    const band = getBand(score);
    if (band === 'good') return 'is-filled-good';
    if (band === 'fair') return 'is-filled-fair';
    return 'is-filled-poor';
  }

  function segmentFill(score, index) {
    const segStart = index * 2;
    const segEnd = (index + 1) * 2;
    if (score >= segEnd) return { state: 'full', partialPct: 100 };
    if (score <= segStart) return { state: 'empty', partialPct: 0 };
    return { state: 'partial', partialPct: ((score - segStart) / 2) * 100 };
  }

  function segmentedBarHtmlClient(score, isWinner) {
    const fc = fillClass(score);
    const ratio = Math.min(Math.max(score / 10, 0), 1);
    const track = Array.from({ length: 5 }, () => `<span class="roundup-compare-bar__seg"></span>`).join('');
    const fill = Array.from({ length: 5 }, (_, i) => {
      const seg = segmentFill(score, i);
      if (seg.state === 'full') return `<span class="roundup-compare-bar__seg ${fc}"></span>`;
      if (seg.state === 'partial') {
        return `<span class="roundup-compare-bar__seg"><span class="roundup-compare-bar__fill ${fc}" style="width:${seg.partialPct}%"></span></span>`;
      }
      return `<span class="roundup-compare-bar__seg"></span>`;
    }).join('');
    const winnerClass = isWinner ? ' roundup-compare-bar--winner' : '';
    return `<div class="roundup-compare-bar roundup-compare-bar--segmented roundup-compare-bar--segmented-thin${winnerClass}" data-roundup-score-bar style="--score-fill-ratio:${ratio}" aria-hidden="true"><div class="roundup-score-bar__track">${track}</div><div class="roundup-score-bar__meter-fill">${fill}</div></div>`;
  }

  function bestBadgeHtmlClient() {
    return `<span class="roundup-compare__best-badge" aria-label="Best in row"><span class="material-symbols-outlined roundup-compare__best-icon" aria-hidden="true">crown</span><span class="roundup-compare__best-text">Best</span></span>`;
  }

  function featureCellHtmlClient(featureId, featureMeta, pickId) {
    const value = featureMeta?.value ?? '—';
    const values = featureMeta?.values ?? null;
    return compareFeatureCellInnerHtml(featureId, value, values, `${pickId}-${featureId}`);
  }

  function perfCellHtmlClient(score, isWinner) {
    const badge = isWinner ? bestBadgeHtmlClient() : '';
    const cellClass = isWinner ? ' roundup-compare__perf-cell--best' : '';
    return `<div class="roundup-compare__perf-cell${cellClass}"><div class="roundup-compare__perf-head"><div class="roundup-compare__perf-badge-row">${badge}</div><span class="roundup-compare__perf-score">${fmtScoreClient(score)}/10</span></div>${segmentedBarHtmlClient(score, isWinner)}</div>`;
  }

  function winnerIdsForScores(entries) {
    if (!entries.length) return new Set();
    const max = Math.max(...entries.map((e) => e.score));
    if (!Number.isFinite(max)) return new Set();
    return new Set(entries.filter((e) => e.score === max).map((e) => e.id));
  }

  const featureIds = featureRowLabels.map((row) => row.id);
  const pricingIds = pricingRowLabels.map((row) => row.id);

  function initRoundupCompare() {
    const root = document.querySelector('[data-roundup-compare]');
    if (!root || root.dataset.bound === 'true') return;

    let selected = [...defaultIds];
    const byId = Object.fromEntries(comparePayload.map((p) => [p.id, p]));
    const pickerRow = root.querySelector('[data-compare-picker-row]');
    const scoresPickerRow = root.querySelector('[data-compare-scores-picker-row]');
    const scoresSection = root.querySelector('[data-compare-scores-section]');
    const pickerSentinel = document.createElement('div');
    pickerSentinel.className = 'roundup-compare__picker-sentinel';
    pickerSentinel.setAttribute('aria-hidden', 'true');
    pickerRow?.before(pickerSentinel);

    const scoresPickerSentinel = document.createElement('div');
    scoresPickerSentinel.className = 'roundup-compare__picker-sentinel';
    scoresPickerSentinel.setAttribute('aria-hidden', 'true');
    scoresPickerRow?.before(scoresPickerSentinel);

    function syncStickyTop() {
      const header = document.querySelector('[data-site-header]');
      const top = header ? `${header.getBoundingClientRect().height}px` : '4.25rem';
      root.style.setProperty('--compare-sticky-top', top);
    }

    function initPickerPinObserver() {
      syncStickyTop();
      const header = document.querySelector('[data-site-header]');
      const topPx = header ? header.getBoundingClientRect().height : 68;
      const pinOptions = { root: null, threshold: 0, rootMargin: `-${topPx}px 0px 0px 0px` };

      if (pickerRow && pickerSentinel) {
        const observer = new IntersectionObserver(([entry]) => {
          pickerRow.classList.toggle('is-pinned', !entry.isIntersecting);
        }, pinOptions);
        observer.observe(pickerSentinel);
      }

      if (scoresPickerRow && scoresPickerSentinel) {
        const scoresObserver = new IntersectionObserver(([entry]) => {
          scoresPickerRow.classList.toggle('is-pinned', !entry.isIntersecting);
        }, pinOptions);
        scoresObserver.observe(scoresPickerSentinel);
      }
    }

    function visibleCompareSlots() {
      if (window.innerWidth >= 768) return selected.map((_, i) => i);
      return selected.map((_, i) => i).filter((i) => i < 2);
    }

    function syncPickerDisabled() {
      const visibleSlots = new Set(visibleCompareSlots());
      root.querySelectorAll('[data-compare-option]').forEach((btn) => {
        const id = btn.dataset.compareOption;
        const slot = btn.dataset.compareSlot;
        const slotNum = Number(slot);
        const selectedElsewhere = selected.some(
          (sid, i) => sid === id && String(i) !== slot && visibleSlots.has(i),
        );
        btn.disabled = selectedElsewhere;
        btn.classList.toggle('is-disabled', selectedElsewhere);
        btn.classList.toggle('is-active', selected[slotNum] === id);
      });
    }

    function refreshPerfCells(key) {
      const scoresForWinners = selected.map((sid) => ({
        id: sid,
        score: byId[sid]?.categories[key]?.score ?? 0,
      }));
      const winners = winnerIdsForScores(scoresForWinners);

      root.querySelectorAll(`[data-compare-perf-val][data-perf-key="${key}"]`).forEach((cell) => {
        const sid = cell.dataset.comparePerfVal;
        if (!sid) return;
        const cellScore = byId[sid]?.categories[key]?.score ?? 0;
        cell.innerHTML = perfCellHtmlClient(cellScore, winners.has(sid));
        document.dispatchEvent(new CustomEvent('roundup:score-bars-added', { detail: { root: cell } }));
      });

      root.querySelectorAll(`[data-sub-row][data-perf-key="${key}"]`).forEach((row) => {
        const subName = row.dataset.subName;
        if (!subName) return;
        const subScoresForWinners = selected.map((sid) => ({
          id: sid,
          score: byId[sid]?.categories[key]?.subscores?.[subName] ?? 0,
        }));
        const subWinners = winnerIdsForScores(subScoresForWinners);
        row.querySelectorAll('[data-compare-sub-val]').forEach((cell) => {
          const sid = cell.dataset.compareSubVal;
          if (!sid) return;
          const subScore = byId[sid]?.categories[key]?.subscores?.[subName] ?? 0;
          cell.innerHTML = perfCellHtmlClient(subScore, subWinners.has(sid));
          document.dispatchEvent(new CustomEvent('roundup:score-bars-added', { detail: { root: cell } }));
        });
      });
    }

    function updatePickerLabels(slot, pick) {
      root.querySelectorAll(`[data-compare-picker="${slot}"]`).forEach((picker) => {
        const logoEl = picker.querySelector('[data-compare-picker-logo]');
        const nameEl = picker.querySelector('[data-compare-picker-name]');
        if (logoEl) logoEl.src = pick.logo;
        if (nameEl) nameEl.textContent = pick.name;
      });
    }

    function renderColumn(slot, pickId) {
      const pick = byId[pickId];
      if (!pick) return;

      const band = getBand(pick.overallScore);

      const pickerColGroups = root.querySelectorAll('.roundup-compare__picker-cols, .roundup-compare__scores-picker-cols');
      pickerColGroups.forEach((group) => {
        const pickerCol = group.querySelectorAll('[data-compare-col]')[slot];
        if (pickerCol) pickerCol.dataset.compareCol = pickId;
      });

      const imageCol = root.querySelectorAll('[data-compare-image-col]')[slot];
      if (imageCol) {
        imageCol.dataset.compareImageCol = pickId;
        const thumb = imageCol.querySelector('.roundup-compare__thumb');
        if (thumb) {
          thumb.innerHTML = `<img src="${pick.image}" alt="${pick.imageAlt}" width="240" height="150" loading="lazy" /><span class="roundup-compare__score-on-image roundup-compare__score-on-image--${band}">${fmtScoreClient(pick.overallScore)}</span>`;
        }
      }

      updatePickerLabels(slot, pick);

      featureIds.forEach((id) => {
        const row = root.querySelector(`[data-feature-row="${id}"]`);
        const cell = row?.querySelectorAll('[data-compare-feature-val]')[slot];
        if (!cell) return;
        const featureMeta = pick.atGlanceFeatures[id];
        cell.innerHTML = featureCellHtmlClient(id, featureMeta, pickId);
        initMultiValuePopovers(cell);
      });

      pricingIds.forEach((id) => {
        const row = root.querySelector(`[data-pricing-row="${id}"]`);
        const cell = row?.querySelectorAll('[data-compare-pricing-val]')[slot];
        if (!cell) return;
        const textEl = cell.querySelector('.roundup-compare__matrix-val-text');
        if (textEl) textEl.textContent = pick.atGlancePricing[id] ?? '—';
        const infoEl = cell.querySelector('[data-compare-pricing-info]');
        const hasTooltip = Boolean(pick.atGlancePricingHasTooltip?.[id]);
        if (infoEl) {
          infoEl.hidden = !hasTooltip;
          const trigger = infoEl.querySelector('[data-ratings-tooltip-trigger]');
          if (trigger && hasTooltip) {
            trigger.dataset.ratingsTooltipTrigger = `compare-pricing-${pick.slug}-${id}`;
          }
        }
      });

      categoryKeys.forEach((key) => refreshPerfCells(key));

      const visitCol = root.querySelectorAll('[data-compare-visit-col]')[slot];
      const visitLink = visitCol?.querySelector('[data-compare-visit]');
      if (visitLink) {
        visitLink.href = pick.affiliateUrl;
        visitLink.dataset.compareVisit = pickId;
        const nameEl = visitLink.querySelector('.roundup-compare__visit-cta-name');
        if (nameEl) nameEl.textContent = pick.name;
      }

      const reviewLink = visitCol?.querySelector('[data-compare-review]');
      if (reviewLink instanceof HTMLAnchorElement) {
        if (pick.reviewUrl) {
          reviewLink.href = pick.reviewUrl;
          reviewLink.innerHTML = `<span class="roundup-compare__review-brand">${pick.name}</span><span class="roundup-compare__review-word">review</span>`;
          reviewLink.hidden = false;
        } else {
          reviewLink.hidden = true;
        }
      } else if (pick.reviewUrl && visitCol) {
        visitCol.insertAdjacentHTML(
          'beforeend',
          `<a class="roundup-compare__review-link" href="${pick.reviewUrl}" data-compare-review="${pickId}"><span class="roundup-compare__review-brand">${pick.name}</span><span class="roundup-compare__review-word">review</span></a>`,
        );
      }

      document.dispatchEvent(new CustomEvent('ratings-tooltips:reinit'));
    }

    function closeAllMenus() {
      root.querySelectorAll('[data-compare-picker-menu]').forEach((m) => {
        m.hidden = true;
      });
      root.querySelectorAll('[data-compare-picker-btn]').forEach((b) => {
        b.setAttribute('aria-expanded', 'false');
      });
    }

    root.querySelectorAll('[data-compare-category-info], [data-compare-sub-info], [data-compare-pricing-info]').forEach((el) => {
      el.addEventListener('click', (e) => e.stopPropagation());
    });

    function toggleCategoryRow(row, key) {
      const expanded = row.getAttribute('aria-expanded') === 'true';
      const nextExpanded = !expanded;
      const name = row.querySelector('.roundup-compare__category-name')?.textContent ?? 'category';
      row.setAttribute('aria-expanded', String(nextExpanded));
      row.classList.toggle('is-expanded', nextExpanded);
      row.setAttribute('aria-label', `${nextExpanded ? 'Hide' : 'Show'} ${name} subscores`);
      const panel = root.querySelector(`[data-compare-subscores="${key}"]`);
      if (panel) panel.hidden = !nextExpanded;
    }

    root.addEventListener('click', (e) => {
      if (e.target.closest('[data-compare-category-info], [data-compare-sub-info], [data-compare-pricing-info], .rt-tooltip-trigger, [data-ratings-tooltip-trigger]')) {
        return;
      }

      const categoryRow = e.target.closest('[data-compare-category-toggle]');
      if (categoryRow && root.contains(categoryRow)) {
        toggleCategoryRow(categoryRow, categoryRow.dataset.compareCategoryToggle);
        return;
      }

      const pickerBtn = e.target.closest('[data-compare-picker-btn]');
      if (pickerBtn && root.contains(pickerBtn)) {
        e.stopPropagation();
        const picker = pickerBtn.closest('[data-compare-picker]');
        const menu = picker?.querySelector('[data-compare-picker-menu]');
        if (!menu) return;
        const open = menu.hidden;
        closeAllMenus();
        if (open) {
          menu.hidden = false;
          pickerBtn.setAttribute('aria-expanded', 'true');
          syncPickerDisabled();
        }
        return;
      }

      const optionBtn = e.target.closest('[data-compare-option]');
      if (optionBtn && root.contains(optionBtn)) {
        e.stopPropagation();
        if (optionBtn.disabled) return;
        const slot = Number(optionBtn.dataset.compareSlot);
        const id = optionBtn.dataset.compareOption;
        if (!Number.isFinite(slot) || !id) return;
        selected[slot] = id;
        renderColumn(slot, id);
        closeAllMenus();
        syncPickerDisabled();
      }
    });

    root.addEventListener('keydown', (e) => {
      const categoryRow = e.target.closest('[data-compare-category-toggle]');
      if (!categoryRow || !root.contains(categoryRow)) return;
      if (e.key !== 'Enter' && e.key !== ' ') return;
      e.preventDefault();
      toggleCategoryRow(categoryRow, categoryRow.dataset.compareCategoryToggle);
    });

    document.addEventListener('click', (e) => {
      if (!root.contains(e.target)) closeAllMenus();
    });

    window.addEventListener('resize', syncStickyTop, { passive: true });
    window.addEventListener('scroll', syncStickyTop, { passive: true });
    initPickerPinObserver();
    initMultiValuePopovers(root);

    root.dataset.bound = 'true';
    syncPickerDisabled();
  }

  initRoundupCompare();
  document.addEventListener('astro:page-load', initRoundupCompare);
</script>
