---
import type { RoundupTesting } from '../../data/roundups/ai-girlfriend';
import EditorialPillLink from '../ui/EditorialPillLink.astro';
import { cdnAsset } from '../../lib/media/cdn';

interface Props {
  testing: RoundupTesting;
}

const { testing } = Astro.props;
const videoSrc = testing.videoSrc ? cdnAsset(testing.videoSrc) : '';
const videoPoster = cdnAsset(testing.videoPoster);
const hasVideo = Boolean(videoSrc);
---

<section id="roundup-testing" class="roundup-testing scroll-mt-24" data-roundup-testing>
  <p class="roundup-testing__eyebrow">{testing.eyebrow}</p>
  <h2 class="roundup-testing__heading">{testing.title}</h2>

  <div class="roundup-testing__top">
    <div class="roundup-testing__copy">
      <p class="roundup-testing__desc">{testing.description}</p>
      <EditorialPillLink href={testing.processHref} icon="science" variant="quiet" class="roundup-testing__editorial-link">
        {testing.processLabel}
      </EditorialPillLink>
    </div>

    <div class="roundup-testing__video-wrap" data-testing-video-wrap>
      <div class="roundup-testing__video-frame">
        {
          hasVideo ? (
            <video
              class="roundup-testing__video"
              data-testing-video-el
              data-src={videoSrc}
              poster={videoPoster}
              loop
              muted
              playsinline
              disablepictureinpicture
              disableremoteplayback
              preload="none"
              aria-label="How we test AI girlfriend apps — quick video"
            />
          ) : (
            <img
              class="roundup-testing__video-fallback"
              data-testing-video-fallback
              src={videoPoster}
              alt="How we test AI girlfriend apps — quick video"
              width="1280"
              height="720"
              loading="lazy"
              decoding="async"
            />
          )
        }
        {
          hasVideo && (
            <img
              class="roundup-testing__video-fallback"
              data-testing-video-fallback
              src={videoPoster}
              alt="How we test AI girlfriend apps — quick video"
              width="1280"
              height="720"
              loading="lazy"
              decoding="async"
              hidden
            />
          )
        }
      </div>
    </div>
  </div>

  <ul class="roundup-testing__stats">
    {
      testing.stats.map((stat) => (
        <li class="roundup-testing__stat">
          <span class="roundup-testing__stat-icon-wrap" aria-hidden="true">
            <span class="material-symbols-outlined roundup-testing__stat-icon">{stat.icon}</span>
          </span>
          <div class="roundup-testing__stat-text">
            <span class="roundup-testing__stat-title">{stat.title}</span>
            {stat.subtitle && <span class="roundup-testing__stat-sub">{stat.subtitle}</span>}
            {stat.lines?.map((line) => <span class="roundup-testing__stat-sub">{line}</span>)}
          </div>
        </li>
      ))
    }
  </ul>
</section>

<script>
  function initRoundupTesting() {
    document.querySelectorAll<HTMLElement>('[data-roundup-testing]').forEach((root) => {
      if (root.dataset.bound === 'true') return;
      root.dataset.bound = 'true';

      const wrap = root.querySelector<HTMLElement>('[data-testing-video-wrap]');
      const video = root.querySelector<HTMLVideoElement>('[data-testing-video-el]');
      const fallback = root.querySelector<HTMLImageElement>('[data-testing-video-fallback]');

      if (!wrap || !video) return;

      let sourceAttached = false;

      function enableFallback() {
        video.hidden = true;
        if (fallback) fallback.hidden = false;
      }

      function ensureSource() {
        const src = video.dataset.src;
        if (!src || sourceAttached) return;
        const source = document.createElement('source');
        source.src = src;
        source.type = 'video/mp4';
        video.appendChild(source);
        video.load();
        sourceAttached = true;
      }

      function startPlayback() {
        ensureSource();
        video.muted = true;
        video.defaultMuted = true;
        video.playsInline = true;
        void video.play().catch(() => enableFallback());
      }

      function stopPlayback() {
        if (!video.hidden) video.pause();
      }

      video.addEventListener('error', enableFallback);

      const observer = new IntersectionObserver(
        (entries) => {
          const visible = entries.some((entry) => entry.isIntersecting);
          if (visible) startPlayback();
          else stopPlayback();
        },
        { threshold: 0.25, rootMargin: '80px 0px' },
      );

      observer.observe(wrap);
    });
  }

  initRoundupTesting();
  document.addEventListener('astro:page-load', initRoundupTesting);
</script>
