---
import type { AtGlanceTooltip } from '../../data/roundups/ai-girlfriend';
import InfoIcon from '../ui/InfoIcon.astro';
import RoundupUsageEstimateTooltipPanel from './RoundupUsageEstimateTooltipPanel.astro';

interface Props {
  pickSlug: string;
  rowId: string;
  label: string;
  tooltip: AtGlanceTooltip;
  /** Render only the hover trigger (template lives in the shared pool). */
  triggerOnly?: boolean;
  /** Render only the template (for the preloaded tooltip pool). */
  templateOnly?: boolean;
}

const { pickSlug, rowId, label, tooltip, triggerOnly = false, templateOnly = false } = Astro.props;
const tooltipId = `compare-pricing-${pickSlug}-${rowId}`;
---

{
  !templateOnly && (
    <span class="roundup-compare__pricing-info" data-compare-pricing-info>
      <span
        role="button"
        tabindex="0"
        class="rt-tooltip-trigger inline-flex cursor-help"
        data-ratings-tooltip-trigger={tooltipId}
        aria-label={`About ${label.toLowerCase()} for this app`}
      >
        <InfoIcon size="xs" class="text-tertiary/50 hover:text-tertiary/80" />
      </span>
    </span>
  )
}

{
  !triggerOnly && (
    <template id={`tooltip-${tooltipId}`}>
      <RoundupUsageEstimateTooltipPanel tooltip={tooltip} />
    </template>
  )
}
