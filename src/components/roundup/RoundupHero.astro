---
import type { Roundup } from '../../data/roundups/ai-girlfriend';
import { imageSrcSet, optimizedImageUrl } from '../../lib/media/optimize';

interface Props {
  roundup: Roundup;
}

const { roundup } = Astro.props;
const heroSrc = optimizedImageUrl(roundup.featuredImage, { width: 1200, quality: 72 });
---

<section class="roundup-hero" aria-hidden="false">
  <img
    class="roundup-featured w-full"
    src={heroSrc}
    srcset={imageSrcSet(roundup.featuredImage, [640, 960, 1600], 72) || undefined}
    sizes="100vw"
    alt={roundup.featuredImageAlt}
    width="1600"
    height="640"
    loading="eager"
    fetchpriority="high"
    decoding="async"
  />
</section>
