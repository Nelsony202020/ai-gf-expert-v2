---
import type { Roundup } from '../../data/roundups/ai-girlfriend';
import { optimizedRoundupBannerUrl } from '../../lib/media/optimize';

interface Props {
  roundup: Roundup;
  /** Full-bleed banner that scrolls under the fixed site header (roundup hub only). */
  variant?: 'default' | 'scroll-under';
}

const { roundup, variant = 'default' } = Astro.props;
const heroSrc = optimizedRoundupBannerUrl(roundup.featuredImage);
---

<section class:list={['roundup-hero', variant === 'scroll-under' && 'roundup-hero--scroll-under']} aria-hidden="false">
  <img
    class="roundup-featured"
    src={heroSrc}
    alt={roundup.featuredImageAlt}
    width="1024"
    height="256"
    loading="eager"
    fetchpriority="high"
    decoding="async"
  />
</section>
