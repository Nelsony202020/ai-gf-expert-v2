---
import type { AtGlanceData, AtGlanceStat } from '../../data/roundups/ai-girlfriend';
import { atGlanceValueTone } from '../../lib/roundup/atGlance';
import InfoIcon from '../ui/InfoIcon.astro';
import MultiValueDisplay from '../ui/MultiValueDisplay.astro';
import RoundupUsageEstimateTooltipPanel from './RoundupUsageEstimateTooltipPanel.astro';

interface Props {
  atGlance?: AtGlanceData;
  pickSlug: string;
}

const { atGlance, pickSlug } = Astro.props;

function hasStats(stats: AtGlanceStat[] | undefined): stats is AtGlanceStat[] {
  return Boolean(stats?.length);
}

function valueClass(value: string): string {
  return atGlanceValueTone(value) === 'muted'
    ? 'roundup-at-glance__value roundup-at-glance__value--muted'
    : 'roundup-at-glance__value';
}
---

{
  atGlance && (hasStats(atGlance.features) || hasStats(atGlance.pricing)) && (
    <div class="roundup-at-glance" data-glossary-skip>
      {
        hasStats(atGlance.features) && (
          <section class="roundup-at-glance__section" aria-labelledby={`at-glance-features-${pickSlug}`}>
            <div class="roundup-at-glance__section-head">
              <h3 class="roundup-at-glance__heading" id={`at-glance-features-${pickSlug}`}>
                At a glance
              </h3>
              <span class="roundup-at-glance__heading-rule" aria-hidden="true"></span>
            </div>
            <dl class="roundup-at-glance__grid">
              {
                atGlance.features.map((item) => (
                  <div class="roundup-at-glance__item">
                    <span class="material-symbols-outlined roundup-at-glance__icon" aria-hidden="true">
                      {item.icon}
                    </span>
                    <div class="roundup-at-glance__content">
                      <dt class="roundup-at-glance__label-row">
                        <span class="roundup-at-glance__label">{item.label}</span>
                      </dt>
                      {
                        item.values && item.values.length > 0 ? (
                          <dd class={valueClass(item.value)}>
                            <MultiValueDisplay
                              values={item.values}
                              uid={`${pickSlug}-${item.id}`}
                              muted={atGlanceValueTone(item.value) === 'muted'}
                              maxVisible={item.id === 'video-generator' ? 1 : 2}
                            />
                          </dd>
                        ) : (
                          <dd class={valueClass(item.value)}>{item.value}</dd>
                        )
                      }
                    </div>
                  </div>
                ))
              }
            </dl>
          </section>
        )
      }

      {
        hasStats(atGlance.pricing) && (
          <section class="roundup-at-glance__section" aria-labelledby={`at-glance-pricing-${pickSlug}`}>
            <div class="roundup-at-glance__section-head">
              <h3 class="roundup-at-glance__heading" id={`at-glance-pricing-${pickSlug}`}>
                Real-world pricing
              </h3>
              <span class="roundup-at-glance__heading-rule" aria-hidden="true"></span>
            </div>
            <dl class="roundup-at-glance__grid">
              {
                atGlance.pricing.map((item) => {
                  const tooltipId = `at-glance-${pickSlug}-${item.id}`;
                  return (
                    <div class="roundup-at-glance__item">
                      <span class="material-symbols-outlined roundup-at-glance__icon" aria-hidden="true">
                        {item.icon}
                      </span>
                      <div class="roundup-at-glance__content">
                        <dt class="roundup-at-glance__label-row">
                          <span class="roundup-at-glance__label">{item.label}</span>
                          {
                            item.tooltip && (
                              <span class="roundup-at-glance__info">
                                <span
                                  role="button"
                                  tabindex="0"
                                  class="rt-tooltip-trigger inline-flex cursor-help"
                                  data-ratings-tooltip-trigger={tooltipId}
                                  aria-label={`About ${item.label.toLowerCase()}`}
                                >
                                  <InfoIcon size="xs" class="text-tertiary/50 hover:text-tertiary/80" />
                                </span>
                              </span>
                            )
                          }
                        </dt>
                        {
                        item.values && item.values.length > 0 ? (
                          <dd class={valueClass(item.value)}>
                            <MultiValueDisplay
                              values={item.values}
                              uid={`${pickSlug}-${item.id}`}
                              muted={atGlanceValueTone(item.value) === 'muted'}
                              maxVisible={item.id === 'video-generator' ? 1 : 2}
                            />
                          </dd>
                        ) : (
                          <dd class={valueClass(item.value)}>{item.value}</dd>
                        )
                      }
                      </div>
                      {
                        item.tooltip && (
                          <template id={`tooltip-${tooltipId}`}>
                            <RoundupUsageEstimateTooltipPanel tooltip={item.tooltip} />
                          </template>
                        )
                      }
                    </div>
                  );
                })
              }
            </dl>
          </section>
        )
      }
    </div>
  )
}
