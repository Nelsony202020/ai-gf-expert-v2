---
import type { TestSubscoreNode } from '../../lib/test-framework';

interface Props {
  categoryName: string;
  categoryWeight: number;
  categoryHref: string;
  subscores: TestSubscoreNode[];
}

const { categoryName, categoryWeight, categoryHref, subscores } = Astro.props;

const subscoreIcons: Record<string, string> = {
  Understanding: 'psychology',
  Realism: 'sentiment_satisfied',
  Reliability: 'verified_user',
};
---

<div class="test-subscore-example">
  <div class="test-subscore-example__header">
    <div class="test-category-subscore__weight-col">
      <span class="test-category-subscore__weight">{categoryWeight}%</span>
    </div>

    <div class="test-category-subscore__divider" aria-hidden="true"></div>

    <div class="test-subscore-example__header-main">
      <div class="test-category-subscore__head">
        <div class="test-category-subscore__title-block">
          <h3 class="test-category-subscore__name">Example: {categoryName}</h3>
          <a class="test-category-subscore__method-link" href={categoryHref}>
            View {categoryName} methodology
            <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
          </a>
        </div>
      </div>
      <p class="test-category-subscore__body test-subscore-example__lead">
        The {categoryName} category is evaluated across {subscores.length} subscores.
      </p>
    </div>
  </div>

  <div class="test-subscore-example__cards">
    {
      subscores.map((sub, i) => (
        <article class="test-subscore-example__card">
          <span class="test-subscore-example__num" aria-hidden="true">{i + 1}</span>
          <span class="test-subscore-example__sub-icon material-symbols-outlined" aria-hidden="true">
            {subscoreIcons[sub.name] ?? 'analytics'}
          </span>
          <h4 class="test-subscore-example__sub-title">{sub.name}</h4>
          <p class="test-subscore-example__sub-desc">{sub.description}</p>
          <a class="test-category-subscore__method-link test-subscore-example__link" href={sub.href}>
            View {sub.name} methodology
            <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
          </a>
        </article>
      ))
    }
  </div>
</div>
