---
import { type TestCategoryNode } from '../../lib/test-framework';
import { getTestCategoryMethodology } from '../../data/test-category-methodology';
import { iconForEvidenceDef } from '../../lib/ratings/evidenceIcons';

interface Props {
  categories: TestCategoryNode[];
}

const { categories } = Astro.props;

function countLabel(count: number, singular: string, plural: string) {
  return `${count} ${count === 1 ? singular : plural}`;
}

function contributorIcon(categoryKey: string, subscoreSlug: string, contributorSlug: string, label: string) {
  return iconForEvidenceDef(contributorSlug, label);
}

function chunkLabels(labels: string[], columns: number) {
  const rows: string[][] = [];
  for (let i = 0; i < labels.length; i += columns) {
    rows.push(labels.slice(i, i + columns));
  }
  return rows;
}
---

<div class="test-framework-explorer">
  <p class="test-framework-explorer__crumb" aria-hidden="true">
    <span>Category</span>
    <span class="test-framework-explorer__crumb-arrow" aria-hidden="true">→</span>
    <span>Subscore</span>
    <span class="test-framework-explorer__crumb-arrow" aria-hidden="true">→</span>
    <span>Evidence test</span>
  </p>

  <div class="test-framework-accordion">
    {
      categories.map((cat) => {
        const content = getTestCategoryMethodology(cat.key);

        return (
          <details class="test-framework-cat">
            <summary class="test-framework-cat__summary">
              <span class="test-framework-cat__leading">
                <span class="test-category-subscore__weight test-framework-cat__weight">{cat.weight}%</span>
                <span class="test-framework-cat__divider" aria-hidden="true"></span>
                <span class="test-framework-cat__name">{cat.name}</span>
                <a
                  class="test-category-subscore__method-link test-framework-cat__method-link"
                  href={cat.href}
                  onclick="event.stopPropagation()"
                >
                  View {cat.name} methodology
                  <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
                </a>
              </span>
            </summary>

            <div class="test-framework-cat__body">
              {
                cat.subscores.map((sub) => {
                  const rich = content?.subscores.find((s) => s.slug === sub.slug);
                  const weight = content?.scoreCalculation.weights.find((w) => w.name === sub.name)?.weight;
                  const evidenceContributors = sub.contributors;

                  return (
                    <div class="test-framework-sub-wrap">
                      <details class="test-framework-sub">
                        <summary class="test-framework-sub__summary">
                          <span class="test-framework-sub__leading">
                            {
                              weight != null && (
                                <span class="test-category-subscore__weight test-framework-sub__weight">{weight}%</span>
                              )
                            }
                            <span class="test-framework-sub__name">{sub.name}</span>
                            <a
                              class="test-category-subscore__method-link test-framework-sub__method-link"
                              href={sub.href}
                              onclick="event.stopPropagation()"
                            >
                              {rich?.methodologyLinkLabel ?? `View ${sub.name} methodology`}
                              <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
                            </a>
                          </span>
                        </summary>

                        <div class="test-framework-sub__body">
                          <div class="test-framework-evidence-table">
                            <table class="test-framework-evidence-table__grid">
                              <caption class="test-framework-evidence-table__caption">
                                {countLabel(evidenceContributors.length, 'evidence test', 'evidence tests')}
                              </caption>
                              <tbody>
                                {
                                  chunkLabels(
                                    evidenceContributors.map((c) => c.label),
                                    2,
                                  ).map((row) => (
                                    <tr>
                                      {
                                        row.map((label) => {
                                          const contributor = sub.contributors.find((c) => c.label === label)!;
                                          const href = contributor.href;

                                          return (
                                            <td>
                                              <a class="test-framework-evidence-table__link" href={href}>
                                                <span
                                                  class="material-symbols-outlined test-framework-evidence-table__icon"
                                                  aria-hidden="true"
                                                >
                                                  {contributorIcon(cat.key, sub.slug, contributor.slug, label)}
                                                </span>
                                                {label}
                                              </a>
                                            </td>
                                          );
                                        })
                                      }
                                      {row.length === 1 && <td aria-hidden="true"></td>}
                                    </tr>
                                  ))
                                }
                              </tbody>
                            </table>
                          </div>
                        </div>
                      </details>
                    </div>
                  );
                })
              }
            </div>
          </details>
        );
      })
    }
  </div>
</div>
