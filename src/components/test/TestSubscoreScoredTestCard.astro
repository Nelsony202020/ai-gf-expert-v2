---
import { findEvidenceBySlug } from '../../lib/test-methodology-evidence';
import {
  bandIndexForCount,
  formatScoringBandsTableRows,
  formatScoringBandsForDisplay,
  scoreFromBandsRule,
} from '../../lib/test-category-benchmarks/format-from-rule';
import { formatScore } from '../../lib/test-subscore-exact-calculation';
import { iconForMethodologyScoredTest } from '../../lib/ratings/evidenceIcons';
import type { TestEvidenceSectionContent } from '../../data/test-subscore-methodology';

interface Props {
  categoryKey: string;
  subscoreSlug: string;
  section: TestEvidenceSectionContent;
  sharePercent?: number;
  /** Label for share context — the evidence group, e.g. Amount. */
  shareOfLabel?: string;
  /** Total public weight for the evidence group, e.g. 30 for Amount. */
  shareGroupWeight?: number;
  hideWhyItMatters?: boolean;
}

const { categoryKey, subscoreSlug, section, sharePercent, shareOfLabel, shareGroupWeight, hideWhyItMatters } =
  Astro.props;

function scoringTableMeta(
