---
/** Four-level rating hierarchy — horizontal roadmap with short labels. */

const tiers = [
  {
    icon: 'crown',
    label: 'Overall score',
    sub: 'Shown on reviews and roundups',
  },
  {
    icon: 'apps',
    label: '8 category scores',
    sub: 'Characters, Chat, Images, and more',
  },
  {
    icon: 'bar_chart',
    label: '3 subscores each',
    sub: 'Variety, Discovery, Quality…',
  },
  {
    icon: 'description',
    label: 'Scored tests',
    sub: 'Memory, speed, accuracy, and more',
  },
];
---

<nav
  class="rt-pipeline rt-pipeline--horizontal test-methodology-roadmap test-hub-hierarchy-roadmap test-hub__pipeline"
  aria-label="Rating hierarchy from overall score down to individual evidence"
>
  <ol class="rt-pipeline__track">
    {
      tiers.map((tier, i) => (
        <li class="rt-pipeline__step">
          <div class="rt-pipeline__rail">
            <div
              class:list={[
                'rt-pipeline__connector',
                'rt-pipeline__connector--before',
                i === 0 && 'rt-pipeline__connector--spacer',
                i > 0 && 'rt-pipeline__connector--filled',
              ]}
            >
              {i > 0 && <span class="rt-pipeline__connector-fill" />}
            </div>
            <span class="rt-pipeline__node">
              <span class="material-symbols-outlined rt-pipeline__node-icon">{tier.icon}</span>
            </span>
            <div
              class:list={[
                'rt-pipeline__connector',
                'rt-pipeline__connector--after',
                i === tiers.length - 1 && 'rt-pipeline__connector--spacer',
                i < tiers.length - 1 && 'rt-pipeline__connector--filled',
              ]}
            >
              {i < tiers.length - 1 && <span class="rt-pipeline__connector-fill" />}
            </div>
          </div>
          <div class="rt-pipeline__card">
            <span class="rt-pipeline__label">{tier.label}</span>
            <span class="rt-pipeline__sub">{tier.sub}</span>
          </div>
        </li>
      ))
    }
  </ol>
</nav>
