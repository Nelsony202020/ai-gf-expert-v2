---
import type { TestMethodologyPageMeta } from '../../data/test-category-pages';
import { testHubTrustMetrics } from '../../data/test-hub-content';
import { getAuthor } from '../../data/authors';
import AuthorBioPopover from '../review/AuthorBioPopover.astro';
import MethodologyTooltip from '../review/tooltips/MethodologyTooltip.astro';
import RatingsChangelogCompact from '../review/RatingsChangelogCompact.astro';
import InfoIcon from '../ui/InfoIcon.astro';
import VerifiedCheck from '../ui/VerifiedCheck.astro';
import ShareMenu from '../ui/ShareMenu.astro';
import RoundupHubNav from '../roundup/RoundupHubNav.astro';
import Breadcrumbs from '../ui/Breadcrumbs.astro';

interface Props {
  meta: TestMethodologyPageMeta;
  shareUrl?: string;
}

const { meta, shareUrl } = Astro.props;
const shareTitle = 'How We Test AI Girlfriend Apps — AI Girlfriend Expert';
---

<div class="roundup-hero-intro">
  <Breadcrumbs
    items={[
      { label: 'Home', href: '/' },
      { label: 'How We Test' },
    ]}
  />

  <div class="roundup-hero-intro__title-row">
    <h1 class="roundup-hero-intro__title text-3xl md:text-4xl lg:text-5xl font-black text-on-surface tracking-tight mb-0">
      <span class="roundup-hero-intro__title-main">How We Test AI Girlfriend Apps</span>
      <span class="roundup-hero-intro__title-date font-serif italic font-normal">Testing methodology</span>
    </h1>
    <ShareMenu shareTitle={shareTitle} shareUrl={shareUrl} variant="title-mobile" />
  </div>

  {meta.changelog.length > 0 && <RatingsChangelogCompact entries={meta.changelog} />}

  <div class="article-meta-row mb-5">
    <span>Published {meta.reviewedDate}</span>
    <span class="article-meta-row__sep" aria-hidden="true">·</span>
    <span>Updated {meta.modifiedDate}</span>
    <span class="article-meta-row__sep" aria-hidden="true">·</span>
    <span class="article-meta-row__methodology">
      {meta.methodology}
      <MethodologyTooltip id="test-hub-methodology">
        <InfoIcon size="xs" class="text-tertiary hover:text-accent" />
      </MethodologyTooltip>
    </span>
    <span class="article-meta-row__sep article-meta-row__sep--before-share" aria-hidden="true">·</span>
    <ShareMenu shareTitle={shareTitle} shareUrl={shareUrl} variant="inline" />
  </div>

  <div class="flex flex-wrap items-center gap-x-5 gap-y-3 pb-5">
    {
      meta.authors.map((author, i) => {
        const profile = author.slug ? getAuthor(author.slug) : undefined;
        return (
          <>
            {i > 0 && <div class="w-px h-10 bg-surface-variant hidden md:block" />}
            <div class={`flex items-center gap-2.5 ${profile ? 'relative' : ''}`}>
              <div class="w-9 h-9 rounded-full overflow-hidden border-2 border-white shadow-sm shrink-0 bg-white">
                <img alt={author.name} class="w-full h-full object-contain p-0.5" src={author.avatar} />
              </div>
              <div class="flex flex-col">
                {
                  profile ? (
                    <button
                      type="button"
                      class="flex items-center gap-1.5 text-left group overflow-visible"
                      data-author-trigger={author.slug}
                    >
                      <span class="text-sm font-bold group-hover:underline cursor-pointer">{author.name}</span>
                      {author.verified && <VerifiedCheck class="w-[16px] h-[16px] shrink-0" />}
                    </button>
                  ) : (
                    <div class="flex items-center gap-1.5">
                      <span class="text-sm font-bold">{author.name}</span>
                      {author.verified && <VerifiedCheck class="w-[16px] h-[16px] shrink-0" />}
                    </div>
                  )
                }
                <span class="text-[11px] text-tertiary font-medium">{author.role}</span>
              </div>
              {profile && <AuthorBioPopover author={profile} />}
            </div>
          </>
        );
      })
    }
  </div>
</div>

<RoundupHubNav active="how-we-test" />

<div class="roundup-hero-intro__body">
  <p class="text-[15px] md:text-base text-on-surface-variant leading-relaxed">
    In a world where everyone hammers out AI-generated affiliate articles and calls themselves an “expert” who gives honest reviews, we do things differently.
  </p>
  <p class="text-[15px] md:text-base text-on-surface-variant leading-relaxed mt-3">
    Every AI girlfriend app mentioned on aigirlfriend.expert goes through a rigorous review process that relies heavily on data-driven scores.
  </p>
  <p class="text-[15px] md:text-base text-on-surface-variant leading-relaxed mt-3">
    This page explains our entire scoring process, what those scores mean, and how we calculate them.
  </p>
  <ul class="test-hub__metrics mt-4">
    {
      testHubTrustMetrics.map((m) => (
        <li class="test-hub__metric">
          <span class="material-symbols-outlined" aria-hidden="true">{m.icon}</span>
          {m.value}
        </li>
      ))
    }
  </ul>
</div>
