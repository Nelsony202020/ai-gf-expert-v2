---
import MethodologyDepthRoadmap from './MethodologyDepthRoadmap.astro';
import type { MethodologyDepthLevel } from './MethodologyDepthRoadmap.astro';
import type { TestCategoryNode, TestSubscoreNode } from '../../lib/test-framework';
import { testHubUrl } from '../../lib/slugs';

interface Props {
  category: TestCategoryNode;
  subscore: TestSubscoreNode;
  activeLevel?: MethodologyDepthLevel;
  evidenceCount?: number;
}

const { category, subscore, activeLevel = 'subscore', evidenceCount = subscore.contributors.length } =
  Astro.props;

const steps = [
  {
    level: 'overall' as const,
    icon: 'crown',
    label: 'Overall Performance',
    href: `${testHubUrl()}#how-scores-work`,
  },
  {
    level: 'category' as const,
    icon: 'apps',
    label: category.name,
    href: category.href,
  },
  {
    level: 'subscore' as const,
    icon: 'bar_chart',
    label: subscore.name,
  },
  {
    level: 'evidence' as const,
    icon: 'description',
    label: `${evidenceCount} ${evidenceCount === 1 ? 'evidence group' : 'evidence groups'}`,
    href: '#evidence-groups',
  },
];
---

<MethodologyDepthRoadmap steps={steps} activeLevel={activeLevel} />
