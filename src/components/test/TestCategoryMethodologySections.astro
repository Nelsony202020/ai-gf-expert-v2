---
import type { TestCategoryMethodologyContent } from '../../data/test-category-methodology';

interface Props {
  content: TestCategoryMethodologyContent;
}

const { content } = Astro.props;
---

<section id="how-we-test" class="test-page__section scroll-mt-24">
  <h2 class="test-page__h2">{content.howWeTest.title}</h2>
  {
    content.howWeTest.paragraphs.map((p) => (
      <p class="test-methodology-prose">{p}</p>
    ))
  }
</section>

<section id="score-calculation" class="test-page__section scroll-mt-24">
  <h2 class="test-page__h2">{content.scoreCalculation.title}</h2>
  <p class="test-methodology-prose">{content.scoreCalculation.intro}</p>
  <ul class="test-methodology-list">
    {
      content.scoreCalculation.weights.map((w) => (
        <li>
          <strong>{w.name}</strong> — {w.weight}%
        </li>
      ))
    }
  </ul>
  <p class="test-methodology-prose">{content.scoreCalculation.footer}</p>
</section>

<section id="limitations" class="test-page__section scroll-mt-24">
  <h2 class="test-page__h2">{content.limitations.title}</h2>
  {
    content.limitations.paragraphs.map((p) => (
      <p class="test-methodology-prose">{p}</p>
    ))
  }
</section>

<section id="related-methodology" class="test-page__section scroll-mt-24">
  <h2 class="test-page__h2">Related methodology</h2>
  <ul class="test-methodology-related">
    {
      content.related.map((link) => (
        <li>
          <a href={link.href}>{link.label}</a>
        </li>
      ))
    }
  </ul>
</section>
