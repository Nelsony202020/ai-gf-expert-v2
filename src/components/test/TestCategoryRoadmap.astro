---
import MethodologyDepthRoadmap from './MethodologyDepthRoadmap.astro';
import type { TestCategoryNode } from '../../lib/test-framework';
import { testHubUrl } from '../../lib/slugs';

interface Props {
  category: TestCategoryNode;
}

const { category } = Astro.props;
const subscoreCount = category.subscores.length;

const steps = [
  {
    level: 'overall' as const,
    icon: 'crown',
    label: 'Overall Performance',
    href: `${testHubUrl()}#how-scores-work`,
  },
  {
    level: 'category' as const,
    icon: 'apps',
    label: category.name,
  },
  {
    level: 'subscore' as const,
    icon: 'bar_chart',
    label: `${subscoreCount} ${subscoreCount === 1 ? 'subscore' : 'subscores'}`,
    href: '#category-subscores',
  },
  {
    level: 'evidence' as const,
    icon: 'description',
    label: 'Evidence tests',
  },
];
---

<MethodologyDepthRoadmap steps={steps} activeLevel="category" />
