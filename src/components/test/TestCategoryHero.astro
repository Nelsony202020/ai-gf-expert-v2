---
interface Props {
  image: string;
  alt: string;
  /**
   * `scroll-under` matches the roundup hub: a full-bleed band the page body
   * scrolls over. Used on /test/ and the buying guide so all three long-form
   * pages open with the identical header -> banner -> breadcrumbs shape and
   * clicking between them shifts nothing.
   */
  variant?: 'default' | 'scroll-under';
}

const { image, alt, variant = 'default' } = Astro.props;
---

<section
  class:list={['roundup-hero', variant === 'scroll-under' && 'roundup-hero--scroll-under']}
  aria-hidden="false"
>
  <img
    class="roundup-featured w-full"
    src={image}
    alt={alt}
    width="1600"
    height="640"
    loading="eager"
    fetchpriority="high"
  />
</section>
