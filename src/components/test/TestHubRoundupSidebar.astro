---
import type { TestCategoryNode } from '../../lib/test-framework';
import {
  testHubRelatedMethodology,
  testHubTocSections,
  type TestHubTocSection,
} from '../../data/test-hub-content';

interface Props {
  categories: TestCategoryNode[];
}

const { categories } = Astro.props;

function withCategoryChildren(sections: TestHubTocSection[]): TestHubTocSection[] {
  return sections.map((section) => {
    if (section.id !== 'category-scores') return section;
    return {
      ...section,
      children: categories.map((cat) => ({
        id: `category-${cat.key}`,
        label: cat.name,
      })),
    };
  });
}

const tocSections = withCategoryChildren(testHubTocSections);
---

<aside class="roundup-sidebar test-hub-sidebar" aria-label="Test hub navigation">
  <nav class="roundup-toc" aria-label="Table of contents">
    <p class="roundup-toc__title">Contents</p>
    <ul class="roundup-toc__list">
      <li>
        <a class="roundup-toc__link roundup-toc__link--top" href="#test-hub-top">
          <span class="material-symbols-outlined" aria-hidden="true">arrow_upward</span>
          Top
        </a>
      </li>
      {
        tocSections.map((section) => (
          <li
            class:list={[section.children?.length && 'has-toc-children']}
            data-toc-section={section.children?.length ? section.id : undefined}
          >
            <a class="roundup-toc__link" href={`#${section.id}`} data-toc-link={section.id}>
              {section.label}
            </a>
            {
              section.children && section.children.length > 0 && (
                <ul class="roundup-toc__sublist" data-toc-sublist>
                  {
                    section.children.map((child) => (
                      <li>
                        <a
                          class="roundup-toc__link roundup-toc__link--h3"
                          href={`#${child.id}`}
                          data-toc-link={child.id}
                        >
                          {child.label}
                        </a>
                      </li>
                    ))
                  }
                </ul>
              )
            }
          </li>
        ))
      }
    </ul>
  </nav>

  <details class="roundup-toc roundup-toc-panel">
    <summary class="roundup-toc-panel__toggle">
      <span class="roundup-toc-panel__label">
        <span class="material-symbols-outlined roundup-toc-panel__icon" aria-hidden="true">category</span>
        <span>Eight testing categories</span>
      </span>
      <span class="material-symbols-outlined roundup-toc-panel__chevron" aria-hidden="true">expand_more</span>
    </summary>
    <ul class="roundup-toc__list roundup-toc-panel__list">
      {
        categories.map((cat) => (
          <li>
            <a class="roundup-toc__link roundup-toc__link--h3" href={cat.href}>
              {cat.name}
            </a>
          </li>
        ))
      }
    </ul>
  </details>

  <details class="roundup-toc roundup-toc-panel">
    <summary class="roundup-toc-panel__toggle">
      <span class="roundup-toc-panel__label">
        <span class="material-symbols-outlined roundup-toc-panel__icon" aria-hidden="true">menu_book</span>
        <span>Related</span>
      </span>
      <span class="material-symbols-outlined roundup-toc-panel__chevron" aria-hidden="true">expand_more</span>
    </summary>
    <ul class="roundup-toc__list roundup-toc-panel__list">
      {
        testHubRelatedMethodology.map((link) => (
          <li>
            <a class="roundup-toc__link roundup-toc__link--h3" href={link.href}>
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </details>
</aside>

<script>
  import './test-hub-toc.client.ts';
</script>
