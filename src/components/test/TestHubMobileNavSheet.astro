---
import type { TestCategoryNode } from '../../lib/test-framework';
import type { TestHubTocSection } from '../../data/test-hub-content';

interface Props {
  categories: TestCategoryNode[];
  tocSections: TestHubTocSection[];
  collapsibleToc?: boolean;
  pageTitle?: string;
  pageUrl?: string;
}

const { tocSections, pageTitle, pageUrl } = Astro.props;
---

<div
  class="roundup-sheet roundup-nav-sheet test-hub-nav-sheet"
  data-nav-sheet="page"
  hidden
  aria-hidden="true"
  data-page-title={pageTitle}
  data-page-url={pageUrl}
>
  <div class="roundup-sheet__backdrop" data-sheet-backdrop tabindex="-1"></div>
  <div
    class="roundup-sheet__panel roundup-nav-sheet__panel"
    role="dialog"
    aria-modal="true"
    aria-labelledby="test-hub-nav-sheet-title"
  >
    <div class="roundup-sheet__handle" aria-hidden="true"></div>
    <h2 id="test-hub-nav-sheet-title" class="roundup-nav-sheet__toc-title">On this page</h2>

    <div class="sheet-scroll-host">
    <nav class="roundup-nav-sheet__toc sheet-scroll" data-sheet-scroll aria-label="Table of contents">
      <ul class="roundup-nav-sheet__toc-list">
        {
          tocSections.map((section) => (
            <li
              class:list={[section.children?.length && 'has-toc-children']}
              data-toc-section={section.children?.length ? section.id : undefined}
            >
              <a class="roundup-nav-sheet__toc-link" href={`#${section.id}`} data-toc-link={section.id}>
                {section.label}
              </a>
              {
                section.children && section.children.length > 0 && (
                  <ul class="roundup-nav-sheet__toc-sublist roundup-toc__sublist" data-toc-sublist>
                    {
                      section.children.map((child) => (
                        <li>
                          <a
                            class="roundup-nav-sheet__toc-link roundup-nav-sheet__toc-link--h3"
                            href={`#${child.id}`}
                            data-toc-link={child.id}
                          >
                            {child.label}
                          </a>
                        </li>
                      ))
                    }
                  </ul>
                )
              }
            </li>
          ))
        }
      </ul>
    </nav>
    </div>

    <button type="button" class="roundup-sheet__cancel" data-sheet-close>Close</button>
  </div>
</div>

<script>
  import './test-hub-toc.client.ts';

  function initTestHubMobileNavSheet() {
    const sheet = document.querySelector('.test-hub-nav-sheet[data-nav-sheet]');
    if (!sheet || sheet.dataset.bound === 'true') return;
    sheet.dataset.bound = 'true';

    function closeSheet() {
      sheet.hidden = true;
      sheet.setAttribute('aria-hidden', 'true');
      document.body.classList.remove('roundup-sheet-open');
    }

    function openSheet() {
      sheet.hidden = false;
      sheet.setAttribute('aria-hidden', 'false');
      document.body.classList.add('roundup-sheet-open');
    }

    document.querySelectorAll('[data-nav-sheet-open]').forEach((btn) => {
      if (btn.dataset.bound === 'true') return;
      btn.dataset.bound = 'true';
      btn.addEventListener('click', openSheet);
    });

    sheet.querySelector('[data-sheet-close]')?.addEventListener('click', closeSheet);
    sheet.querySelector('[data-sheet-backdrop]')?.addEventListener('click', closeSheet);

    sheet.querySelectorAll('a[href^="#"]').forEach((link) => {
      link.addEventListener('click', () => {
        closeSheet();
      });
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && sheet && !sheet.hidden) closeSheet();
    });
  }

  initTestHubMobileNavSheet();
  document.addEventListener('astro:page-load', initTestHubMobileNavSheet);
</script>
