---
import type { TestCategoryNode } from '../../lib/test-framework';

interface Props {
  categories: TestCategoryNode[];
}

const { categories } = Astro.props;
---

<div class="test-category-subscores-box test-hub-categories-box">
  {
    categories.map((cat) => (
      <article class="test-category-subscore test-hub-category-overview scroll-mt-24" id={`category-${cat.key}`}>
        <div class="test-category-subscore__weight-col">
          <span class="test-category-subscore__weight test-framework-cat__weight">{cat.weight}%</span>
        </div>

        <div class="test-category-subscore__divider" aria-hidden="true"></div>

        <div class="test-category-subscore__head">
          <div class="test-category-subscore__title-block">
            <h3 class="test-category-subscore__name">{cat.name}</h3>
            <a class="test-category-subscore__method-link" href={cat.href}>
              View {cat.name} methodology
              <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
            </a>
          </div>
        </div>

        <div class="test-category-subscore__content">
          <p class="test-category-subscore__body test-hub-category-overview__desc">{cat.description}</p>
        </div>
      </article>
    ))
  }
</div>
