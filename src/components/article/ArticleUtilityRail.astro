---
import ShareMenu from '../ui/ShareMenu.astro';

interface Props {
  pageTitle: string;
  pageUrl?: string;
  /** Mobile: back-to-top only; share/feedback elsewhere on page */
  mobileMinimal?: boolean;
  /** Mobile roundup: floating nav button opens hub + TOC sheet */
  showMobileNav?: boolean;
}

const { pageTitle, pageUrl, mobileMinimal = false, showMobileNav = false } = Astro.props;
---

<aside
  class:list={['article-util-rail', mobileMinimal && 'article-util-rail--mobile-minimal']}
  data-article-util-rail
  data-mobile-minimal={mobileMinimal ? 'true' : undefined}
  aria-label="Page utilities"
>
  <div class="article-util-rail__stack">
    {
      showMobileNav && (
        <button
          type="button"
          class="article-util-rail__btn article-util-rail__btn--nav"
          data-nav-sheet-open
          aria-label="Open table of contents"
        >
          <span class="material-symbols-outlined article-util-rail__nav-icon" aria-hidden="true">description</span>
        </button>
      )
    }

    <button
      type="button"
      class="article-util-rail__btn article-util-rail__btn--top"
      data-util-top
      aria-label="Back to top"
      aria-hidden="true"
      tabindex="-1"
      hidden
    >
      <svg class="article-util-rail__progress" viewBox="0 0 48 48" aria-hidden="true">
        <circle class="article-util-rail__progress-track" cx="24" cy="24" r="22" />
        <circle class="article-util-rail__progress-fill" cx="24" cy="24" r="22" data-util-progress-fill />
      </svg>
      <span class="material-symbols-outlined article-util-rail__top-icon" aria-hidden="true">arrow_upward</span>
    </button>

    <ShareMenu shareTitle={pageTitle} shareUrl={pageUrl} variant="fab" />
  </div>
</aside>

<script>
  function deferUntilIdle(fn: () => void) {
    if (typeof window.requestIdleCallback === 'function') {
      window.requestIdleCallback(() => fn(), { timeout: 2000 });
    } else {
      setTimeout(fn, 1);
    }
  }

  function prefersReducedMotion() {
    return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  }

  function initArticleUtilityRail() {
    const rail = document.querySelector<HTMLElement>('[data-article-util-rail]');
    if (!rail || rail.dataset.bound === 'true') return;
    rail.dataset.bound = 'true';

    const topBtn = rail.querySelector<HTMLButtonElement>('[data-util-top]');
    const progressFill = rail.querySelector<SVGElement>('[data-util-progress-fill]');

    const SCROLL_TOP_THRESHOLD = rail.dataset.mobileMinimal === 'true'
      ? Math.max(window.innerHeight, 700)
      : 700;
    const PROGRESS_RADIUS = 22;
    const PROGRESS_CIRC = 2 * Math.PI * PROGRESS_RADIUS;
    let hideTimer = 0;
    let topVisible = false;

    if (progressFill) {
      progressFill.style.strokeDasharray = `${PROGRESS_CIRC}`;
      progressFill.style.strokeDashoffset = `${PROGRESS_CIRC}`;
    }

    function showTopBtn() {
      if (!topBtn || topVisible) return;
      window.clearTimeout(hideTimer);
      topVisible = true;
      topBtn.hidden = false;
      topBtn.removeAttribute('hidden');
      topBtn.setAttribute('aria-hidden', 'false');
      topBtn.removeAttribute('tabindex');
      rail.classList.add('article-util-rail--scrolled');
      if (prefersReducedMotion()) {
        topBtn.classList.add('is-visible');
        return;
      }
      requestAnimationFrame(() => {
        topBtn.classList.add('is-visible');
      });
    }

    function hideTopBtn() {
      if (!topBtn || !topVisible) return;
      topVisible = false;
      topBtn.classList.remove('is-visible');
      topBtn.setAttribute('aria-hidden', 'true');
      topBtn.tabIndex = -1;
      rail.classList.remove('article-util-rail--scrolled');
      const finish = () => {
        if (topVisible) return;
        topBtn.hidden = true;
      };
      if (prefersReducedMotion()) {
        finish();
        return;
      }
      window.clearTimeout(hideTimer);
      hideTimer = window.setTimeout(finish, 220);
    }

    function updateScrollState() {
      const y = window.scrollY;
      const docHeight = document.documentElement.scrollHeight - window.innerHeight;
      const ratio = docHeight > 0 ? Math.min(Math.max(y / docHeight, 0), 1) : 0;

      if (progressFill) {
        progressFill.style.strokeDashoffset = `${PROGRESS_CIRC * (1 - ratio)}`;
      }

      if (y >= SCROLL_TOP_THRESHOLD) showTopBtn();
      else hideTopBtn();
    }

    topBtn?.addEventListener('click', () => {
      const topTarget =
        document.querySelector('#roundup-top') ??
        document.querySelector('#review-top') ??
        document.querySelector('[id$="-top"]') ??
        document.querySelector('main');
      const behavior = prefersReducedMotion() ? 'auto' : 'smooth';
      if (topTarget) {
        topTarget.scrollIntoView({ behavior, block: 'start' });
      } else {
        window.scrollTo({ top: 0, behavior });
      }
    });

    let ticking = false;
    window.addEventListener(
      'scroll',
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          updateScrollState();
          ticking = false;
        });
      },
      { passive: true },
    );

    updateScrollState();
  }

  deferUntilIdle(initArticleUtilityRail);
  document.addEventListener('astro:page-load', initArticleUtilityRail);
</script>
