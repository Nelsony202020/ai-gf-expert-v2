---
import BrandIcon from '../ui/BrandIcon.astro';
import { brandIcons } from '../../lib/brand-icons';
---

<div class="article-feedback" data-article-feedback hidden aria-hidden="true">
  <div class="article-feedback__backdrop" data-feedback-close tabindex="-1"></div>

  <div
    class="article-feedback__panel"
    role="dialog"
    aria-modal="true"
    aria-labelledby="article-feedback-title"
    data-feedback-panel
  >
    <header class="article-feedback__header">
      <p id="article-feedback-title" class="article-feedback__title">Help us improve this article</p>
      <button type="button" class="article-feedback__close" data-feedback-close aria-label="Close feedback">
        <span class="material-symbols-outlined">close</span>
      </button>
    </header>

    <div class="article-feedback__body" data-feedback-form-view>
      <p class="article-feedback__desc">
        Spot something wrong, outdated, or missing? Send us a note and we'll review it.
      </p>

      <p class="article-feedback__categories-label">
        What's this about? <span class="article-feedback__required" aria-hidden="true">*</span>
      </p>

      <div class="article-feedback__categories" role="radiogroup" aria-label="Feedback type" data-feedback-category-group>
        <button
          type="button"
          class="article-feedback__cat"
          data-feedback-category="outdated"
          role="radio"
          aria-checked="false"
        >
          <span class="article-feedback__cat-icon" aria-hidden="true">
            <span class="material-symbols-outlined">calendar_today</span>
          </span>
          <span class="article-feedback__cat-label">Outdated information</span>
        </button>
        <button
          type="button"
          class="article-feedback__cat"
          data-feedback-category="missing-app"
          role="radio"
          aria-checked="false"
        >
          <span class="article-feedback__cat-icon" aria-hidden="true">
            <span class="material-symbols-outlined">search</span>
          </span>
          <span class="article-feedback__cat-label">Missing app</span>
        </button>
        <button
          type="button"
          class="article-feedback__cat"
          data-feedback-category="wrong"
          role="radio"
          aria-checked="false"
        >
          <span class="article-feedback__cat-icon" aria-hidden="true">
            <span class="material-symbols-outlined">warning</span>
          </span>
          <span class="article-feedback__cat-label">Something is wrong</span>
        </button>
        <button
          type="button"
          class="article-feedback__cat"
          data-feedback-category="general"
          role="radio"
          aria-checked="false"
        >
          <span class="article-feedback__cat-icon" aria-hidden="true">
            <span class="material-symbols-outlined">chat_bubble</span>
          </span>
          <span class="article-feedback__cat-label">General feedback</span>
        </button>
      </div>

      <p class="article-feedback__categories-hint" data-feedback-category-hint>Select a topic above to continue.</p>

      <form class="article-feedback__form" data-feedback-form>
        <input type="hidden" name="category" value="" data-feedback-category-input />
        <input type="hidden" name="pageUrl" value="" data-feedback-url-input />
        <input type="hidden" name="pageTitle" value="" data-feedback-title-input />

        <label class="article-feedback__field">
          <span class="article-feedback__field-label">Email <span class="article-feedback__required" aria-hidden="true">*</span></span>
          <input
            type="email"
            name="email"
            data-feedback-email
            class="article-feedback__input"
            placeholder="you@example.com"
            autocomplete="email"
            inputmode="email"
            required
          />
          <span class="article-feedback__field-hint">Required — we’ll only use this to reply to your note.</span>
        </label>

        <label class="article-feedback__field">
          <span class="sr-only">Your feedback</span>
          <textarea
            data-feedback-message
            name="message"
            rows="4"
            maxlength="500"
            placeholder="Type your feedback…"
            required
          ></textarea>
          <span class="article-feedback__counter" data-feedback-counter>0/500</span>
        </label>

        <button type="submit" class="article-feedback__submit bg-brand-cta" data-feedback-submit disabled>
          Send feedback
        </button>
      </form>

      <footer class="article-feedback__footer">
        <BrandIcon
          src={brandIcons.scientist.dark}
          srcLight={brandIcons.scientist.light}
          width={32}
          height={32}
          class="article-feedback__footer-icon"
        />
        <span>Herman reads every note ❤️</span>
      </footer>
    </div>

    <div class="article-feedback__success hidden" data-feedback-success-view>
      <BrandIcon
        src={brandIcons.scientist.dark}
        srcLight={brandIcons.scientist.light}
        width={64}
        height={64}
        class="article-feedback__success-icon"
      />
      <p class="article-feedback__success-text">Thanks—Herman will review it.</p>
      <button type="button" class="article-feedback__success-close" data-feedback-close>Close</button>
    </div>
  </div>
</div>

<script>
  import { overlayDurationMs, playOverlayClose, playOverlayOpen } from '../../lib/ui/overlayTransition.ts';

  function initArticleFeedback() {
    const root = document.querySelector<HTMLElement>('[data-article-feedback]');
    if (!root || root.dataset.bound === 'true') return;
    root.dataset.bound = 'true';

    const panel = root.querySelector<HTMLElement>('[data-feedback-panel]');
    const formView = root.querySelector<HTMLElement>('[data-feedback-form-view]');
    const successView = root.querySelector<HTMLElement>('[data-feedback-success-view]');
    const form = root.querySelector<HTMLFormElement>('[data-feedback-form]');
    const message = root.querySelector<HTMLTextAreaElement>('[data-feedback-message]');
    const email = root.querySelector<HTMLInputElement>('[data-feedback-email]');
    const counter = root.querySelector<HTMLElement>('[data-feedback-counter]');
    const categoryInput = root.querySelector<HTMLInputElement>('[data-feedback-category-input]');
    const urlInput = root.querySelector<HTMLInputElement>('[data-feedback-url-input]');
    const titleInput = root.querySelector<HTMLInputElement>('[data-feedback-title-input]');
    const categoryBtns = root.querySelectorAll<HTMLButtonElement>('[data-feedback-category]');
    const categoryHint = root.querySelector<HTMLElement>('[data-feedback-category-hint]');
    const categoryGroup = root.querySelector<HTMLElement>('[data-feedback-category-group]');
    const submitBtn = form?.querySelector<HTMLButtonElement>('[data-feedback-submit]');

    let pageTitle = document.title;
    let pageUrl = window.location.href;

    function updateSubmitState() {
      const hasCategory = Boolean(categoryInput?.value);
      if (submitBtn) submitBtn.disabled = !hasCategory;
      categoryGroup?.classList.toggle('is-invalid', false);
      if (categoryHint) {
        categoryHint.textContent = hasCategory
          ? 'Thanks — add your note below.'
          : 'Select a topic above to continue.';
        categoryHint.classList.toggle('is-ready', hasCategory);
      }
    }

    function setPageContext(title: string, url: string) {
      pageTitle = title;
      pageUrl = url;
      if (urlInput) urlInput.value = url;
      if (titleInput) titleInput.value = title;
    }

    function resetForm() {
      form?.reset();
      categoryBtns.forEach((b) => {
        b.classList.remove('is-selected');
        b.setAttribute('aria-checked', 'false');
      });
      if (categoryInput) categoryInput.value = '';
      if (counter) counter.textContent = '0/500';
      formView?.classList.remove('hidden');
      successView?.classList.add('hidden');
      updateSubmitState();
    }

    function openFeedback(title?: string, url?: string) {
      resetForm();
      setPageContext(title ?? document.title, url ?? window.location.href);
      root.hidden = false;
      root.setAttribute('aria-hidden', 'false');
      root.classList.remove('is-visible');
      document.body.classList.add('article-feedback-open');
      playOverlayOpen(root);
      window.setTimeout(() => categoryBtns[0]?.focus(), overlayDurationMs() + 40);
    }

    function closeFeedback() {
      if (root.hidden || !root.classList.contains('is-visible')) return;
      playOverlayClose(root, () => {
        root.hidden = true;
        root.setAttribute('aria-hidden', 'true');
        document.body.classList.remove('article-feedback-open');
      });
    }

    window.addEventListener('article-feedback:open', ((e: CustomEvent<{ title?: string; url?: string }>) => {
      openFeedback(e.detail?.title, e.detail?.url);
    }) as EventListener);

    root.querySelectorAll('[data-feedback-close]').forEach((el) => {
      el.addEventListener('click', closeFeedback);
    });

    categoryBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        categoryBtns.forEach((b) => {
          b.classList.remove('is-selected');
          b.setAttribute('aria-checked', 'false');
        });
        btn.classList.add('is-selected');
        btn.setAttribute('aria-checked', 'true');
        if (categoryInput) categoryInput.value = btn.dataset.feedbackCategory ?? '';
        updateSubmitState();
      });
    });

    message?.addEventListener('input', () => {
      if (counter && message) counter.textContent = `${message.value.length}/500`;
    });

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!categoryInput?.value) {
        categoryGroup?.classList.add('is-invalid');
        if (categoryHint) categoryHint.textContent = 'Please select a topic before sending.';
        categoryBtns[0]?.focus();
        return;
      }

      if (!email?.value.trim() || !email.checkValidity()) {
        email?.focus();
        email?.reportValidity();
        return;
      }

      const payload = {
        kind: 'feedback',
        category: categoryInput.value,
        email: email.value.trim(),
        message: message?.value ?? '',
        pageUrl,
        pageTitle,
      };

      const submitButton = form.querySelector<HTMLButtonElement>('[data-feedback-submit]');
      submitButton?.setAttribute('disabled', 'true');

      try {
        const res = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const body = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(body.error || 'Failed to send feedback');
      } catch (error) {
        submitButton?.removeAttribute('disabled');
        updateSubmitState();
        window.alert(error instanceof Error ? error.message : 'Could not send feedback. Please try again.');
        return;
      }

      submitButton?.removeAttribute('disabled');
      formView?.classList.add('hidden');
      successView?.classList.remove('hidden');
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !root.hidden && root.classList.contains('is-visible')) closeFeedback();
    });

    updateSubmitState();
  }

  initArticleFeedback();
  document.addEventListener('astro:page-load', initArticleFeedback);
</script>
