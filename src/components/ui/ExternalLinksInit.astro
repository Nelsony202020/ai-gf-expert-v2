<script>
  /** True when href points at a cloaked /go/ affiliate redirect. */
  function isGoAffiliateHref(href: string | null): boolean {
    if (!href) return false;
    const raw = String(href).trim();
    if (!raw || raw.startsWith('#') || raw.startsWith('mailto:') || raw.startsWith('tel:')) return false;
    try {
      const url = raw.startsWith('//') ? new URL('https:' + raw) : new URL(raw, location.origin);
      return url.pathname === '/go' || url.pathname.startsWith('/go/');
    } catch {
      return raw.startsWith('/go/');
    }
  }

  /**
   * rel for a /go/ link. Never noreferrer: it strips the referrer and can
   * break affiliate attribution. Mirrors goAffiliateRel in lib/affiliate/rel.ts.
   */
  function goAffiliateRel(newTab: boolean): string {
    return newTab ? 'sponsored nofollow noopener' : 'sponsored nofollow';
  }

  function externalizeLinks(root: ParentNode = document) {
    root.querySelectorAll('a[href]').forEach((node) => {
      const anchor = node as HTMLAnchorElement;
      const href = anchor.getAttribute('href');
      if (!href || href.startsWith('#') || href.startsWith('mailto:') || href.startsWith('tel:')) return;

      // Explicit opt-out for the rare link that must stay in this tab.
      if (anchor.getAttribute('target') === '_self') return;

      // Cloaked affiliate redirects (/go/...) are same-origin paths, so they
      // never reach the external check below — they must be handled first.
      if (isGoAffiliateHref(href)) {
        anchor.target = '_blank';
        anchor.rel = goAffiliateRel(true);
        return;
      }

      let external = false;
      if (href.startsWith('//')) {
        external = true;
      } else if (/^https?:\/\//i.test(href)) {
        try {
          external = new URL(href).origin !== window.location.origin;
        } catch {
          return;
        }
      }
      if (!external) return;

      anchor.target = '_blank';
      const rel = anchor.getAttribute('rel') ?? '';
      const parts = new Set(rel.split(/\s+/).filter(Boolean));
      parts.add('noopener');
      parts.add('noreferrer');
      parts.delete('');
      anchor.rel = [...parts].join(' ');
    });
  }

  /**
   * Central enforcement of the site-wide rule: every external URL opens in a new
   * tab with safe rel attributes; internal links, anchors, mailto/tel and any
   * link that explicitly opts out with target="_self" are left alone.
   *
   * A one-off sweep at load is not enough — large parts of the review page are
   * injected after load (the lazily fetched ratings panel, evidence drawer
   * panels cloned from <template>, lightbox content), and links inside them
   * used to keep opening in the same tab. Observing the document means any
   * markup added later automatically follows the rule, so future links never
   * have to be patched one by one.
   */
  let queued = false;
  const pending = new Set<ParentNode>();

  function flush() {
    queued = false;
    const roots = [...pending];
    pending.clear();
    for (const root of roots) externalizeLinks(root);
  }

  function schedule(root: ParentNode) {
    pending.add(root);
    if (queued) return;
    queued = true;
    requestAnimationFrame(flush);
  }

  function watchForNewLinks() {
    if (document.documentElement.dataset.externalLinksObserved === 'true') return;
    document.documentElement.dataset.externalLinksObserved = 'true';

    const observer = new MutationObserver((records) => {
      for (const record of records) {
        if (record.type === 'attributes') {
          const target = record.target as HTMLElement;
          if (target instanceof HTMLAnchorElement) schedule(target.parentNode ?? document);
          continue;
        }
        record.addedNodes.forEach((node) => {
          if (node.nodeType !== 1) return;
          const el = node as HTMLElement;
          if (el instanceof HTMLAnchorElement || el.querySelector?.('a[href]')) {
            schedule(el.parentNode ?? document);
          }
        });
      }
    });

    observer.observe(document.body, {
      childList: true,
      subtree: true,
      attributes: true,
      attributeFilter: ['href'],
    });
  }

  externalizeLinks();
  watchForNewLinks();
  document.addEventListener('astro:page-load', () => {
    externalizeLinks();
    watchForNewLinks();
  });
</script>
