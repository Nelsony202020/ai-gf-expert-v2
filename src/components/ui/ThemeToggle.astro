---
interface Props {
  variant?: 'header' | 'footer' | 'switch';
}

const { variant = 'header' } = Astro.props;
---

{
  variant === 'switch' ? (
    <button
      type="button"
      class="theme-toggle theme-toggle--switch"
      data-theme-toggle
      role="switch"
      aria-checked="false"
      aria-label="Switch to dark mode"
    >
      <span class="theme-toggle__switch-main">
        <svg class="theme-toggle__icon" data-theme-icon="moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
        <svg class="theme-toggle__icon" data-theme-icon="sun" hidden width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
        <span class="theme-toggle__label">Dark mode</span>
      </span>
      <span class="theme-toggle__track" aria-hidden="true">
        <span class="theme-toggle__thumb"></span>
      </span>
    </button>
  ) : variant === 'header' ? (
    <button
      type="button"
      class="theme-toggle theme-toggle--header"
      data-theme-toggle
      aria-label="Switch to dark mode"
    >
      <svg class="theme-toggle__icon" data-theme-icon="moon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
      <svg class="theme-toggle__icon" data-theme-icon="sun" hidden width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
    </button>
  ) : (
    <button
      type="button"
      class="theme-toggle theme-toggle--footer"
      data-theme-toggle
      aria-label="Switch to dark mode"
    >
      <span class="theme-toggle__label">Dark mode</span>
    </button>
  )
}
