---
import ThemeModeIcons from './ThemeModeIcons.astro';

interface Props {
  variant?: 'header' | 'footer' | 'switch';
}

const { variant = 'header' } = Astro.props;
const iconSize = variant === 'header' ? 20 : 20;
---

{
  variant === 'switch' ? (
    <button
      type="button"
      class="theme-toggle theme-toggle--switch"
      data-theme-toggle
      role="switch"
      aria-checked="false"
      aria-label="Toggle dark mode"
    >
      <span class="theme-toggle__switch-main">
        <ThemeModeIcons size={iconSize} />
        <span class="theme-toggle__label">Dark mode</span>
      </span>
      <span class="theme-toggle__track" aria-hidden="true">
        <span class="theme-toggle__thumb"></span>
      </span>
    </button>
  ) : (
    <button
      type="button"
      class={`theme-toggle theme-toggle--${variant}`}
      data-theme-toggle
      aria-label="Toggle dark mode"
    >
      <ThemeModeIcons size={iconSize} />
      <span class="theme-toggle__label">Dark mode</span>
    </button>
  )
}
