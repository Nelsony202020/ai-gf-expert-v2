---
interface Props {
  variant?: 'header' | 'footer' | 'switch';
}

const { variant = 'header' } = Astro.props;
---

{
  variant === 'switch' ? (
    <button
      type="button"
      class="theme-toggle theme-toggle--switch"
      data-theme-toggle
      role="switch"
      aria-checked="false"
      aria-label="Toggle dark mode"
    >
      <span class="theme-toggle__switch-main">
        <svg class="theme-toggle__icon" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12 2v20c-5.5 0-10-4.5-10-10S6.5 2 12 2Zm0 3.2C8 5.2 5.2 8 5.2 12S8 18.8 12 18.8V5.2Z" />
      </svg>
        <span class="theme-toggle__label">Dark mode</span>
      </span>
      <span class="theme-toggle__track" aria-hidden="true">
        <span class="theme-toggle__thumb"></span>
      </span>
    </button>
  ) : (
    <button
      type="button"
      class={`theme-toggle theme-toggle--${variant}`}
      data-theme-toggle
      aria-label="Toggle dark mode"
    >
      <svg class="theme-toggle__icon" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12.1 21.5c-5.2 0-9.5-4.2-9.5-9.5 0-3.7 2.1-7 5.4-8.6-.3.9-.5 1.8-.5 2.8 0 4.7 3.8 8.5 8.5 8.5 1 0 1.9-.2 2.8-.5-1.6 3.3-4.9 5.3-8.7 5.3Z" />
      </svg>
      <span class="theme-toggle__label">Dark mode</span>
    </button>
  )
}
