<div
  data-image-lightbox
  class="image-lightbox hidden fixed inset-0 z-[200] bg-black/92 items-center justify-center p-4 md:p-8"
  role="dialog"
  aria-modal="true"
  aria-label="Image preview"
  aria-hidden="true"
>
  <button
    type="button"
    data-lightbox-close
    class="absolute top-4 right-4 z-10 w-10 h-10 rounded-full bg-white/10 hover:bg-white/20 text-white flex items-center justify-center transition-colors"
    aria-label="Close"
  >
    <span class="material-symbols-outlined">close</span>
  </button>

  <button
    type="button"
    data-lightbox-prev
    class="image-lightbox__nav image-lightbox__nav--prev hidden"
    aria-label="Previous image"
  >
    <span class="material-symbols-outlined">chevron_left</span>
  </button>

  <button
    type="button"
    data-lightbox-next
    class="image-lightbox__nav image-lightbox__nav--next hidden"
    aria-label="Next image"
  >
    <span class="material-symbols-outlined">chevron_right</span>
  </button>

  <div class="image-lightbox__stage" data-lightbox-stage>
    <img id="site-image-lightbox-img" data-lightbox-img class="image-lightbox__img max-w-full max-h-[90vh] object-contain rounded-lg shadow-2xl" alt="" />
    <video
      data-lightbox-video
      class="image-lightbox__video hidden max-w-full max-h-[90vh] object-contain rounded-lg shadow-2xl"
      controls
      controlslist="nodownload noremoteplayback"
      disablepictureinpicture
      playsinline
    />
  </div>

  <div class="image-lightbox__caption-bar" aria-hidden="true">
    <p data-lightbox-caption class="image-lightbox__caption"></p>
    <p data-lightbox-counter class="image-lightbox__counter hidden"></p>
  </div>
</div>

<style is:global>
  .image-lightbox.flex {
    display: flex;
  }

  .image-lightbox {
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.34s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .image-lightbox.is-visible {
    opacity: 1;
    pointer-events: auto;
  }

  .image-lightbox__stage {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    max-width: min(100%, 1200px);
    max-height: 90vh;
    opacity: 0;
    transform: scale(0.94) translateY(10px);
    transition:
      opacity 0.36s cubic-bezier(0.4, 0, 0.2, 1),
      transform 0.38s cubic-bezier(0.34, 1.12, 0.64, 1);
  }

  .image-lightbox.is-visible .image-lightbox__stage {
    opacity: 1;
    transform: scale(1) translateY(0);
  }

  .image-lightbox [data-lightbox-close],
  .image-lightbox__nav {
    opacity: 0;
    transition: opacity 0.28s ease 0.08s;
  }

  .image-lightbox.is-visible [data-lightbox-close],
  .image-lightbox.is-visible .image-lightbox__nav:not(.hidden) {
    opacity: 1;
  }

  .image-lightbox__caption-bar {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 5;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    gap: 0.35rem;
    padding: 1.25rem 1.5rem calc(1rem + env(safe-area-inset-bottom, 0px));
    pointer-events: none;
    text-align: center;
    opacity: 0;
    transition: opacity 0.28s ease 0.1s;
  }

  .image-lightbox.is-visible .image-lightbox__caption-bar {
    opacity: 1;
  }

  .image-lightbox__caption {
    margin: 0;
    max-width: min(36rem, calc(100% - 2rem));
    color: rgb(255 255 255 / 82%);
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.4;
    text-align: center;
  }

  .image-lightbox__caption:empty {
    display: none;
  }

  .image-lightbox__counter {
    margin: 0;
    color: rgb(255 255 255 / 55%);
    font-size: 0.75rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    text-align: center;
  }

  .image-lightbox__counter.hidden {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .image-lightbox,
    .image-lightbox__stage,
    .image-lightbox [data-lightbox-close],
    .image-lightbox__nav,
    .image-lightbox__caption-bar {
      transition: none !important;
    }

    .image-lightbox.is-visible .image-lightbox__stage {
      transform: none;
    }
  }

  .image-lightbox__img {
    transition:
      opacity 0.32s cubic-bezier(0.4, 0, 0.2, 1),
      transform 0.32s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .image-lightbox__video {
    transition:
      opacity 0.32s cubic-bezier(0.4, 0, 0.2, 1),
      transform 0.32s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .image-lightbox__video.is-changing {
    opacity: 0;
    transform: scale(0.985);
  }

  .image-lightbox__video.hidden {
    display: none;
  }

  .image-lightbox__img.is-changing {
    opacity: 0;
    transform: scale(0.98);
  }

  .image-lightbox__img.from-left {
    transform: translateX(-16px);
  }

  .image-lightbox__img.from-right {
    transform: translateX(16px);
  }

  .image-lightbox__nav {
    position: absolute;
    top: 50%;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    margin-top: -22px;
    border: 1px solid rgb(255 255 255 / 22%);
    border-radius: 999px;
    background: rgb(255 255 255 / 12%);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    color: rgb(255 255 255 / 92%);
    cursor: pointer;
    box-shadow: 0 4px 20px rgb(0 0 0 / 28%);
    transition:
      background 0.15s ease,
      border-color 0.15s ease,
      transform 0.15s ease,
      opacity 0.15s ease;
  }

  .image-lightbox__nav:hover {
    background: rgb(255 255 255 / 20%);
    border-color: rgb(255 255 255 / 35%);
    transform: scale(1.05);
  }

  .image-lightbox__nav--prev {
    left: 1rem;
  }

  .image-lightbox__nav--next {
    right: 1rem;
  }

  @media (min-width: 768px) {
    .image-lightbox__nav {
      width: 48px;
      height: 48px;
      margin-top: -24px;
    }

    .image-lightbox__nav--prev {
      left: 1.5rem;
    }

    .image-lightbox__nav--next {
      right: 1.5rem;
    }
  }
</style>

<script>
  import { playOverlayClose, playOverlayOpen } from '../../lib/ui/overlayTransition.ts';
  import { deferUntilIdle } from '../../lib/ui/deferUntilIdle';

  interface LightboxItem {
    src: string;
    alt?: string;
    caption?: string;
    type?: 'image' | 'video';
  }

  function initImageLightbox() {
    const lightbox = document.querySelector<HTMLElement>('[data-image-lightbox]');
    if (!lightbox || lightbox.dataset.bound === 'true') return;
    lightbox.dataset.bound = 'true';

    const img = lightbox.querySelector<HTMLImageElement>('[data-lightbox-img]');
    const video = lightbox.querySelector<HTMLVideoElement>('[data-lightbox-video]');
    const caption = lightbox.querySelector<HTMLElement>('[data-lightbox-caption]');
    const counter = lightbox.querySelector<HTMLElement>('[data-lightbox-counter]');
    const closeBtn = lightbox.querySelector<HTMLButtonElement>('[data-lightbox-close]');
    const prevBtn = lightbox.querySelector<HTMLButtonElement>('[data-lightbox-prev]');
    const nextBtn = lightbox.querySelector<HTMLButtonElement>('[data-lightbox-next]');
    if (!img) return;

    let items: LightboxItem[] = [];
    let index = 0;
    let isOpen = false;

    function updateNavUi() {
      const hasMultiple = items.length > 1;
      prevBtn?.classList.toggle('hidden', !hasMultiple);
      nextBtn?.classList.toggle('hidden', !hasMultiple);

      if (counter) {
        if (hasMultiple) {
          counter.textContent = `${index + 1} / ${items.length}`;
          counter.classList.remove('hidden');
        } else {
          counter.classList.add('hidden');
          counter.textContent = '';
        }
      }
    }

    function pauseVideo() {
      if (!video) return;
      video.pause();
      video.removeAttribute('src');
      video.load();
      video.classList.add('hidden');
    }

    function renderItem(direction: 'left' | 'right' | 'none' = 'none') {
      const item = items[index];
      if (!item) return;
      const isVideo = item.type === 'video';

      const apply = () => {
        if (caption) caption.textContent = (item.caption ?? '').trim();
        if (isVideo && video) {
          img.classList.add('hidden');
          img.removeAttribute('src');
          video.classList.remove('hidden');
          video.src = item.src;
          video.setAttribute('aria-label', item.alt ?? 'Gallery video');
          void video.play().catch(() => {});
        } else {
          pauseVideo();
          img.classList.remove('hidden');
          img.src = item.src;
          img.alt = item.alt ?? '';
        }
        img.classList.remove('is-changing', 'from-left', 'from-right');
        video?.classList.remove('is-changing', 'from-left', 'from-right');
      };

      if (direction !== 'none') {
        const activeEl = isVideo ? video : img;
        activeEl?.classList.add('is-changing', direction === 'left' ? 'from-left' : 'from-right');
        window.setTimeout(() => {
          apply();
        }, 180);
        return;
      }

      apply();
      updateNavUi();
    }

    function open(itemsList: LightboxItem[], startIndex = 0) {
      items = itemsList
        .filter((item) => item.src)
        .map((item) => ({
          ...item,
          type: item.type ?? (/\.(mp4|webm|mov)(\?|#|$)/i.test(item.src) ? 'video' : 'image'),
        }));
      index = Math.min(Math.max(startIndex, 0), Math.max(items.length - 1, 0));
      isOpen = true;
      lightbox.classList.remove('hidden', 'is-visible');
      lightbox.classList.add('flex');
      lightbox.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      renderItem('none');
      updateNavUi();
      playOverlayOpen(lightbox);
    }

    function close() {
      if (!isOpen) return;
      isOpen = false;
      lightbox.setAttribute('aria-hidden', 'true');
      playOverlayClose(lightbox, () => {
        lightbox.classList.add('hidden');
        lightbox.classList.remove('flex');
        pauseVideo();
        img.classList.remove('hidden', 'is-changing', 'from-left', 'from-right');
        items = [];
        index = 0;
        document.body.style.overflow = '';
        updateNavUi();
      });
    }

    function step(delta: number) {
      if (items.length <= 1) return;
      index = (index + delta + items.length) % items.length;
      renderItem(delta < 0 ? 'left' : 'right');
      updateNavUi();
    }

    function collectGalleryItems(trigger: HTMLElement): { items: LightboxItem[]; index: number } | null {
      const gallery = trigger.closest<HTMLElement>('[data-gallery]');
      if (!gallery) return null;

      let parsed: LightboxItem[] = [];
      const raw = gallery.dataset.galleryImages;
      if (raw) {
        try {
          parsed = JSON.parse(raw) as LightboxItem[];
        } catch {
          parsed = [];
        }
      }

      if (!parsed.length) {
        parsed = Array.from(gallery.querySelectorAll<HTMLElement>('[data-thumb]')).map((btn) => ({
          src: btn.dataset.full ?? '',
          alt: btn.dataset.alt ?? '',
          caption: btn.dataset.caption ?? '',
          type: (btn.dataset.mediaType === 'video' ? 'video' : 'image') as 'image' | 'video',
        }));
      }

      const src = trigger.dataset.lightboxOpen ?? '';
      const foundIndex = parsed.findIndex((item) => item.src === src);
      return { items: parsed, index: foundIndex >= 0 ? foundIndex : 0 };
    }

    function openFromTrigger(trigger: HTMLElement) {
      const galleryData = collectGalleryItems(trigger);
      if (galleryData && galleryData.items.length > 0) {
        open(galleryData.items, galleryData.index);
        return;
      }

      open([
        {
          src: trigger.dataset.lightboxOpen ?? '',
          alt: trigger.dataset.lightboxAlt,
          caption: trigger.dataset.lightboxCaption ?? '',
          type: trigger.dataset.lightboxType === 'video' ? 'video' : 'image',
        },
      ]);
    }

    document.addEventListener('click', (e) => {
      if (isOpen) return;
      const trigger = (e.target as HTMLElement).closest<HTMLElement>('[data-lightbox-open]');
      if (!trigger || lightbox.contains(trigger)) return;
      e.preventDefault();
      openFromTrigger(trigger);
    });

    document.addEventListener('keydown', (e) => {
      if (isOpen) {
        if (e.key === 'Escape') {
          close();
          return;
        }
        if (e.key === 'ArrowLeft') {
          e.preventDefault();
          step(-1);
          return;
        }
        if (e.key === 'ArrowRight') {
          e.preventDefault();
          step(1);
        }
        return;
      }

      if (e.key !== 'Enter' && e.key !== ' ') return;
      const target = e.target as HTMLElement;
      if (!target.closest('[data-lightbox-open]')) return;
      const trigger = target.closest<HTMLElement>('[data-lightbox-open]');
      if (!trigger || trigger.tagName === 'BUTTON' || lightbox.contains(trigger)) return;
      e.preventDefault();
      openFromTrigger(trigger);
    });

    closeBtn?.addEventListener('click', close);
    prevBtn?.addEventListener('click', () => step(-1));
    nextBtn?.addEventListener('click', () => step(1));

    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox) close();
    });

    document.addEventListener(
      'auxclick',
      (e) => {
        if (!isOpen) return;
        if (e.button === 3) {
          e.preventDefault();
          step(-1);
        } else if (e.button === 4) {
          e.preventDefault();
          step(1);
        }
      },
      true,
    );

    (window as unknown as { openImageLightbox?: (items: LightboxItem[], index?: number) => void }).openImageLightbox = (
      itemsList,
      startIndex = 0,
    ) => open(itemsList, startIndex);
  }

  // Closed overlay: nothing shows until an image thumbnail is clicked.
  deferUntilIdle(initImageLightbox);
  document.addEventListener('astro:page-load', initImageLightbox);
</script>
