<script>
  function getThemeColors() {
    const meta = document.querySelector('meta[name="theme-color"][data-theme-color]');
    return {
      light: meta?.getAttribute('data-theme-color-light') ?? '#f9f9f9',
      dark: meta?.getAttribute('data-theme-color-dark') ?? '#020617',
    };
  }

  function syncThemeColor(dark) {
    const meta = document.querySelector('meta[name="theme-color"][data-theme-color]');
    const colors = getThemeColors();
    if (meta) meta.setAttribute('content', dark ? colors.dark : colors.light);
  }

  function syncThemeModeIcons(btn, dark) {
    btn.querySelectorAll('.theme-toggle__icon[data-theme-icon]').forEach((el) => {
      const kind = el.getAttribute('data-theme-icon');
      const show = dark ? kind === 'sun' : kind === 'moon';
      if (show) el.removeAttribute('hidden');
      else el.setAttribute('hidden', '');
    });
  }

  function initThemeToggles() {
    const buttons = document.querySelectorAll('[data-theme-toggle]');
    if (!buttons.length) return;

    const root = document.documentElement;

    function applyTheme(dark) {
      if (dark) {
        root.setAttribute('data-theme', 'dark');
        localStorage.setItem('theme', 'dark');
      } else {
        root.removeAttribute('data-theme');
        localStorage.setItem('theme', 'light');
      }
      syncThemeColor(dark);
    }

    function syncAll() {
      const dark = root.getAttribute('data-theme') === 'dark';
      syncThemeColor(dark);
      buttons.forEach((btn) => {
        const label = btn.querySelector('.theme-toggle__label');
        const isSwitch = btn.classList.contains('theme-toggle--switch');
        syncThemeModeIcons(btn, dark);
        if (isSwitch) {
          if (label) label.textContent = 'Dark mode';
          btn.setAttribute('aria-checked', dark ? 'true' : 'false');
          btn.setAttribute('aria-label', dark ? 'Turn off dark mode' : 'Turn on dark mode');
        } else {
          if (label) label.textContent = dark ? 'Light mode' : 'Dark mode';
          btn.setAttribute('aria-label', dark ? 'Switch to light mode' : 'Switch to dark mode');
          btn.setAttribute('aria-pressed', dark ? 'true' : 'false');
        }
      });
    }

    buttons.forEach((btn) => {
      if (btn.dataset.bound === 'true') return;
      btn.dataset.bound = 'true';

      btn.addEventListener('click', () => {
        const dark = root.getAttribute('data-theme') === 'dark';
        applyTheme(!dark);
        syncAll();
      });
    });

    syncAll();
  }

  initThemeToggles();
  document.addEventListener('astro:page-load', initThemeToggles);
</script>
