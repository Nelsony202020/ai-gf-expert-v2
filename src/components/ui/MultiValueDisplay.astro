---
import {
  joinMultiValueParts,
  segmentMultiValues,
} from '../../lib/ui/multiValueDisplay';

interface Props {
  values: string[];
  /** Stable id for popover aria wiring (e.g. pick slug + stat id). */
  uid: string;
  muted?: boolean;
  /** How many values show inline before +N (default 2; video uses 1). */
  maxVisible?: number;
}

const { values, uid, muted = false, maxVisible = 2 } = Astro.props;
const { visible, overflow, overflowCount } = segmentMultiValues(values, maxVisible);
const popoverId = `mv-popover-${uid}`;
const backdropId = `mv-backdrop-${uid}`;
---

{
  values.length === 0 ? null : values.length === 1 ? (
    <span class:list={['multi-value', muted && 'multi-value--muted']}>{values[0]}</span>
  ) : (
    <span class:list={['multi-value', muted && 'multi-value--muted']} data-multi-value-root={uid}>
      <span class="multi-value__inline">{joinMultiValueParts(visible)}</span>
      {
        overflowCount > 0 && (
          <>
            <span class="multi-value__sep" aria-hidden="true">
              {' · '}
            </span>
            <button
              type="button"
              class="multi-value__more"
              data-multi-value-trigger={uid}
              aria-expanded="false"
              aria-controls={popoverId}
            >
              +{overflowCount}
            </button>
            <span
              id={backdropId}
              class="multi-value__backdrop"
              hidden
              data-multi-value-backdrop={uid}
              aria-hidden="true"
            />
            <span
              id={popoverId}
              class="multi-value__popover"
              role="dialog"
              aria-modal="true"
              hidden
              data-multi-value-popover={uid}
            >
              <button type="button" class="multi-value__close" data-multi-value-close={uid} aria-label="Close">
                <span class="material-symbols-outlined" aria-hidden="true">close</span>
              </button>
              <span class="multi-value__popover-body">{joinMultiValueParts(overflow)}</span>
            </span>
          </>
        )
      }
    </span>
  )
}

<script>
  import { initMultiValuePopovers } from '../../lib/ui/multiValueDisplay.client.ts';

  initMultiValuePopovers();
  document.addEventListener('astro:page-load', () => initMultiValuePopovers());
</script>

<style is:global>
  .multi-value {
    display: inline;
    font-size: inherit;
    font-weight: inherit;
    line-height: inherit;
    color: inherit;
  }

  .multi-value--muted {
    font-weight: 400;
    color: var(--color-tertiary);
  }

  .multi-value__inline {
    display: inline;
  }

  .multi-value__sep {
    display: inline;
  }

  .multi-value__more {
    display: inline;
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    font-weight: 600;
    color: var(--color-primary);
    cursor: pointer;
    text-decoration: underline;
    text-decoration-style: dotted;
    text-underline-offset: 2px;
  }

  .multi-value__more:hover,
  .multi-value__more:focus-visible {
    color: var(--color-on-surface);
  }

  .multi-value__backdrop {
    position: fixed;
    inset: 0;
    z-index: 9998;
    background: color-mix(in srgb, #000 28%, transparent);
  }

  .multi-value__popover {
    position: absolute;
    z-index: 40;
    margin-top: 0.25rem;
    min-width: 12rem;
    max-width: min(28rem, 92vw);
    padding: 0.5rem 0.75rem;
    border-radius: 0.375rem;
    border: 1px solid var(--color-surface-variant);
    background: var(--color-surface);
    box-shadow: 0 4px 12px rgb(0 0 0 / 0.12);
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1.45;
    color: var(--color-on-surface);
    white-space: nowrap;
  }

  .multi-value__close {
    display: none;
  }

  [data-multi-value-root] {
    position: relative;
  }

  body.multi-value-open {
    overflow: hidden;
  }

  @media (max-width: 767px) {
    .multi-value__popover {
      position: fixed;
      left: 50%;
      top: 50%;
      transform: translate(-50%, -50%);
      margin: 0;
      width: calc(100vw - 2rem);
      max-width: 22rem;
      padding: 1.65rem 1rem 1rem;
      border-radius: 0.875rem;
      white-space: normal;
      z-index: 9999;
      box-shadow: 0 12px 40px rgb(0 0 0 / 18%);
    }

    .multi-value__close {
      display: inline-flex;
      position: absolute;
      top: 0.55rem;
      right: 0.45rem;
      align-items: center;
      justify-content: center;
      width: 2rem;
      height: 2rem;
      padding: 0;
      border: none;
      border-radius: 999px;
      background: transparent;
      color: var(--color-tertiary);
      cursor: pointer;
    }

    .multi-value__close:hover,
    .multi-value__close:focus-visible {
      color: var(--color-on-surface);
      background: var(--color-surface-container-low);
    }

    .multi-value__close .material-symbols-outlined {
      font-size: 1.25rem;
    }

    .multi-value__popover-body {
      display: block;
      padding-right: 1.75rem;
      line-height: 1.5;
    }
  }
</style>
