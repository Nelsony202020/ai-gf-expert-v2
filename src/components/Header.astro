---
import HomeDesktopHeader from './home/desktop/HomeDesktopHeader.astro';

interface Props {
  /** `hero` = on dark ink surfaces; `standard` = sticky glass bar on content pages. */
  variant?: 'standard' | 'hero';
}

const { variant = 'standard' } = Astro.props;
const homeVariant = variant === 'hero' ? 'hero' : 'standard';
---

<HomeDesktopHeader variant={homeVariant} />
