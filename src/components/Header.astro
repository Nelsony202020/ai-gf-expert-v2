---
import { buildMegaMenuColumns } from '../data/nav-mega-menu';
import { buildSearchIndex } from '../data/site-search';
import { loadComparisonProducts } from '../lib/content/comparisonProducts';
import { cdnAsset } from '../lib/media/cdn';
import ThemeToggle from './ui/ThemeToggle.astro';

const publishedProducts = await loadComparisonProducts();
const megaMenuColumns = buildMegaMenuColumns(publishedProducts);
const searchIndex = buildSearchIndex(publishedProducts, megaMenuColumns);
---

<header class="site-header relative z-50" data-site-header data-glossary-skip>
  <div class="section-container px-4 md:px-8 site-header__inner">
    <div class="site-header__left">
      <a href="/" class="site-logo-link site-header__logo-link shrink-0">
        <img
          src={cdnAsset('/brand/girlfriend-expert-logo.png')}
          alt="Girlfriend Expert AI"
          class="site-header__logo site-header__logo--light"
          width="148"
          height="82"
          loading="eager"
          fetchpriority="low"
          decoding="async"
        />
        <img
          src={cdnAsset('/brand/girlfriend-expert-logo-white.png')}
          alt=""
          class="site-header__logo site-header__logo--dark"
          width="148"
          height="82"
          loading="lazy"
          decoding="async"
          aria-hidden="true"
        />
      </a>

      <nav class="site-header__nav" aria-label="Main">
        <div class="site-header__mega-wrap" data-mega-wrap>
          <button
            type="button"
            class="site-header__nav-link"
            data-mega-trigger
            aria-haspopup="menu"
            aria-controls="site-mega-menu"
            aria-expanded="false"
          >
            Explore
            <svg class="site-header__nav-chevron" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M7.4 8.6 12 13.2l4.6-4.6L18 10l-6 6-6-6 1.4-1.4Z" />
            </svg>
          </button>
        </div>

        <a href="/ai-girlfriend-apps/" class="site-header__nav-link">All Apps</a>
        <a href="/test/" class="site-header__nav-link">How We Review</a>
      </nav>
    </div>

    <div class="site-header__actions">
      <div class="site-header__search" data-header-search>
        <button
          type="button"
          class="site-header__search-toggle"
          data-search-toggle
          aria-expanded="false"
          aria-label="Search"
        >
          <svg class="site-header__icon" width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M15.5 14h-.8l-.3-.3a6.5 6.5 0 1 0-.7.7l.3.3v.8l5 5 1.5-1.5-5-5Zm-6 0a4.5 4.5 0 1 1 0-9 4.5 4.5 0 0 1 0 9Z" />
          </svg>
        </button>

        <div class="site-header__search-field" data-search-field>
          <svg class="site-header__icon site-header__search-field-icon" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M15.5 14h-.8l-.3-.3a6.5 6.5 0 1 0-.7.7l.3.3v.8l5 5 1.5-1.5-5-5Zm-6 0a4.5 4.5 0 1 1 0-9 4.5 4.5 0 0 1 0 9Z" />
          </svg>
          <input
            type="search"
            class="site-header__search-input"
            data-search-input
            placeholder="Search reviews, guides, pages…"
            autocomplete="off"
            spellcheck="false"
            tabindex="-1"
            aria-label="Search reviews, guides, and pages"
          />
        </div>

        <div class="site-header__search-dropdown hidden" data-search-results role="listbox" />
      </div>

      <div class="site-header__theme-desktop">
        <ThemeToggle variant="header" />
      </div>

      <div class="site-header__auth site-header__auth--desktop">
        <button type="button" class="site-header__link coming-soon-tip coming-soon-muted site-header__auth-btn" data-coming-soon-tip="Coming soon">
          Sign In
        </button>
        <button type="button" class="site-header__join coming-soon-tip coming-soon-muted site-header__auth-btn" data-coming-soon-tip="Coming soon">
          <span class="site-header__join-text site-header__join-text--full">Join Now</span>
          <span class="site-header__join-text site-header__join-text--short">Join</span>
          <svg class="site-header__join-arrow" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 4v2.8l5.2 5.2H4v2h13.2L12 19.2V22l8-8-8-8Z" />
          </svg>
        </button>
      </div>

      <button
        type="button"
        class="site-header__menu-toggle"
        data-mobile-menu-toggle
        aria-expanded="false"
        aria-controls="site-mobile-menu"
        aria-label="Open menu"
      >
        <svg class="site-header__icon site-header__menu-icon--bars" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M3 6h18v2H3V6Zm0 5h18v2H3v-2Zm0 5h18v2H3v-2Z" />
        </svg>
        <svg class="site-header__icon site-header__menu-icon--close hidden" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M19 6.4 17.6 5 12 10.6 6.4 5 5 6.4 10.6 12 5 17.6 6.4 19 12 13.4 17.6 19 19 17.6 13.4 12 19 6.4Z" />
        </svg>
      </button>
    </div>
  </div>

  <div class="site-header__mobile-backdrop hidden" data-mobile-menu-backdrop aria-hidden="true"></div>

  <div id="site-mobile-menu" class="site-header__mobile-menu hidden" data-mobile-menu hidden>
    <div class="site-header__mobile-menu-handle" aria-hidden="true"></div>
    <nav class="site-header__mobile-nav" aria-label="Site">
      <a href="/" class="site-header__mobile-link">Home</a>
      <a href="/reviews/" class="site-header__mobile-link">All Reviews</a>
      <a href="/best/ai-girlfriend/" class="site-header__mobile-link">Best AI Girlfriend</a>
      <a href="/test/" class="site-header__mobile-link">How We Test</a>
      <a href="/about/" class="site-header__mobile-link">About</a>
      <a href="/contact/" class="site-header__mobile-link">Contact</a>
    </nav>
    <div class="site-header__mobile-actions">
      <ThemeToggle variant="footer" />
    </div>
    <button type="button" class="site-header__mobile-close-sheet" data-mobile-menu-toggle aria-label="Close menu">
      Close
    </button>
  </div>

  <div
    id="site-mega-menu"
    class="site-header__mega hidden"
    data-mega-panel
    role="menu"
    aria-label="Explore"
  >
    <div class="section-container px-4 md:px-8">
      <div class="site-header__mega-grid">
        {
          megaMenuColumns.map((col) => (
            <div class="site-header__mega-col">
              <div class="site-header__mega-col-head">
                <span class="site-header__mega-col-icon">
                  <span class="material-symbols-outlined">{col.icon}</span>
                </span>
                <div>
                  <p class="site-header__mega-col-title">{col.title}</p>
                  <p class="site-header__mega-col-desc">{col.description}</p>
                </div>
              </div>
              <ul class="site-header__mega-links">
                {
                  col.links.map((link) => (
                    <li>
                      <a href={link.href} class="site-header__mega-link" role="menuitem">
                        <span>{link.label}</span>
                        <span class="material-symbols-outlined">chevron_right</span>
                      </a>
                    </li>
                  ))
                }
              </ul>
              <a href={col.viewAll.href} class="site-header__mega-view-all" role="menuitem">
                <span class="link-text">{col.viewAll.label}</span>
                <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
              </a>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</header>

<script>
  window.__scrollChrome = {
    applyScrollDirectionBodyClass: () => {},
    readScrollDirection: () => 'none',
    shouldHideSiteHeader: () => false,
  };
</script>

<script define:vars={{ searchIndex }}>
  function initSiteHeader() {
    const header = document.querySelector('[data-site-header]');
    if (!header || header.dataset.bound === 'true') return;
    header.dataset.bound = 'true';

    const megaWrap = header.querySelector('[data-mega-wrap]');
    const megaTrigger = header.querySelector('[data-mega-trigger]');
    const megaPanel = header.querySelector('[data-mega-panel]');
    const searchRoot = header.querySelector('[data-header-search]');
    const searchToggle = header.querySelector('[data-search-toggle]');
    const searchField = header.querySelector('[data-search-field]');
    const searchInput = header.querySelector('[data-search-input]');
    const searchResults = header.querySelector('[data-search-results]');
    const mobileMenu = header.querySelector('[data-mobile-menu]');
    const mobileMenuBackdrop = header.querySelector('[data-mobile-menu-backdrop]');

    let activeMenuToggle = null;

    function closeMobileMenu() {
      mobileMenu?.classList.add('hidden');
      mobileMenu?.setAttribute('hidden', '');
      mobileMenuBackdrop?.classList.add('hidden');
      mobileMenuBackdrop?.setAttribute('aria-hidden', 'true');
      document.querySelectorAll('[data-mobile-menu-toggle]').forEach((btn) => {
        btn.setAttribute('aria-expanded', 'false');
        btn.setAttribute('aria-label', 'Open menu');
        btn.querySelector('.site-header__menu-icon--bars')?.classList.remove('hidden');
        btn.querySelector('.site-header__menu-icon--close')?.classList.add('hidden');
      });
      header.classList.remove('site-header--menu-open');
      document.body.classList.remove('site-header-menu-open');
      activeMenuToggle = null;
    }

    function openMobileMenu(toggle) {
      closeMega();
      closeSearch();
      activeMenuToggle = toggle;
      mobileMenu?.classList.remove('hidden');
      mobileMenu?.removeAttribute('hidden');
      mobileMenuBackdrop?.classList.remove('hidden');
      mobileMenuBackdrop?.setAttribute('aria-hidden', 'false');
      toggle.setAttribute('aria-expanded', 'true');
      toggle.setAttribute('aria-label', 'Close menu');
      toggle.querySelector('.site-header__menu-icon--bars')?.classList.add('hidden');
      toggle.querySelector('.site-header__menu-icon--close')?.classList.remove('hidden');
      header.classList.add('site-header--menu-open');
      document.body.classList.add('site-header-menu-open');
    }

    document.querySelectorAll('[data-mobile-menu-toggle]').forEach((toggle) => {
      toggle.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        if (mobileMenu?.classList.contains('hidden')) openMobileMenu(toggle);
        else closeMobileMenu();
      });
      toggle.addEventListener('pointerdown', (e) => {
        e.stopPropagation();
      });
    });

    mobileMenuBackdrop?.addEventListener('click', closeMobileMenu);

    let activeIndex = -1;
    let currentResults = [];
    let megaCloseTimer = null;

    header.querySelectorAll('.site-header__auth-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
      });
    });

    function closeMega() {
      megaPanel?.classList.add('hidden');
      megaTrigger?.classList.remove('site-header__nav-link--active');
      megaTrigger?.setAttribute('aria-expanded', 'false');
      header.classList.remove('site-header--mega-open');
    }

    function openMega() {
      if (megaCloseTimer) {
        clearTimeout(megaCloseTimer);
        megaCloseTimer = null;
      }
      closeSearch();
      megaPanel?.classList.remove('hidden');
      megaTrigger?.classList.add('site-header__nav-link--active');
      megaTrigger?.setAttribute('aria-expanded', 'true');
      header.classList.add('site-header--mega-open');
    }

    function scheduleMegaClose() {
      if (megaCloseTimer) clearTimeout(megaCloseTimer);
      megaCloseTimer = setTimeout(closeMega, 120);
    }

    function closeSearch() {
      searchRoot?.classList.remove('is-open');
      searchToggle?.setAttribute('aria-expanded', 'false');
      searchResults?.classList.add('hidden');
      if (searchInput) {
        searchInput.value = '';
        searchInput.setAttribute('tabindex', '-1');
      }
      if (searchResults) searchResults.innerHTML = '';
      activeIndex = -1;
      currentResults = [];
    }

    function openSearch() {
      closeMega();
      searchRoot?.classList.add('is-open');
      searchToggle?.setAttribute('aria-expanded', 'true');
      searchInput?.setAttribute('tabindex', '0');
      window.setTimeout(() => searchInput?.focus(), 180);
    }

    function renderResults(query) {
      if (!searchResults) return;
      const q = query.trim().toLowerCase();
      if (!q) {
        searchResults.innerHTML = '';
        searchResults.classList.add('hidden');
        currentResults = [];
        activeIndex = -1;
        return;
      }

      const typeIcons = {
        review: 'rate_review',
        roundup: 'emoji_events',
        guide: 'menu_book',
        page: 'article',
      };

      const typeLabels = {
        review: 'Review',
        roundup: 'Roundup',
        guide: 'Guide',
        page: 'Page',
      };

      currentResults = searchIndex.filter((item) => {
        const hay = `${item.label} ${item.meta ?? ''}`.toLowerCase();
        return hay.includes(q);
      }).slice(0, 8);

      searchResults.classList.remove('hidden');

      if (currentResults.length === 0) {
        searchResults.innerHTML = '<p class="site-header__search-empty">No results found.</p>';
        activeIndex = -1;
        return;
      }

      searchResults.innerHTML = currentResults.map((item, i) => {
        const icon = typeIcons[item.type] || 'article';
        const meta = item.meta || typeLabels[item.type] || 'Page';
        return `
        <a
          href="${item.href}"
          class="site-header__search-item${i === activeIndex ? ' is-active' : ''}"
          role="option"
          data-search-index="${i}"
        >
          <span class="site-header__search-item-icon material-symbols-outlined" aria-hidden="true">${icon}</span>
          <span class="site-header__search-item-body">
            <span class="site-header__search-item-label">${item.label}</span>
            <span class="site-header__search-item-meta">${meta}</span>
          </span>
          <span class="site-header__search-item-chevron material-symbols-outlined" aria-hidden="true">chevron_right</span>
        </a>
      `;
      }).join('');
    }

    megaWrap?.addEventListener('mouseenter', openMega);
    megaWrap?.addEventListener('mouseleave', scheduleMegaClose);
    megaPanel?.addEventListener('mouseenter', openMega);
    megaPanel?.addEventListener('mouseleave', scheduleMegaClose);

    megaTrigger?.addEventListener('click', (e) => {
      e.preventDefault();
    });

    searchToggle?.addEventListener('click', (e) => {
      e.stopPropagation();
      if (searchRoot?.classList.contains('is-open')) closeSearch();
      else openSearch();
    });

    searchInput?.addEventListener('input', () => {
      activeIndex = -1;
      renderResults(searchInput.value);
    });

    searchInput?.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeSearch();
        return;
      }
      if (!currentResults.length) return;

      if (e.key === 'ArrowDown') {
        e.preventDefault();
        activeIndex = Math.min(activeIndex + 1, currentResults.length - 1);
        renderResults(searchInput.value);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        activeIndex = Math.max(activeIndex - 1, 0);
        renderResults(searchInput.value);
      } else if (e.key === 'Enter' && activeIndex >= 0) {
        e.preventDefault();
        const target = currentResults[activeIndex];
        if (target?.href && target.href !== '#') window.location.href = target.href;
      }
    });

    document.addEventListener('click', (e) => {
      if (e.target.closest('[data-mobile-menu-toggle]')) return;
      if (!searchRoot?.contains(e.target)) closeSearch();
      if (
        mobileMenu &&
        !mobileMenu.classList.contains('hidden') &&
        !header.contains(e.target)
      ) {
        closeMobileMenu();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeMega();
        closeSearch();
        closeMobileMenu();
      }
    });

    function syncHeaderOffset() {
      document.documentElement.style.setProperty('--site-header-offset', '0px');
      document.dispatchEvent(new CustomEvent('site-header-offset-change'));
    }

    syncHeaderOffset();
    window.addEventListener('resize', syncHeaderOffset, { passive: true });
  }

  initSiteHeader();
  document.addEventListener('astro:page-load', initSiteHeader);
</script>

<style is:global>
  [data-theme='dark'] .site-header__logo.site-header__logo--light {
    opacity: 0;
    visibility: hidden;
  }

  [data-theme='dark'] .site-header__logo.site-header__logo--dark {
    opacity: 1;
    visibility: visible;
    background: transparent;
    box-shadow: none;
    filter: none;
  }
</style>
