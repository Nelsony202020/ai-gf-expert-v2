---
import { LUCIDE_MENU_ICONS, type LucideMenuIconName } from '../../lib/ui/lucideIconPaths';

interface Props {
  name: LucideMenuIconName;
  size?: number;
  class?: string;
}

const { name, size = 20, class: className } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={LUCIDE_MENU_ICONS[name]}
/>
