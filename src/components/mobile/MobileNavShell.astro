---
import DefaultMobileNavSheet from './DefaultMobileNavSheet.astro';

interface Props {
  pathname: string;
  /** True when the page already renders its own data-nav-sheet="page" sheet. */
  hasPageNavSheet?: boolean;
}

const { pathname: _pathname, hasPageNavSheet = false } = Astro.props;
---

<script>
  import { bindDrawerScrollFades } from '../../lib/ui/scrollFade';

  bindDrawerScrollFades();
  document.addEventListener('astro:page-load', () => bindDrawerScrollFades());
</script>

{/* Fallback sheet only — a page that ships its own TOC sheet must not get both. */}
{!hasPageNavSheet && <DefaultMobileNavSheet />}
