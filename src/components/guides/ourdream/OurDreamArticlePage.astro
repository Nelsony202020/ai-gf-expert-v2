---
import Breadcrumbs from '../../ui/Breadcrumbs.astro';
import OurDreamArticleSidebar from './OurDreamArticleSidebar.astro';
import OurDreamArticleMobileJump from './OurDreamArticleMobileJump.astro';
import OurDreamArticleRelated from './OurDreamArticleRelated.astro';
import { cdnAsset } from '../../../lib/media/cdn';
import type { AuthorProfile } from '../../../data/authors';
import { extractOurDreamGuideToc, estimateGuideReadMinutes } from '../../../lib/ourdream-guide-toc';
import GuideVideoBlock from '../GuideVideoBlock.astro';
import { videoLengthLabel, type GuideVideo } from '../../../lib/guides/video';

interface Props {
  title: string;
  /**
   * One-sentence standfirst between the H1 and the byline — the `Description` slot of
   * Figma Article / Header (158:2532). Optional: no article populates it yet, because
   * that is a content decision, not a shell one.
   */
  dek?: string;
  breadcrumbLabel: string;
  bodyHtml: string;
  author: AuthorProfile | undefined;
  published: string;
  publishedShort?: string;
  publishedIso?: string;
  canonical: string;
  currentHref: string;
  hubHref?: string;
  /** Companion video. Absent means no link, no block, nothing. */
  video?: GuideVideo;
}

const {
  title,
  dek,
  breadcrumbLabel,
  bodyHtml,
  author,
  published,
  publishedShort,
  publishedIso,
  canonical,
  currentHref,
  video,
  hubHref = '/guides/ourdream-ai/',
} = Astro.props;

const toc = extractOurDreamGuideToc(bodyHtml);
const readMinutes = estimateGuideReadMinutes(bodyHtml);
const avatarUrl = author?.avatar ? cdnAsset(author.avatar) : undefined;
const dateShort = publishedShort ?? published;
const authorHref = author?.profileUrl ?? (author?.slug ? `/author/${author.slug}/` : undefined);

/**
 * The video block belongs after the opening paragraphs and before the first H2.
 * The body arrives as one raw string, so it is split at the first H2 and the
 * block is rendered between the halves. No H2 (or no video) and the body is
 * emitted whole, exactly as before.
 */
const firstH2 = video ? bodyHtml.search(/<h2[\s>]/i) : -1;
const bodyBeforeVideo = firstH2 > -1 ? bodyHtml.slice(0, firstH2) : bodyHtml;
const bodyAfterVideo = firstH2 > -1 ? bodyHtml.slice(firstH2) : '';
const videoLength = video ? videoLengthLabel(video) : undefined;
---

<div
  class="ourdream-article-page"
  data-ourdream-article
  data-page-url={canonical}
  style={avatarUrl ? `--od-author-avatar: url('${avatarUrl}')` : undefined}
>
  <div class="ourdream-article-layout">
    <div class="ourdream-article-primary">
      <header class="ourdream-article-hero">
        <Breadcrumbs
          items={[
            { label: 'Home', href: '/' },
            { label: 'Guides', href: '/guides/' },
            { label: breadcrumbLabel },
          ]}
        />
        <h1 class="ourdream-article-hero__title">{title}</h1>
        {dek && <p class="ourdream-article-hero__dek">{dek}</p>}
        <div class="ourdream-article-hero__meta">
          {
            avatarUrl &&
            (authorHref ? (
              <a href={authorHref} class="ourdream-article-hero__avatar-link">
                <img
                  src={avatarUrl}
                  alt=""
                  class="ourdream-article-hero__avatar"
                  width="28"
                  height="28"
                  loading="lazy"
                  decoding="async"
                />
              </a>
            ) : (
              <img
                src={avatarUrl}
                alt=""
                class="ourdream-article-hero__avatar"
                width="28"
                height="28"
                loading="lazy"
                decoding="async"
              />
            ))
          }
          <div class="ourdream-article-hero__meta-copy">
            {author &&
              (authorHref ? (
                <a href={authorHref} class="ourdream-article-hero__author">
                  {author.name}
                </a>
              ) : (
                <span class="ourdream-article-hero__author">{author.name}</span>
              ))}
            <span class="ourdream-article-hero__byline">
              <span class="ourdream-article-hero__read--desktop">· {published}</span>
              <span class="ourdream-article-hero__read--mobile">
                · Updated {dateShort} · {readMinutes} min read
              </span>
            </span>
          </div>
        </div>
        {video && (
          <button type="button" class="ourdream-article-hero__video-link" data-video-lightbox-open>
            <span class="ourdream-article-hero__video-caret" aria-hidden="true">&#9656;</span>
            <span>Prefer to watch? {videoLength ? `${videoLength} video guide` : 'video guide'}</span>
          </button>
        )}
        {toc.length > 0 && <OurDreamArticleMobileJump toc={toc} />}
      </header>

      <article class="ourdream-article-main min-w-0">
        {firstH2 > -1 ? (
          <div class="ourdream-article-prose" data-glossary-decorate data-ourdream-prose>
            <Fragment set:html={bodyBeforeVideo} />
            <GuideVideoBlock video={video!} authorSlug={author?.slug} />
            <Fragment set:html={bodyAfterVideo} />
          </div>
        ) : (
          <div class="ourdream-article-prose" data-glossary-decorate data-ourdream-prose set:html={bodyHtml} />
        )}
      </article>

      <OurDreamArticleRelated currentHref={currentHref} hubHref={hubHref} />
    </div>

    {toc.length > 0 && <OurDreamArticleSidebar toc={toc} hubHref={hubHref} />}
  </div>
</div>

<script>
  import '../../test/test-hub-toc.client.ts';
  import './ourdream-article.client.ts';
</script>
