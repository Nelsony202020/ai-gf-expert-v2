---
import type { OurDreamTocSection } from '../../../lib/ourdream-guide-toc';

interface Props {
  toc: OurDreamTocSection[];
}

const { toc } = Astro.props;
---

<details class="ourdream-article-jump" data-ourdream-jump>
  <summary class="ourdream-article-jump__toggle">
    <span>Jump to section</span>
    <span class="material-symbols-outlined ourdream-article-jump__chevron" aria-hidden="true">expand_more</span>
  </summary>
  <nav class="ourdream-article-jump__panel" aria-label="Jump to section">
    <ul class="ourdream-article-jump__list">
      {
        toc.map((section) => (
          <li>
            <a class="ourdream-article-jump__link" href={`#${section.id}`}>
              {section.label}
            </a>
            {
              section.children?.map((child) => (
                <a class="ourdream-article-jump__link ourdream-article-jump__link--child" href={`#${child.id}`}>
                  {child.label}
                </a>
              ))
            }
          </li>
        ))
      }
    </ul>
  </nav>
</details>
