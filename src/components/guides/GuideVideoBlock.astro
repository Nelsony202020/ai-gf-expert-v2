---
import { getAuthor } from '../../data/authors';
import {
  videoLengthLabel,
  youtubeEmbedUrl,
  youtubeThumbnail,
  youtubeThumbnailFallback,
  type GuideVideo,
} from '../../lib/guides/video';

interface Props {
  video: GuideVideo;
  /** Author whose face sits on the badge. */
  authorSlug?: string;
}

const { video, authorSlug } = Astro.props;
const author = authorSlug ? getAuthor(authorSlug) : undefined;
const poster = youtubeThumbnail(video);
const posterFallback = youtubeThumbnailFallback(video);
const length = videoLengthLabel(video);
const embedUrl = youtubeEmbedUrl(video, { autoplay: true });
---

{/*
  A facade, not an embed. Nothing here loads YouTube: it is a poster image and a
  button. On click the button is replaced, in place, by the player — the reader
  never leaves the column and no dialog opens.

  A <div> rather than a <figure>: `.ourdream-article-prose figure` carries its
  own margins, borders and figcaption rules, and this block wants none of them.
*/}
<div class="od-video">
  <button
    type="button"
    class="od-video__trigger"
    data-guide-video
    data-video-embed={embedUrl}
    data-video-title={video.title}
    aria-label={`Play video: ${video.title}`}
  >
    <span class="od-video__frame">
      <img
        class="od-video__poster"
        src={poster}
        alt=""
        width="1280"
        height="720"
        loading="lazy"
        decoding="async"
        data-poster-fallback={posterFallback}
      />
      <span class="od-video__scrim" aria-hidden="true"></span>
      <span class="od-video__play" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none">
          <path d="M8 5.2v13.6L19 12 8 5.2Z" fill="currentColor" />
        </svg>
      </span>
      {author && (
        <img
          class="od-video__avatar"
          src={author.avatar}
          alt=""
          width="44"
          height="44"
          loading="lazy"
          decoding="async"
        />
      )}
      {/* aria-hidden: the caption below already names the video, and a bare
          "5:36" read out on its own tells a screen reader user nothing. */}
      {length && <span class="od-video__duration" aria-hidden="true">{length}</span>}
    </span>
  </button>
  <span class="od-video__title">{video.title}</span>
</div>
