---
import { authors } from '../data/authors';
import { legalPages } from '../data/legal-pages';
import { loadComparisonProducts } from '../lib/content/comparisonProducts';
import { cdnAsset } from '../lib/media/cdn';
import SocialIcon from './ui/SocialIcon.astro';
import ThemeToggle from './ui/ThemeToggle.astro';

const publishedProducts = await loadComparisonProducts();
const herman = authors['herman-carter'];
const year = new Date().getFullYear();

const reviewLinks = [
  { label: 'All Reviews', href: '/reviews/' },
  ...publishedProducts.map((product) => ({
    label: `${product.name} Review`,
    href: `/reviews/${product.slug}/`,
  })),
];

const legalBySlug = Object.fromEntries(legalPages.map((page) => [page.slug, page]));

const columns = [
  {
    title: 'Explore',
    links: [
      { label: 'AI Girlfriend App Directory', href: '/ai-girlfriend-apps/' },
      { label: 'Best AI Girlfriend Apps', href: '/best/ai-girlfriend/' },
      { label: 'Guides', href: '/guides/' },
      { label: 'Comparisons', href: '/best/ai-girlfriend/#roundup-compare' },
    ],
  },
  {
    title: 'Reviews',
    links: reviewLinks,
  },
  {
    title: 'How We Test',
    links: [
      { label: 'Our Methodology', href: '/test/' },
      { label: 'All Testing Categories', href: '/test/all/' },
      { label: 'How Score Tooltips Work', href: '/test/tooltips/' },
      { label: 'Market Data Methodology', href: '/test/market-data/' },
      { label: 'Editorial Guidelines', href: '/editorial-guidelines/' },
    ],
  },
  {
    title: 'Company',
    links: [
      { label: 'About Us', href: '/about/' },
      { label: 'Herman Carter', href: '/author/herman-carter/' },
      { label: 'Contact', href: '/contact/' },
      { label: 'Affiliate Disclosure', href: '/legal/affiliate-disclosure/' },
    ],
  },
  {
    title: 'Legal',
    links: [
      { label: legalBySlug.privacy?.title ?? 'Privacy Policy', href: legalBySlug.privacy?.href ?? '/legal/privacy/' },
      { label: legalBySlug.terms?.title ?? 'Terms of Service', href: legalBySlug.terms?.href ?? '/legal/terms/' },
      { label: legalBySlug.accessibility?.title ?? 'Accessibility', href: legalBySlug.accessibility?.href ?? '/legal/accessibility/' },
      { label: legalBySlug.copyright?.title ?? 'Copyright Policy', href: legalBySlug.copyright?.href ?? '/legal/copyright/' },
      { label: legalBySlug.disclaimer?.title ?? 'Disclaimer', href: legalBySlug.disclaimer?.href ?? '/legal/disclaimer/' },
    ],
  },
];
---

<footer class="site-footer">
  <div class="section-container px-4 md:px-8">
    <div class="site-footer__main">
      <div class="site-footer__brand">
        <a href="/" class="site-logo-link site-footer__logo-link">
          <img
            src={cdnAsset('/brand/ai-gf-logo-light.png')}
            alt="AI Girlfriend Expert"
            class="site-footer__logo site-footer__logo--light"
            width="127"
            height="100"
            loading="lazy"
            decoding="async"
          />
          <img
            src={cdnAsset('/brand/ai-gf-logo-white.png')}
            alt=""
            class="site-footer__logo site-footer__logo--dark"
            width="127"
            height="100"
            loading="lazy"
            decoding="async"
            aria-hidden="true"
          />
        </a>

        <p class="site-footer__tagline">
          Independent AI companion reviews — tested honestly, scored transparently, updated regularly.
        </p>

        <a href="/test/" class="site-footer__method-link">
          See how we test
          <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
        </a>

        {
          herman?.socials?.length ? (
            <div class="site-footer__social-block">
              <p class="site-footer__label">Follow us</p>
              <ul class="site-footer__socials">
                {herman.socials.map((item) => (
                  <li>
                    <a
                      href={item.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="site-footer__social-link"
                      aria-label={item.platform}
                    >
                      <SocialIcon platform={item.icon} class="site-footer__social-icon" />
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ) : null
        }
      </div>

      {
        columns.map((col) => (
          <div class="site-footer__col">
            <p class="site-footer__label">{col.title}</p>
            <ul class="site-footer__links">
              {col.links.map((link) => (
                <li>
                  <a href={link.href}>{link.label}</a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="site-footer__bottom">
      <p class="site-footer__copyright">&copy; {year} Nelson Digital FZ LLC. All rights reserved.</p>
      <ThemeToggle variant="footer" />
    </div>
  </div>
</footer>
