---
import { legalPages } from '../data/legal-pages';
import { BRAND_SOCIAL } from '../data/social-links';
import SocialIcon from './ui/SocialIcon.astro';
import ThemeToggle from './ui/ThemeToggle.astro';

const year = new Date().getFullYear();
const legalBySlug = Object.fromEntries(legalPages.map((page) => [page.slug, page]));

const channels = [
  {
    label: 'AI Girlfriend Expert',
    descriptor: 'Reviews, rankings & app testing',
    href: BRAND_SOCIAL.youtube,
    icon: 'youtube' as const,
  },
  {
    label: 'AI Girlfriend Help Desk',
    descriptor: 'Tutorials, FAQs & how-to guides',
    href: 'https://www.youtube.com/@ai-girlfriend-help-desk?sub_confirmation=1',
    icon: 'youtube' as const,
  },
  {
    label: 'TikTok',
    descriptor: '',
    href: BRAND_SOCIAL.tiktok,
    icon: 'tiktok' as const,
  },
  {
    label: 'Reddit Community',
    descriptor: 'New community coming soon',
    href: '',
    icon: 'reddit' as const,
  },
];

const columns = [
  {
    title: 'Explore',
    links: [
      { label: 'Roundups', href: '/best/ai-girlfriend/' },
      { label: 'Reviews', href: '/reviews/' },
      { label: 'Guides', href: '/guides/' },
      { label: 'AI Girlfriend Apps', href: '/ai-girlfriend-apps/' },
    ],
  },
  {
    title: 'Testing',
    links: [
      { label: 'How We Test', href: '/test/' },
      { label: 'Testing Categories', href: '/test/all/' },
      { label: 'How Scoring Works', href: '/test/tooltips/' },
      { label: 'Market Data Methodology', href: '/test/market-data/' },
    ],
  },
  {
    title: 'Resources',
    links: [
      { label: 'Glossary', href: '/glossary/' },
      { label: 'Site Index', href: '/sitemap/' },
    ],
  },
  {
    title: 'Company',
    links: [
      { label: 'About Us', href: '/about/' },
      { label: 'Herman Carter', href: '/author/herman-carter/' },
      { label: 'Contact', href: '/contact/' },
      { label: 'Editorial Guidelines', href: '/editorial-guidelines/' },
      { label: 'Affiliate Disclosure', href: '/legal/affiliate-disclosure/' },
    ],
  },
];

const legal = [
  { label: legalBySlug.privacy?.title ?? 'Privacy Policy', href: legalBySlug.privacy?.href ?? '/legal/privacy/' },
  { label: legalBySlug.terms?.title ?? 'Terms of Service', href: legalBySlug.terms?.href ?? '/legal/terms/' },
  { label: legalBySlug.accessibility?.title ?? 'Accessibility', href: legalBySlug.accessibility?.href ?? '/legal/accessibility/' },
];
---

<footer class="site-footer" aria-label="Site">
  <div class="site-footer__container section-container px-4 sm:px-6 lg:px-8">
    <div class="site-footer__top">
      <div class="site-footer__brand">
        <a href="/" class="site-logo-link site-footer__logo-link">
          <span class="site-footer__logo" role="img" aria-label="Girlfriend Expert AI"></span>
        </a>
        <p class="site-footer__description">
          Independent AI companion reviews — tested honestly, scored transparently, updated regularly.
        </p>
        <div class="site-footer__channels" aria-label="Channels and community">
          <p class="site-footer__channels-label">Channels &amp; community</p>
          {
            channels.map((channel) =>
              channel.href ? (
                <a
                  class="site-footer__channel"
                  href={channel.href}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <SocialIcon platform={channel.icon} class="site-footer__channel-icon" />
                  <span class="site-footer__channel-copy">
                    <span class="site-footer__channel-title">
                      <span class="site-footer__channel-name">{channel.label}</span>
                      <span class="site-footer__channel-ext" aria-hidden="true">↗</span>
                    </span>
                    {channel.descriptor && <small>{channel.descriptor}</small>}
                  </span>
                </a>
              ) : (
                <div class="site-footer__channel site-footer__channel--muted">
                  <SocialIcon platform={channel.icon} class="site-footer__channel-icon" />
                  <span class="site-footer__channel-copy">
                    <span class="site-footer__channel-title">
                      <span class="site-footer__channel-name">{channel.label}</span>
                    </span>
                    {channel.descriptor && <small>{channel.descriptor}</small>}
                  </span>
                </div>
              )
            )
          }
        </div>
      </div>

      <nav class="site-footer__nav" aria-label="Footer">
        {
          columns.map((col) => (
            <div class="site-footer__col">
              <h4 class="site-footer__col-title">{col.title}</h4>
              <ul class="site-footer__links">
                {col.links.map((link) => (
                  <li>
                    <a href={link.href} class="site-footer__link">
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>
    </div>

    <p class="site-footer__signoff">
      Tested, <span>not hyped.</span>
    </p>

    <div class="site-footer__bottom">
      <p class="site-footer__copyright">&copy; {year} Nelson Digital FZ-LLC. All rights reserved.</p>
      <div class="site-footer__bottom-actions">
        <nav class="site-footer__legal" aria-label="Legal">
          {legal.map((link) => (
            <a href={link.href} class="site-footer__legal-link">{link.label}</a>
          ))}
        </nav>
        <ThemeToggle variant="footer" />
      </div>
    </div>
  </div>
</footer>
