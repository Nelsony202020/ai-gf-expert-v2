---
// NOTE: Site footer — dark brand background, social links, dark mode toggle.
import { authors } from '../data/authors';
import { products } from '../data/products';
import { megaMenuColumns } from '../data/nav-mega-menu';
import { legalPages } from '../data/legal-pages';
import SocialTooltip from './ui/SocialTooltip.astro';
import ThemeToggle from './ui/ThemeToggle.astro';

const herman = authors['herman-carter'];
const year = new Date().getFullYear();

const roundupLinks = megaMenuColumns.find((col) => col.id === 'best-picks')?.links ?? [
  { label: 'Best AI Girlfriend Apps', href: '/best/ai-girlfriend' },
];

const reviewLinks = products.map((product) => ({
  label: `${product.name} Review`,
  href: `/reviews/${product.slug}/`,
}));

const columns = [
  {
    title: 'Roundups',
    links: roundupLinks,
  },
  {
    title: 'Reviews',
    links: reviewLinks,
  },
  {
    title: 'Tools',
    links: [{ label: 'AI Girlfriend App Directory', href: '/ai-girlfriend-apps/' }],
  },
  {
    title: 'Resources',
    links: [
      { label: 'Our Methodology', href: '/test/' },
      { label: 'How Score Tooltips Work', href: '/test/tooltips/' },
    ],
  },
  {
    title: 'Company',
    links: [
      { label: 'About Us', href: '/about/' },
      { label: 'Contact', href: '/contact/' },
    ],
  },
];
---

<footer class="site-footer">
  <div class="site-footer__accent" aria-hidden="true" />

  <div class="section-container px-4 md:px-8 relative z-[1]">
    <div class="site-footer__main">
      <div class="site-footer__brand">
        <a href="/" class="site-logo-link site-footer__logo-link mb-5">
          <img
            src="/brand/ai-gf-logo-light.png"
            alt="AI Girlfriend Expert"
            class="site-footer__logo site-footer__logo--light"
            width="127"
            height="100"
            loading="lazy"
            decoding="async"
          />
          <img
            src="/brand/ai-gf-logo-white.png"
            alt=""
            class="site-footer__logo site-footer__logo--dark"
            width="127"
            height="100"
            loading="lazy"
            decoding="async"
            aria-hidden="true"
          />
        </a>
        <p class="site-footer__tagline">
          Independent AI companion reviews — tested honestly, scored transparently, updated regularly.
        </p>
        {
          herman && (
            <div class="mt-6">
              <p class="site-footer__label">Follow us</p>
              <SocialTooltip items={herman.socials} variant="light" class="site-footer__socials" />
            </div>
          )
        }
      </div>

      {
        columns.map((col) => (
          <div class="site-footer__col">
            <h4 class="site-footer__label">{col.title}</h4>
            <ul class="site-footer__links">
              {col.links.map((link) => (
                <li>
                  <a href={link.href}>{link.label}</a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="site-footer__bottom">
      <p>&copy; {year} Nelson Digital FZ LLC. All rights reserved.</p>
      <div class="site-footer__legal">
        <ThemeToggle variant="footer" />
        {
          legalPages.map((page) => (
            <a href={page.href}>{page.shortLabel ?? page.title}</a>
          ))
        }
        <a href="/sitemap/">Sitemap</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    background: #f4f7ef;
    color: #1a2418;
    padding: 3.5rem 0 2rem;
    overflow: hidden;
    border-top: 1px solid #e2e9dc;
  }

  .site-logo-link.site-footer__logo-link {
    display: grid;
    align-items: center;
    justify-items: start;
    background: transparent;
    box-shadow: none;
    height: 3.5rem;
    max-height: 3.5rem;
    max-width: 12rem;
    overflow: hidden;
  }

  .site-footer__logo {
    grid-area: 1 / 1;
    display: block;
    width: auto;
    max-width: 100%;
    height: 3.5rem;
    max-height: 3.5rem;
    background: transparent;
    box-shadow: none;
    filter: none;
    mix-blend-mode: normal;
    object-fit: contain;
    pointer-events: none;
  }

  .site-footer__logo.site-footer__logo--light {
    opacity: 1;
    visibility: visible;
  }

  .site-footer__logo.site-footer__logo--dark {
    opacity: 0;
    visibility: hidden;
  }

  @media (min-width: 768px) {
    .site-logo-link.site-footer__logo-link {
      height: 4rem;
      max-height: 4rem;
      max-width: 14rem;
    }

    .site-footer__logo {
      height: 4rem;
      max-height: 4rem;
    }
  }

  .site-footer__accent {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, #daf66c, #db2777, #daf66c);
  }

  .site-footer__main {
    display: grid;
    grid-template-columns: 1.2fr repeat(5, minmax(0, 1fr));
    gap: 2rem 1.5rem;
  }

  @media (max-width: 1100px) {
    .site-footer__main {
      grid-template-columns: 1fr 1fr 1fr;
    }

    .site-footer__brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 640px) {
    .site-footer__main {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 520px) {
    .site-footer__main {
      grid-template-columns: 1fr;
    }
  }

  .site-footer__tagline {
    margin: 0;
    max-width: 280px;
    font-size: 0.8125rem;
    line-height: 1.55;
    color: #5a6b52;
  }

  .site-footer__label {
    margin: 0 0 1rem;
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #3d5235;
  }

  .site-footer__links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .site-footer__links a {
    font-size: 0.8125rem;
    font-weight: 500;
    color: #5a6b52;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .site-footer__links a:hover {
    color: #db2777;
  }

  .site-footer__bottom {
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid #dde5d3;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.6875rem;
    color: #5a6b52;
  }

  .site-footer__legal {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
  }

  .site-footer__legal a,
  .theme-toggle--footer {
    color: #5a6b52;
    text-decoration: none;
    font-weight: 600;
    transition: color 0.15s ease;
  }

  .site-footer__legal a:hover,
  .theme-toggle--footer:hover {
    color: #db2777;
  }
</style>

<style is:global>
  [data-theme='dark'] .site-footer__accent {
    background: linear-gradient(90deg, #daf66c, #db2777, #daf66c, #daf66c);
    background-size: 200% 100%;
    animation: footer-accent-slide 10s linear infinite;
  }

  @keyframes footer-accent-slide {
    0% { background-position: 0% 0; }
    100% { background-position: 200% 0; }
  }

  [data-theme='dark'] .site-footer {
    background: #1a2418;
    color: #ececec;
    border-top-color: transparent;
  }

  [data-theme='dark'] .site-footer__logo.site-footer__logo--light {
    opacity: 0;
    visibility: hidden;
  }

  [data-theme='dark'] .site-footer__logo.site-footer__logo--dark {
    opacity: 1;
    visibility: visible;
  }

  [data-theme='dark'] .site-footer__tagline {
    color: #9cab96;
  }

  [data-theme='dark'] .site-footer__label {
    color: #daf66c;
  }

  [data-theme='dark'] .site-footer__links a {
    color: #9cab96;
  }

  [data-theme='dark'] .site-footer__links a:hover {
    color: #fff;
  }

  [data-theme='dark'] .site-footer__bottom {
    border-top-color: rgb(255 255 255 / 10%);
    color: #9cab96;
  }

  [data-theme='dark'] .site-footer__legal a,
  [data-theme='dark'] .theme-toggle--footer {
    color: #9cab96;
  }

  [data-theme='dark'] .site-footer__legal a:hover,
  [data-theme='dark'] .theme-toggle--footer:hover {
    color: #fff;
  }

  [data-theme='dark'] .site-footer__socials.social-tooltip--light .social-tooltip__link {
    background: rgb(255 255 255 / 8%);
    border-color: rgb(255 255 255 / 12%);
  }
</style>
