---
const options = [
  { id: 'skim', label: 'Skim' },
  { id: 'medium', label: 'Medium' },
  { id: 'all-in', label: 'All In' },
];
---

<div class="flex justify-end mb-6" data-detail-level-control>
  <div class="flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-3">
    <span class="text-[11px] font-black uppercase tracking-widest text-on-surface-variant sm:text-right">
      Detail level
    </span>
    <div
      class="inline-flex p-1 rounded-lg border border-surface-variant bg-surface-container-low"
      role="tablist"
      aria-label="Detail level"
    >
      {
        options.map((opt, index) => (
          <button
            type="button"
            role="tab"
            data-detail-level-tab={opt.id}
            aria-selected={index === 0 ? 'true' : 'false'}
            class="detail-level-tab block px-3 py-1.5 text-xs font-bold rounded-md transition-colors text-on-surface-variant hover:text-on-surface"
          >
            {opt.label}
          </button>
        ))
      }
    </div>
  </div>
</div>

<style is:global>
  .detail-level-tab[aria-selected='true'] {
    background: var(--color-brand-lime);
    color: var(--color-on-brand-lime);
    box-shadow: 0 1px 2px rgb(0 0 0 / 8%);
  }

  [data-theme='dark'] .detail-level-tab[aria-selected='true'] {
    background: #db2777;
    color: #fff;
    box-shadow: 0 1px 2px rgb(0 0 0 / 20%);
  }

  [data-ratings-root][data-detail-level='skim'] [data-detail-tier='deep'] {
    display: none !important;
  }

  [data-ratings-root][data-detail-level='skim'] [data-subscore-breakdown] {
    display: none !important;
  }

  [data-ratings-root][data-detail-level='medium'] [data-detail-tier='deep'],
  [data-ratings-root][data-detail-level='medium'] [data-detail-tier='calc'] {
    display: none !important;
  }

  [data-ratings-root][data-detail-level='medium'] [data-subscore-grid] {
    grid-template-columns: 1fr !important;
  }

  [data-ratings-root][data-detail-level='medium'] [data-subscore-list] {
    max-width: 420px;
  }

  [data-ratings-root][data-detail-level='medium'] [data-subscore-grid][data-subscore-open] [data-subscore-breakdown],
  [data-ratings-root][data-detail-level='skim'] [data-subscore-grid][data-subscore-open] [data-subscore-breakdown] {
    display: block !important;
  }

  @media (min-width: 1024px) {
    [data-ratings-root][data-detail-level='medium'] [data-subscore-grid][data-subscore-open],
    [data-ratings-root][data-detail-level='skim'] [data-subscore-grid][data-subscore-open] {
      grid-template-columns: var(--ratings-subscore-nav-width, 300px) minmax(0, 1fr) !important;
    }
  }

  [data-ratings-root][data-detail-level='medium'] .ratings-subscore-nav__item {
    border: none !important;
    box-shadow: none !important;
    background: transparent !important;
  }

  [data-ratings-root][data-detail-level='medium'] .ratings-subscore-nav__item:hover {
    background: var(--color-surface-container-low);
  }

  [data-ratings-root][data-detail-level='medium'] .ratings-subscore-nav__item--active {
    background: rgb(219 39 119 / 6%) !important;
  }

  [data-ratings-root][data-detail-level='all-in'] .ratings-subscore-nav__item--active {
    background: rgb(219 39 119 / 6%);
  }

  [data-ratings-root][data-detail-level='all-in'] .ratings-subscore-nav__item:hover {
    background: var(--color-surface-container-low);
  }

  [data-theme='dark'] [data-ratings-root][data-detail-level='medium'] .ratings-subscore-nav__item:hover {
    background: rgb(255 255 255 / 6%) !important;
  }

  [data-theme='dark'] [data-ratings-root][data-detail-level='medium'] .ratings-subscore-nav__item--active {
    background: rgb(219 39 119 / 12%) !important;
  }

  [data-theme='dark'] [data-ratings-root][data-detail-level='all-in'] .ratings-subscore-nav__item--active {
    background: rgb(219 39 119 / 10%);
  }

  [data-theme='dark'] [data-ratings-root][data-detail-level='all-in'] .ratings-subscore-nav__item:hover {
    background: rgb(255 255 255 / 6%);
  }
</style>

<script>
  type DetailLevel = 'skim' | 'medium' | 'all-in';

  function syncAccordionVisibility(level: DetailLevel) {
    const root = document.querySelector<HTMLElement>('[data-ratings-root]');
    if (!root) return;

    root.querySelectorAll<HTMLElement>('[data-category]').forEach((cat) => {
      const toggle = cat.querySelector<HTMLElement>('[data-accordion-toggle]');
      const content = cat.querySelector<HTMLElement>('[data-accordion-content]');
      if (!toggle || !content) return;

      if (level === 'skim') {
        toggle.setAttribute('aria-expanded', 'false');
        content.classList.add('hidden');
        return;
      }

      toggle.setAttribute('aria-expanded', 'true');
      content.classList.remove('hidden');
    });
  }

  function syncDetailLevelTabs(level: DetailLevel) {
    document.querySelectorAll<HTMLButtonElement>('[data-detail-level-tab]').forEach((tab) => {
      const active = tab.dataset.detailLevelTab === level;
      tab.setAttribute('aria-selected', active ? 'true' : 'false');
    });
  }

  function applyDetailLevel(level: string) {
    const root = document.querySelector<HTMLElement>('[data-ratings-root]');
    if (!root) return;

    const scrollY = window.scrollY;
    const normalized = (level === 'medium' || level === 'all-in' ? level : 'skim') as DetailLevel;
    root.dataset.detailLevel = normalized;

    syncDetailLevelTabs(normalized);
    syncAccordionVisibility(normalized);

    requestAnimationFrame(() => {
      window.scrollTo({ top: scrollY, behavior: 'instant' in window ? 'instant' : 'auto' });
      document.dispatchEvent(new CustomEvent('detail-level-change', { detail: { level: normalized } }));
    });
  }

  function initDetailLevel() {
    const root = document.querySelector<HTMLElement>('[data-ratings-root]');
    if (!root) return;

    const html = document.documentElement;
    if (html.dataset.detailLevelBound !== 'true') {
      html.dataset.detailLevelBound = 'true';

      document.addEventListener('click', (event) => {
        const tab = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-detail-level-tab]');
        if (!tab || !tab.closest('[data-detail-level-control]')) return;
        const level = tab.dataset.detailLevelTab;
        if (level) applyDetailLevel(level);
      });

      document.addEventListener('detail-level-set', ((event: CustomEvent<{ level: string }>) => {
        if (event.detail?.level) applyDetailLevel(event.detail.level);
      }) as EventListener);
    }

    const level = root.dataset.detailLevel || 'skim';
    syncDetailLevelTabs(level as DetailLevel);

    if (root.dataset.detailLevelInitialized !== 'true') {
      root.dataset.detailLevelInitialized = 'true';
      applyDetailLevel(level);
    }
  }

  initDetailLevel();
  document.addEventListener('astro:page-load', initDetailLevel);

  (window as Window & { applyDetailLevel?: (level: string) => void }).applyDetailLevel = applyDetailLevel;
</script>
