---
import { fmtScore } from '../../lib/scores';
import { getDraftScoreChipClass } from '../../lib/draft-ratings/scoreBands';

interface Props {
  score: number | null;
  size?: 'xs' | 'sm' | 'md' | 'lg';
  variant?: 'solid' | 'outline';
  /** @deprecated shape is ignored — chips use rt-score-chip sizing */
  shape?: 'pill' | 'rect' | 'badge';
  class?: string;
}

const { score, size = 'md', variant = 'solid', class: className = '' } = Astro.props;
const chip = getDraftScoreChipClass(score);

/* sm = default chip scale (same as overall tooltip header scores) */
const sizeClass =
  size === 'xs'
    ? 'rt-score-chip--xs'
    : size === 'md'
      ? 'rt-score-chip--md'
      : size === 'lg'
        ? 'rt-score-chip--lg'
        : '';
const variantClass = variant === 'outline' ? 'rt-score-chip--outline' : '';
---

<span class={`rt-score-chip ${variantClass} ${sizeClass} ${chip} ${className}`.trim()}>{fmtScore(score)}</span>
