---
import type { Product } from '../../data/products';
import type { FeaturedIn } from '../../lib/content/store';
import { getAuthor } from '../../data/authors';
import { formatReviewedOn, getReviewProofMeta, getBestFeaturedIn, featuredInHref, featuredInDesktopLabel, featuredInMobileLabel } from '../../lib/review-shell';
import ShareMenu from '../ui/ShareMenu.astro';
import Gallery from './Gallery.astro';
import RatingSidebar from './RatingSidebar.astro';

interface Props {
  product: Product;
  featuredIn?: FeaturedIn[];
}

const { product, featuredIn = [] } = Astro.props;
const author = product.authors[0];
const authorProfile = author?.slug ? getAuthor(author.slug) : undefined;
const authorHref = authorProfile ? `/author/${authorProfile.slug}/` : author?.slug ? `/author/${author.slug}/` : undefined;
const published = formatReviewedOn(product.reviewedDate);
const updated = formatReviewedOn(product.modifiedDate);
const proof = getReviewProofMeta(product);
const featured = getBestFeaturedIn(featuredIn);
---

<header class="rs-hero">
  <nav class="rs-crumb" aria-label="Breadcrumb">
    <a href="/">Home</a>
    <span class="rs-crumb-sep" aria-hidden="true">
      <svg width="5" height="9" viewBox="0 0 5 9" fill="none" aria-hidden="true"><path d="M0 7.5L3.5 4 0 0.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </span>
    <a href="/reviews/">Reviews</a>
    <span class="rs-crumb-sep" aria-hidden="true">
      <svg width="5" height="9" viewBox="0 0 5 9" fill="none" aria-hidden="true"><path d="M0 7.5L3.5 4 0 0.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </span>
    <span class="rs-crumb-current">{product.name}</span>
  </nav>

  <div class="rs-hero-title-row">
    <h1 class="rs-hero-title">{product.name} Review</h1>
    <div class="rs-share-mobile">
      <ShareMenu shareTitle={`${product.name} Review`} variant="title-mobile" />
    </div>
  </div>

  <div class="rs-hero-meta">
    {author && (
      <div class="rs-author">
        {author.avatar && (
          authorHref ? (
            <a href={authorHref} class="rs-author-avatar">
              <img src={author.avatar} alt="" width="28" height="28" />
            </a>
          ) : (
            <span class="rs-author-avatar">
              <img src={author.avatar} alt="" width="28" height="28" />
            </span>
          )
        )}
        {authorHref ? (
          <a href={authorHref} class="rs-author-name">{author.name}</a>
        ) : (
          <span class="rs-author-name">{author.name}</span>
        )}
        {author.verified && (
          <svg class="rs-verified" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M12.5 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0Z" stroke="#db2777" stroke-width="1.5"/>
            <path d="M4.2 6.6 6.1 8.5 9.6 5" stroke="#db2777" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        )}
        {author.role && <span class="rs-author-role">{author.role}</span>}
      </div>
    )}
    {(published || updated) && (
      <>
        <span class="rs-meta-sep" aria-hidden="true"></span>
        <div class="rs-dates">
          <span>
            {published && <>Published {published}</>}
            {published && updated && updated !== published && <> · Updated {updated}</>}
            {product.methodology && <> · {product.methodology}</>}
          </span>
          <button type="button" class="rs-info-btn" data-tooltip-trigger="methodology" aria-label="About our methodology">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><circle cx="7" cy="7" r="5.5" stroke="currentColor" stroke-width="1.5"/><path d="M7 6.2V9.5M7 4.6h.01" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
          </button>
        </div>
      </>
    )}
    <span class="rs-meta-sep rs-share-desktop-sep" aria-hidden="true"></span>
    <div class="rs-share-desktop">
      <ShareMenu shareTitle={`${product.name} Review`} variant="inline" />
    </div>
  </div>

  <div class="rs-hero-media">
    <Gallery product={product} />
    <RatingSidebar product={product} />
  </div>

  {featured && (
    <a class="rs-rank-row" href={featuredInHref(featured)}>
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3.3 5.3v-4h8v4a4 4 0 1 1-8 0Z" stroke="currentColor" stroke-width="1.5"/><path d="M3.3 6H2a2 2 0 0 1-2-2V2.3h3.3" stroke="currentColor" stroke-width="1.5"/></svg>
      <span>{featuredInMobileLabel(featured)}</span>
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M4 2.5 9.5 7 4 11.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </a>
  )}

  <div class="rs-proof">
    <div class="rs-proof-left">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M4 2h7M5 14V5.5h6V14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
      <span>
        <strong>{proof.categoryCount}</strong> categories
        {' · '}
        <strong>{proof.subscoreCount}</strong> subscores
      </span>
    </div>
    {featured && (
      <div class="rs-proof-right">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3.3 5.3v-4h8v4a4 4 0 1 1-8 0Z" stroke="currentColor" stroke-width="1.5"/></svg>
        <span>Also featured in</span>
        <a href={featuredInHref(featured)} class="rs-proof-chip">
          {featuredInDesktopLabel(featured)}
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M3.5 1.5 8 6 3.5 10.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        </a>
      </div>
    )}
  </div>
</header>

<style>
  .rs-hero-title-row {
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }
  .rs-hero-title-row .rs-hero-title {
    flex: 1;
    min-width: 0;
  }
  .rs-share-mobile { display: none; }
  .rs-share-desktop { display: flex; align-items: center; }
  .rs-share-desktop-sep { display: block; }
  @media (max-width: 767px) {
    .rs-share-mobile { display: block; flex-shrink: 0; }
    .rs-share-desktop,
    .rs-share-desktop-sep { display: none; }
  }
</style>
