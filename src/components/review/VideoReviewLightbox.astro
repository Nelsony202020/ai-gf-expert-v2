---
import type { Product } from '../../data/products';
import { getAuthor } from '../../data/authors';
import SocialIcon from '../ui/SocialIcon.astro';

interface Props {
  product: Product;
}

const { product } = Astro.props;
const herman = getAuthor('herman-carter');
const video = product.videoReview;
const hermanAvatar = herman?.avatar || '/brand/herman-main-icon.webp';
---

{video?.embedUrl && (
  <div
    class="video-review-lightbox"
    id="video-review-lightbox"
    hidden
    role="dialog"
    aria-modal="true"
    aria-labelledby="video-review-title"
  >
    <div class="video-review-lightbox__backdrop" data-video-review-close></div>
    <div class="video-review-lightbox__panel">
      <button type="button" class="video-review-lightbox__close" data-video-review-close aria-label="Close video review">
        <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M4 4l8 8M12 4 4 12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
        </svg>
      </button>
      <div class="video-review-lightbox__frame">
        <iframe
          data-video-review-iframe
          title={`${product.name} video review`}
          src="about:blank"
          data-src={video.embedUrl}
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          allowfullscreen
        ></iframe>
      </div>
      <div class="video-review-lightbox__meta">
        <img
          class="video-review-lightbox__avatar"
          src={hermanAvatar}
          alt=""
          width="40"
          height="40"
        />
        <div class="video-review-lightbox__copy">
          <p id="video-review-title">{product.name} video review</p>
          <p class="video-review-lightbox__by">with {herman?.name || 'Herman Carter'}</p>
        </div>
        {video.channelUrl && (
          <a class="video-review-lightbox__yt" href={video.channelUrl} target="_blank" rel="noopener noreferrer">
            <SocialIcon platform="youtube" class="video-review-lightbox__yt-icon" />
            <span>{video.channelLabel || 'Watch on YouTube'}</span>
            <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M4.5 11.5 11.5 4.5M7 4.5h4.5V9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        )}
      </div>
    </div>
  </div>
)}

<script>
  import { lockBodyScroll, unlockBodyScroll } from '../../lib/ui/bodyScrollLock.ts';

  function initVideoReviewLightbox() {
    const lightbox = document.getElementById('video-review-lightbox');
    const iframe = lightbox?.querySelector<HTMLIFrameElement>('[data-video-review-iframe]');
    if (!lightbox || !iframe) return;

    const openers = document.querySelectorAll<HTMLElement>('[data-video-review-open]');
    const closers = lightbox.querySelectorAll('[data-video-review-close]');
    const src = iframe.dataset.src || '';
    let lastFocus: HTMLElement | null = null;

    const close = () => {
      if (lightbox.hidden) return;
      lightbox.hidden = true;
      iframe.src = 'about:blank';
      unlockBodyScroll();
      lastFocus?.focus({ preventScroll: true });
    };

    const open = (trigger: HTMLElement) => {
      lastFocus = trigger;
      if (lightbox.parentElement !== document.body) {
        document.body.appendChild(lightbox);
      }
      lockBodyScroll();
      lightbox.hidden = false;
      iframe.src = src;
      lightbox.querySelector<HTMLElement>('[data-video-review-close]')?.focus({ preventScroll: true });
    };

    openers.forEach((button) => {
      if (button.dataset.bound === 'true') return;
      button.dataset.bound = 'true';
      button.addEventListener('click', (event) => {
        event.stopPropagation();
        event.preventDefault();
        open(button);
      });
    });

    closers.forEach((button) => {
      if (button.dataset.bound === 'true') return;
      button.dataset.bound = 'true';
      button.addEventListener('click', close);
    });

    if (lightbox.dataset.escBound !== 'true') {
      lightbox.dataset.escBound = 'true';
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && !lightbox.hidden) close();
      });
    }
  }

  document.addEventListener('DOMContentLoaded', initVideoReviewLightbox);
  document.addEventListener('astro:page-load', initVideoReviewLightbox);
</script>
