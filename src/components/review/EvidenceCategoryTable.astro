---
import type { DraftEvidenceCategory } from '../../lib/draft-ratings/types';
import { fmtScore } from '../../lib/scores';
import { getFigmaScoreTone } from '../../lib/ratings/figmaScoreTone';

interface Props {
  tableId: string;
  items: DraftEvidenceCategory[];
  hideScores?: boolean;
}

const { tableId, items, hideScores = false } = Astro.props;
---

<div class="evidence-cat-table-wrap">
  <div class="evidence-cat-table" role="table" aria-labelledby={`${tableId}-label`}>
    <p id={`${tableId}-label`} class="evidence-cat-table__sr-only">Evidence categories</p>
    <div class="evidence-cat-table__head" role="row">
      <span role="columnheader" class="evidence-cat-table__score-col">Score</span>
      <span role="columnheader" class="evidence-cat-table__name-col">
        <span class="evidence-cat-table__name-col-full">Evidence category</span>
        <span class="evidence-cat-table__name-col-short">Evidence</span>
      </span>
      <span role="columnheader" class="evidence-cat-table__summary-col">Summary</span>
      <span role="columnheader" class="evidence-cat-table__proof-col">Proof</span>
      <span role="columnheader" class="evidence-cat-table__action-col">
        <span class="evidence-cat-table__sr-only">Details</span>
      </span>
    </div>

    {
      items.map((item) => {
        const displayScore = hideScores ? null : item.score;
        const tone = getFigmaScoreTone(displayScore);
        const summary = item.cardTeaser || item.summary;
        return (
          <button
            type="button"
            class="evidence-cat-table__row"
            role="row"
            data-ratings-open-drawer={item.drawerId}
            aria-haspopup="dialog"
            aria-label={`${item.name}, score ${fmtScore(displayScore)}. Open evidence details.`}
          >
            <span class="evidence-cat-table__score" role="cell">
              <span class={`ratings-figma-chip ratings-figma-chip--${tone}`}>{fmtScore(displayScore)}</span>
            </span>
            <span class="evidence-cat-table__copy" role="cell">
              <span class="evidence-cat-table__name">{item.name}</span>
              <span class="evidence-cat-table__summary">{summary}</span>
            </span>
            <span class="evidence-cat-table__proof" role="cell">
              {item.proofCount > 0 ? (
                <span class="evidence-cat-table__proof-chip" aria-hidden="true">
                  <img src="/icons/ratings/paperclip.svg" width="13" height="13" alt="" />
                  <span class="evidence-cat-table__proof-count">{item.proofCount}</span>
                </span>
              ) : (
                <span class="evidence-cat-table__proof-empty" aria-hidden="true">—</span>
              )}
            </span>
            <span class="evidence-cat-table__action" role="cell" aria-hidden="true">
              Details
              <img src="/icons/ratings/arrow-right.svg" width="13" height="13" alt="" />
            </span>
          </button>
        );
      })
    }
  </div>
</div>
