---
import type { DraftTestingOverview } from '../../lib/draft-ratings/types';

interface Props {
  overview: DraftTestingOverview;
}

const { overview } = Astro.props;
const canDownload = Boolean(overview.testRunId);
const reportHref = `/api/admin/test-runs/${overview.testRunId}/export?format=pdf&type=reader`;
const progressPct =
  overview.totalRequiredEvidence > 0
    ? Math.min(100, (overview.completedEvidence / overview.totalRequiredEvidence) * 100)
    : 0;
---

<section class="draft-cred-card" aria-labelledby="testing-credentials-overview">
  <span class="draft-cred-card__accent" aria-hidden="true"></span>
  <div class="draft-cred-card__inner">
    <div class="draft-cred-card__head">
      <div class="draft-cred-card__head-main">
        <div>
          <p class="draft-cred-card__eyebrow">Testing credentials</p>
          <h3 id="testing-credentials-overview" class="draft-cred-card__title">
            How we tested {overview.productName}
          </h3>
        </div>
      </div>
      {
        canDownload && (
          <a href={reportHref} class="draft-cred-card__download">
            <span class="material-symbols-outlined" aria-hidden="true">download</span>
            Download report
          </a>
        )
      }
    </div>

    <p class="draft-cred-card__lead">{overview.trustStatement}</p>

    <div class="draft-cred-card__metrics" role="list">
      <div class="draft-cred-card__metric draft-cred-card__metric--evidence" role="listitem">
        <p class="draft-cred-card__metric-value tabular-nums">
          {overview.completedEvidence}<span class="draft-cred-card__metric-denom"> / {overview.totalRequiredEvidence}</span>
        </p>
        <p class="draft-cred-card__metric-label">Checks recorded</p>
        <div class="draft-cred-card__progress-row">
          <div
            class="draft-cred-card__progress"
            role="progressbar"
            aria-valuenow={overview.completedEvidence}
            aria-valuemin={0}
            aria-valuemax={overview.totalRequiredEvidence}
            aria-label="Checks"
          >
            <span class="draft-cred-card__progress-fill" style={`width: ${progressPct}%`}></span>
          </div>
          <span class="draft-cred-card__progress-count tabular-nums">
            {overview.completedEvidence} / {overview.totalRequiredEvidence}
          </span>
        </div>
      </div>

      <div class="draft-cred-card__metric-divider" aria-hidden="true"></div>

      <div class="draft-cred-card__metric" role="listitem">
        <p class="draft-cred-card__metric-value tabular-nums">{overview.testGroupsCompleted}</p>
        <p class="draft-cred-card__metric-label">Tests run</p>
      </div>

      <div class="draft-cred-card__metric-divider" aria-hidden="true"></div>

      <div class="draft-cred-card__metric" role="listitem">
        <p class="draft-cred-card__metric-value tabular-nums">{overview.proofAttachments}</p>
        <p class="draft-cred-card__metric-label">Proof files</p>
        <p class="draft-cred-card__metric-sub">Across {overview.testGroupCount} test groups</p>
      </div>

      <div class="draft-cred-card__metric-divider" aria-hidden="true"></div>

      <div class="draft-cred-card__metric" role="listitem">
        <p class="draft-cred-card__metric-value">{overview.lastTested}</p>
        <p class="draft-cred-card__metric-label">Last tested</p>
      </div>
    </div>

    <div class="draft-cred-card__rule" aria-hidden="true"></div>

    {
      overview.coverage.length > 0 && (
        <div class="draft-cred-card__coverage">
          <p class="draft-cred-card__section-label">Testing coverage</p>
          <div class="draft-cred-card__coverage-row">
            {
              overview.coverage.map((item, index) => (
                <>
                  {index > 0 && <div class="draft-cred-card__metric-divider draft-cred-card__metric-divider--coverage" aria-hidden="true"></div>}
                  <div class="draft-cred-card__coverage-cell">
                    <span class="draft-cred-card__dot" aria-hidden="true"></span>
                    <span class="draft-cred-card__coverage-title">{item.label}</span>
                    {item.detail ? (
                      <abbr title={item.detail} class="draft-cred-card__coverage-detail">
                        {item.summary}
                      </abbr>
                    ) : (
                      <span class="draft-cred-card__coverage-detail">{item.summary}</span>
                    )}
                  </div>
                </>
              ))
            }
          </div>
        </div>
      )
    }

    <div class="draft-cred-card__rule" aria-hidden="true"></div>

    <p class="draft-cred-card__meta">{overview.metadataParts.join(' · ')}</p>
  </div>
</section>
