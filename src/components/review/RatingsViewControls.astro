---
import type { Product } from '../../data/products';
import VerdictCategoryIcon from './VerdictCategoryIcon.astro';

interface Props {
  product: Product;
}

const { product } = Astro.props;
const defaultCategory = product.categories[0];
const defaultLabel = defaultCategory
  ? defaultCategory.key === 'pricing'
    ? 'Pricing'
    : defaultCategory.name
  : 'Categories';

const detailOptions = [
  {
    id: 'skim',
    label: 'Skim',
    description: 'Category scores only',
  },
  {
    id: 'medium',
    label: 'Medium',
    description: 'Scores + subscores',
  },
  {
    id: 'all-in',
    label: 'All',
    description: 'Every test & evidence',
  },
] as const;

const categories = product.categories.map((category) => ({
  key: category.key,
  label: category.key === 'pricing' ? 'Pricing' : category.name,
}));
---

<div class="ratings-view-controls" data-ratings-view-controls>
  <div class="ratings-view-field" data-ratings-field="category">
    <div class="ratings-view-field__wrap">
      <button
        type="button"
        class="ratings-view-controls__jump"
        data-category-jump-open
        aria-haspopup="listbox"
        aria-expanded="false"
        aria-label="Jump to category"
        aria-controls="category-jump-menu"
      >
        <span class="ratings-view-controls__jump-prefix">Jump to</span>
        <span class="ratings-view-controls__value" data-category-jump-label>{defaultLabel}</span>
        <img
          class="ratings-view-controls__chevron-img"
          src="/icons/ratings/chevron-down.svg"
          width="14"
          height="14"
          alt=""
        />
      </button>

      <div
        class="ratings-view-menu"
        id="category-jump-menu"
        data-category-jump-menu
        role="listbox"
        aria-label="Jump to category"
        hidden
      >
        {
          categories.map((category, index) => (
            <button
              type="button"
              role="option"
              class:list={['ratings-view-menu__option', index === 0 && 'is-active']}
              data-goto-category={category.key}
              data-category-jump-option={category.key}
              data-category-jump-option-label={category.label}
              aria-selected={index === 0 ? 'true' : 'false'}
            >
              <span class="ratings-view-menu__option-label">{category.label}</span>
              <span class="material-symbols-outlined ratings-view-menu__check" aria-hidden="true">check</span>
            </button>
          ))
        }
      </div>
    </div>
  </div>

  <div class="ratings-view-field" data-ratings-field="detail">
    <div
      class="ratings-detail-seg"
      role="radiogroup"
      aria-label="Detail level"
      data-detail-level-group
    >
      {
        detailOptions.map((opt, index) => (
          <button
            type="button"
            role="radio"
            class:list={['ratings-detail-seg__btn', index === 1 && 'is-active']}
            data-detail-level-option={opt.id}
            aria-checked={index === 1 ? 'true' : 'false'}
            aria-label={`${opt.label}: ${opt.description}`}
          >
            {opt.label}
          </button>
        ))
      }
    </div>
  </div>
</div>

<div
  class="mobile-sheet category-jump-sheet"
  id="category-jump-sheet"
  data-category-jump-sheet
  hidden
  aria-hidden="true"
>
  <button type="button" class="mobile-sheet__backdrop" data-category-jump-close aria-label="Close"></button>
  <div
    class="mobile-sheet__panel"
    role="dialog"
    aria-modal="true"
    aria-labelledby="category-jump-sheet-title"
  >
    <div class="mobile-sheet__handle" aria-hidden="true"></div>
    <header class="mobile-sheet__head">
      <h2 id="category-jump-sheet-title" class="mobile-sheet__title">Jump to category</h2>
      <button type="button" class="mobile-sheet__close" data-category-jump-close aria-label="Close">
        <span class="material-symbols-outlined" aria-hidden="true">close</span>
      </button>
    </header>
    <div class="mobile-sheet__body ratings-view-sheet__body">
      <div class="ratings-view-sheet__list" role="listbox" aria-label="Rating categories">
        {
          categories.map((category, index) => (
            <button
              type="button"
              role="option"
              class:list={['ratings-view-sheet__option', index === 0 && 'is-active']}
              data-goto-category={category.key}
              data-category-jump-option={category.key}
              data-category-jump-option-label={category.label}
              aria-selected={index === 0 ? 'true' : 'false'}
            >
              <span class="ratings-view-sheet__option-icon" aria-hidden="true">
                <VerdictCategoryIcon id={category.key} class="w-5 h-5" />
              </span>
              <span class="ratings-view-sheet__option-copy">
                <span class="ratings-view-sheet__option-label">{category.label}</span>
              </span>
            </button>
          ))
        }
      </div>
    </div>
  </div>
</div>

<script>
  import { closeSheet, openSheet } from '../../lib/ui/bottomSheet.ts';

  function initRatingsViewControls() {
    const root = document.querySelector<HTMLElement>('[data-ratings-view-controls]');
    if (!root || root.dataset.bound === 'true') return;
    root.dataset.bound = 'true';

    const isMobile = () => window.matchMedia('(max-width: 767px)').matches;

    const categoryOpen = root.querySelector<HTMLElement>('[data-category-jump-open]');
    const categoryMenu = document.querySelector<HTMLElement>('[data-category-jump-menu]');
    const categorySheet = document.querySelector<HTMLElement>('[data-category-jump-sheet]');
    const categoryPanel = categorySheet?.querySelector<HTMLElement>('.mobile-sheet__panel');
    const categoryLabel = root.querySelector<HTMLElement>('[data-category-jump-label]');

    let releaseFocus: (() => void) | null = null;
    let openKind: 'category' | null = null;

    function setCategoryActive(key: string, label?: string) {
      if (label && categoryLabel) categoryLabel.textContent = label;
      document.querySelectorAll<HTMLElement>('[data-category-jump-option]').forEach((opt) => {
        const active = opt.dataset.categoryJumpOption === key;
        opt.classList.toggle('is-active', active);
        opt.setAttribute('aria-selected', active ? 'true' : 'false');
      });
    }

    function closeMenus() {
      categoryMenu?.classList.remove('is-open');
      categoryMenu?.setAttribute('hidden', '');
      categoryOpen?.setAttribute('aria-expanded', 'false');
    }

    function closeMobileSheets() {
      if (categorySheet && !categorySheet.hidden) {
        closeSheet(categorySheet, () => {
          releaseFocus?.();
          releaseFocus = null;
        });
      }
      categoryOpen?.setAttribute('aria-expanded', 'false');
    }

    function closeAll() {
      closeMenus();
      closeMobileSheets();
      openKind = null;
    }

    function openDesktopMenu() {
      closeMobileSheets();
      if (openKind === 'category') {
        closeMenus();
        openKind = null;
        return;
      }
      if (!categoryMenu || !categoryOpen) return;
      categoryMenu.hidden = false;
      categoryMenu.classList.add('is-open');
      categoryOpen.setAttribute('aria-expanded', 'true');
      openKind = 'category';
      requestAnimationFrame(() => {
        categoryMenu.querySelector<HTMLElement>('.ratings-view-menu__option.is-active')?.focus();
      });
    }

    function openMobileSheet() {
      closeMenus();
      if (!categorySheet || !categoryPanel || !categoryOpen) return;
      if (openKind === 'category' && !categorySheet.hidden) {
        closeMobileSheets();
        openKind = null;
        return;
      }
      releaseFocus?.();
      releaseFocus = openSheet(categorySheet, categoryPanel, {
        focusSelector: '.ratings-view-sheet__option.is-active',
      });
      categoryOpen.setAttribute('aria-expanded', 'true');
      openKind = 'category';
    }

    categoryOpen?.addEventListener('click', (event) => {
      event.stopPropagation();
      if (isMobile()) openMobileSheet();
      else openDesktopMenu();
    });

    categorySheet?.querySelectorAll('[data-category-jump-close]').forEach((el) => {
      el.addEventListener('click', () => {
        closeMobileSheets();
        openKind = null;
      });
    });

    document.querySelectorAll<HTMLElement>('[data-category-jump-option]').forEach((opt) => {
      opt.addEventListener('click', () => {
        const key = opt.dataset.categoryJumpOption;
        const label = opt.dataset.categoryJumpOptionLabel;
        if (!key) return;
        setCategoryActive(key, label);
        closeAll();
      });
    });

    document.querySelectorAll<HTMLElement>('[data-detail-level-option]').forEach((opt) => {
      opt.addEventListener('click', () => {
        const level = opt.dataset.detailLevelOption;
        if (!level) return;
        document.dispatchEvent(new CustomEvent('detail-level-set', { detail: { level } }));
      });
    });

    if (document.body.dataset.ratingsViewControlsGlobal !== 'true') {
      document.body.dataset.ratingsViewControlsGlobal = 'true';
      document.addEventListener('pointerdown', (event) => {
        const target = event.target;
        if (!(target instanceof Node)) return;
        if (root.contains(target)) return;
        if (categoryMenu?.contains(target)) return;
        if (categorySheet?.contains(target)) return;
        closeMenus();
        openKind = openKind && !isMobile() ? null : openKind;
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') closeAll();
      });
      window.addEventListener('resize', () => {
        closeAll();
      });
    }
  }

  initRatingsViewControls();
  document.addEventListener('astro:page-load', initRatingsViewControls);
</script>
