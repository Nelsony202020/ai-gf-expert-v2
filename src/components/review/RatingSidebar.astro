---
import type { Product } from '../../data/products';
import { affiliateRel } from '../../lib/affiliate/rel';
import { getScoreVisual, fmtScore } from '../../lib/scores';
import { buildReviewRatingsHash } from '../../lib/review/ratingsDeepLink';
import ScorePill from './ScorePill.astro';
import OverallScoreTooltip from './tooltips/OverallScoreTooltip.astro';
import CategoryScoreTooltip from './tooltips/CategoryScoreTooltip.astro';
import InfoIcon from '../ui/InfoIcon.astro';
import CmsField from '../cms/CmsField.astro';

interface Props {
  product: Product;
}

const { product } = Astro.props;
const overall = getScoreVisual(product.overallScore);
const ctaRel = affiliateRel(product.affiliateRel);
---

<div class="border border-surface-variant rounded-xl overflow-hidden shadow-sm sticky top-4">
  <div class={`${overall.bg} p-5 flex items-center gap-4 min-h-[72px]`}>
    <span class="inline-flex items-center justify-center min-w-[3.25rem] text-3xl font-black tabular-nums">{fmtScore(product.overallScore)}</span>
    <span class="text-lg font-bold flex items-center gap-1.5">
      Overall Performance
      <OverallScoreTooltip product={product}>
        <span class="inline-flex text-white/90 hover:text-white">
          <InfoIcon size="xs" />
        </span>
      </OverallScoreTooltip>
    </span>
  </div>
  <div class="bg-surface-container-low px-4 py-2 text-[11px] font-medium border-b border-surface-variant text-on-surface-variant">
    <CmsField field="oneLineVerdict">{product.overallSummary}</CmsField>
  </div>

  <div class="p-4 space-y-3.5">
    {
      product.categories.map((category) => (
        <div class="w-full group">
          <a
            href={`#${buildReviewRatingsHash(category.key)}`}
            class="flex items-center gap-2.5 text-left w-full no-underline"
            data-goto-category={category.key}
          >
            <ScorePill score={category.score} size="sm" class="shrink-0" />
            <span class="font-bold text-on-surface group-hover:text-accent transition-colors truncate">
              {category.name}
            </span>
            <CategoryScoreTooltip category={category}>
              <span class="inline-flex text-tertiary/70 group-hover:text-accent shrink-0">
                <InfoIcon size="xs" />
              </span>
            </CategoryScoreTooltip>
          </a>
        </div>
      ))
    }

    <div class="pt-4 border-t border-surface-variant"></div>

    <div class="pt-2">
      <a
        href={product.affiliateUrl}
        target="_blank"
        rel={ctaRel}
        class="block w-full bg-brand-cta text-center py-4 rounded-xl font-black text-xl hover:opacity-90 transition shadow-lg mb-2"
      >
        Visit {product.name}
      </a>
      <p class="rating-sidebar__cta-note">
        <span class="rating-sidebar__cta-note-inner">
          <span class="material-symbols-outlined rating-sidebar__cta-note-icon" aria-hidden="true">verified_user</span>
          <button
            type="button"
            class="glossary-trigger rating-sidebar__affiliate-trigger"
            data-glossary-trigger
            aria-expanded="false"
            data-glossary-term="Affiliate link"
            data-glossary-definition="A special link that lets us earn a commission if you sign up or buy something through it. You don't pay anything extra."
            data-glossary-cta="Affiliate Disclosure"
            data-glossary-href="/legal/affiliate-disclosure/"
            data-glossary-eyebrow="Disclosure"
            data-glossary-category="pricing"
          >
            Affiliate link
          </button>
          <span aria-hidden="true">·</span>
          <span>Secure site</span>
        </span>
      </p>
    </div>
  </div>
</div>

<style>
  .rating-sidebar__cta-note {
    margin: 0;
    text-align: center;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-tertiary);
  }

  .rating-sidebar__cta-note-inner {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.25rem;
  }

  .rating-sidebar__cta-note-icon {
    font-size: 12px;
  }

  .rating-sidebar__affiliate-trigger {
    font-size: inherit;
    font-weight: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    color: inherit;
    text-underline-offset: 3px;
  }
</style>
