---
import type { DraftSubscore } from '../../../lib/draft-ratings/types';
import DraftScorePill from './DraftScorePill.astro';

interface Props {
  subscore: DraftSubscore;
  categorySlug: string;
  isDefault?: boolean;
}

const { subscore, categorySlug, isDefault = false } = Astro.props;
---

<div
  class="draft-area-panel"
  role="tabpanel"
  id={`subscore-panel-${categorySlug}-${subscore.slug}`}
  aria-labelledby={`subscore-tab-${categorySlug}-${subscore.slug}`}
  data-draft-subscore-panel={subscore.slug}
  data-draft-subscore-panel-category={categorySlug}
  hidden={!isDefault}
>
  <div class="draft-area-panel__title-row">
    <h5 class="draft-area-panel__title">{subscore.name}</h5>
    <DraftScorePill score={subscore.score} size="sm" variant="outline" />
  </div>

  {(subscore.scopeDescription || subscore.explanation) && (
    <div class="draft-area-panel__scope-block">
      <p class="draft-area-panel__scope-label">What this measures</p>
      <p class="draft-area-panel__scope">
        {subscore.scopeDescription ?? subscore.explanation}
      </p>
    </div>
  )}
</div>
