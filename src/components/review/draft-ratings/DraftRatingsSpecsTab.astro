---
import type { DraftRatingsViewModel } from '../../../lib/draft-ratings/types';
import DraftTestingOverview from './DraftTestingOverview.astro';
import DraftCategorySection from './DraftCategorySection.astro';
import DraftTestGroupDrawer from './DraftTestGroupDrawer.astro';
import DraftDetailLevelControl from './DraftDetailLevelControl.astro';
import VerdictCategoryIcon from '../VerdictCategoryIcon.astro';
import './draft-ratings.css';

interface Props {
  model: DraftRatingsViewModel;
  /** When false, skip SSR drawer panels (preview pages use Ratings & Specs drawers instead). */
  includeDrawers?: boolean;
}

const { model, includeDrawers = true } = Astro.props;
const allGroups = model.categories.flatMap((c) => c.subscores.flatMap((s) => s.testGroups));
const allEvidenceCategories = model.categories.flatMap((c) =>
  c.subscores.flatMap((s) => s.evidenceCategories),
);
const defaultCategory = model.categories[0];
---

<section
  class="draft-ratings-root bg-white py-12 md:py-14"
  data-draft-ratings-root
  data-draft-detail-level={model.detailLevelDefault}
  data-draft-active-category={defaultCategory?.slug ?? ''}
>
  <div class="section-container px-4 md:px-8">
    <div class="mb-8 flex flex-wrap items-end justify-between gap-4 md:mb-10">
      <div>
        <div class="mb-2 flex items-center gap-2">
          <span class="rounded-full bg-amber-100 px-2 py-0.5 text-[10px] font-black uppercase tracking-wider text-amber-800">
            Experimental
          </span>
        </div>
        <h2 class="text-3xl font-black tracking-tight text-on-surface md:text-4xl">Draft Ratings &amp; Specs</h2>
        <p class="mt-2 max-w-xl text-sm text-on-surface-variant">
          Tap a category to explore its test results. Each section shows what we tested, what we found, and the proof behind it.
        </p>
      </div>
      <DraftDetailLevelControl defaultLevel={model.detailLevelDefault} />
    </div>

    <DraftTestingOverview overview={model.overview} />

    <div class="draft-category-explorer mt-6">
      <nav
        class="draft-category-icon-nav shrink-0"
        data-draft-category-icon-nav
        aria-label="Rating categories"
      >
        {
          model.categories.map((category, index) => {
            const isDefault = index === 0;
            return (
              <button
                type="button"
                data-draft-nav-category={category.slug}
                aria-selected={isDefault ? 'true' : 'false'}
                aria-label={category.name}
                class:list={[
                  'draft-category-icon-nav__btn',
                  isDefault && 'draft-category-icon-nav__btn--active',
                ]}
              >
                <VerdictCategoryIcon id={category.slug} />
                <span class="draft-category-icon-nav__tip">{category.name}</span>
              </button>
            );
          })
        }
      </nav>

      <div class="draft-category-panels min-w-0" data-draft-categories>
        {
          model.categories.map((category, index) => (
            <div
              data-draft-category-panel={category.slug}
              class={index === 0 ? '' : 'hidden'}
              role="tabpanel"
              aria-label={category.name}
            >
              <DraftCategorySection category={category} />
            </div>
          ))
        }
      </div>
    </div>
  </div>

  {includeDrawers && (
    <DraftTestGroupDrawer groups={allGroups} evidenceCategories={allEvidenceCategories} />
  )}
</section>

<script src="./draft-ratings.client.ts"></script>
