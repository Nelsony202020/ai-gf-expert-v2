---
import type { DraftDetailLevel } from '../../../lib/draft-ratings/types';

interface Props {
  defaultLevel?: DraftDetailLevel;
}

const { defaultLevel = 'summary' } = Astro.props;

const levels: { id: DraftDetailLevel; label: string }[] = [
  { id: 'summary', label: 'Summary' },
  { id: 'detailed', label: 'Detailed results' },
  { id: 'full', label: 'Full evidence' },
];
---

<div class="draft-detail-control" role="radiogroup" aria-label="Detail level">
  {levels.map((level) => (
    <label>
      <input
        type="radio"
        name="draft-detail-level"
        value={level.id}
        checked={level.id === defaultLevel}
        data-draft-detail-input={level.id}
      />
      <span>{level.label}</span>
    </label>
  ))}
</div>

<script>
  function bindDraftDetailControl() {
    const root = document.querySelector<HTMLElement>('[data-draft-ratings-root]');
    if (!root || root.dataset.detailBound === 'true') return;
    root.dataset.detailBound = 'true';

    const inputs = root.querySelectorAll<HTMLInputElement>('[data-draft-detail-input]');
    const apply = (level: string) => {
      root.dataset.draftDetailLevel = level;
      root.dispatchEvent(new CustomEvent('draft-detail-change', { detail: { level } }));
    };

    inputs.forEach((input) => {
      input.addEventListener('change', () => {
        if (input.checked) apply(input.value);
      });
    });

    apply(root.dataset.draftDetailLevel || 'summary');
  }

  bindDraftDetailControl();
  document.addEventListener('astro:page-load', bindDraftDetailControl);
</script>
