---
import type { DraftEvidenceCategory } from '../../../lib/draft-ratings/types';
import DraftScorePill from './DraftScorePill.astro';

interface Props {
  category: DraftEvidenceCategory;
}

const { category } = Astro.props;
---

<article class="draft-evidence-card">
  <div class="draft-evidence-card__header">
    <h5 class="draft-evidence-card__title">{category.name}</h5>
    <DraftScorePill score={category.score} size="sm" variant="outline" />
  </div>

  {category.meaning && (
    <p class="draft-evidence-card__meaning">{category.meaning}</p>
  )}

  {category.cardTeaser && (
    <p class="draft-evidence-card__teaser">{category.cardTeaser}</p>
  )}

  <footer class="draft-evidence-card__footer">
    {category.proofCount > 0 && (
      <span class="draft-evidence-card__proof-count">{category.proofLabel}</span>
    )}
    <button
      type="button"
      class="draft-evidence-card__action"
      data-draft-open-drawer={category.drawerId}
      aria-haspopup="dialog"
    >
      Open full test
      <span class="material-symbols-outlined" aria-hidden="true">chevron_right</span>
    </button>
  </footer>
</article>
