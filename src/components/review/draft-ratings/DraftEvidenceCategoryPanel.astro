---
import type { DraftEvidenceCategory, DraftSubscore } from '../../../lib/draft-ratings/types';
import { fmtScore, getScoreVisual, isScoreCalculated } from '../../../lib/scores';
import ScorePill from '../ScorePill.astro';

interface Props {
  evidenceCategory: DraftEvidenceCategory;
  subscore: DraftSubscore;
  categorySlug: string;
  isDefault?: boolean;
}

const { evidenceCategory, subscore, categorySlug, isDefault = false } = Astro.props;
const scoredCount = evidenceCategory.testResults.filter((m) =>
  isScoreCalculated(m.normalizedScore),
).length;
---

<div
  class="draft-evidence-detail"
  role="region"
  aria-label={`${evidenceCategory.name} evidence details`}
  data-draft-evidence-panel={evidenceCategory.slug}
  data-draft-evidence-panel-subscore={subscore.slug}
  data-draft-evidence-panel-area={categorySlug}
  hidden={!isDefault}
>
  <div class="draft-evidence-detail__header">
    <h5 class="draft-evidence-detail__title">{evidenceCategory.name}</h5>
    <ScorePill score={evidenceCategory.score} size="sm" variant="outline" />
  </div>

  {(evidenceCategory.scopeDescription || subscore.scopeDescription) && (
    <p class="draft-evidence-detail__scope">
      {evidenceCategory.scopeDescription ?? subscore.scopeDescription}
    </p>
  )}

  {evidenceCategory.testResults.length > 0 && (
    <div class="draft-evidence-detail__results">
      <p class="draft-evidence-detail__results-label">Test results</p>
      <div class="draft-evidence-detail__table-wrap">
        <table class="draft-evidence-detail__table">
          <thead>
            <tr>
              <th scope="col">Test result</th>
              <th scope="col" class="draft-evidence-detail__num">Measured value</th>
            </tr>
          </thead>
          <tbody>
            {evidenceCategory.testResults.map((result) => (
              <tr>
                <td>{result.label}</td>
                <td class="draft-evidence-detail__num">{result.value}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="draft-evidence-detail__scores-full" data-draft-detail-tier="full">
        <table class="draft-evidence-detail__table">
          <thead>
            <tr>
              <th scope="col">Test result</th>
              <th scope="col" class="draft-evidence-detail__num">Value</th>
              <th scope="col" class="draft-evidence-detail__num">Evidence score</th>
            </tr>
          </thead>
          <tbody>
            {evidenceCategory.testResults.map((result) => {
              const visual = getScoreVisual(result.normalizedScore);
              return (
                <tr>
                  <td>{result.label}</td>
                  <td class="draft-evidence-detail__num">{result.value}</td>
                  <td class={`draft-evidence-detail__num ${visual.text}`}>
                    {isScoreCalculated(result.normalizedScore)
                      ? fmtScore(result.normalizedScore)
                      : '—'}
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </div>
  )}

  {isScoreCalculated(evidenceCategory.score) && scoredCount > 0 && (
    <p class="draft-evidence-detail__calc">
      These {evidenceCategory.testResults.length} measurement
      {evidenceCategory.testResults.length !== 1 ? 's are' : ' is'} combined using the{' '}
      {evidenceCategory.name} scoring rules to produce a score of{' '}
      <strong>{fmtScore(evidenceCategory.score)}</strong>.
    </p>
  )}

  <footer class="draft-evidence-detail__footer">
    <div class="draft-evidence-detail__meta">
      <span>{evidenceCategory.testResults.length} metrics</span>
      {evidenceCategory.proofLabel && (
        <>
          <span aria-hidden="true">·</span>
          <span>{evidenceCategory.proofLabel}</span>
        </>
      )}
    </div>
    {evidenceCategory.testGroupId && (
      <button
        type="button"
        class="draft-evidence-detail__action"
        data-draft-open-drawer={evidenceCategory.testGroupId}
        aria-haspopup="dialog"
      >
        Open full test
        <span class="material-symbols-outlined" aria-hidden="true">chevron_right</span>
      </button>
    )}
  </footer>
</div>
