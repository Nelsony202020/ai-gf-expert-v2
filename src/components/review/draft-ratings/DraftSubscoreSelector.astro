---
import type { DraftSubscore } from '../../../lib/draft-ratings/types';
import DraftScorePill from './DraftScorePill.astro';

interface Props {
  subscores: DraftSubscore[];
  categorySlug: string;
}

const { subscores, categorySlug } = Astro.props;
---

<div
  class="draft-area-tabs"
  role="tablist"
  aria-label="Areas"
  data-draft-subscore-selector={categorySlug}
>
  {
    subscores.map((sub, index) => (
      <button
        type="button"
        role="tab"
        class:list={[
          'draft-area-tabs__btn',
          index === 0 && 'draft-area-tabs__btn--active',
        ]}
        data-draft-subscore-tab={sub.slug}
        data-draft-subscore-category={categorySlug}
        aria-selected={index === 0 ? 'true' : 'false'}
        tabindex={index === 0 ? 0 : -1}
        id={`subscore-tab-${categorySlug}-${sub.slug}`}
        aria-controls={`subscore-panel-${categorySlug}-${sub.slug}`}
      >
        <span class="draft-area-tabs__name">{sub.name}</span>
        <DraftScorePill score={sub.score} size="sm" class="draft-area-tabs__pill" />
      </button>
    ))
  }
</div>
