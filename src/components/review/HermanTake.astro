---
import type { AuthorProfile } from '../../data/authors';
import CmsField from '../cms/CmsField.astro';

interface Props {
  author: AuthorProfile;
  quote: string;
}

const { author, quote } = Astro.props;
const trimmed = quote.trim();
if (!trimmed) return;
---

<div class="rs-herman">
  <span class="rs-herman-bar" aria-hidden="true"></span>
  <div class="rs-herman-body">
    <div class="rs-herman-head">
      <img class="rs-herman-avatar" src={author.avatar} alt="" width="36" height="36" />
      <div>
        <p class="rs-herman-title">Herman’s take</p>
        <p class="rs-herman-role">{author.name} · Lead reviewer</p>
      </div>
    </div>
    <p class="rs-herman-copy">
      <CmsField path="expertOpinion">{trimmed}</CmsField>
    </p>
  </div>
</div>
