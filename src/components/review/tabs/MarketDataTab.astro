  .md-scatter__dot {
    width: 10px;
    height: 10px;
    border-radius: 999px;
    background: var(--pt-color);
    border: 2px solid #fff;
    box-shadow: 0 1px 4px rgb(0 0 0 / 20%);
    flex-shrink: 0;
  }
  .md-scatter__label {
    font-size: 9px;
    font-weight: 800;
    color: var(--color-on-surface-variant);
    white-space: nowrap;
    background: rgb(255 255 255 / 92%);
    padding: 1px 5px;
    border-radius: 999px;
    border: 1px solid rgb(226 226 226 / 80%);
  }
  .md-scatter__point--highlight .md-scatter__label {
    background: var(--pt-color);
    color: #fff;
    border-color: transparent;
  }
  .md-scatter__point--highlight .md-scatter__dot {
    animation: md-scatter-pulse 1.8s ease-in-out infinite;
  }
  @keyframes md-scatter-pulse {
    0%, 100% {
      box-shadow: 0 0 0 0 rgb(219 39 119 / 40%);
      transform: scale(1);
    }
    50% {
      box-shadow: 0 0 0 7px rgb(219 39 119 / 0%);
      transform: scale(1.2);
    }
  }

  .md-takeaway { display: flex; gap: 12px; align-items: flex-start; }
  .md-takeaway__icon {
    width: 32px; height: 32px; border-radius: 10px; flex-shrink: 0;
    display: flex; align-items: center; justify-content: center;
  }
  .md-takeaway__icon--pink { background: rgb(219 39 119 / 10%); color: #db2777; }
  .md-takeaway__icon--green { background: rgb(34 197 94 / 10%); color: #16a34a; }
  .md-takeaway__icon--blue { background: rgb(59 130 246 / 10%); color: #2563eb; }
  .md-takeaway__icon--amber { background: rgb(245 158 11 / 10%); color: #d97706; }
  .md-takeaway__icon--purple { background: rgb(168 85 247 / 10%); color: #9333ea; }
</style>

<script>
  const CHART_W = 360;
  const CHART_H = 140;

  function seriesPoints(values: number[]) {
    if (values.length < 2) return [];
    const step = CHART_W / (values.length - 1);
    return values.map((v, i) => {
      const clamped = Math.min(100, Math.max(0, v));
      return { x: i * step, y: CHART_H - (clamped / 100) * CHART_H, value: clamped };
    });
  }

  function trendPointsJs(values: number[]) {
    return seriesPoints(values).map((p) => `${p.x},${p.y}`).join(' ');
  }

  document.querySelectorAll('[data-md-trend-chart]').forEach((root) => {
    const payloadRaw = root.getAttribute('data-md-trend-payload');
    const rangeSelect = root.closest('.md-panel')?.querySelector<HTMLSelectElement>('[data-md-trend-range]');
    const svg = root.querySelector<SVGSVGElement>('[data-md-trend-svg]');
    const monthsEl = root.querySelector<HTMLElement>('[data-md-trend-months]');
    const wrap = root.querySelector<HTMLElement>('[data-md-trend-wrap]');
    const tooltip = root.querySelector<HTMLElement>('[data-md-trend-tooltip]');
    const tooltipMonth = root.querySelector<HTMLElement>('[data-md-trend-tooltip-month]');
    const tooltipRows = root.querySelector<HTMLElement>('[data-md-trend-tooltip-rows]');
    const crosshair = svg?.querySelector<SVGGElement>('[data-md-trend-crosshair]');
    const vline = svg?.querySelector<SVGLineElement>('[data-md-trend-vline]');
    const dotsGroup = svg?.querySelector<SVGGElement>('[data-md-trend-dots]');
    if (!payloadRaw || !svg || !monthsEl || !wrap || !tooltip || !tooltipMonth || !tooltipRows || !crosshair || !vline || !dotsGroup) return;

    const payload = JSON.parse(payloadRaw) as {
      months12: string[];
      months24: string[];
      lines12: Array<{ name: string; color: string; values: number[]; highlight?: boolean }>;
      lines24: Array<{ name: string; color: string; values: number[]; highlight?: boolean }>;
    };

    function activeData() {
      const is24 = rangeSelect?.value === '24';
      return {
        months: is24 ? payload.months24 : payload.months12,
        lines: is24 ? payload.lines24 : payload.lines12,
      };
    }

    function renderRange() {
      const { months, lines } = activeData();
      const gridLines = svg.querySelectorAll('line:not([data-md-trend-vline])');
      gridLines.forEach((el) => el.remove());
      svg.querySelectorAll('polyline[data-md-trend-line]').forEach((el) => el.remove());

      for (let pct = 0; pct <= 100; pct += 25) {
        const line = document.createElementNS('http://www.w3.org/2000/svg', 'line');
        line.setAttribute('x1', '0');
        line.setAttribute('y1', String((CHART_H * pct) / 100));
        line.setAttribute('x2', String(CHART_W));
        line.setAttribute('y2', String((CHART_H * pct) / 100));
        line.setAttribute('stroke', '#ececec');
        line.setAttribute('stroke-width', '1');
        svg.insertBefore(line, crosshair);
      }

      lines.forEach((series) => {
        const poly = document.createElementNS('http://www.w3.org/2000/svg', 'polyline');
        poly.setAttribute('fill', 'none');
        poly.setAttribute('stroke', series.color);
        poly.setAttribute('stroke-width', series.highlight ? '3' : '2.5');
        poly.setAttribute('points', trendPointsJs(series.values));
        poly.dataset.mdTrendLine = series.name;
        svg.insertBefore(poly, crosshair);
      });

      monthsEl.innerHTML = months.map((m) => `<span>${m}</span>`).join('');
      monthsEl.style.gridTemplateColumns = `repeat(${months.length}, 1fr)`;
      crosshair.setAttribute('style', 'display:none');
    }

    function showHover(clientX: number, clientY: number) {
      const rect = svg.getBoundingClientRect();
      const x = ((clientX - rect.left) / rect.width) * CHART_W;
      const { months, lines } = activeData();
      if (lines.length === 0 || months.length < 2) return;

      const step = CHART_W / (months.length - 1);
      const idx = Math.max(0, Math.min(months.length - 1, Math.round(x / step)));
      const snapX = idx * step;

      crosshair.setAttribute('style', 'display:block');
      vline.setAttribute('x1', String(snapX));
      vline.setAttribute('x2', String(snapX));
      vline.setAttribute('y1', '0');
      vline.setAttribute('y2', String(CHART_H));

      dotsGroup.innerHTML = '';
      const rowsHtml: string[] = [];

      lines.forEach((series) => {
        const pt = seriesPoints(series.values)[idx];
        if (!pt) return;
        const circle = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
        circle.setAttribute('cx', String(pt.x));
        circle.setAttribute('cy', String(pt.y));
        circle.setAttribute('r', series.highlight ? '5' : '4');
        circle.setAttribute('fill', series.color);
        circle.setAttribute('stroke', '#fff');
        circle.setAttribute('stroke-width', '2');
        dotsGroup.appendChild(circle);

        rowsHtml.push(`
          <div class="md-line-chart__tooltip-row">
            <span class="md-line-chart__tooltip-swatch" style="background:${series.color}"></span>
            <span class="md-line-chart__tooltip-label">${series.name}</span>
            <span class="md-line-chart__tooltip-value">${pt.value}/100</span>
          </div>
        `);
      });

      tooltipMonth.textContent = months[idx] ?? '';
      tooltipRows.innerHTML = rowsHtml.join('');
      tooltip.classList.remove('md-line-chart__tooltip--hidden');

      const wrapRect = wrap.getBoundingClientRect();
      const left = ((snapX / CHART_W) * rect.width) + (rect.left - wrapRect.left);
      tooltip.style.left = `${Math.min(Math.max(left, 80), wrapRect.width - 80)}px`;
      tooltip.style.top = `${clientY - wrapRect.top}px`;
    }

    function hideHover() {
      tooltip.classList.add('md-line-chart__tooltip--hidden');
      crosshair.setAttribute('style', 'display:none');
    }

    renderRange();
    rangeSelect?.addEventListener('change', () => {
      renderRange();
      hideHover();
    });

    wrap.addEventListener('mousemove', (event) => showHover(event.clientX, event.clientY));
    wrap.addEventListener('mouseleave', hideHover);
  });

  document.querySelectorAll('[data-md-price-bar]').forEach((col) => {
    const tip = col.querySelector('.md-price-chart__hover-tip');
    const label = col.getAttribute('data-md-price-label') ?? '';
    const value = col.getAttribute('data-md-price-value') ?? '';
    if (tip) tip.textContent = `${label} · ${value}`;
  });
</script>
