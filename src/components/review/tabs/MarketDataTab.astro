  .md-scatter__grid {
    position: relative; height: 240px;
    border-left: 1px solid var(--color-surface-variant);
    border-bottom: 1px solid var(--color-surface-variant);
    background:
      linear-gradient(to right, transparent 49.5%, rgb(226 226 226 / 80%) 49.5%, rgb(226 226 226 / 80%) 50.5%, transparent 50.5%),
      linear-gradient(to top, transparent 49.5%, rgb(226 226 226 / 80%) 49.5%, rgb(226 226 226 / 80%) 50.5%, transparent 50.5%);
