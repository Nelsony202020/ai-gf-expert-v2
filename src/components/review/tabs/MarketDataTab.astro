---
import type { Product } from '../../../data/products';
import { getAuthor } from '../../../data/authors';
import VerifiedCheck from '../../ui/VerifiedCheck.astro';
import InfoIcon from '../../ui/InfoIcon.astro';
import BrandIcon from '../../ui/BrandIcon.astro';
import { brandIcons } from '../../../lib/brand-icons';
import InlineHelpTooltip from '../tooltips/InlineHelpTooltip.astro';
import { loadMarketDataViewModel } from '../../../lib/market-data/loadMarketData';
import { unwrapPrice } from '../../../lib/market-data/aura-ai-draft';
import { faviconUrl } from '../../../lib/alternatives/ahrefs';
import { resolveReviewDomain } from '../../../lib/market-data/review-peers';
import {
  formatGrowth,
  formatInterest,
  formatPrice,
  formatRank,
  formatRankSub,
  formatMarketRankCell,
  formatUnavailable,
} from '../../../lib/market-data/format';

interface Props {
  product: Product;
}

const { product } = Astro.props;
const vm = await loadMarketDataViewModel(product);
const herman = getAuthor('herman-carter');

const categoryAvgPrice = vm.categoryAvgPrice.status === 'ok' ? vm.categoryAvgPrice.value : null;
const productPrice = vm.productPrice.status === 'ok' ? vm.productPrice.value : null;
const priceSavingsPct =
  categoryAvgPrice != null && productPrice != null && categoryAvgPrice > 0
    ? Math.round(((categoryAvgPrice - productPrice) / categoryAvgPrice) * 100)
    : null;

function interestSub(interest: typeof vm.searchInterest): string {
  if (interest.status === 'unavailable') return '';
  if (interest.value >= 75) return 'High';
  if (interest.value >= 50) return 'Moderate';
  return 'Lower';
}

const metrics = [
  {
    label: 'Search interest',
    value: formatInterest(vm.searchInterest),
    sub: interestSub(vm.searchInterest),
    icon: 'trending_up',
    tone: 'pink',
    muted: vm.searchInterest.status === 'unavailable',
  },
  {
    label: '12-month growth',
    value: formatGrowth(vm.growth12m),
    sub: vm.growth12m.status === 'ok' ? 'vs. previous 12 months' : '',
    icon: 'schedule',
    tone: 'green',
    muted: vm.growth12m.status === 'unavailable',
  },
  {
    label: 'Market rank',
    value: formatRank(vm.marketRank, vm.totalTracked),
    sub: formatRankSub(vm.marketRank, vm.totalTracked),
    icon: 'emoji_events',
    tone: 'amber',
    muted: vm.marketRank.status === 'unavailable',
  },
  {
    label: 'Monthly price',
    value: vm.productPrice.status === 'ok' ? formatPrice(vm.productPrice) : product.overview.highlights.startingPrice,
    sub:
      categoryAvgPrice != null
        ? `vs. category avg $${categoryAvgPrice.toFixed(2)}`
        : '',
    icon: 'sell',
    tone: 'pink',
    muted: vm.productPrice.status === 'unavailable',
  },
  {
    label: 'Value rank',
    value: vm.valueRank.status === 'ok' ? `#${vm.valueRank.value}` : formatUnavailable(),
    sub: vm.valueRank.status === 'ok' ? 'Among tracked competitors' : '',
    icon: 'star',
    tone: 'green',
    muted: vm.valueRank.status === 'unavailable',
  },
  {
    label: 'Category position',
    value: vm.categoryPositionLabel.status === 'ok' ? vm.categoryPositionLabel.value : formatUnavailable(),
    sub: vm.categoryPositionLabel.status === 'ok' ? 'Overall market presence' : '',
    icon: 'visibility',
    tone: 'purple',
    muted: vm.categoryPositionLabel.status === 'unavailable',
  },
];

const rankList = vm.rankList;
const rankMaxInterest = Math.max(
  ...rankList.map((item) => (item.interest.status === 'ok' ? item.interest.value : 0)),
  1,
);
const marketComparison = vm.marketComparison.map((c) => ({
  ...c,
  iconUrl:
    c.highlight && product.logo
      ? product.logo
      : c.slug
        ? faviconUrl(resolveReviewDomain(c.slug) ?? '')
        : null,
}));
const trendMonths = vm.trendMonths;
const trendSeries = vm.trendSeries;
const trendMonths24 = vm.trendMonths24;
const trendSeries24 = vm.trendSeries24;

const chartLines12 = [
  { name: product.name, color: '#db2777', values: trendSeries.product, highlight: true },
  ...trendSeries.peers.map((p) => ({ name: p.name, color: p.color, values: p.values })),
];
const chartLines24 = [
  { name: product.name, color: '#db2777', values: trendSeries24.product, highlight: true },
  ...trendSeries24.peers.map((p) => ({ name: p.name, color: p.color, values: p.values })),
];
const chartPayload = JSON.stringify({
  months12: trendMonths,
  months24: trendMonths24,
  lines12: chartLines12,
  lines24: chartLines24,
});

const priceBars = vm.priceBars.map((bar) => ({
  ...bar,
  priceNum: unwrapPrice(bar.price),
}));
const maxPrice = Math.max(22, ...priceBars.map((b) => b.priceNum).filter((n) => n > 0));
const chartBarMaxPx = 160;
const avgLinePx =
  categoryAvgPrice != null ? Math.round((categoryAvgPrice / maxPrice) * chartBarMaxPx) : 0;

const scatterPoints = vm.scatterPoints.map((pt) => ({
  ...pt,
  priceNum: unwrapPrice(pt.price),
  scoreNum: pt.score.status === 'ok' ? pt.score.value : null,
}));
const scatterMaxPrice = 22;
const scatterMinScore = 7;
const scatterMaxScore = 10;

const trendMin = 0;
const trendMax = 100;
const hasTrendData =
  trendSeries.product.length >= 2 ||
  trendSeries.peers.some((p) => p.values.length >= 2);

function trendPoints(values: number[]) {
  const width = 360;
  const height = 140;
  if (values.length < 2) return '';
  const step = width / (values.length - 1);
  return values
    .map((v, i) => {
      const x = i * step;
      const clamped = Math.min(trendMax, Math.max(trendMin, v));
      const y = height - ((clamped - trendMin) / (trendMax - trendMin)) * height;
      return `${x},${y}`;
    })
    .join(' ');
}

const takeaways = vm.takeaways;
---

<section class="py-12 md:py-14 bg-background dark-section">
  <div class="section-container px-4 md:px-8">
    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-2 mb-8">
      <h2 class="text-3xl md:text-4xl font-black text-on-surface">Market Data</h2>
      <p class="text-xs font-semibold text-tertiary">
        Updated {vm.updatedLabel}
        {vm.isDraft && <span class="ml-1 text-amber-700 dark:text-amber-300">(draft test data)</span>}
      </p>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-3 xl:grid-cols-6 gap-3 md:gap-4 mb-10">
      {
        metrics.map((m) => (
          <div class="md-metric-card">
            <div class={`md-metric-card__icon md-metric-card__icon--${m.tone}`}>
              <span class="material-symbols-outlined text-[18px]">{m.icon}</span>
            </div>
            <p class="md-metric-card__label">{m.label}</p>
            <p class={`md-metric-card__value ${m.muted ? 'md-metric-card__value--muted' : ''}`}>{m.value}</p>
            <p class="md-metric-card__sub">{m.sub}</p>
          </div>
        ))
      }
    </div>

    <div class="grid grid-cols-1 xl:grid-cols-[minmax(0,1.35fr)_minmax(300px,0.65fr)] gap-6 mb-10">
      <div class="md-panel">
        <div class="flex items-center justify-between gap-3 mb-4">
          <div class="flex items-center gap-1.5">
            <h3 class="text-lg font-black text-on-surface">Search Interest Over Time</h3>
            <InlineHelpTooltip
              id={`md-trends-${product.slug}`}
              title="Ahrefs search data"
              label="About search interest"
              text="Search interest index from Ahrefs organic traffic for each reviewed product in our database. Hover the chart to compare all products at a given month."
            >
              <InfoIcon size="xs" class="text-tertiary hover:text-accent" />
            </InlineHelpTooltip>
          </div>
          <select class="md-select" aria-label="Time range" data-md-trend-range>
            <option value="12">12 months</option>
            <option value="24">24 months</option>
          </select>
        </div>
        <div class="md-line-chart" data-md-trend-chart data-md-trend-payload={chartPayload}>
          {
            hasTrendData ? (
              <>
                <div class="md-line-chart__wrap" data-md-trend-wrap>
                  <svg viewBox="0 0 360 140" class="md-line-chart__svg" preserveAspectRatio="none" aria-hidden="true" data-md-trend-svg>
                    {[0, 25, 50, 75, 100].map((pct) => (
                      <line x1="0" y1={(140 * pct) / 100} x2="360" y2={(140 * pct) / 100} stroke="#ececec" stroke-width="1" />
                    ))}
                    <g data-md-trend-crosshair class="md-line-chart__crosshair" style="display:none">
                      <line x1="0" y1="0" x2="0" y2="140" stroke="#94a3b8" stroke-width="1" stroke-dasharray="4 3" data-md-trend-vline />
                      <g data-md-trend-dots />
                    </g>
                    {
                      trendSeries.peers.map((peer) => (
                        <polyline fill="none" stroke={peer.color} stroke-width="2.5" points={trendPoints(peer.values)} data-md-trend-line={peer.name} />
                      ))
                    }
                    <polyline fill="none" stroke="#db2777" stroke-width="3" points={trendPoints(trendSeries.product)} data-md-trend-line={product.name} />
                  </svg>
                  <div class="md-line-chart__tooltip md-line-chart__tooltip--hidden" data-md-trend-tooltip aria-hidden="true">
                    <div class="md-line-chart__tooltip-month" data-md-trend-tooltip-month />
                    <div class="md-line-chart__tooltip-rows" data-md-trend-tooltip-rows />
                  </div>
                  <div class="md-line-chart__ylabels" aria-hidden="true">
                    <span>100</span>
                    <span>75</span>
                    <span>50</span>
                  </div>
                </div>
                <div class="md-line-chart__months" aria-hidden="true" data-md-trend-months>
                  {trendMonths.map((m) => <span>{m}</span>)}
                </div>
              </>
            ) : (
              <p class="text-sm text-tertiary py-8 text-center">Not enough data</p>
            )
          }
        </div>
        <div class="flex flex-wrap gap-3 mt-3 text-xs font-semibold text-on-surface-variant">
          <span class="inline-flex items-center gap-1.5"><span class="w-4 h-0.5 bg-accent rounded" /> {product.name}</span>
          {
            trendSeries.peers.map((peer) => (
              <span class="inline-flex items-center gap-1.5">
                <span class="w-4 h-0.5 rounded" style={`background:${peer.color}`} /> {peer.name}
              </span>
            ))
          }
        </div>
      </div>

      <div class="md-panel">
        <div class="flex items-center gap-1.5 mb-1">
          <h3 class="text-lg font-black text-on-surface">Market Rank</h3>
          <InlineHelpTooltip
            id={`md-rank-${product.slug}`}
            title="Market rank"
            label="About market rank"
            text="Ranked by Ahrefs search interest index (0–100) among AI companion apps we have reviewed. Higher = more relative organic search demand."
          >
            <InfoIcon size="xs" class="text-tertiary hover:text-accent" />
          </InlineHelpTooltip>
        </div>
        <p class="text-xs text-tertiary mb-4">vs. AI companion apps</p>
        <ol class="space-y-3">
          {
            rankList.length > 0 ? rankList.map((item, i) => (
              <li class="md-rank-row">
                <span class="md-rank-row__pos">
                  {
                    item.medal === 'gold' ? '🥇' :
                    item.medal === 'silver' ? '🥈' :
                    item.medal === 'bronze' ? '🥉' :
                    <span class="text-tertiary tabular-nums">{i + 1}</span>
                  }
                </span>
                <div class="md-rank-row__body min-w-0">
                  <div class="flex items-center justify-between gap-2 mb-1">
                    <span class={`text-sm font-bold truncate ${item.highlight ? 'text-accent' : 'text-on-surface'}`}>{item.name}</span>
                    <span class="text-xs font-black tabular-nums text-on-surface-variant shrink-0">
                      {item.interest.status === 'ok' ? item.interest.value : formatUnavailable()}
                    </span>
                  </div>
                  {
                    item.interest.status === 'ok' && (
                      <div class="md-rank-row__track h-2 rounded-full bg-surface-container overflow-hidden">
                        <div
                          class={`h-full rounded-full ${item.highlight ? 'bg-accent' : 'bg-tertiary/35'}`}
                          style={`width: ${Math.round((item.interest.value / rankMaxInterest) * 100)}%`}
                        />
                      </div>
                    )
                  }
                </div>
              </li>
            )) : (
              <li class="text-sm text-tertiary">Not enough data</li>
            )
          }
        </ol>
      </div>
    </div>

    <div class="md-panel mb-10 overflow-hidden p-0">
      <div class="p-5 border-b border-surface-variant">
        <h3 class="text-lg font-black text-on-surface">Market Comparison</h3>
        <p class="text-xs text-tertiary mt-1">Market metrics only — search interest, growth, and rank.</p>
      </div>
      <div class="overflow-x-auto">
        <table class="md-comp-table w-full min-w-[520px] text-sm">
          <thead>
            <tr class="text-left text-[11px] uppercase tracking-wide text-tertiary border-b border-surface-variant">
              <th class="p-3">Product</th>
              <th class="p-3">Search interest</th>
              <th class="p-3">12M growth</th>
              <th class="p-3">Market rank</th>
            </tr>
          </thead>
          <tbody>
            {
              marketComparison.length > 0 ? marketComparison.map((c) => (
                <tr class={`md-comp-table__row border-b border-surface-variant/60 ${c.highlight ? 'md-comp-table__highlight bg-accent/[0.04]' : ''}`}>
                  <td class="p-3">
                    <div class="md-comp-table__product">
                      {
                        c.iconUrl && (
                          <img src={c.iconUrl} alt="" width="24" height="24" class="md-comp-table__icon" loading="lazy" />
                        )
                      }
                      <span class={`font-bold ${c.highlight ? 'text-accent' : 'text-on-surface'}`}>{c.name}</span>
                    </div>
                  </td>
                  <td class="p-3 tabular-nums">{formatInterest(c.interest)}</td>
                  <td class="p-3">
                    {
                      c.growth.status === 'ok' ? (
                        <span class={`md-growth ${c.growth.value >= 0 ? 'md-growth--up' : 'md-growth--down'}`}>
                          {c.growth.value >= 0 ? '+' : ''}{c.growth.value}%
                        </span>
                      ) : (
                        <span class="text-tertiary">{formatUnavailable()}</span>
                      )
                    }
                  </td>
                  <td class="p-3 tabular-nums">{formatMarketRankCell(c.marketRank)}</td>
                </tr>
              )) : (
                <tr>
                  <td colspan="4" class="p-6 text-center text-sm text-tertiary">Not enough data</td>
                </tr>
              )
            }
          </tbody>
        </table>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-10">
      <div class="md-panel">
        <div class="flex items-center gap-1.5 mb-4">
          <h3 class="text-lg font-black text-on-surface">Price Position</h3>
          <InlineHelpTooltip
            id={`md-price-${product.slug}`}
            title="Price position"
            label="About price position"
            text="Compares monthly subscription price against competitors and our tracked category average."
          >
            <InfoIcon size="xs" class="text-tertiary hover:text-accent" />
          </InlineHelpTooltip>
        </div>
        <div class="md-price-chart">
          <div class="md-price-chart__y-label">Price ($)</div>
          <div class="md-price-chart__bars">
            {
              priceBars.map((bar) => (
                <div
                  class="md-price-chart__col"
                  tabindex="0"
                  data-md-price-bar
                  data-md-price-label={bar.label}
                  data-md-price-value={bar.price.status === 'ok' ? `$${bar.priceNum.toFixed(2)}/mo` : 'N/A'}
                >
                  <span class="md-price-chart__val">
                    {bar.price.status === 'ok' ? `$${bar.priceNum.toFixed(2)}` : formatUnavailable()}
                  </span>
                  {
                    bar.priceNum > 0 && (
                      <div
                        class={`md-price-chart__bar ${bar.highlight ? 'md-price-chart__bar--highlight' : ''}`}
                        style={`height: ${Math.round((bar.priceNum / maxPrice) * chartBarMaxPx)}px; background: ${bar.color};`}
                      />
                    )
                  }
                  <span class={`md-price-chart__name ${bar.highlight ? 'text-accent font-bold' : ''}`}>{bar.label}</span>
                  <div class="md-price-chart__hover-tip" aria-hidden="true">
                    {bar.label} · {bar.price.status === 'ok' ? `$${bar.priceNum.toFixed(2)}/mo` : 'N/A'}
                  </div>
                </div>
              ))
            }
            {
              categoryAvgPrice != null && (
                <div class="md-price-chart__avg-line" style={`bottom: ${avgLinePx}px`} aria-hidden="true" />
              )
            }
          </div>
          {
            categoryAvgPrice != null && (
              <p class="md-price-chart__avg-legend">
                <span class="md-price-chart__avg-legend-line" aria-hidden="true" />
                Category average: <strong>${categoryAvgPrice.toFixed(2)}/mo</strong>
              </p>
            )
          }
        </div>
        {
          priceSavingsPct != null && productPrice != null && (
            <div class="md-price-callout mt-4">
              <p class="text-xs font-bold text-tertiary uppercase tracking-wide">{product.name} vs. Category Avg</p>
              <p class="text-lg font-black text-green-700">{priceSavingsPct > 0 ? `−${priceSavingsPct}%` : `+${Math.abs(priceSavingsPct)}%`}</p>
              <p class="text-sm font-semibold text-green-800">{priceSavingsPct > 0 ? 'More affordable' : 'Above category average'}</p>
            </div>
          )
        }
      </div>

      <div class="md-panel">
        <div class="flex items-center gap-1.5 mb-4">
          <h3 class="text-lg font-black text-on-surface">Value for Money</h3>
          <InlineHelpTooltip
            id={`md-value-${product.slug}`}
            title="Value for money"
            label="About value chart"
            text="Plots overall performance score against monthly price. Top-left quadrant = high score, lower price (best value)."
          >
            <InfoIcon size="xs" class="text-tertiary hover:text-accent" />
          </InlineHelpTooltip>
        </div>
        <p class="text-xs text-tertiary mb-2">Score vs. Price</p>
        <div class="md-scatter">
          <span class="md-scatter__ylabel">Overall Score ↑</span>
          <span class="md-scatter__xlabel">Monthly Price →</span>
          <div class="md-scatter__grid">
            <span class="md-scatter__quad md-scatter__quad--tl">Best Value</span>
            <span class="md-scatter__quad md-scatter__quad--tr">Premium</span>
            <span class="md-scatter__quad md-scatter__quad--bl">Budget</span>
            <span class="md-scatter__quad md-scatter__quad--br">Overpriced</span>
            {
              scatterPoints.map((pt) => {
                if (pt.priceNum <= 0 || pt.scoreNum == null) return null;
                const leftPct = ((pt.priceNum - 8) / (scatterMaxPrice - 8)) * 100;
                const bottomPct = ((pt.scoreNum - scatterMinScore) / (scatterMaxScore - scatterMinScore)) * 100;
                return (
                  <span
                    class={`md-scatter__point ${pt.highlight ? 'md-scatter__point--highlight' : ''}`}
                    style={`left: ${Math.min(92, Math.max(8, leftPct))}%; bottom: ${Math.min(92, Math.max(8, bottomPct))}%; --pt-color: ${pt.color};`}
                  >
                    <span class="md-scatter__dot" />
                    <span class="md-scatter__label">{pt.name}</span>
                  </span>
                );
              })
            }
          </div>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,0.52fr)_minmax(0,0.48fr)] gap-6">
      <div class="md-panel">
        <h3 class="text-lg font-black text-on-surface mb-4">Key Takeaways</h3>
        <ul class="space-y-4">
          {
            takeaways.map((item) => (
              <li class="md-takeaway">
                <span class={`md-takeaway__icon md-takeaway__icon--${item.tone}`}>
                  <span class="material-symbols-outlined text-[16px]">{item.icon}</span>
                </span>
                <p class="text-sm text-on-surface-variant leading-relaxed">{item.text}</p>
              </li>
            ))
          }
        </ul>
      </div>

      {
        herman && (
          <div class="md-panel md-expert">
            <h3 class="text-lg font-black text-on-surface mb-4">Expert Analysis</h3>
            {
              vm.expertAnalysis.map((paragraph) => (
                <p class="text-sm text-on-surface leading-relaxed mb-4 last:mb-5">{paragraph}</p>
              ))
            }
            <div class="md-expert__byline flex items-center gap-3">
              <BrandIcon
                src={brandIcons.scientist.dark}
                srcLight={brandIcons.scientist.light}
                width={48}
                height={48}
                class="shrink-0"
              />
              <div>
                <div class="flex items-center gap-1.5">
                  <p class="text-sm font-bold text-on-surface">{herman.name}</p>
                  <VerifiedCheck class="w-[18px] h-[18px]" />
                </div>
                <p class="text-xs text-tertiary font-medium">Lead Reviewer</p>
              </div>
            </div>
          </div>
        )
      }
    </div>

    {
      vm.sources.length > 0 && (
        <div class="mt-8 pt-6 border-t border-surface-variant">
          <p class="text-xs font-bold text-tertiary uppercase tracking-wide mb-2">Sources</p>
          <ul class="text-xs text-on-surface-variant space-y-1">
            {vm.sources.map((source) => <li>{source}</li>)}
          </ul>
        </div>
      )
    }
  </div>
</section>

<style>
  .md-metric-card {
    background: var(--color-surface-container-lowest);
    border: 1px solid var(--color-surface-variant);
    border-radius: 14px;
    padding: 16px;
    box-shadow: 0 1px 3px rgb(0 0 0 / 4%);
  }
  .md-metric-card__icon {
    width: 34px; height: 34px; border-radius: 10px;
    display: flex; align-items: center; justify-content: center;
  }
  .md-metric-card__icon--pink { background: rgb(219 39 119 / 10%); color: #db2777; }
  .md-metric-card__icon--green { background: rgb(34 197 94 / 10%); color: #16a34a; }
  .md-metric-card__icon--amber { background: rgb(245 158 11 / 10%); color: #d97706; }
  .md-metric-card__icon--purple { background: rgb(168 85 247 / 10%); color: #9333ea; }
  .md-metric-card__label { margin: 10px 0 2px; font-size: 11px; font-weight: 700; color: var(--color-tertiary); }
  .md-metric-card__value { font-size: 1.35rem; font-weight: 900; color: var(--color-on-surface); line-height: 1.1; }
  .md-metric-card__value--muted { font-size: 1rem; font-weight: 700; color: var(--color-tertiary); }
  .md-metric-card__sub { margin-top: 4px; font-size: 11px; color: var(--color-on-surface-variant); line-height: 1.35; }

  .md-panel {
    background: var(--color-surface-container-lowest);
    border: 1px solid var(--color-surface-variant);
    border-radius: 14px;
    padding: 20px;
    box-shadow: 0 1px 3px rgb(0 0 0 / 4%);
  }

  .md-select {
    font-size: 12px; font-weight: 700;
    border: 1px solid var(--color-surface-variant);
    border-radius: 8px; padding: 6px 10px; background: var(--color-surface-container-lowest);
  }

  .md-line-chart__wrap {
    position: relative;
    padding-left: 28px;
    cursor: crosshair;
  }

  .md-line-chart__crosshair {
    pointer-events: none;
  }

