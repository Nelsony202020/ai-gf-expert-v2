  .md-scatter__quad { position: absolute; font-size: 9px; font-weight: 700; color: var(--color-tertiary); opacity: 0.7; }
  .md-scatter__quad--tl { top: 8px; left: 8px; }
  .md-scatter__quad--tr { top: 8px; right: 8px; }
  .md-scatter__quad--bl { bottom: 8px; left: 8px; }
  .md-scatter__quad--br { bottom: 8px; right: 8px; }
  .md-scatter__point {
    position: absolute;
    transform: translate(-50%, 50%);
