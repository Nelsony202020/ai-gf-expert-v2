---
import type { Product } from '../../../data/products';
import InfoIcon from '../../ui/InfoIcon.astro';
import AlternativesSummaryCard from '../alternatives/AlternativesSummaryCard.astro';
import AlternativeCompactCard from '../alternatives/AlternativeCompactCard.astro';
import AlternativesComparisonTable from '../alternatives/AlternativesComparisonTable.astro';
import MarketTrafficChart from '../alternatives/MarketTrafficChart.astro';
import MarketCompetitorsTable from '../alternatives/MarketCompetitorsTable.astro';
import { loadAlternativesViewModel } from '../../../lib/alternatives/loadAlternatives';

interface Props {
  product: Product;
}

const { product } = Astro.props;
const vm = await loadAlternativesViewModel(product);
if (!vm) {
  return null;
}

function productThumb(p: Product): string | undefined {
  return p.logo ?? p.gallery[0]?.full ?? p.gallery[0]?.thumb;
}

function productPrice(p: Product): string {
  const raw = p.overview.highlights.startingPrice || '—';
  return raw.replace(/\s*\/\s*mo(nth)?/i, '/mo').trim();
}
---

<section class="py-12 md:py-16 bg-background dark-section alt-tab">
  <div class="section-container px-4 md:px-8 alt-tab__inner">
    <header class="alt-intro">
      <div class="alt-intro__copy">
        <h2 class="alt-intro__title">{vm.source.name} Alternatives</h2>
        <p class="alt-intro__text">{vm.intro}</p>
        <p class="alt-intro__updated">Updated {vm.updatedLabel}</p>
      </div>
      <AlternativesSummaryCard
        featured={vm.summaryFeatured}
        listStats={vm.summaryListStats}
        appsCompared={vm.appsCompared}
      />
    </header>

    {
      vm.testingPeers.length > 0 && (
        <section class="alt-section" aria-labelledby="alt-best-title">
          <h3 id="alt-best-title" class="alt-section__kicker">Best alternatives</h3>
          <div class="alt-compact-grid">
            {
              vm.testingPeers.map((peer) => (
                <AlternativeCompactCard
                  peer={peer}
                  bullets={vm.compactBullets[peer.product.slug] ?? { wins: [], losses: [] }}
                  thumb={productThumb(peer.product)}
                  price={productPrice(peer.product)}
                />
              ))
            }
          </div>
        </section>
      )
    }

    <section class="alt-section" aria-label="Comparison with closest alternatives">
      <AlternativesComparisonTable
        sourceName={vm.source.name}
        rows={vm.comparisonTableRows}
        takeaway={vm.comparisonTableTakeaway}
        altCount={vm.tablePeers.length}
        updatedLabel={vm.updatedLabel}
      />
    </section>

    {
      vm.marketTrafficChart.length > 0 && (
        <section class="alt-section alt-market-section" aria-labelledby="alt-market-title">
          <h3 id="alt-market-title" class="alt-section__heading">
            Market competitors
            <InfoIcon title="Search market data from Ahrefs — not our review scores" />
          </h3>
          <MarketTrafficChart
              sourceDomain={vm.marketSourceDomain ?? vm.source.name.toLowerCase().replace(/\s+/g, '') + '.ai'}
              columns={vm.marketTrafficChart}
              periodLabel={vm.updatedLabel}
            />
            {
              vm.marketMetricsTable.length > 0 && (
                <MarketCompetitorsTable
                  rows={vm.marketMetricsTable}
                  sourceName={vm.source.name}
                  snapshotMonths={vm.marketSnapshotMonths}
                  defaultMonthKey={vm.marketSnapshotDefaultKey}
                />
              )
            }
            <p class="alt-market-source">
              <span class="material-symbols-outlined" aria-hidden="true">travel_explore</span>
              Market data only — does not reflect our testing scores.{' '}
              <strong>
                {
                  vm.marketDataSource === 'ahrefs'
                    ? `Source: Ahrefs organic competitors for ${vm.source.name} (${vm.updatedLabel})`
                    : vm.marketDataSource === 'unavailable'
                      ? `Source: Ahrefs unavailable — showing sample data`
                      : `Source: Sample data (${vm.updatedLabel}) — live Ahrefs used when API key is connected`
                }
              </strong>
            </p>
        </section>
      )
    }

    <section class="alt-section" aria-labelledby="alt-choose-title">
      <h3 id="alt-choose-title" class="alt-section__kicker">Which should you choose?</h3>
      <div class="alt-choose-grid">
        {
          vm.testingPeers.map((peer) => (
            <article class="alt-choose-card">
              <span class="material-symbols-outlined alt-choose-card__icon" aria-hidden="true">
                {peer.editorial.decisionIcon}
              </span>
              <p class="alt-choose-card__hook">{peer.editorial.decisionHook}</p>
              <p class="alt-choose-card__name">{peer.product.name}</p>
              <p class="alt-choose-card__detail">{peer.editorial.chooseIf}</p>
              {
                peer.reviewUrl && (
                  <a href={peer.reviewUrl} class="alt-choose-card__link">Read review</a>
                )
              }
            </article>
          ))
        }
        <article class="alt-choose-card alt-choose-card--source">
          <span class="material-symbols-outlined alt-choose-card__icon" aria-hidden="true">
            {vm.stickWithDecisionIcon}
          </span>
          <p class="alt-choose-card__hook">{vm.stickWithDecisionHook}</p>
          <p class="alt-choose-card__name">Stick with {vm.source.name}</p>
          <p class="alt-choose-card__detail">{vm.stickWithSourceIf}</p>
        </article>
      </div>
    </section>
  </div>
</section>
