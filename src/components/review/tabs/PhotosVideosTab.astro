---
import type { Product } from '../../../data/products';
import type { FeaturedReviewVideo, MediaItem } from '../../../data/aura-ai-media';
import BrandIcon from '../../ui/BrandIcon.astro';
import AgeRatingIcon from '../../ui/AgeRatingIcon.astro';
import MediaGalleryCard from '../MediaGalleryCard.astro';
import NsfwAgeGateModal from '../NsfwAgeGateModal.astro';
import { brandIcons } from '../../../lib/brand-icons';

interface Props {
  product: Product;
}

const { product } = Astro.props;

function youtubeIdFromUrl(url: string): string | null {
  const m =
    url.match(/[?&]v=([\w-]{6,})/) ??
    url.match(/youtu\.be\/([\w-]{6,})/) ??
    url.match(/\/embed\/([\w-]{6,})/);
  return m?.[1] ?? null;
}

const featuredVideo: FeaturedReviewVideo | null = product.videoReview?.embedUrl
  ? {
      youtubeId: youtubeIdFromUrl(product.videoReview.embedUrl) ?? '',
      title: `${product.name} review video`,
      description: `My complete hands-on review of ${product.name} — chat, characters, images, video, and more.`,
    }
  : null;

const mediaItems: MediaItem[] =
  product.mediaItems && product.mediaItems.length > 0
    ? product.mediaItems
    : product.gallery.map((g, i) => ({
        id: `product-gallery-${i}`,
        type: 'image' as const,
        src: g.full,
        thumb: g.thumb,
        alt: g.alt,
        caption: g.alt,
        filter: 'gallery' as const,
      }));

const hasFeaturedVideo = Boolean(featuredVideo?.youtubeId);
const hasMedia = mediaItems.length > 0;
const youtubeWatchUrl = featuredVideo?.youtubeId
  ? `https://www.youtube.com/watch?v=${featuredVideo.youtubeId}`
  : null;

const filters = [
  { id: 'all', label: 'Overview', icon: 'grid_view' },
  { id: 'characters', label: 'Characters', icon: 'groups' },
  { id: 'images', label: 'Images', icon: 'photo_library' },
  { id: 'videos', label: 'Videos', icon: 'videocam' },
  { id: 'chat', label: 'Chat', icon: 'chat_bubble' },
  { id: '18plus', label: '18+', icon: 'no_adult_content' },
];

function matchesOverviewGroup(item: MediaItem, groupId: string): boolean {
  if (groupId === '18plus') return Boolean(item.nsfw);
  if (groupId === 'videos') return item.type === 'video';
  if (groupId === 'images') return item.type === 'image' && item.filter === 'gallery';
  if (groupId === 'characters') return item.filter === 'characters';
  if (groupId === 'chat') return item.filter === 'chat';
  return false;
}

const overviewSections = [
  { id: '18plus', title: '18+', limit: 3, aspect: 'landscape' as const, filterTarget: '18plus' },
  {
    id: 'characters',
    title: 'Characters',
    limit: 4,
    aspect: 'portrait' as const,
    filterTarget: 'characters',
  },
  { id: 'chat', title: 'Chat & voice', limit: 3, aspect: 'landscape' as const, filterTarget: 'chat' },
  { id: 'images', title: 'Image results', limit: 4, aspect: 'portrait' as const, filterTarget: 'images' },
  {
    id: 'videos',
    title: 'Video results',
    limit: 5,
    aspect: 'landscape' as const,
    filterTarget: 'videos',
    fullWidth: true,
  },
];

const overviewGroups = overviewSections.map((section) => {
  const groupItems = mediaItems.filter((item) => matchesOverviewGroup(item, section.id));
  return {
    ...section,
    items: groupItems.slice(0, section.limit),
    total: groupItems.length,
  };
});
---

<section class="bg-background py-12 md:py-14" data-media-gallery-root>
  <div class="section-container px-4 md:px-8">
    <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-6 mb-8">
      <div class="min-w-0">
        <h2 class="text-3xl md:text-4xl font-black text-on-surface mb-3">Photos &amp; Videos</h2>
        <p class="text-on-surface-variant text-base md:text-lg max-w-2xl">
          Screenshots and video from our {product.name} review — characters, chat, and general gallery media from testing.
        </p>
      </div>

      <div class="media-nsfw-box shrink-0">
        <div class="media-nsfw-toggle" role="group" aria-label="Content safety mode">
          <button
            type="button"
            class="media-nsfw-btn media-nsfw-btn--safe media-nsfw-btn--active"
            data-nsfw-mode="safe"
            aria-pressed="true"
            aria-label="Safe only"
          >
            <span class="material-symbols-outlined media-nsfw-btn__icon text-[22px]" aria-hidden="true">shield</span>
            <span class="media-nsfw-btn__label">Safe only</span>
          </button>
          <button
            type="button"
            class="media-nsfw-btn media-nsfw-btn--nsfw"
            data-nsfw-mode="nsfw"
            aria-pressed="false"
            aria-label="Show 18 plus content"
          >
            <AgeRatingIcon size={22} class="media-nsfw-btn__icon" />
            <span class="media-nsfw-btn__label">18+</span>
          </button>
        </div>
        <p class="media-nsfw-status" data-nsfw-status>
          <span class="material-symbols-outlined text-[14px]">lock</span>
          <span data-nsfw-status-text>18+ content is blurred</span>
        </p>
      </div>
    </div>

    {
      hasFeaturedVideo && featuredVideo && youtubeWatchUrl && (
        <div class="media-featured-box rounded-2xl border border-surface-variant overflow-hidden shadow-sm mb-6">
          <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,1fr)]">
            <div class="relative aspect-video bg-black">
              <iframe
                src={`https://www.youtube.com/embed/${featuredVideo.youtubeId}`}
                title={featuredVideo.title}
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                allowfullscreen
                loading="lazy"
                class="absolute inset-0 w-full h-full border-0"
              />
            </div>
            <div class="p-5 md:p-6 flex flex-col justify-center bg-background">
              <div class="flex items-center gap-2.5 mb-3">
                <BrandIcon
                  src={brandIcons.youtube.dark}
                  srcLight={brandIcons.youtube.light}
                  width={44}
                  height={44}
                  class="shrink-0"
                />
                <span class="text-[11px] font-black uppercase tracking-widest text-accent">Featured video review</span>
              </div>
              <h3 class="text-xl font-black text-on-surface mb-2">{product.name} Review Video</h3>
              <p class="text-sm text-on-surface-variant leading-relaxed mb-5">{featuredVideo.description}</p>
              <a
                href={youtubeWatchUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2.5 self-start px-4 py-2.5 rounded-full border border-surface-variant bg-background text-sm font-bold text-on-surface hover:border-accent hover:text-accent transition-colors shadow-sm"
              >
                <svg class="w-[22px] h-[22px] shrink-0" viewBox="0 0 24 24" aria-hidden="true">
                  <path fill="#FF0000" d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814z" />
                  <path fill="#FFF" d="M9.545 15.568V8.432L15.818 12l-6.273 3.568z" />
                </svg>
                Watch on YouTube
              </a>
            </div>
          </div>
        </div>
      )
    }

    {
      hasMedia ? (
        <>
    <div class="media-section-header mb-5" data-media-section-header aria-live="polite">
      <div class="media-section-header__inner">
        <span class="material-symbols-outlined media-section-header__icon" data-media-section-icon aria-hidden="true">grid_view</span>
        <span class="media-section-header__label" data-media-section-label>Overview</span>
      </div>
      <span class="media-section-header__divider" aria-hidden="true"></span>
    </div>

    <div class="flex flex-wrap gap-2 mb-5" data-media-filters role="tablist" aria-label="Media filters">
      {
        filters.map((f, i) => (
          <button
            type="button"
            role="tab"
            data-media-filter={f.id}
            data-filter-label={f.label}
            data-filter-icon={f.icon}
            aria-selected={i === 0 ? 'true' : 'false'}
            class="media-filter-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-bold border border-surface-variant transition-colors"
          >
            <span class="material-symbols-outlined text-[15px]">{f.icon}</span>
            {f.label}
          </button>
        ))
      }
    </div>

    <div class="media-overview" data-media-overview>
      <div class="media-overview__grid">
        {
          overviewGroups.map((group) => (
            <section
              class:list={['media-overview__panel', group.fullWidth && 'media-overview__panel--full']}
              data-overview-panel={group.id}
            >
              <header class="media-overview__header">
                <div class="media-overview__heading">
                  <h3 class="media-overview__title">{group.title}</h3>
                  <p class="media-overview__count">{group.total} {group.total === 1 ? 'item' : 'items'}</p>
                </div>
                <button
                  type="button"
                  class="media-overview__view-all"
                  data-media-filter-jump={group.filterTarget}
                >
                  View all
                </button>
              </header>
              {
                group.items.length > 0 ? (
                  <div
                    class:list={[
                      'media-overview__previews',
                      group.aspect === 'landscape' ? 'media-overview__previews--landscape' : 'media-overview__previews--portrait',
                    ]}
                  >
                    {group.items.map((item) => (
                      <MediaGalleryCard item={item} aspect={group.aspect} />
                    ))}
                  </div>
                ) : (
                  <p class="media-overview__empty">No items yet</p>
                )
              }
            </section>
          ))
        }
      </div>
    </div>

    <div
      class="hidden grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-3 md:gap-4"
      data-media-grid
      data-gallery
      data-gallery-images="[]"
    >
      {mediaItems.map((item) => <MediaGalleryCard item={item} aspect="portrait" />)}
    </div>

    <nav class="media-pagination hidden mt-6" data-media-pagination aria-label="Media gallery pages">
      <button type="button" class="media-pagination__btn" data-media-page-prev aria-label="Previous page">
        <span class="material-symbols-outlined text-[18px]">chevron_left</span>
      </button>
      <span class="media-pagination__status" data-media-page-status>Page 1 of 1</span>
      <button type="button" class="media-pagination__btn" data-media-page-next aria-label="Next page">
        <span class="material-symbols-outlined text-[18px]">chevron_right</span>
      </button>
    </nav>

    <p data-media-empty class="hidden text-center text-sm text-tertiary py-12">No media matches these filters.</p>
        </>
      ) : (
        !hasFeaturedVideo && (
          <p class="text-center text-sm text-tertiary py-12">
            No photos or videos have been added for this review yet.
          </p>
        )
      )
    }
  </div>

  <NsfwAgeGateModal />
</section>

<style>
  .media-nsfw-box {
    border-radius: 14px;
    padding: 12px 14px 10px;
  }

  .media-nsfw-toggle {
    display: inline-flex;
    padding: 4px;
    border-radius: 999px;
    border: 1px solid var(--color-surface-variant);
    background: var(--color-surface-container-low);
    gap: 2px;
  }

  .media-nsfw-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    min-width: 96px;
    padding: 8px 12px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 800;
    color: var(--color-on-surface-variant);
    background: transparent;
    border: none;
    cursor: pointer;
    transition: background 0.15s ease, color 0.15s ease, box-shadow 0.15s ease;
  }

  .media-nsfw-btn__icon {
    flex-shrink: 0;
  }

  .media-nsfw-btn--safe.media-nsfw-btn--active {
    background: rgb(218 246 108 / 35%);
    color: #3d5a1e;
    box-shadow: inset 0 0 0 1px rgb(218 246 108 / 45%);
  }

  .media-nsfw-btn--nsfw.media-nsfw-btn--active {
    background: rgb(219 39 119 / 14%);
    color: var(--color-accent);
    box-shadow: inset 0 0 0 1px rgb(219 39 119 / 25%);
  }

  .media-nsfw-status {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin: 8px 0 0;
    font-size: 11px;
    font-weight: 600;
    color: var(--color-tertiary);
  }

  .media-card[data-nsfw='true']:not(.media-card--revealed) .media-card__img {
    filter: blur(28px) brightness(0.65) !important;
    transform: scale(1.08);
  }

  .media-card--revealed .media-card__img {
    filter: none !important;
    transform: none;
  }

  .media-card--revealed .media-card__nsfw {
    display: none;
  }

  .media-card--hidden {
    display: none;
  }

  .media-card__open {
    border: none;
    padding: 0;
    background: transparent;
  }

  .media-card__nsfw {
    z-index: 2;
  }

  .media-section-header {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .media-section-header__inner {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }

  .media-section-header__icon {
    font-size: 1.25rem;
    color: var(--color-accent);
    font-variation-settings: 'FILL' 0, 'wght' 600;
  }

  .media-section-header__label {
    font-size: 0.8125rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-on-surface);
  }

  .media-section-header__divider {
    display: block;
    height: 1px;
    width: 100%;
    background: linear-gradient(
      90deg,
      rgb(219 39 119 / 45%) 0%,
      rgb(219 39 119 / 18%) 35%,
      var(--color-surface-variant) 100%
    );
  }

  .media-pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
  }

  .media-pagination.hidden,
  .media-overview__empty.hidden,
  .media-overview__previews.hidden {
    display: none;
  }

  .media-pagination__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 999px;
    border: 1px solid var(--color-surface-variant);
    background: var(--color-surface-container-lowest);
    color: var(--color-on-surface-variant);
    cursor: pointer;
    transition: border-color 0.15s ease, color 0.15s ease;
  }

  .media-pagination__btn:hover:not(:disabled) {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .media-pagination__btn:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }

  .media-pagination__status {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-on-surface-variant);
    min-width: 7rem;
    text-align: center;
  }

  .media-overview__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @media (min-width: 768px) {
    .media-overview__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .media-overview__panel {
    border: 1px solid var(--color-surface-variant);
    border-radius: 1rem;
    background: var(--color-surface-container-lowest);
    padding: 1rem 1.125rem 1.125rem;
    min-width: 0;
  }

  .media-overview__panel--full {
    grid-column: 1 / -1;
  }

  .media-overview__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.875rem;
  }

  .media-overview__title {
    font-size: 1.125rem;
    font-weight: 900;
    color: var(--color-on-surface);
    line-height: 1.2;
    margin: 0;
  }

  .media-overview__count {
    margin: 0.2rem 0 0;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-tertiary);
  }

  .media-overview__view-all {
    flex-shrink: 0;
    border: none;
    background: none;
    padding: 0;
    font-size: 0.875rem;
    font-weight: 800;
    color: var(--color-accent);
    cursor: pointer;
    text-decoration: none;
  }

  .media-overview__view-all:hover {
    text-decoration: underline;
  }

  .media-overview__previews {
    display: grid;
    gap: 0.5rem;
    min-width: 0;
  }

  .media-overview__previews--landscape {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .media-overview__previews--portrait {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  @media (min-width: 640px) {
    .media-overview__previews--landscape {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .media-overview__previews--portrait {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .media-overview__panel--full .media-overview__previews--landscape {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  @media (min-width: 640px) {
    .media-overview__panel--full .media-overview__previews--landscape {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }

  .media-overview__empty {
    margin: 0;
    padding: 1.5rem 0;
    text-align: center;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-tertiary);
  }

  .media-card--portrait {
    aspect-ratio: 4 / 5;
  }

  .media-card--landscape {
    aspect-ratio: 16 / 10;
  }

  .media-card__play {
    font-size: 2.75rem;
  }
</style>

<style is:global>
  .media-nsfw-box {
    background: var(--color-surface-container-lowest);
    border: 1px solid var(--color-surface-variant);
    box-shadow: 0 1px 3px rgb(0 0 0 / 4%);
  }

  [data-theme='dark'] .media-nsfw-box {
    background: var(--dark-elevated);
    border-color: var(--dark-border-subtle);
    box-shadow: none;
  }

  [data-theme='dark'] .media-nsfw-toggle {
    background: var(--color-background);
    border-color: var(--dark-border-subtle);
  }

  [data-theme='dark'] .media-nsfw-btn {
    color: var(--dark-muted);
  }

  [data-theme='dark'] .media-nsfw-btn--safe.media-nsfw-btn--active {
    background: var(--dark-hover-strong);
    color: var(--dark-accent-text);
    box-shadow: inset 0 0 0 1px rgb(219 39 119 / 30%);
  }

  [data-theme='dark'] .media-nsfw-btn--nsfw.media-nsfw-btn--active {
    background: rgb(219 39 119 / 18%);
    color: #f472b6;
  }

  .media-filter-btn[aria-selected='true'] {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: #fff;
  }

  .media-filter-btn[aria-selected='false'] {
    background: var(--color-surface-container-lowest);
    border-color: var(--color-surface-variant);
    color: var(--color-on-surface-variant);
  }

  .media-filter-btn[aria-selected='false']:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  [data-theme='dark'] .media-filter-btn[aria-selected='false'] {
    background: var(--dark-elevated);
    border-color: var(--dark-border-subtle);
    color: var(--dark-muted);
  }

  [data-theme='dark'] .media-filter-btn[aria-selected='false']:hover {
    border-color: #f472b6;
    color: #f472b6;
    background: rgb(219 39 119 / 10%);
  }

  [data-theme='dark'] .media-filter-btn[aria-selected='true'] {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: #fff;
  }

  [data-theme='dark'] .media-featured-box > div > div.bg-background {
    background: var(--dark-elevated) !important;
  }

  [data-theme='dark'] .media-pagination__btn {
    background: var(--dark-elevated);
    border-color: var(--dark-border-subtle);
    color: var(--dark-muted);
  }

  [data-theme='dark'] .media-overview__panel {
    background: var(--dark-elevated);
    border-color: var(--dark-border-subtle);
  }
</style>

<script>
  const NSFW_STORAGE_KEY = 'lr-nsfw-preference';
  const NSFW_COOKIE_KEY = 'lr_nsfw_preference';

  type NsfwMode = 'safe' | 'nsfw';

  function readStoredMode(): NsfwMode | null {
    try {
      const fromStorage = localStorage.getItem(NSFW_STORAGE_KEY);
      if (fromStorage === 'safe' || fromStorage === 'nsfw') return fromStorage;
    } catch {
      /* ignore */
    }

    const cookie = document.cookie
      .split('; ')
      .find((row) => row.startsWith(`${NSFW_COOKIE_KEY}=`));
    const value = cookie?.split('=')[1];
    return value === 'safe' || value === 'nsfw' ? value : null;
  }

  function saveStoredMode(mode: NsfwMode, remember: boolean) {
    if (!remember) {
      try {
        localStorage.removeItem(NSFW_STORAGE_KEY);
      } catch {
        /* ignore */
      }
      document.cookie = `${NSFW_COOKIE_KEY}=; path=/; max-age=0; SameSite=Lax`;
      return;
    }

    try {
      localStorage.setItem(NSFW_STORAGE_KEY, mode);
    } catch {
      /* ignore */
    }

    const maxAge = 60 * 60 * 24 * 365;
    document.cookie = `${NSFW_COOKIE_KEY}=${mode}; path=/; max-age=${maxAge}; SameSite=Lax`;
  }

  function initNsfwGateOnce(
    onConfirm: (remember: boolean) => void,
    onCancel: () => void,
  ) {
    const html = document.documentElement;
    if (html.dataset.nsfwGateBound === 'true') {
      (window as Window & { __setNsfwGateHandlers?: (c: (remember: boolean) => void, x: () => void) => void }).__setNsfwGateHandlers?.(
        onConfirm,
        onCancel,
      );
      return;
    }
    html.dataset.nsfwGateBound = 'true';

    const gate = document.querySelector<HTMLElement>('[data-nsfw-gate]');
    const gateBackdrop = document.querySelector<HTMLElement>('[data-nsfw-gate-backdrop]');
    const gateAge = document.querySelector<HTMLInputElement>('[data-nsfw-gate-age]');
    const gateRemember = document.querySelector<HTMLInputElement>('[data-nsfw-gate-remember]');
    const gateCancel = document.querySelector<HTMLButtonElement>('[data-nsfw-gate-cancel]');
    const gateConfirm = document.querySelector<HTMLButtonElement>('[data-nsfw-gate-confirm]');

    let confirmHandler = onConfirm;
    let cancelHandler = onCancel;

    function closeGate() {
      if (!gate) return;
      gate.classList.add('hidden');
      gate.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    gateAge?.addEventListener('change', () => {
      if (gateConfirm) gateConfirm.disabled = !gateAge.checked;
    });

    gateCancel?.addEventListener('click', () => {
      cancelHandler();
      closeGate();
    });

    gateBackdrop?.addEventListener('click', () => {
      cancelHandler();
      closeGate();
    });

    gateConfirm?.addEventListener('click', () => {
      if (!gateAge?.checked) return;
      confirmHandler(gateRemember?.checked ?? false);
      closeGate();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && gate && !gate.classList.contains('hidden')) {
        cancelHandler();
        closeGate();
      }
    });

    (window as Window & { __setNsfwGateHandlers?: (c: (remember: boolean) => void, x: () => void) => void }).__setNsfwGateHandlers = (
      c,
      x,
    ) => {
      confirmHandler = c;
      cancelHandler = x;
    };
  }

  function initMediaGallery() {
    const root = document.querySelector('[data-media-gallery-root]');
    if (!root || root.dataset.bound === 'true') return;
    root.dataset.bound = 'true';

    const items = Array.from(root.querySelectorAll<HTMLElement>('[data-media-grid] [data-media-item]'));
    const overviewItems = Array.from(root.querySelectorAll<HTMLElement>('[data-media-overview] [data-media-item]'));
    const allInteractiveItems = Array.from(root.querySelectorAll<HTMLElement>('[data-media-item]'));
    const filterBtns = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-media-filter]'));
    const filterJumpBtns = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-media-filter-jump]'));
    const nsfwBtns = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-nsfw-mode]'));
    const statusText = root.querySelector<HTMLElement>('[data-nsfw-status-text]');
    const emptyEl = root.querySelector<HTMLElement>('[data-media-empty]');
    const overviewEl = root.querySelector<HTMLElement>('[data-media-overview]');
    const galleryRoot = root.querySelector<HTMLElement>('[data-gallery]');
    const gridEl = root.querySelector<HTMLElement>('[data-media-grid]');
    const paginationEl = root.querySelector<HTMLElement>('[data-media-pagination]');
    const pagePrev = root.querySelector<HTMLButtonElement>('[data-media-page-prev]');
    const pageNext = root.querySelector<HTMLButtonElement>('[data-media-page-next]');
    const pageStatus = root.querySelector<HTMLElement>('[data-media-page-status]');
    const sectionIcon = root.querySelector<HTMLElement>('[data-media-section-icon]');
    const sectionLabel = root.querySelector<HTMLElement>('[data-media-section-label]');

    const gate = document.querySelector<HTMLElement>('[data-nsfw-gate]');
    const gateAge = document.querySelector<HTMLInputElement>('[data-nsfw-gate-age]');
    const gateConfirm = document.querySelector<HTMLButtonElement>('[data-nsfw-gate-confirm]');

    let activeFilter = 'all';
    let nsfwMode: NsfwMode = 'safe';
    let pendingRevealItem: HTMLElement | null = null;
    let currentPage = 1;

    const ROWS_PER_PAGE = 3;

    function gridColumns(): number {
      const w = window.innerWidth;
      if (w >= 1280) return 5;
      if (w >= 1024) return 4;
      if (w >= 640) return 3;
      return 2;
    }

    function itemsPerPage(): number {
      return gridColumns() * ROWS_PER_PAGE;
    }

    function updateSectionHeader(btn?: HTMLButtonElement) {
      const activeBtn =
        btn ?? filterBtns.find((b) => b.dataset.mediaFilter === activeFilter) ?? filterBtns[0];
      if (!activeBtn) return;
      const label = activeBtn.dataset.filterLabel ?? 'Overview';
      const icon = activeBtn.dataset.filterIcon ?? 'grid_view';
      if (sectionLabel) sectionLabel.textContent = label;
      if (sectionIcon) sectionIcon.textContent = icon;
    }

    function updateToggleUi() {
      nsfwBtns.forEach((btn) => {
        const mode = btn.dataset.nsfwMode as NsfwMode;
        const active = mode === nsfwMode;
        btn.classList.toggle('media-nsfw-btn--active', active);
        btn.setAttribute('aria-pressed', active ? 'true' : 'false');
      });

      if (statusText) {
        statusText.textContent =
          nsfwMode === 'safe' ? '18+ content is blurred' : '18+ content is visible';
      }
    }

    function revealNsfwItems(target?: HTMLElement | null) {
      if (target) {
        target.classList.add('media-card--revealed');
        syncLightboxGallery();
        return;
      }

      allInteractiveItems.forEach((item) => {
        if (item.dataset.nsfw === 'true') item.classList.add('media-card--revealed');
      });
    }

    function hideNsfwItems() {
      allInteractiveItems.forEach((item) => {
        if (item.dataset.nsfw === 'true') item.classList.remove('media-card--revealed');
      });
    }

    function setNsfwMode(mode: NsfwMode, remember = false) {
      nsfwMode = mode;
      updateToggleUi();

      if (mode === 'nsfw') {
        revealNsfwItems(pendingRevealItem);
        saveStoredMode('nsfw', remember);
      } else {
        hideNsfwItems();
        saveStoredMode('safe', remember);
      }

      pendingRevealItem = null;
      applyFilters();
    }

    function visibleImageItems(): HTMLElement[] {
      const scope =
        activeFilter === 'all'
          ? root.querySelector('[data-media-overview]')
          : root.querySelector('[data-media-grid]');
      const scopedItems = Array.from(scope?.querySelectorAll<HTMLElement>('[data-media-item]') ?? []);

      return scopedItems.filter((item) => {
        if (item.classList.contains('media-card--hidden')) return false;
        if (item.dataset.mediaType !== 'image') return false;
        if (item.dataset.nsfw === 'true' && nsfwMode === 'safe') return false;
        if (item.dataset.nsfw === 'true' && !item.classList.contains('media-card--revealed')) return false;
        return Boolean(item.dataset.lightboxSrc);
      });
    }

    function syncLightboxGallery() {
      if (!galleryRoot) return;
      const lightboxItems = visibleImageItems().map((item) => ({
        src: item.dataset.lightboxSrc ?? '',
        alt: item.dataset.lightboxAlt ?? '',
        caption: item.dataset.lightboxCaption ?? item.dataset.lightboxAlt ?? '',
      }));
      galleryRoot.dataset.galleryImages = JSON.stringify(lightboxItems);
    }

    function openLightboxForItem(item: HTMLElement) {
      const visible = visibleImageItems();
      const src = item.dataset.lightboxSrc ?? '';
      const index = visible.findIndex((el) => el.dataset.lightboxSrc === src);
      const lightboxItems = visible.map((el) => ({
        src: el.dataset.lightboxSrc ?? '',
        alt: el.dataset.lightboxAlt ?? '',
        caption: el.dataset.lightboxCaption ?? el.dataset.lightboxAlt ?? '',
      }));
      syncLightboxGallery();
      const openFn = (window as Window & {
        openImageLightbox?: (items: Array<{ src: string; alt?: string; caption?: string }>, index?: number) => void;
      }).openImageLightbox;
      if (openFn && lightboxItems.length > 0) {
        openFn(lightboxItems, index >= 0 ? index : 0);
      }
    }

    function applyFilters() {
      const isOverview = activeFilter === 'all';
      overviewEl?.classList.toggle('hidden', !isOverview);
      gridEl?.classList.toggle('hidden', isOverview);

      if (isOverview) {
        overviewItems.forEach((item) => {
          const isNsfw = item.dataset.nsfw === 'true';
          // Safe mode: show blurred previews (not display:none) so overview panels stay populated.
          item.classList.remove('media-card--hidden');
          if (isNsfw && nsfwMode === 'safe') item.classList.remove('media-card--revealed');
        });
        overviewEl?.querySelectorAll<HTMLElement>('[data-overview-panel]').forEach((panel) => {
          const visibleInPanel = Array.from(panel.querySelectorAll<HTMLElement>('[data-media-item]')).filter(
            (item) => !item.classList.contains('media-card--hidden'),
          );
          const emptyEl = panel.querySelector<HTMLElement>('.media-overview__empty');
          const previewsEl = panel.querySelector<HTMLElement>('.media-overview__previews');
          if (emptyEl && previewsEl) {
            emptyEl.classList.toggle('hidden', visibleInPanel.length > 0);
            previewsEl.classList.toggle('hidden', visibleInPanel.length === 0);
          }
        });
        if (emptyEl) emptyEl.classList.add('hidden');
        if (paginationEl) paginationEl.classList.add('hidden');
        syncLightboxGallery();
        return;
      }

      const matching: HTMLElement[] = [];
      items.forEach((item) => {
        const filter = item.dataset.filter ?? '';
        const mediaType = item.dataset.mediaType ?? 'image';
        const isNsfw = item.dataset.nsfw === 'true';
        let matchFilter = false;
        if (activeFilter === 'all') {
          matchFilter = true;
        } else if (activeFilter === '18plus') {
          matchFilter = isNsfw;
        } else if (activeFilter === 'videos') {
          matchFilter = mediaType === 'video';
        } else if (activeFilter === 'images') {
          matchFilter = mediaType === 'image' && filter === 'gallery';
        } else {
          matchFilter = filter === activeFilter;
        }
        item.dataset.filterMatch = matchFilter ? 'true' : 'false';
        if (matchFilter) matching.push(item);
      });

      const perPage = itemsPerPage();
      const totalPages = Math.max(1, Math.ceil(matching.length / perPage));
      if (currentPage > totalPages) currentPage = totalPages;

      const start = (currentPage - 1) * perPage;
      const end = start + perPage;
      const visibleIds = new Set(matching.slice(start, end));

      let visible = 0;
      items.forEach((item) => {
        const matchFilter = item.dataset.filterMatch === 'true';
        const show = matchFilter && visibleIds.has(item);
        item.classList.toggle('media-card--hidden', !show);
        if (show) visible += 1;
        const isNsfw = item.dataset.nsfw === 'true';
        if (isNsfw && nsfwMode === 'safe') item.classList.remove('media-card--revealed');
      });

      if (emptyEl) emptyEl.classList.toggle('hidden', matching.length > 0);
      if (paginationEl) paginationEl.classList.toggle('hidden', totalPages <= 1);
      if (pageStatus) pageStatus.textContent = `Page ${currentPage} of ${totalPages}`;
      if (pagePrev) pagePrev.disabled = currentPage <= 1;
      if (pageNext) pageNext.disabled = currentPage >= totalPages;

      syncLightboxGallery();
    }

    function resetGateForm() {
      if (gateAge) gateAge.checked = false;
      const gateRemember = document.querySelector<HTMLInputElement>('[data-nsfw-gate-remember]');
      if (gateRemember) gateRemember.checked = false;
      if (gateConfirm) gateConfirm.disabled = true;
    }

    function openGate(target: HTMLElement | null = null) {
      if (!gate) return;
      pendingRevealItem = target;
      resetGateForm();
      gate.classList.remove('hidden');
      gate.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      gateConfirm?.focus();
    }

    initNsfwGateOnce(
      (remember) => setNsfwMode('nsfw', remember),
      () => {
        pendingRevealItem = null;
      },
    );

    function requestNsfwAccess(target: HTMLElement | null = null) {
      if (nsfwMode === 'nsfw') {
        if (target) target.classList.add('media-card--revealed');
        return;
      }

      const remembered = readStoredMode();
      if (remembered === 'nsfw') {
        setNsfwMode('nsfw', true);
        if (target) target.classList.add('media-card--revealed');
        return;
      }

      openGate(target);
    }

    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        activeFilter = btn.dataset.mediaFilter ?? 'all';
        currentPage = 1;
        filterBtns.forEach((b) => b.setAttribute('aria-selected', b === btn ? 'true' : 'false'));
        updateSectionHeader(btn);
        applyFilters();
      });
    });

    filterJumpBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetId = btn.dataset.mediaFilterJump;
        const targetBtn = filterBtns.find((b) => b.dataset.mediaFilter === targetId);
        targetBtn?.click();
      });
    });

    pagePrev?.addEventListener('click', () => {
      if (currentPage <= 1) return;
      currentPage -= 1;
      applyFilters();
    });

    pageNext?.addEventListener('click', () => {
      currentPage += 1;
      applyFilters();
    });

    window.addEventListener('resize', () => {
      currentPage = 1;
      applyFilters();
    });

    nsfwBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const mode = (btn.dataset.nsfwMode as NsfwMode) ?? 'safe';
        if (mode === nsfwMode) return;

        if (mode === 'safe') {
          const remember = readStoredMode() !== null;
          setNsfwMode('safe', remember);
          return;
        }

        requestNsfwAccess();
      });
    });

    allInteractiveItems.forEach((item) => {
      if (item.dataset.nsfw !== 'true') return;

      const overlay = item.querySelector<HTMLButtonElement>('.media-card__nsfw');
      overlay?.addEventListener('click', (e) => {
        e.stopPropagation();
        e.preventDefault();
        requestNsfwAccess(item);
      });
    });

    allInteractiveItems.forEach((item) => {
      if (item.dataset.mediaType !== 'image') return;
      const trigger = item.querySelector<HTMLButtonElement>('[data-media-lightbox-trigger]');
      trigger?.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        if (item.dataset.nsfw === 'true' && !item.classList.contains('media-card--revealed')) {
          requestNsfwAccess(item);
          return;
        }
        openLightboxForItem(item);
      });
    });

    const remembered = readStoredMode();
    if (remembered === 'nsfw') {
      nsfwMode = 'nsfw';
      updateToggleUi();
      revealNsfwItems();
    } else {
      updateToggleUi();
    }

    applyFilters();
    updateSectionHeader();
  }

  initMediaGallery();
  document.addEventListener('astro:page-load', initMediaGallery);
</script>
