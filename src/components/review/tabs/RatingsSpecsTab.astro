---
import type { Product, RatingCategory as ProductRatingCategory } from '../../../data/products';
import type { DraftCategory, DraftRatingsViewModel } from '../../../lib/draft-ratings/types';
import RatingCategory from './RatingCategory.astro';
import DetailLevelControl from '../DetailLevelControl.astro';
import RatingsViewControls from '../RatingsViewControls.astro';
import RatingsScoringWeights from '../RatingsScoringWeights.astro';
import RatingsEvidenceDrawer from '../RatingsEvidenceDrawer.astro';
import { loadDraftRatingsViewModel } from '../../../lib/draft-ratings/loadDraftRatingsData';
import {
  buildSubscoreCalcHeadline,
  buildSubscoreCalcScope,
} from '../../../lib/draft-ratings/evidenceDrawerContent';
import { getSubscoreDescription } from '../../../data/subscore-descriptions';
import { buildSubscoreCalcDrawer } from '../../../lib/ratings/evidenceGroupScoring';
import { buildDrawerNavChain } from '../../../lib/draft-ratings/drawerNav';
import { deferPayAsYouGoScores, iconForEvidenceDef, PRICING_BENCHMARK_PENDING_NOTE } from '../../../lib/ratings/evidenceIcons';
import '../ratings-evidence.css';
import '../ratings-body.css';

interface Props {
  product: Product;
  preview?: boolean;
  /** Pre-loaded model — skips a duplicate DB fetch when the page already loaded it. */
  ratingsModel?: DraftRatingsViewModel;
}

const { product, preview = false, ratingsModel: ratingsModelProp } = Astro.props;
const ratingsModel =
  ratingsModelProp ?? (await loadDraftRatingsViewModel(product, { preview }));

const enrichedByKey = new Map(ratingsModel.categories.map((c) => [c.slug, c]));

/** Prefer draft subscore structure (methodology) over stale published snapshots. */
function displayCategory(productCat: ProductRatingCategory, draftCat?: DraftCategory): ProductRatingCategory {
  if (!draftCat?.subscores.length) return productCat;
  return {
    ...productCat,
    score: draftCat.score ?? productCat.score,
    subscores: draftCat.subscores.map((ds) => {
      const ps = productCat.subscores.find(
        (s) => s.name === ds.name || s.name.toLowerCase().replace(/\s+/g, '-') === ds.slug,
      );
      return {
        name: ds.name,
        score: ds.score ?? ps?.score ?? null,
        weight: ps?.weight ?? 25,
        description: ds.finding ?? ps?.description ?? getSubscoreDescription(draftCat.slug, ds.name),
        contributors: ps?.contributors ?? [],
      };
    }),
  };
}

const displayCategories = product.categories.map((cat) =>
  displayCategory(cat, enrichedByKey.get(cat.key)),
);

const drawerNavById = buildDrawerNavChain(ratingsModel.categories);

const approvedTakeaways = ratingsModel.approvedSubscoreTakeaways ?? new Map<string, string>();

const allEvidenceCategories = ratingsModel.categories.flatMap((c) =>
  c.subscores.flatMap((s) => s.evidenceCategories),
);

const subscoreCalcs = ratingsModel.categories.flatMap((cat) =>
  cat.subscores.map((sub) => {
    const productCat = product.categories.find((c) => c.key === cat.slug);
    const productSub = productCat?.subscores.find((s) => s.name === sub.name);
    const iconByName = new Map(
      (productSub?.contributors ?? []).map((c) => [c.label, c.icon ?? 'analytics']),
    );
    const deferScores = deferPayAsYouGoScores(product.slug, sub.slug);
    const { rows, excludedNames, computedScore } = buildSubscoreCalcDrawer(
      cat.slug,
      sub.slug,
      sub.evidenceCategories.map((ec) => ({ name: ec.name, score: ec.score })),
      { deferScores },
    );
    const items = rows.map((row, i) => ({
      name: row.name,
      score: row.score,
      weight: row.weight,
      icon: iconForEvidenceDef(sub.evidenceCategories[i]?.slug ?? '', row.name) ?? iconByName.get(row.name) ?? 'analytics',
      contribution: row.contribution,
      excluded: row.excluded,
    }));
    const excludedNote =
      deferScores && excludedNames.length === 0 ? PRICING_BENCHMARK_PENDING_NOTE : undefined;
    const scopeSource =
      sub.scopeDescription ||
      productSub?.description ||
      getSubscoreDescription(cat.slug, sub.name);
    const calcId = `subscore-calc-${cat.slug}-${sub.slug}`;
    const nav = drawerNavById.get(calcId) ?? {};
    return {
      drawerId: calcId,
      categorySlug: cat.slug,
      subscoreSlug: sub.slug,
      categoryName: cat.name,
      categoryWeight: cat.weight,
      subscoreName: sub.name,
      subscoreScore: computedScore ?? sub.score,
      scopeDescription: buildSubscoreCalcScope(product.name, sub.name, scopeSource),
      headlineConclusion: buildSubscoreCalcHeadline(sub.name, items),
      keyTakeaways: approvedTakeaways.get(`${cat.slug}/${sub.slug}`) ?? '—',
      items,
      excludedNote,
      prevLabel: cat.name,
      nextDrawerId: nav.nextDrawerId,
      nextLabel: nav.nextLabel,
    };
  }),
);
---

<section class="rft" data-ratings-root data-detail-level="medium">
  <div class="rft__page">
    <header class="rft-head">
      <div class="rft-head__text">
        <h2 class="rft-head__title">How {product.name} scored</h2>
        <p class="rft-head__intro">Every score comes from the subscores and the evidence behind it.</p>
      </div>
      <RatingsViewControls product={product} />
    </header>

    <DetailLevelControl />

    <div class="rft-layout">
      <div class="rft-list" data-accordion-group>
        {
          product.categories.map((category, index) => {
            const verdict = product.verdicts.find((v) => v.id === category.key);
            return (
              <RatingCategory
                category={displayCategories[index] ?? category}
                enrichedCategory={enrichedByKey.get(category.key)}
                productName={product.name}
                productSlug={product.slug}
                headline={verdict?.tagline}
                summary={verdict?.summary}
                open={true}
              />
            );
          })
        }
      </div>
      <RatingsScoringWeights product={product} />
    </div>
  </div>

  <RatingsEvidenceDrawer
    evidenceCategories={allEvidenceCategories}
    subscoreCalcs={subscoreCalcs}
    drawerNavById={Object.fromEntries(drawerNavById)}
    productName={product.name}
    lastTested={ratingsModel.overview.lastTested}
    methodologyVersion={ratingsModel.overview.methodologyVersion}
  />
</section>

