---
import type { Product } from '../../../data/products';
import { buildReviewToc, renderReviewBlocksHtml, reviewReadingMinutes } from '../../../lib/review/renderReviewBlocks';
import { getPublishedGlossaryTermsForTooltips } from '../../../lib/glossary/load';

interface Props {
  product: Product;
}

const { product } = Astro.props;

const reviewBlocks = product.reviewBlocks ?? [];
const hasSavedReview = reviewBlocks.length > 0;

const mediaById = product.reviewMediaById ?? {};
if (Object.keys(mediaById).length === 0) {
  for (const item of product.mediaItems ?? []) {
    mediaById[item.id] = {
      url: item.src,
      altText: item.alt,
      mediaType: item.type,
      adult: Boolean(item.nsfw),
    };
  }
}
for (const item of product.gallery ?? []) {
  if (!item.full) continue;
  const galleryId = `gallery-${item.full}`;
  if (!mediaById[galleryId]) {
    mediaById[galleryId] = { url: item.full, altText: item.alt, mediaType: 'image' };
  }
}

const sections = hasSavedReview
  ? buildReviewToc(reviewBlocks)
  : [
      { id: 'first-impressions', label: 'First Impressions', level: 3 as const },
      { id: 'chat-experience', label: 'Chat Experience', level: 3 as const },
      { id: 'media-experience', label: 'Media Experience', level: 3 as const },
      { id: 'pricing-in-real-use', label: 'Pricing in Real Use', level: 3 as const },
      { id: 'what-stands-out', label: 'What Stands Out', level: 3 as const },
      { id: 'what-frustrated-me', label: 'What Frustrated Me', level: 3 as const },
      { id: 'final-recommendation', label: 'Final Recommendation', level: 3 as const },
    ];

const glossaryTerms = hasSavedReview ? await getPublishedGlossaryTermsForTooltips() : [];

const savedReviewHtml = hasSavedReview
  ? renderReviewBlocksHtml(reviewBlocks, { mediaById, glossaryTerms })
  : '';

const readingMinutes = hasSavedReview ? reviewReadingMinutes(reviewBlocks) : 5;

const author = product.authors?.[0];
const authorHref = author?.slug ? `/author/${author.slug}/` : undefined;
const authorName = author?.name ?? 'Herman Carter';
const authorAvatar = author?.avatar ?? '/brand/herman-main-icon.webp';

const deck =
  product.seo?.searchExcerpt?.trim() ||
  product.directoryDescription?.trim() ||
  product.ourTake?.trim() ||
  product.tagline?.trim() ||
  `What hands-on testing of ${product.name} was really like.`;

const updatedLabel = product.modifiedDate
  ? product.modifiedDate.toLowerCase().startsWith('updated')
    ? product.modifiedDate
    : `Updated ${product.modifiedDate}`
  : null;
---

<section data-review-article>
  <div class="review-article-layout">
    <div class="review-article-main">
      <header class="review-article-head">
        <div class="review-article-eyebrow">
          <span class="review-article-eyebrow__mark" aria-hidden="true"></span>
          <span class="review-article-eyebrow__text">Full review</span>
        </div>
        <h2 class="review-article-title">{product.name} Hands-On Review</h2>
        <p class="review-article-deck">{deck}</p>
        <div class="review-article-meta">
          <img
            class="review-article-meta__avatar"
            src={authorAvatar}
            alt=""
            width="28"
            height="28"
          />
          {
            authorHref ? (
              <a class="review-article-meta__author" href={authorHref}>{authorName}</a>
            ) : (
              <span class="review-article-meta__author">{authorName}</span>
            )
          }
          <span class="review-article-meta__dot" aria-hidden="true">·</span>
          <span>{readingMinutes} min read</span>
          {
            updatedLabel && (
              <>
                <span class="review-article-meta__dot" aria-hidden="true">·</span>
                <span>{updatedLabel}</span>
              </>
            )
          }
        </div>
      </header>

      {
        sections.length > 0 && (
          <details class="review-jump" data-review-jump>
            <summary class="review-jump__summary">
              <svg class="review-jump__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
              <span class="review-jump__label">Jump to section</span>
              <svg class="review-jump__chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </summary>
            <nav aria-label="Jump to section">
              <ol class="review-jump__list">
                {
                  sections.map((s, i) => (
                    <li>
                      <a class:list={['review-jump__link', { 'is-active': i === 0 }]} href={`#${s.id}`} data-review-toc-link>
                        <span class="review-jump__dot" aria-hidden="true"></span>
                        {s.label}
                      </a>
                    </li>
                  ))
                }
              </ol>
            </nav>
          </details>
        )
      }

      <article class="review-article prose-review">
        {
          hasSavedReview ? (
            <div class="review-blocks" set:html={savedReviewHtml} />
          ) : (
            <>
              <section id="first-impressions" class="review-section">
                <h3 class="review-heading">First Impressions</h3>
                <p>
                  I opened {product.name} expecting another polished chat wrapper, and the first surprise was how quickly
                  the characters felt like people rather than templates. Setup was straightforward — no awkward onboarding
                  quiz — and I was talking to a companion within a couple of minutes.
                </p>
                <p>
                  What felt good: the UI is clean, the default character has personality, and nothing screams "beta product."
                  What felt a little awkward: a few premium features are visible before you upgrade, which nudges you early
                  even if you are just exploring.
                </p>
              </section>

              <section id="chat-experience" class="review-section">
                <h3 class="review-heading">Chat Experience</h3>
                <p>
                  This is where {product.name} earns most of its score for me. Replies stay in character, remember context
                  across sessions better than average, and rarely fall into the generic "As an AI language model…" trap.
                </p>
                <p>
                  What surprised me: emotional beats land — frustration, flirtation, inside jokes — without me having to
                  over-direct every message. What annoyed me: occasional repetition after long sessions, especially when
                  I pushed the same scenario for 30+ minutes.
                </p>
                <p>
                  In real use, the chat score mostly means "will I keep coming back?" For {product.name}, yes — at least
                  for roleplay-heavy sessions.
                </p>
              </section>

              <section id="media-experience" class="review-section">
                <h3 class="review-heading">Media Experience</h3>
                <p>
                  Images and video are a mixed bag. When generation hits, results can look genuinely good — especially
                  character portraits that match the chat persona. When it misses, you wait longer than you'd like for
                  something slightly off-model.
                </p>
                <p>
                  What felt good: voice notes and call-style features add immersion without feeling gimmicky. What felt
                  awkward: switching between chat and media modes breaks the fantasy for a few seconds while assets load.
                </p>
              </section>

              <section id="pricing-in-real-use" class="review-section">
                <h3 class="review-heading">Pricing in Real Use</h3>
                {
                  product.pricingDisplay.typicalMonthly && (
                    <aside class="review-callout" role="note">
                      <div class="review-callout__label">
                        <svg class="review-callout__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                          <path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                          <path d="M9 18h6M10 22h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                        </svg>
                        <span>Tip</span>
                      </div>
                      <div class="review-callout__body">
                        Typical monthly spend: {product.pricingDisplay.typicalMonthly} for a regular user
                        (subscription plus any extra tokens needed). Sticker price starts at {product.pricingDisplay.monthly}.
                      </div>
                    </aside>
                  )
                }
                <p>
                  On paper, {product.name} sits in the mid-premium tier. In practice, the free tier is usable enough to
                  understand the product, but the meaningful features — better models, faster media, deeper memory — sit
                  behind the paywall fast.
                </p>
                <p>
                  What the pricing numbers meant for me: I would pay if chat quality is my priority; I'd hesitate if I
                  mainly want unlimited image generation. The value depends on how often you actually open the app, not
                  the feature list alone.
                </p>
              </section>

              <section id="what-stands-out" class="review-section">
                <h3 class="review-heading">What Stands Out</h3>
                <p>
                  Character depth and consistency. {product.name} does not just offer quantity — the companions feel
                  differentiated, and that makes repeat sessions more interesting than swapping skins on the same bot.
                </p>
                <p>
                  The overall performance score reflects that strength: this is a product built for people who want an
                  ongoing relationship with a persona, not a one-off prompt toy.
                </p>
              </section>

              <section id="what-frustrated-me" class="review-section">
                <h3 class="review-heading">What Frustrated Me</h3>
                <p>
                  Media latency is the main friction point. When I am in a flow state chatting, waiting 10–15 seconds
                  for an image pulls me out. Privacy settings also take a bit of digging — not terrible, but not as
                  front-and-center as I'd prefer for this category.
                </p>
                <p>
                  Minor UI nits add up: some buttons look tappable but aren't, and the upgrade prompts appear at
                  emotionally bad moments (mid-conversation).
                </p>
              </section>

              <section id="final-recommendation" class="review-section">
                <h3 class="review-heading">Final Recommendation</h3>
                <p>
                  Would I keep using {product.name}? Yes — primarily for chat and character variety. I'd treat media
                  as a bonus, not the main reason to subscribe.
                </p>
                <p>
                  If you want a companion that feels present, remembers you, and supports longer roleplay arcs,
                  {product.name} is an easy recommend. If you need fast, unlimited visual generation or the cheapest
                  entry point, look elsewhere first — then come back if the conversation quality wins you over.
                </p>
              </section>
            </>
          )
        }
      </article>

      <footer class="review-article-end">
        <img class="review-article-end__avatar" src={authorAvatar} alt="" width="40" height="40" />
        <div class="review-article-end__copy">
          {
            authorHref ? (
              <a class="review-article-end__by" href={authorHref}>Written by {authorName}</a>
            ) : (
              <p class="review-article-end__by">Written by {authorName}</p>
            )
          }
          <p class="review-article-end__note">Every claim in this review is scored with evidence in Ratings &amp; Tests.</p>
        </div>
        <button type="button" class="review-article-end__scores" data-tab="ratings">
          See the scores →
        </button>
      </footer>
    </div>

    {
      sections.length > 0 && (
        <aside class="review-toc" data-review-toc aria-label="In this review">
          <p class="review-toc__title">In this review</p>
          <nav>
            <ol class="review-toc__list">
              {
                sections.map((s, i) => (
                  <li class:list={['review-toc__item', { 'review-toc__item--h3': s.level === 3 }]}>
                    <a
                      class:list={['review-toc__link', { 'is-active': i === 0 }]}
                      href={`#${s.id}`}
                      data-review-toc-link
                      data-review-toc-level={s.level}
                    >
                      <span class="review-toc__bar" aria-hidden="true"></span>
                      <span class="review-toc__text">{s.label}</span>
                    </a>
                  </li>
                ))
              }
            </ol>
          </nav>
        </aside>
      )
    }
  </div>
</section>

<script>
  import { deferUntilIdle } from '../../../lib/ui/deferUntilIdle';

  function showNsfwComingSoonToast() {
    let toast = document.querySelector<HTMLElement>('[data-nsfw-toast]');
    if (!toast) {
      toast = document.createElement('div');
      toast.className = 'review-nsfw-toast';
      toast.dataset.nsfwToast = 'true';
      toast.setAttribute('role', 'status');
      toast.textContent = '18+ Content coming soon..';
      document.body.appendChild(toast);
    }

    toast.classList.remove('is-visible');
    void toast.offsetWidth;
    toast.classList.add('is-visible');

    window.clearTimeout(Number(toast.dataset.hideTimer || 0));
    const timer = window.setTimeout(() => {
      toast?.classList.remove('is-visible');
    }, 2200);
    toast.dataset.hideTimer = String(timer);
  }

  function initNsfwGates() {
    const root = document.querySelector('[data-review-article]');
    if (!root || root.dataset.nsfwBound === 'true') return;
    root.dataset.nsfwBound = 'true';

    root.addEventListener('click', (e) => {
      const gate = (e.target as HTMLElement).closest<HTMLElement>('[data-nsfw-gate]');
      if (!gate || !root.contains(gate)) return;
      e.preventDefault();
      e.stopPropagation();
      showNsfwComingSoonToast();
    });

    root.addEventListener('keydown', (e) => {
      if (e.key !== 'Enter' && e.key !== ' ') return;
      const gate = (e.target as HTMLElement).closest<HTMLElement>('[data-nsfw-gate]');
      if (!gate || !root.contains(gate)) return;
      e.preventDefault();
      showNsfwComingSoonToast();
    });
  }

  function initReviewToc() {
    const root = document.querySelector('[data-review-article]');
    if (!root || root.dataset.bound === 'true') return;
    root.dataset.bound = 'true';

    const jump = root.querySelector<HTMLDetailsElement>('[data-review-jump]');
    const links = Array.from(root.querySelectorAll<HTMLAnchorElement>('[data-review-toc-link]'));
    if (links.length === 0) return;

    links.forEach((link) => {
      link.addEventListener('click', () => {
        if (jump && window.innerWidth < 1100) jump.open = false;
      });
    });

    const headings = links
      .map((l) => document.querySelector(l.getAttribute('href') || ''))
      .filter((el, i, arr) => Boolean(el) && arr.indexOf(el) === i) as Element[];

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const id = entry.target.id;
          links.forEach((l) => {
            l.classList.toggle('is-active', l.getAttribute('href') === `#${id}`);
          });
        });
      },
      { rootMargin: '-30% 0px -55% 0px', threshold: 0 },
    );

    headings.forEach((h) => observer.observe(h));
  }

  deferUntilIdle(() => {
    initReviewToc();
    initNsfwGates();
  });
  document.addEventListener('astro:page-load', () => {
    initReviewToc();
    initNsfwGates();
  });
</script>
