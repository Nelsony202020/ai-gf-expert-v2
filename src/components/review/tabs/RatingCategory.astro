---
import type { RatingCategory as RatingCategoryType } from '../../../data/products';
import type { DraftCategory } from '../../../lib/draft-ratings/types';
import { deferPricingBenchmarkScores, PRICING_BENCHMARK_PENDING_NOTE } from '../../../lib/ratings/evidenceIcons';
import { fmtScore } from '../../../lib/scores';
import { figmaScoreBarWidth, getFigmaScoreTone } from '../../../lib/ratings/figmaScoreTone';
import EvidenceCategoryTable from '../EvidenceCategoryTable.astro';
import RatingsCategoryIcon from '../RatingsCategoryIcon.astro';
import { buildReviewRatingsHash } from '../../../lib/review/ratingsDeepLink';

interface Props {
  category: RatingCategoryType;
  enrichedCategory?: DraftCategory;
  productName?: string;
  productSlug?: string;
  headline?: string;
  summary?: string;
  open?: boolean;
}

const {
  category,
  enrichedCategory,
  productSlug,
  headline,
  summary,
  open = false,
} = Astro.props;
const categoryLabel = category.key === 'pricing' ? 'Pricing' : category.name;
const subscoreCount = category.subscores.length;
const subscoreMeta = `${subscoreCount} subscore${subscoreCount === 1 ? '' : 's'} · ${category.weight}% of overall score`;
const contentId = `ratings-panel-${category.key}`;
const tone = getFigmaScoreTone(category.score);
const barWidth = figmaScoreBarWidth(category.score);

const subscorePanels = category.subscores.map((sub, i) => {
  const enrichedSub = enrichedCategory?.subscores.find((s) => s.name === sub.name);
  const evidenceCategories = enrichedSub?.evidenceCategories ?? [];
  const calcDrawerId = enrichedSub
    ? `subscore-calc-${enrichedCategory?.slug}-${enrichedSub.slug}`
    : undefined;
  const evidenceCount = evidenceCategories.length || sub.contributors.length;
  return {
    sub,
    index: i,
    evidenceCategories,
    calcDrawerId,
    evidenceCount,
    tone: getFigmaScoreTone(sub.score),
  };
});
const sectionHash = buildReviewRatingsHash(category.key);
---

<div class="rft-cat" id={sectionHash} data-category={category.key}>
  <button
    type="button"
    data-accordion-toggle
    aria-expanded={open ? 'true' : 'false'}
    aria-controls={contentId}
    aria-label={`Toggle ${categoryLabel} details`}
    class="rft-cat__toggle"
  >
    <span class="rft-cat__icon">
      <RatingsCategoryIcon categoryKey={category.key} />
    </span>
    <span class="rft-cat__main">
      <span class="rft-cat__top">
        <span class="rft-cat__copy">
          <span class="rft-cat__name ratings-accordion__title">{categoryLabel}</span>
          <span class="rft-cat__meta">{subscoreMeta}</span>
        </span>
        <span class:list={['rft-cat__score', `rft-score--${tone}`]}>{fmtScore(category.score)}</span>
      </span>
      <span class="rft-cat__track" aria-hidden="true">
        <span class:list={['rft-cat__fill', `rft-score-fill--${tone}`]} style={`width: ${barWidth}`}></span>
      </span>
    </span>
    <span class="rft-cat__chevron" aria-hidden="true">
      <img
        class="rft-cat__chevron-img rft-cat__chevron-img--down"
        src="/icons/ratings/chevron-down.svg"
        width="16"
        height="16"
        alt=""
      />
      <img
        class="rft-cat__chevron-img rft-cat__chevron-img--up"
        src="/icons/ratings/chevron-up.svg"
        width="16"
        height="16"
        alt=""
      />
    </span>
  </button>

  <div id={contentId} data-accordion-content class:list={['rft-cat__panel', !open && 'hidden']}>
    <div class="rft-cat__body" data-subscore-grid>
      {
        (headline || summary) && (
          <div class="rft-summary">
            {headline && <p class="rft-summary__headline">{headline}</p>}
            {summary && <p class="rft-summary__text">{summary}</p>}
          </div>
        )
      }
      <p class="rft-subscores-label">Subscores</p>
      <div class="rft-subscores" data-subscore-list>
        {
          subscorePanels.map(({ sub, index: i, evidenceCount, tone: subTone }) => {
            const evidenceId = `evidence-region-${category.key}-${i}`;
            return (
            <button
              type="button"
              class="rft-subscore"
              data-subscore-select
              data-subscore-index={i}
              data-score-text={fmtScore(sub.score)}
              aria-expanded="false"
              aria-controls={evidenceId}
            >
              <span class="rft-subscore__top">
                <span class:list={['rft-subscore__score', `rft-score--${subTone}`]}>{fmtScore(sub.score)}</span>
                <img
                  data-subscore-chevron
                  class="rft-subscore__chevron"
                  src="/icons/ratings/chevron-right.svg"
                  width="16"
                  height="16"
                  alt=""
                />
              </span>
              <span data-subscore-label class="rft-subscore__name">
                {sub.name}
              </span>
              <span class="rft-subscore__meta">
                {evidenceCount} evidence item{evidenceCount === 1 ? '' : 's'}
              </span>
            </button>
            );
          })
        }
      </div>
      <div class="rft-evidence-stack" data-evidence-stack>
        <div class="rft-evidence-stack__clip">
        {
          subscorePanels.map(({ sub, index: i, calcDrawerId, evidenceCategories }) => {
            const enrichedSub = enrichedCategory?.subscores.find((s) => s.name === sub.name);
            const showBenchmarkNote =
              category.key === 'pricing' &&
              productSlug &&
              enrichedSub &&
              deferPricingBenchmarkScores(productSlug, enrichedSub.slug);
            const tableId = `evidence-${category.key}-${sub.name}`.replace(/[^a-zA-Z0-9_-]/g, '-');
            const evidenceId = `evidence-region-${category.key}-${i}`;
            const deferScores =
              enrichedSub && productSlug && deferPricingBenchmarkScores(productSlug, enrichedSub.slug);
            return (
              <div
                id={evidenceId}
                data-subscore-panel
                data-subscore-breakdown
                data-detail-tier="deep"
                data-subscore-index={i}
                class="rft-evidence-slot"
                aria-hidden="true"
                inert
              >
                <div class="rft-evidence-slot__inner">
                <div class="rft-evidence">
                <div class="rft-evidence__head">
                  <p class="rft-evidence__title">Evidence · {sub.name}</p>
                  {calcDrawerId && (
                    <button
                      type="button"
                      class="rft-evidence__why"
                      data-ratings-open-drawer={calcDrawerId}
                      aria-haspopup="dialog"
                      aria-label={`Why ${deferScores ? 'this score' : fmtScore(sub.score)}? Open score calculation`}
                    >
                      Why {deferScores ? 'this score' : fmtScore(sub.score)}?
                      <img src="/icons/ratings/arrow-right.svg" width="13" height="13" alt="" />
                    </button>
                  )}
                </div>
                {showBenchmarkNote && (
                  <p class="rft-evidence__note" role="note">
                    {PRICING_BENCHMARK_PENDING_NOTE}
                  </p>
                )}
                <EvidenceCategoryTable tableId={tableId} items={
                  evidenceCategories.length > 0
                    ? evidenceCategories
                    : sub.contributors.map((c, ci) => ({
                        slug: c.label.toLowerCase().replace(/\s+/g, '-'),
                        name: c.label,
                        score: deferScores ? null : c.internalScore ?? sub.score,
                        summary: c.value,
                        cardTeaser: c.value,
                        testResults: [],
                        drawerId: `evidence-fallback-${category.key}-${i}-${ci}`,
                        proofCount: 0,
                        proofLabel: '',
                        selectedProof: [],
                      }))
                } hideScores={deferScores} />
                <p class="rft-evidence__foot">
                  <span class="rft-evidence__foot-desktop">
                    Showing evidence for the selected subscore. Pick another subscore card to switch tables.
                  </span>
                  <span class="rft-evidence__foot-mobile">
                    Showing evidence for the selected subscore. Tap another subscore card to switch tables.
                  </span>
                </p>
                </div>
                </div>
              </div>
            );
          })
        }
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function initSubscoreSelect() {
    document.querySelectorAll<HTMLElement>('[data-ratings-root] [data-category]').forEach((categoryEl) => {
      if (categoryEl.dataset.subscoreBound === 'true') return;
      categoryEl.dataset.subscoreBound = 'true';

      const cards = Array.from(categoryEl.querySelectorAll<HTMLElement>('[data-subscore-select]'));
      const panels = Array.from(categoryEl.querySelectorAll<HTMLElement>('[data-subscore-panel]'));
      if (!cards.length || !panels.length) return;

      let activeIndex: string | null = null;
      const stack = categoryEl.querySelector<HTMLElement>('[data-evidence-stack]');
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      let collapseTimer = 0;

      function syncPanel(panel: HTMLElement, isActive: boolean) {
        panel.classList.toggle('is-open', isActive);
        panel.setAttribute('aria-hidden', isActive ? 'false' : 'true');
        panel.toggleAttribute('inert', !isActive);
      }

      function applySubscoreState(index: string | null, scrollToBreakdown = false) {
        window.clearTimeout(collapseTimer);
        activeIndex = index;
        cards.forEach((card) => {
          const isActive = index != null && card.dataset.subscoreIndex === index;
          card.setAttribute('aria-expanded', isActive ? 'true' : 'false');
          card.classList.toggle('rft-subscore--selected', isActive);
        });

        const grid = categoryEl.querySelector<HTMLElement>('[data-subscore-grid]');
        if (index) {
          panels.forEach((panel) => syncPanel(panel, panel.dataset.subscoreIndex === index));
          grid?.setAttribute('data-subscore-open', 'true');
          stack?.classList.add('is-open');
        } else {
          stack?.classList.remove('is-open');
          grid?.removeAttribute('data-subscore-open');
          const hide = () => panels.forEach((panel) => syncPanel(panel, false));
          if (reduceMotion) hide();
          else collapseTimer = window.setTimeout(hide, 200);
        }

        if (scrollToBreakdown && index) {
          requestAnimationFrame(() => {
            categoryEl
              .querySelector<HTMLElement>(`[data-subscore-panel][data-subscore-index="${index}"].is-open`)
              ?.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'nearest' });
          });
        }
      }

      function clearSubscoreSelection() {
        applySubscoreState(null);
      }

      function selectSubscore(index: string, scrollToBreakdown = false) {
        applySubscoreState(index, scrollToBreakdown);
      }

      categoryEl.clearSubscoreSelection = clearSubscoreSelection;
      categoryEl.selectSubscore = selectSubscore;

      cards.forEach((card) => {
        card.addEventListener('click', (e) => {
          if ((e.target as HTMLElement).closest('.rt-tooltip-trigger')) return;
          if ((e.target as HTMLElement).closest('[data-ratings-open-drawer]')) return;
          const index = card.dataset.subscoreIndex;
          if (index === undefined) return;
          if (activeIndex === index) {
            applySubscoreState(null);
            return;
          }
          applySubscoreState(index, true);
        });
      });

      const root = document.querySelector<HTMLElement>('[data-ratings-root]');
      const content = categoryEl.querySelector<HTMLElement>('[data-accordion-content]');
      const isOpen = content && !content.classList.contains('hidden');
      const level = root?.dataset.detailLevel ?? 'medium';
      if (level === 'all-in' && isOpen) {
        selectSubscore('0', false);
      } else {
        clearSubscoreSelection();
      }
    });
  }

  /*
    Each level owns the evidence state, rather than only All setting it:

      skim    category collapsed, nothing selected
      medium  category open, subscores visible, evidence closed
      all-in  category open, evidence open

    Previously skim and medium left the subscore selection alone, so All ->
    Medium kept every evidence panel open, and Skim only hid it behind the
    collapsed category — reopening at Medium brought it straight back. Clearing
    here does not lock Medium down: the card click handler is untouched, so a
    subscore clicked while on Medium still opens its evidence.
  */
  document.addEventListener('detail-level-change', ((e: CustomEvent) => {
    const level = e.detail?.level;
    document.querySelectorAll<HTMLElement>('[data-ratings-root] [data-category]').forEach((el) => {
      const content = el.querySelector<HTMLElement>('[data-accordion-content]');
      const isOpen = content && !content.classList.contains('hidden');
      if (level === 'all-in') {
        if (!isOpen) return;
        const alreadyOpen = el.querySelector('[data-subscore-select][aria-expanded="true"]');
        if (!alreadyOpen) el.selectSubscore?.('0', false);
        return;
      }
      el.clearSubscoreSelection?.();
    });
  }) as EventListener);

  initSubscoreSelect();
  document.addEventListener('astro:page-load', initSubscoreSelect);
</script>
