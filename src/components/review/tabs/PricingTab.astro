    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.2rem;
    max-width: 22rem;
    padding: 0.85rem 1rem 0.95rem;
    border: 1px solid rgb(219 39 119 / 18%);
    border-radius: 0.85rem;
    background: rgb(253 242 248 / 75%);
