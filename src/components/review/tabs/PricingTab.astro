    font-size: 1.125rem;
    color: #db2777;
  }

  .pt-menu-select__menu {
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    z-index: 40;
    min-width: 100%;
    width: max-content;
    max-width: min(16rem, calc(100vw - 2rem));
    padding: 0.35rem;
    border: 1px solid #e5e7eb;
    border-radius: 0.75rem;
    background: #fff;
    box-shadow: 0 10px 28px rgb(15 23 42 / 12%);
