                      }
                      {
                        vm.pricingEvidence?.topUps && (
                          <p class="pt-evidence pt-evidence--inline">
                            <button
                              type="button"
                              class="pt-evidence__view"
                              data-lightbox-open={vm.pricingEvidence.topUps.src}
                              data-lightbox-alt={vm.pricingEvidence.topUps.alt}
                              data-lightbox-caption={`${vm.pricingEvidence.verifiedLabel}. ${vm.pricingEvidence.capturedLabel}`}
                            >
                              <span class="material-symbols-outlined" aria-hidden="true">image</span>
                              View top-up pricing screenshot
                            </button>
                          </p>
                        )
                      }
                    </div>
          </div>
        </div>
      )}
    </section>

    <section class="pt2-section" id="pricing-comparison" aria-labelledby="pt-compare-title">
      <h3 class="pt2-h2" id="pt-compare-title">How it compares to the market</h3>
      {vm.compareIntro && <p class="pt2-lead">{vm.compareIntro}</p>}
      {compactCompare.length > 0 && (
        <div class="pt2-market-grid">
          {compactCompare.map((row) => (
            <div>
              <p class="pt2-market-pair__label">{row.metric}</p>
              <dl>
                <div class="pt2-market-row">
                  <dt>{vm.productName}</dt>
                  <dd>{row.productValue}</dd>
                </div>
                <div class="pt2-market-row">
                  <dt>Typical comparison app</dt>
                  <dd>{row.typicalValue}</dd>
                </div>
              </dl>
              <p class:list={['pt2-market-pct', row.diffTone === 'worse' && 'is-bad', row.diffTone === 'better' && 'is-good']}>
                {row.diffLabel}
              </p>
            </div>
          ))}
        </div>
      )}
      <div class="pt2-disclose pt2-disclose--tight" data-pt2-disclose>
        <button type="button" class="pt2-disclose__btn" aria-expanded="false">
          <span class="pt2-disclose__copy">
            <span class="pt2-disclose__title">See full market comparison</span>
            <span class="pt2-disclose__sum">Every metric we compare, including rows where the category has insufficient data.</span>
          </span>
          <span class="pt2-disclose__action" data-closed="View comparison" data-open="Hide comparison">
            <span data-pt2-action-label>View comparison</span>
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
        </button>
        <div class="pt2-disclose__panel" hidden>
          {
            vm.compareRows.length > 0 ? (
          <div class="pt-compare-wrap">
                <table class="pt-compare">
                  <thead>
                    <tr>
                      <th>Metric</th>
                      <th>{vm.productName}</th>
                      <th>Typical price</th>
                      <th>Difference</th>
                    </tr>
                  </thead>
                  <tbody>
                    {
                      vm.compareRows.map((row) => {
                        const productParts = withUnit(row.productValue);
                        const typicalParts = withUnit(row.typicalValue);
                        return (
                          <tr>
                            <td>{row.metric}</td>
                            <td class="pt-compare__highlight">
                              {productParts.main}
                              {productParts.unit && <span class="pt-unit">{productParts.unit}</span>}
                            </td>
                            <td>
                              {typicalParts.main}
                              {typicalParts.unit && <span class="pt-unit">{typicalParts.unit}</span>}
                            </td>
                            <td>
                              <span class={`pt-pill pt-pill--${row.diffTone}`}>{row.diffLabel}</span>
                            </td>
                          </tr>
                        );
                      })
                    }
                  </tbody>
                </table>
              </div>
            ) : (
              <p class="pt-empty">Comparison data is still being verified.</p>
            )
          }
          {
            comparisonNote && (
              <p class="pt-compare-note">{comparisonNote}</p>
            )
          }
        </div>
      </div>
    </section>

    {(vm.hermanTake || vm.pricingScore != null) && (
      <section class="pt2-section" id="pricing-verdict" aria-labelledby="pt-verdict-title">
        <div class="pt2-verdict">
          <div>
            <p class="pt2-verdict__score-label">Pricing score</p>
            {vm.pricingScore != null && (
              <p class="pt2-verdict__score">
                <span class="pt2-verdict__n">{fmtScore(vm.pricingScore)}</span>
                <span class="pt2-verdict__of">/10</span>
              </p>
            )}
          </div>
          <div>
            <h3 class="pt2-verdict__title" id="pt-verdict-title">{vm.scoreInsight || `Our take on ${vm.productName}'s pricing`}</h3>
            {vm.hermanTake && (
              <p class="pt2-verdict__body" set:html={renderReviewProseText(vm.hermanTake, pricingGlossary)} />
            )}
            {herman && (
              <p class="pt2-verdict__byline">
                <strong>{herman.name}</strong>
                {' · '}
                Lead reviewer
              </p>
            )}
          </div>
          <AffiliateLink href={product.affiliateUrl} target="_blank" class="pt2-verdict__cta">
            Visit {vm.productName} ↗
          </AffiliateLink>
        </div>
      </section>
    )}
  </div>
</section>

