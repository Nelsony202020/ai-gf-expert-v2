                                              aria-label={`${ch.label} amount — double-click to type`}
                                            >
                                              0
                                            </button>
                                            <button
                                              type="button"
                                              class="pt-mixer__step"
                                              data-pt-mixer-sheet-inc
                                              aria-label={`Increase ${ch.label}`}
