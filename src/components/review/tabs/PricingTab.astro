  .pt-credit-pool__await-title {
    margin: 0;
    font-size: 0.9375rem;
    font-weight: 800;
    line-height: 1.35;
    color: var(--color-on-surface);
  }

  .pt-credit-pool__await-hint {
    margin: 0.15rem 0 0;
    font-size: 0.8125rem;
    line-height: 1.4;
    color: #6b7280;
  }

  .pt-credit-pool__results {
    margin: 0;
  }

  .pt-credit-pool__results.is-locked {
    position: relative;
  }

  .pt-credit-pool__ghost {
    margin: 0;
  }

  .pt-credit-pool__ghost-panel {
    padding: 1rem 1.05rem 1.1rem;
    border: 1px solid #e5e7eb;
    border-radius: 1rem;
    background: #f9fafb;
    opacity: 0.72;
    filter: grayscale(0.35);
  }

  .pt-credit-pool__ghost-bar {
    height: 0.7rem;
    border-radius: 999px;
    background: linear-gradient(90deg, #e5e7eb, #f3f4f6 55%, #e5e7eb);
  }

  .pt-credit-pool__ghost-bar--lg {
    width: 42%;
    height: 0.85rem;
    margin-bottom: 0.9rem;
  }

  .pt-credit-pool__ghost-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.65rem 0.85rem;
    margin-bottom: 1rem;
  }

  .pt-credit-pool__ghost-bar--tool {
    height: 4.5rem;
    border-radius: 0.85rem;
  }

  .pt-credit-pool__live {
    margin: 0;
  }

  .pt-credit-pool__summary {
    margin: 0.15rem 0 1.25rem;
    padding: 0;
    border: none;
    border-radius: 0;
    background: transparent;
  }

  .pt-credit-pool__summary-plan {
    margin: 0;
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.35;
    color: var(--color-on-surface);
  }

  .pt-credit-pool__summary-meta {
    margin: 0.25rem 0 0;
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.45;
    color: #6b7280;
    font-variant-numeric: tabular-nums;
  }

  .pt-credit-pool__summary .pt-plan-active__sale-note {
    margin-top: 0.35rem;
  }

  .pt-credit-pool__equiv {
    margin: 0 0 0.15rem;
    padding: 0;
    border: none;
    background: transparent;
  }

  .pt-credit-pool__lead {
    margin: 0 0 1rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: #6b7280;
  }

  .pt-credit-pool__skim {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    column-gap: 0;
    row-gap: 1.5rem;
    margin: 0;
  }

  .pt-credit-pool__skim-stat {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.3rem;
    min-width: 0;
    padding: 0 1.15rem;
    background: transparent;
    border: none;
  }

  .pt-credit-pool__skim-stat:nth-child(3n + 1) {
    padding-left: 0;
  }

  .pt-credit-pool__skim-stat:nth-child(3n) {
    padding-right: 0;
  }

  .pt-credit-pool__skim-stat:not(:nth-child(3n))::after {
    content: '';
    position: absolute;
    top: 0.2em;
    right: 0;
    bottom: 0.2em;
    width: 1px;
    background: #e8eae4;
  }

  .pt-credit-pool__skim-amount {
    font-size: 1.875rem;
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--color-on-surface);
    font-variant-numeric: tabular-nums;
  }

  .pt-credit-pool__skim-label {
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.35;
    color: #6b7280;
  }

  .pt-credit-pool__or {
    margin: 1.15rem 0 0;
    font-size: 0.875rem;
    font-weight: 500;
    color: #6b7280;
  }

  .pt-credit-pool__note {
    margin: 0 0 1rem;
    font-size: 0.875rem;
    color: #6b7280;
  }

  .pt-credit-pool__tool-rule {
    margin: 1.5rem 0 0;
    border: none;
    border-top: 1px solid #e5e7eb;
  }

  .pt-mixer-host {
    margin-top: 1.35rem;
  }

  /* Soft boxed panel — same header surface as site chrome, inset so it reads clearly */
  .pt-mixer-host:has([data-pt-mixer]) {
    margin-top: 1.25rem;
    padding: 1.35rem 1.35rem 1.5rem;
    border: 1px solid #e4e8dc;
    border-radius: 14px;
    background: var(--color-header-surface, #f8faf3);
    box-shadow: none;
  }

  @media (min-width: 768px) {
    .pt-mixer-host:has([data-pt-mixer]) {
      padding: 1.5rem 1.6rem 1.65rem;
    }
  }

  .pt-mixer {
    margin-top: 0;
  }

  .pt-mixer__tool-head {
    margin: 0 0 1.15rem;
  }

  .pt-mixer__tool-eyebrow {
    margin: 0 0 0.4rem;
    font-size: 0.625rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #9ca3af;
  }

  .pt-mixer__tool-title {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin: 0 0 0.4rem;
    font-size: 0.9375rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--color-on-surface);
  }

  .pt-mixer__tool-title .material-symbols-outlined {
    font-size: 1.05rem;
    color: #9ca3af;
    font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 20;
  }

  .pt-mixer__tool-help {
    margin: 0;
    max-width: 36rem;
    font-size: 0.8125rem;
    line-height: 1.45;
    color: #6b7280;
  }

  .pt-verdict__body {
    max-width: 40rem;
  }

  .pt-mixer__presets {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    margin: 0 0 1.15rem;
  }

  .pt-mixer__preset {
    border: 1px solid #e5e7eb;
    background: #fff;
    border-radius: 999px;
    padding: 0.35rem 0.8rem;
    font-size: 0.75rem;
    font-weight: 700;
    color: #374151;
    cursor: pointer;
    transition: border-color 0.15s ease, color 0.15s ease, background 0.15s ease;
  }

  .pt-mixer__preset.is-active {
    border-color: #db2777;
    color: #db2777;
    background: rgb(219 39 119 / 6%);
  }

  .pt-mixer__layout {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(16rem, 0.85fr);
    gap: 1.25rem 1.5rem;
    align-items: start;
  }

  .pt-mixer__panel-title {
    margin: 0 0 0.85rem;
    font-size: 0.9375rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--color-on-surface);
  }

  .pt-mixer__panel-title.pt-h3 {
    margin: 0 0 0.85rem;
  }

  .pt-mixer__budget {
    margin: 0 0 0.85rem;
    font-size: 0.875rem;
    color: var(--color-on-surface);
  }

  .pt-mixer__budget strong {
    font-weight: 900;
    font-variant-numeric: tabular-nums;
  }

  .pt-mixer__controls {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .pt-mixer__control {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    align-items: center;
    gap: 0.75rem 1rem;
    padding: 0.7rem 0;
    border-bottom: 1px solid #e5e7eb;
  }

  .pt-mixer__control:last-child {
    border-bottom: none;
  }

  .pt-mixer__control-meta {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    min-width: 0;
  }

  .pt-mixer__control-label {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-on-surface);
  }

  .pt-mixer__control-rate {
    font-size: 0.75rem;
    font-weight: 600;
    color: #9ca3af;
  }

  .pt-mixer__stepper {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    border: 1px solid #e5e7eb;
    border-radius: 999px;
    padding: 0.12rem;
    background: #fff;
  }

  .pt-mixer__step {
    width: 1.75rem;
    height: 1.75rem;
    border: none;
    border-radius: 999px;
    background: #f3f4f6;
    color: var(--color-on-surface);
    font-size: 1rem;
    font-weight: 700;
    line-height: 1;
    cursor: pointer;
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
  }

  .pt-mixer__step:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }

  .pt-mixer__qty,
  .pt-mixer__qty-input {
    box-sizing: border-box;
    width: 3.25rem;
    min-width: 3.25rem;
    max-width: 3.25rem;
    min-height: 1.75rem;
    height: 1.75rem;
    margin: 0;
    border: 1px solid transparent;
    border-radius: 0.4rem;
    background: transparent;
    padding: 0;
    text-align: center;
    font-size: 0.875rem;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    font-family: inherit;
    color: var(--color-on-surface);
    line-height: 1.2;
    overflow: hidden;
  }

  .pt-mixer__qty {
    cursor: text;
  }

  .pt-mixer__qty:focus-visible {
    outline: 2px solid rgb(219 39 119 / 35%);
    outline-offset: 1px;
  }

  .pt-mixer__qty-input {
    border-color: rgb(219 39 119 / 35%);
    background: #fff;
    outline: none;
    -moz-appearance: textfield;
    appearance: textfield;
  }

  .pt-mixer__qty-input::-webkit-outer-spin-button,
  .pt-mixer__qty-input::-webkit-inner-spin-button {
    appearance: none;
    margin: 0;
  }

  .pt-mixer__spent {
    margin: 0;
    min-width: 5.5rem;
    text-align: right;
    font-size: 0.8125rem;
    font-weight: 700;
    color: #6b7280;
    font-variant-numeric: tabular-nums;
  }

  .pt-mixer__summary {
    border: 1px solid #e5e7eb;
    border-radius: 14px;
    padding: 1rem 1.05rem 0.95rem;
    background: #fff;
  }

  .pt-mixer__viz {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.85rem 1rem;
    align-items: center;
  }

  .pt-mixer__donut {
    position: relative;
    width: 7.5rem;
    height: 7.5rem;
    flex-shrink: 0;
  }

  .pt-mixer__donut-ring {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: #e5e7eb;
  }

  .pt-mixer__donut-hole {
    position: absolute;
    inset: 14%;
    border-radius: 50%;
    background: #fff;
  }

  .pt-mixer__donut-center {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    pointer-events: none;
    padding: 0.75rem;
  }

  .pt-mixer__donut-center strong {
    font-size: 1.15rem;
    font-weight: 900;
    line-height: 1.1;
    color: var(--color-on-surface);
    font-variant-numeric: tabular-nums;
  }

  .pt-mixer__donut-center span {
    margin-top: 0.15rem;
    font-size: 0.625rem;
    font-weight: 700;
    line-height: 1.2;
    color: #6b7280;
    max-width: 4.5rem;
  }

  .pt-mixer__legend {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.4rem;
  }

  .pt-mixer__legend-item {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: #4b5563;
  }

  .pt-mixer__legend-swatch {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background: #9ca3af;
  }

  .pt-mixer__legend-item--images .pt-mixer__legend-swatch { background: #db2777; }
  .pt-mixer__legend-item--videos .pt-mixer__legend-swatch { background: #8b5cf6; }
  .pt-mixer__legend-item--voice_messages .pt-mixer__legend-swatch { background: #3b82f6; }
  .pt-mixer__legend-item--voice_calls .pt-mixer__legend-swatch { background: #14b8a6; }
  .pt-mixer__legend-item--custom_character .pt-mixer__legend-swatch { background: #6b7280; }
  .pt-mixer__legend-item--remaining .pt-mixer__legend-swatch { background: #e5e7eb; border: 1px solid #d1d5db; }

  .pt-mixer__legend-cr {
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    color: var(--color-on-surface);
  }

  .pt-mixer__totals {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
    margin-top: 0.95rem;
    padding-top: 0.85rem;
    border-top: 1px solid #e5e7eb;
  }

  .pt-mixer__total {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .pt-mixer__total span {
    font-size: 0.6875rem;
    font-weight: 700;
    color: #6b7280;
  }

  .pt-mixer__total strong {
    font-size: 0.875rem;
    font-weight: 800;
    color: var(--color-on-surface);
    font-variant-numeric: tabular-nums;
  }

  .pt-mixer__total--remain strong {
    color: #db2777;
  }

  .pt-mixer__footnote {
    margin: 1rem 0 0;
    padding: 0;
    border: none;
    border-radius: 0;
    background: transparent;
    font-size: 0.75rem;
    line-height: 1.45;
    color: #6b7280;
  }

  /* Compare plans — nested subsection (not a major pink-eyebrow section) */
  .pt-other-limits {
    margin: 0;
    padding-top: 1.75rem;
  }

  .pt-other-limits__head {
    margin: 0 0 1.25rem;
  }

  .pt-other-limits .pt-subhead {
    margin: 0 0 0.5rem;
    font-family: var(--font-display), ui-sans-serif, system-ui, sans-serif;
    font-size: clamp(1.4375rem, 2.5vw, 1.5625rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.25;
    color: var(--color-on-surface);
  }

  .pt-other-limits .pt-sublead {
    margin: 0;
    max-width: 40rem;
    font-size: 0.96875rem;
    font-weight: 400;
    line-height: 1.5;
    color: #6b7280;
  }

  .pt-other-limits__scroll {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .pt-other-limits__table {
    width: 100%;
    min-width: 18rem;
    border-collapse: collapse;
  }

  .pt-other-limits__table th,
  .pt-other-limits__table td {
    padding: 0.7rem 0.65rem;
    border-bottom: 1px solid #e5e7eb;
    font-size: 0.875rem;
    text-align: left;
    vertical-align: middle;
  }

  .pt-other-limits__table thead th {
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.02em;
    color: #6b7280;
  }

  .pt-other-limits__table tbody th {
    font-weight: 600;
    color: var(--color-on-surface);
    white-space: nowrap;
  }

  .pt-other-limits__table td {
    font-weight: 700;
    color: var(--color-on-surface);
    font-variant-numeric: tabular-nums;
  }

  .pt-other-limits__feature {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .pt-other-limits__feature .material-symbols-outlined {
    font-size: 18px;
    color: #4b5563;
    font-variation-settings: 'FILL' 0, 'wght' 300, 'GRAD' 0, 'opsz' 20;
  }

  .pt-plans__tip {
    color: #9ca3af;
  }

  @media (max-width: 720px) {
    .pt-plan-summary {
      grid-template-columns: 1fr;
      gap: 0.85rem;
      padding-bottom: 1.1rem;
    }

    .pt-plan-summary__item,
    .pt-plan-summary__item + .pt-plan-summary__item {
      border-left: none;
      padding: 0;
    }

    .pt-plan-summary__item + .pt-plan-summary__item {
      padding-top: 0.85rem;
      border-top: 1px solid #e5e7eb;
    }

    .pt-mixer__layout {
      grid-template-columns: 1fr;
    }

    .pt-mixer__viz {
      grid-template-columns: auto minmax(0, 1fr);
    }

    .pt-other-limits__table th,
    .pt-other-limits__table td {
      padding: 0.65rem 0.5rem;
      font-size: 0.8125rem;
    }
  }

  .pt-mixer-mobile {
    display: none;
    margin: 0 0 0.25rem;
  }

  .pt-mixer-mobile__meta {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.35rem;
  }

  .pt-mixer-mobile__meta strong {
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--color-on-surface);
  }

  .pt-mixer-mobile__used {
    margin: 0;
    font-size: 0.875rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--color-on-surface);
  }

  .pt-mixer-mobile__mix {
    margin: 0.25rem 0 0;
    font-size: 0.8125rem;
    line-height: 1.4;
    color: #6b7280;
  }

  .pt-mixer-mobile__viz {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.75rem 1rem;
    align-items: center;
    margin: 0.85rem 0 1rem;
  }

  .pt-mixer__donut--sm {
    width: 4.5rem;
    height: 4.5rem;
  }

  .pt-mixer__donut--sm .pt-mixer__donut-center strong {
    font-size: 0.9375rem;
  }

  .pt-mixer__donut--sm .pt-mixer__donut-center span {
    font-size: 0.625rem;
  }

  .pt-mixer-mobile__legend {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .pt-mixer-mobile__customize {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    width: 100%;
    min-height: 2.75rem;
    margin: 0;
    padding: 0.65rem 1rem;
    border: 1px solid #d1d5db;
    border-radius: 10px;
    background: #fff;
    font-size: 0.875rem;
    font-weight: 650;
    color: var(--color-on-surface);
    cursor: pointer;
  }

  .pt-mixer-mobile__customize .material-symbols-outlined {
    font-size: 18px;
  }

  .pt-mixer-sheet .mobile-sheet__panel {
    display: flex;
    flex-direction: column;
    max-height: min(92vh, 720px);
  }

  .pt-mixer-sheet__body {
    padding-bottom: 0.5rem;
  }

  .pt-mixer-sheet__budget {
    margin: 0 0 0.85rem;
    font-size: 0.875rem;
    color: #6b7280;
  }

  .pt-mixer-sheet__budget strong {
    color: var(--color-on-surface);
  }

  .pt-mixer-sheet__controls {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin-top: 0.75rem;
  }

  .pt-mixer-sheet__control {
    padding: 0.85rem 0;
  }

  .pt-mixer-sheet__stepper .pt-mixer__step {
    width: 2.75rem;
    height: 2.75rem;
    font-size: 1.25rem;
  }

  .pt-mixer-sheet__stepper .pt-mixer__qty,
  .pt-mixer-sheet__stepper .pt-mixer__qty-input {
    width: 3.5rem;
    min-width: 3.5rem;
    max-width: 3.5rem;
    min-height: 2rem;
    height: 2rem;
    font-size: 1rem;
  }

  .pt-mixer-sheet__footer {
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    padding: 12px 16px calc(16px + env(safe-area-inset-bottom, 0px));
    border-top: 1px solid var(--color-surface-variant, #e5e7eb);
    background: var(--color-surface-container-lowest, #fff);
  }

  .pt-mixer-sheet__live {
    margin: 0;
    font-size: 0.8125rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: #6b7280;
    text-align: center;
  }

  .pt-mixer-sheet__apply {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 2.75rem;
    margin: 0;
    padding: 0.7rem 1rem;
    border: 1px solid transparent;
    border-radius: 10px;
    background: var(--color-accent, #db2777);
    font-size: 0.9375rem;
    font-weight: 700;
    color: #fff;
    cursor: pointer;
  }

  .pt-mixer-sheet__apply:hover {
    background: color-mix(in srgb, var(--color-accent, #db2777) 88%, #000);
  }

  @media (max-width: 767px) {
    .pt-credit-pool__skim {
      grid-template-columns: 1fr 1fr;
      row-gap: 1.25rem;
    }

    .pt-credit-pool__skim-stat {
      padding: 0 0.85rem;
    }

    .pt-credit-pool__skim-stat:nth-child(2n + 1) {
      padding-left: 0;
    }

    .pt-credit-pool__skim-stat:nth-child(2n) {
      padding-right: 0;
    }

    .pt-credit-pool__skim-stat:not(:nth-child(3n))::after {
      display: none;
    }

    .pt-credit-pool__skim-stat:not(:nth-child(2n))::after {
      content: '';
      display: block;
      position: absolute;
      top: 0.2em;
      right: 0;
      bottom: 0.2em;
      width: 1px;
      background: #e8eae4;
    }

    .pt-credit-pool__skim-amount {
      font-size: 1.5rem;
    }

    .pt-mixer__layout {
      display: none !important;
    }

    .pt-mixer-mobile {
      display: block;
    }

    .pt-mixer__tool-help {
      display: none;
    }
  }

  @media (min-width: 768px) {
    .pt-mixer-mobile {
      display: none !important;
    }

    .pt-mixer-sheet {
      display: none !important;
    }
  }

  /* —— Usage selector + breakdown —— */
  .pt-section-head + .pt-menu-select,
  .pt-major-head + .pt-menu-select {
    margin-bottom: 1rem;
  }

  .pt-usage-flat {
    margin-top: 0.35rem;
    padding: 1rem 0 0.25rem;
    border-top: 1px solid #e5e7eb;
  }

  .pt-usage-flat__price {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 900;
    color: var(--color-on-surface);
  }

  .pt-usage-flat__copy {
    margin: 0.4rem 0 0;
    max-width: 36rem;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: #4b5563;
  }

  .pt-usage-cols {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0 0 1rem;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    overflow: hidden;
    background: #fff;
  }

  .pt-usage-col {
    position: relative;
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 0.65rem;
    width: 100%;
    padding: 0.85rem 1rem;
    border: none;
    border-right: 1px solid #e5e7eb;
    background: transparent;
    text-align: left;
    cursor: pointer;
    transition: background 0.15s ease;
  }

  .pt-usage-col:last-child {
    border-right: none;
  }

  .pt-usage-col.is-active {
    background: rgb(252 231 243 / 40%);
  }

  .pt-usage-col.is-active::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 3px;
    background: #db2777;
