---
import type { Product } from '../../../data/products';
import { getAuthor } from '../../../data/authors';
import { getPublishedGlossaryTermsForTooltips } from '../../../lib/glossary/load';
import {
  renderReviewProseText,
  reviewProseGlossaryContext,
} from '../../../lib/review/renderReviewProse';
import VerifiedCheck from '../../ui/VerifiedCheck.astro';
import AffiliateLink from '../../ui/AffiliateLink.astro';
import { fmtMoney } from '../../../lib/pricing/calc';
import { fmtScore, getScoreVisual } from '../../../lib/scores';
import { clampBarPct, computeHeroComparison } from '../../../lib/pricing-tab/types';
import { splitUnitSuffix } from '../../../lib/pricing-tab/formatUnits';
import { loadPricingTabViewModel } from '../../../lib/pricing-tab/loadPricingTab';

interface Props {
  product: Product;
}

const { product } = Astro.props;
const vm = await loadPricingTabViewModel(product);
const herman = getAuthor('herman-carter');
const glossaryTerms = await getPublishedGlossaryTermsForTooltips();
const pricingGlossary = reviewProseGlossaryContext(glossaryTerms, 'review-pricing');
const scoreVisual = getScoreVisual(vm.pricingScore);

const barMin = vm.barMin ?? 0;
const barMax = vm.barMax ?? 80;
const axisTicks = [
  { pct: 0, label: '$0' },
  { pct: 100, label: `$${barMax}+` },
];

const advertisedLabel =
  vm.advertisedMonthly != null ? `${fmtMoney(vm.advertisedMonthly, vm.currency)}/mo` : '—';
const advertisedShort =
  vm.advertisedMonthly != null ? fmtMoney(vm.advertisedMonthly, vm.currency) : '—';
const regularUseLabel =
  vm.regularUseMonthly != null ? `~${fmtMoney(vm.regularUseMonthly, vm.currency)}/mo` : '—';

/** Starting-price market position — median typical price, not arithmetic mean. */
const marketTypicalAmount = vm.typicalMonthlyPrice ?? null;
const marketTypicalLabel =
  marketTypicalAmount != null ? `~${fmtMoney(marketTypicalAmount, vm.currency)}` : '—';
const marketCompare = computeHeroComparison(vm.advertisedMonthly, marketTypicalAmount);
const productBarPct =
  vm.advertisedMonthly != null ? clampBarPct(vm.advertisedMonthly, barMin, barMax) : null;
const typicalBarPct =
  marketTypicalAmount != null ? clampBarPct(marketTypicalAmount, barMin, barMax) : null;
const cheaperPctAbs =
  marketCompare.cheaperPct != null ? Math.abs(marketCompare.cheaperPct) : null;
const cheaperIsGood = marketCompare.cheaperPct != null && marketCompare.cheaperPct > 3;
const marketTakeaway = (() => {
  const pct = marketCompare.cheaperPct;
  if (pct == null) return null;
  if (Math.abs(pct) <= 3) return 'About average';
  if (pct > 3) return 'Cheaper than typical';
  return 'More expensive than typical';
})();
const marketTakeawayTone =
  marketCompare.cheaperPct == null
    ? null
    : Math.abs(marketCompare.cheaperPct) <= 3
      ? 'neutral'
      : marketCompare.cheaperPct > 3
        ? 'good'
        : 'bad';

/** SSR overlap guess: assume ~320px chart so 72px ≈ 22.5% of the rail. */
const benchPctApart =
  productBarPct != null && typicalBarPct != null ? Math.abs(productBarPct - typicalBarPct) : null;
const benchOverlapSSR = benchPctApart != null && benchPctApart < 22.5;
const benchStackedSSR = benchPctApart != null && benchPctApart < 3.75;

const PRICING_MODEL_META: Record<string, string> = {
  subscription_only: 'Subscription only',
  subscription_credits: 'Subscription + credits',
  credits_only: 'Credits only',
  free_plus_credits: 'Freemium + credits',
  mixed: 'Mixed pricing',
  custom: 'Custom pricing',
};
const primaryPaidPlan =
  vm.plans.find((p) => !p.isFree && p.isRecommended)
  ?? vm.plans.find((p) => !p.isFree)
  ?? null;
const hasUnlimitedChat = Boolean(
  primaryPaidPlan?.rows.some((r) => /^chat$/i.test(r.label) && /unlimited/i.test(r.value)),
);
const introMetaParts: string[] = [];
if (vm.pricingModel && PRICING_MODEL_META[vm.pricingModel]) {
  introMetaParts.push(PRICING_MODEL_META[vm.pricingModel]!);
} else if (vm.pricingModel) {
  introMetaParts.push('Subscription + credits');
}
if (primaryPaidPlan?.includedCredits != null && primaryPaidPlan.includedCredits > 0) {
  introMetaParts.push(`${primaryPaidPlan.includedCredits.toLocaleString('en-US')} credits/mo`);
}
if (hasUnlimitedChat) introMetaParts.push('Chat unlimited');
const introMeta = introMetaParts.length > 0 ? introMetaParts.join(' · ') : null;

const pageIntro = vm.pageIntro;
const marketIntro = vm.marketIntro;
const plansIntro = vm.plansIntro;
const usageIntro =
  vm.usageIntro
  ?? "The subscription price isn't always what you'll really spend. We estimate the monthly cost for light, regular, and heavy users based on how many paid features they use.";
const featureCostsIntro = vm.featureCostsIntro;
const comparisonNote = vm.comparisonNote;
const freeVsPaidIntro =
  vm.freeVsPaidIntro
  ?? 'See what you get with each plan.';
const comparePlansHeading = vm.limitsHeading || 'What’s included in each plan';
const billingIntervals = vm.billingToggle.intervals?.length
  ? vm.billingToggle.intervals
  : [
      { key: 'monthly' as const, label: vm.billingToggle.monthlyLabel || 'Monthly' },
      ...(vm.billingToggle.show
        ? [{ key: 'yearly' as const, label: vm.billingToggle.yearlyLabel || 'Annual' }]
        : []),
    ];
const showPlansBilling = vm.billingToggle.show && billingIntervals.length > 1;

const mixerPlanOptions = vm.plans.filter((p) => {
  const budget = vm.creditPool?.byPlan?.[p.key];
  return Boolean(budget?.mixer);
});
/** Only plans with a shared credit pool — never free / non-credit tiers. */
const creditToolPlans = mixerPlanOptions;

function planBillingKeys(
  plan: (typeof vm.plans)[number] | null,
): Array<'monthly' | 'quarterly' | 'yearly'> {
  if (!plan?.billing || plan.isFree) return [];
  const out: Array<'monthly' | 'quarterly' | 'yearly'> = [];
  if (plan.billing.monthly) out.push('monthly');
  if (plan.billing.quarterly) out.push('quarterly');
  if (plan.billing.yearly) out.push('yearly');
  return out;
}

/** Multi-plan products wait for an explicit pick; single-plan auto-selects. */
const poolNeedsPlanPick = creditToolPlans.length > 1;
const poolPlanKey = poolNeedsPlanPick ? '' : (creditToolPlans[0]?.key ?? '');
const poolPlan = creditToolPlans.find((p) => p.key === poolPlanKey) ?? null;
const poolBillingKeys = planBillingKeys(poolPlan);
const poolBilling: 'monthly' | 'quarterly' | 'yearly' | '' =
  poolBillingKeys.length === 0
    ? ''
    : poolBillingKeys.length === 1
      ? poolBillingKeys[0]
      : poolBillingKeys.includes('monthly')
        ? 'monthly'
        : poolBillingKeys[0];
const poolReady = Boolean(poolPlanKey && poolBilling);
const poolShowBilling = Boolean(poolPlan && poolBillingKeys.length > 1);
const poolPlanNames = creditToolPlans.map((p) => p.displayName);
const poolPlanPickHint =
  poolPlanNames.length === 0
    ? ''
    : poolPlanNames.length === 1
      ? `Pick ${poolPlanNames[0]}.`
      : poolPlanNames.length === 2
        ? `Pick ${poolPlanNames[0]} or ${poolPlanNames[1]}.`
        : `Pick ${poolPlanNames.slice(0, -1).join(', ')}, or ${poolPlanNames[poolPlanNames.length - 1]}.`;

const usageCosts = vm.usageTiers
  .map((t) => t.monthlyCost)
  .filter((n): n is number => n != null && Number.isFinite(n));
const usageCostsIdentical =
  usageCosts.length >= 2
  && usageCosts.every((n) => Math.abs(n - usageCosts[0]) < 0.05);
const flatUsageCost = usageCostsIdentical ? usageCosts[0] : null;

const defaultUsage = vm.usageTiers.find((t) => t.id === 'regular') ?? vm.usageTiers[0] ?? null;
const recommendedPlan = vm.plans.find((p) => p.isRecommended && !p.isFree) ?? vm.plans.find((p) => !p.isFree) ?? null;

function packNoteForTier(tier: (typeof vm.usageTiers)[number]): string | null {
  const lines = tier.calculation?.packageLines ?? [];
  if (lines.length === 0) return null;
  const combo = lines
    .map((line) =>
      line.quantity > 1
        ? `${line.quantity} × ${line.creditsLabel} at ${line.priceLabel}`
        : `${line.creditsLabel} at ${line.priceLabel}`,
    )
    .join(' · ');
  const leftover = tier.calculation?.leftoverCredits
    ? ` · ${tier.calculation.leftoverCreditsLabel} spare`
    : '';
  return combo + leftover;
}

function topUpLabel(topUp: number | null | undefined): string {
  if (topUp == null) return '—';
  if (topUp > 0) return `~${fmtMoney(topUp, vm.currency)}`;
  return '$0';
}

const usagePayload = JSON.stringify(
  Object.fromEntries(
    vm.usageTiers.map((tier) => {
      const topUp =
        tier.topUpCost != null
          ? tier.topUpCost
          : tier.monthlyCost != null && tier.planCost != null
            ? Math.round((tier.monthlyCost - tier.planCost) * 100) / 100
            : null;
      return [
        tier.id,
        {
          title: tier.title,
          description: tier.description,
          costLabel: tier.costLabel,
          icon: tier.icon,
          planLabel:
            tier.planCost != null ? `${fmtMoney(tier.planCost, vm.currency)}` : advertisedLabel.replace(/\/mo$/, ''),
          topUpLabel: topUpLabel(topUp),
          totalLabel: tier.costLabel,
          chat: tier.assumptions.chat,
          images: tier.assumptions.images,
          videos: tier.assumptions.videos,
          voice: tier.assumptions.voice,
          character: tier.assumptions.character,
          packNote: packNoteForTier(tier),
          subline:
            (recommendedPlan?.displayName ?? 'Paid plan')
            + (topUp != null && topUp > 0 ? ' subscription + credit top-ups' : ' subscription'),
          calculation: tier.calculation,
        },
      ];
    }),
  ),
);

const defaultPlanLabel =
  defaultUsage?.planCost != null
    ? fmtMoney(defaultUsage.planCost, vm.currency)
    : advertisedLabel.replace(/\/mo$/, '');
const defaultTopUpLabel = topUpLabel(defaultUsage?.topUpCost);
const defaultCalculation = defaultUsage?.calculation ?? null;

const defaultPlanKey =
  vm.creditPool?.defaultPlanKey
  ?? vm.plans.find((p) => !p.isFree && p.isRecommended)?.key
  ?? vm.plans.find((p) => !p.isFree)?.key
  ?? vm.plans[0]?.key
  ?? '';
const defaultPlan = vm.plans.find((p) => p.key === defaultPlanKey) ?? null;
const defaultBudget = poolReady
  ? (vm.creditPool?.byPlan?.[poolPlanKey] ?? null)
  : null;
const defaultBilling: 'monthly' | 'quarterly' | 'yearly' =
  (poolReady && poolBilling
    ? poolBilling
    : null)
  ?? vm.billingToggle.defaultInterval
  ?? (defaultPlan?.billing?.monthly
    ? 'monthly'
    : defaultPlan?.billing?.quarterly
      ? 'quarterly'
      : 'yearly');
const poolBillingOpt =
  poolBilling === 'yearly'
    ? poolPlan?.billing?.yearly
    : poolBilling === 'quarterly'
      ? poolPlan?.billing?.quarterly
      : poolPlan?.billing?.monthly;
const defaultBillingOpt =
  defaultBilling === 'yearly'
    ? defaultPlan?.billing?.yearly
    : defaultBilling === 'quarterly'
      ? defaultPlan?.billing?.quarterly
      : defaultPlan?.billing?.monthly;
const defaultPlanPrice =
  defaultPlan?.isFree
    ? defaultPlan.priceLabel
    : defaultBillingOpt?.monthlyPriceLabel ?? defaultPlan?.priceLabel ?? '—';
const defaultPlanSub =
  defaultPlan?.isFree
    ? defaultPlan.priceSub ?? 'Try before paying'
    : defaultBillingOpt?.priceSub ?? defaultPlan?.priceSub ?? '';
const defaultSale = (poolReady ? poolBillingOpt?.sale : null) ?? defaultBillingOpt?.sale ?? null;
const defaultCreditsLine = defaultBudget?.creditsLine ?? null;
const defaultBillingLabel =
  (poolReady && poolBilling ? poolBilling : defaultBilling) === 'yearly'
    ? 'Annual'
    : (poolReady && poolBilling ? poolBilling : defaultBilling) === 'quarterly'
      ? 'Quarterly'
      : 'Monthly';
const defaultContextPlanLine =
  poolReady && poolPlan
    ? `${poolPlan.displayName} · ${defaultBillingLabel}`
    : '';
const defaultContextPriceLine =
  poolReady && poolPlan && !poolPlan.isFree && poolBillingOpt?.monthlyPriceLabel
    ? `${poolBillingOpt.monthlyPriceLabel}/mo`
    : null;
const defaultContextMetaLine = [defaultCreditsLine, defaultContextPriceLine].filter(Boolean).join(' · ') || null;
const poolIntroAwaiting = 'Choose your plan to see how far your included credits can go.';
const poolIntroReady =
  vm.creditPool?.note
  || 'Your credits are shared across paid features. Spend them all on one feature, or mix them however you want.';

const freePlan = vm.plans.find((p) => p.isFree) ?? null;
const defaultComparePaid =
  defaultPlan && !defaultPlan.isFree
    ? defaultPlan
    : vm.plans.find((p) => !p.isFree && p.isRecommended)
      ?? vm.plans.find((p) => !p.isFree)
      ?? null;
/** All plans as comparison columns — Free + every paid tier. */
const defaultLimitPlans = vm.plans;
const defaultLimitsHeading = comparePlansHeading;

const plansPayload = JSON.stringify({
  plans: vm.plans.map((plan) => ({
    key: plan.key,
    displayName: plan.displayName,
    isFree: plan.isFree,
    priceLabel: plan.priceLabel,
    priceSub: plan.priceSub ?? '',
    summaryLine: plan.summaryLine,
    billing: plan.billing
      ? {
          monthly: plan.billing.monthly
            ? {
                monthlyPriceLabel: plan.billing.monthly.monthlyPriceLabel,
                periodPriceLabel: plan.billing.monthly.periodPriceLabel,
                priceSub: plan.billing.monthly.priceSub,
                savingsLabel: plan.billing.monthly.savingsLabel,
                sale: plan.billing.monthly.sale,
              }
            : null,
          quarterly: plan.billing.quarterly
            ? {
                monthlyPriceLabel: plan.billing.quarterly.monthlyPriceLabel,
                periodPriceLabel: plan.billing.quarterly.periodPriceLabel,
                priceSub: plan.billing.quarterly.priceSub,
                savingsLabel: plan.billing.quarterly.savingsLabel,
                sale: plan.billing.quarterly.sale,
              }
            : null,
          yearly: plan.billing.yearly
            ? {
                monthlyPriceLabel: plan.billing.yearly.monthlyPriceLabel,
                periodPriceLabel: plan.billing.yearly.periodPriceLabel,
                priceSub: plan.billing.yearly.priceSub,
                savingsLabel: plan.billing.yearly.savingsLabel,
                sale: plan.billing.yearly.sale,
              }
            : null,
        }
      : null,
  })),
  freePlanKey: freePlan?.key ?? null,
  billingIntervals: billingIntervals.map((i) => i.key),
  limitRows: vm.limitRows.map((row) => ({
    key: row.key,
    cells: Object.fromEntries(
      vm.plans.map((plan, idx) => [plan.key, row.cells[idx] ?? '—']),
    ),
  })),
  byPlan: vm.creditPool?.byPlan ?? {},
  defaultPlanKey,
  defaultInterval: defaultBilling,
});
function withUnit(value: string) {
  return splitUnitSuffix(value);
}

function usageSwitchLabel(id: string) {
  if (id === 'casual') return 'Light use';
  if (id === 'power') return 'Heavy use';
  return 'Regular use';
}

const yearlyOpt = recommendedPlan?.billing?.yearly;
const annualNote =
  yearlyOpt?.monthlyPriceLabel && recommendedPlan
    ? `Annual billing drops ${recommendedPlan.displayName} to ${yearlyOpt.monthlyPriceLabel}/mo — the cheapest way to use it.`
    : null;
const yearlySavePct = vm.billingToggle.maxYearlySavingsPercent;

function planBestFor(plan: (typeof vm.plans)[number]): string {
  if (plan.isRecommended) return 'Best for most people';
  if (plan.isFree) return 'Best for trying the app';
  const highlight = vm.creditPool?.byPlan?.[plan.key]?.highlights?.[0];
  return highlight || 'Best for heavier use';
}

const defaultPackNote = defaultUsage ? packNoteForTier(defaultUsage) : null;
const defaultSubline = (() => {
  const planName = recommendedPlan?.displayName ?? 'Paid plan';
  const topUp = defaultUsage?.topUpCost;
  if (topUp != null && topUp > 0) return `${planName} subscription + credit top-ups`;
  return `${planName} subscription`;
})();
const estimateTitle = defaultUsage
  ? `How we estimated ${defaultUsage.costLabel.replace(/\/mo$/, '')} a month`
  : 'How we estimated this month';
const estimateSummary = defaultUsage?.description ?? usageIntro ?? '';
const compactCompare = vm.compareRows.slice(0, 2);
---

<section
  class="pricing-tab pt2"
  data-pt-plans
  data-pt-billing={vm.billingToggle.defaultInterval}
  data-pt-selected-plan={defaultPlanKey}
  data-pt-plan-count={vm.plans.length}
  data-pt-plans-payload={plansPayload}
  data-pt-usage
  data-pt-usage-payload={usagePayload}
  data-pt-usage-flat={usageCostsIdentical ? 'true' : 'false'}
>
  <div class="pt2-page">
    <section class="pt2-section" id="pricing-intro" aria-labelledby="pt-snapshot-title">
      <h2 class="pt2-h2" id="pt-snapshot-title">What {vm.productName} really costs</h2>
      {pageIntro && (
        <p class="pt2-lead" set:html={renderReviewProseText(pageIntro, pricingGlossary)} />
      )}

      {vm.usageTiers.length > 0 && !usageCostsIdentical && (
        <div class="pt2-usage-switch" role="tablist" aria-label="Usage level">
          {vm.usageTiers.map((tier) => (
            <button
              type="button"
              role="tab"
              class:list={[tier.id === defaultUsage?.id && 'is-active']}
              data-pt-usage-option={tier.id}
              aria-selected={tier.id === defaultUsage?.id ? 'true' : 'false'}
            >
              {usageSwitchLabel(tier.id)}
            </button>
          ))}
        </div>
      )}

      {defaultUsage && (
        <>
          <p class="pt2-hero-price">
            <span class="pt2-hero-price__n" data-pt-usage-detail-total>{defaultUsage.costLabel}</span>
            <span class="pt2-hero-price__u">/ month</span>
          </p>
          <p class="pt2-hero-sub" data-pt-usage-subline>{defaultSubline}</p>
          <p class="pt2-eq" aria-label="Cost breakdown">
            <span data-pt-usage-detail-plan>{defaultPlanLabel}</span>
            {' '}
            {recommendedPlan?.displayName ?? 'Plan'}
            {' + '}
            <span data-pt-usage-detail-topup>{defaultTopUpLabel}</span>
            {' top-ups = '}
            <strong data-pt-usage-detail-total-row>{defaultUsage.costLabel.replace(/\/mo$/, '')}</strong>
            /month
          </p>
          {defaultCalculation && (
            <div class="pt2-disclose pt2-disclose--link" data-pt2-disclose>
              <button type="button" class="pt2-disclose__btn" aria-expanded="false">
                <span class="pt2-disclose__action" data-closed="See how we calculated this" data-open="Hide calculation">
                  <span data-pt2-action-label>See how we calculated this</span>
                  <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </span>
              </button>
              <div class="pt2-disclose__panel" hidden>
                <p class="pt2-pack-note" data-pt-usage-pack-note hidden={!defaultPackNote}>{defaultPackNote}</p>
                <span hidden data-pt-usage-calc-summary></span>
                <div class="pt2-calc" data-pt2-calc data-pt-usage-calc>
                  <section class="pt2-calc__step">
                    <p class="pt2-calc__kicker">Step 1</p>
                    <h4 class="pt2-calc__h">What {defaultCalculation.levelName} looks like</h4>
                    <p class="pt2-calc__lead">The usage pattern we model for a typical paying reader.</p>
                    <div class="pt2-calc__cards">
                      {defaultCalculation.features
                        .filter((row) => row.key !== 'chat' && row.monthlyTotalLabel)
                        .map((row) => (
                          <article class={`pt2-calc__card is-${row.accent ?? row.key}`}>
                            <p class="pt2-calc__card-name">
                              <span class="pt2-calc__dot" aria-hidden="true" />
                              {row.label}
                            </p>
                            {row.patternLead && <p class="pt2-calc__card-lead">{row.patternLead}</p>}
                            <p class="pt2-calc__card-total">{row.monthlyTotalLabel}</p>
                          </article>
                        ))}
                    </div>
                    {defaultCalculation.chatIncludedNote && (
                      <p class="pt2-calc__note">{defaultCalculation.chatIncludedNote}</p>
                    )}
                  </section>
                  <section class="pt2-calc__step">
                    <p class="pt2-calc__kicker">Step 2</p>
                    <h4 class="pt2-calc__h">How many credits that uses</h4>
                    <p class="pt2-calc__lead">These features drive the total.</p>
                    <div class="pt2-calc__eqs">
                      {defaultCalculation.features
                        .filter((row) => row.cost > 0 && row.qtyPhrase && row.ratePhrase)
                        .map((row) => (
                          <div class={`pt2-calc__eq is-${row.accent ?? row.key}`}>
                            <p class="pt2-calc__eq-k">{row.label}</p>
                            <p class="pt2-calc__eq-line">
                              <span>{row.qtyPhrase}</span>
                              <span class="pt2-calc__op">×</span>
                              <span>{row.ratePhrase}</span>
                              <span class="pt2-calc__op">=</span>
                              <strong>{row.costLabel}</strong>
                            </p>
                          </div>
                        ))}
                    </div>
                    <p class="pt2-calc__total-pill">
                      <span>Total monthly usage</span>
                      <strong data-pt-usage-calc-media>{defaultCalculation.requiredCreditsLabel}</strong>
                    </p>
                  </section>
                  <section class="pt2-calc__step">
                    <p class="pt2-calc__kicker">Step 3</p>
                    <h4 class="pt2-calc__h">What you’ll actually pay</h4>
                    <div class="pt2-calc__pay">
                      <div class="pt2-calc__pay-card">
                        <p>
                          <strong data-pt-usage-calc-media-2>{defaultCalculation.requiredCreditsLabel}</strong>
                          <span>needed for {defaultCalculation.levelName}</span>
                        </p>
                        <p>
                          <strong data-pt-usage-calc-included>
                            {defaultCalculation.includedCredits.toLocaleString('en-US')} credits
                          </strong>
                          <span>included with {defaultCalculation.planName}</span>
                        </p>
                        <p>
                          <strong data-pt-usage-calc-extra>{defaultCalculation.extraCreditsLabel}</strong>
                          <span>still to buy</span>
                        </p>
                      </div>
                      <div class="pt2-calc__pay-card">
                        <p class="pt2-calc__micro">Smallest pack combination you can buy</p>
                        <p class="pt2-calc__pack-head" data-pt-usage-calc-pack>
                          {defaultCalculation.packHeadline ?? 'No top-up needed'}
                        </p>
                        {defaultCalculation.packFoot && (
                          <p class="pt2-calc__card-lead" data-pt-usage-calc-pack-foot>{defaultCalculation.packFoot}</p>
                        )}
                      </div>
                    </div>
                    <div class="pt2-calc__banner">
                      <p class="pt2-calc__micro">Estimated {defaultCalculation.levelName} cost</p>
                      <p class="pt2-calc__banner-price">
                        <span data-pt-usage-calc-total>{defaultCalculation.totalLabel.replace(/\/mo$/, '')}</span>
                        <span class="pt2-calc__banner-u">/ month</span>
                      </p>
                      <p class="pt2-calc__banner-sub">
                        <span data-pt-usage-calc-plan>{defaultCalculation.planCostLabel}</span>
                        {' '}
                        {defaultCalculation.planName}
                        {defaultCalculation.topUpCost > 0 && (
                          <>
                            {' + '}
                            <span data-pt-usage-calc-topup>{defaultCalculation.topUpCostLabel}</span>
                            {' credit top-ups'}
                          </>
                        )}
                      </p>
                    </div>
                  </section>
                </div>
              </div>
            </div>
          )}
        </>
      )}

      {annualNote && <p class="pt2-annual-note">{annualNote}</p>}

      {(vm.advertisedMonthly != null || marketTypicalAmount != null) && (
        <>
          <hr class="pt2-rule" />
          <p class="pt2-bench-head">Starting price vs category</p>
          <div
            class:list={[
              'pt-bench',
              benchOverlapSSR && 'is-overlap',
              benchStackedSSR && 'is-stacked',
              'has-typical-below',
            ]}
            data-pt-bench
            data-pt-product-pct={productBarPct}
            data-pt-avg-pct={typicalBarPct ?? ''}
          >
            <div class="pt-bench__chart" data-pt-bench-chart>
