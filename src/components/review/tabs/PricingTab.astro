  .pt-usage-math__chip + .pt-usage-math__chip {
    border-left: 1px solid #e5e7eb;
  }

  .pt-usage-math__chip .material-symbols-outlined {
    font-family: 'Material Symbols Outlined', sans-serif;
    font-size: 18px;
    font-weight: normal;
    font-style: normal;
    line-height: 1;
    display: inline-block;
    color: #4b5563;
    font-variation-settings: 'FILL' 0, 'wght' 300, 'GRAD' 0, 'opsz' 20;
    margin-bottom: 0.15rem;
  }

  .pt-usage-math__chip-label {
    font-size: 0.8125rem;
    font-weight: 800;
    color: var(--color-on-surface);
  }

  .pt-usage-math__chip-value {
    font-size: 0.75rem;
    font-weight: 600;
    color: #6b7280;
  }

  .pt-usage-math__table,
  .pt-usage-math__summary {
    width: 100%;
    border-collapse: collapse;
  }

  .pt-usage-math__table th,
  .pt-usage-math__table td,
  .pt-usage-math__summary th,
  .pt-usage-math__summary td {
    padding: 0.65rem 0;
    border-bottom: 1px solid #e5e7eb;
    font-size: 0.875rem;
    text-align: left;
    vertical-align: middle;
  }

  .pt-usage-math__table thead th {
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #9ca3af;
  }

  .pt-usage-math__table thead th:last-child {
    text-align: right;
  }

  .pt-usage-math__table tbody th,
  .pt-usage-math__summary th {
    font-weight: 600;
    color: var(--color-on-surface);
  }

  .pt-usage-math__table td,
  .pt-usage-math__summary td {
    font-weight: 700;
    color: var(--color-on-surface);
    font-variant-numeric: tabular-nums;
    text-align: right;
    white-space: nowrap;
  }

  .pt-usage-math__feat {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .pt-usage-math__feat .material-symbols-outlined {
    font-family: 'Material Symbols Outlined', sans-serif;
    font-size: 18px;
    font-weight: normal;
    font-style: normal;
    line-height: 1;
    display: inline-block;
    color: #4b5563;
    font-variation-settings: 'FILL' 0, 'wght' 300, 'GRAD' 0, 'opsz' 20;
  }

  .pt-usage-math :global(.material-symbols-outlined) {
