  /* —— Usage selector + breakdown —— */
  .pt-section-head + .pt-menu-select,
  .pt-major-head + .pt-menu-select {
    margin-bottom: 1rem;
  }

  .pt-usage-flat {
    margin-top: 0.35rem;
    padding: 1rem 0 0.25rem;
    border-top: 1px solid #e5e7eb;
  }

  .pt-usage-flat__price {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 900;
    color: var(--color-on-surface);
  }

  .pt-usage-flat__copy {
    margin: 0.4rem 0 0;
    max-width: 36rem;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: #4b5563;
  }

  .pt-usage-cols {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0 0 1rem;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    overflow: hidden;
    background: #fff;
  }

  .pt-usage-col {
    position: relative;
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 0.65rem;
    width: 100%;
    padding: 0.85rem 1rem;
