    font-size: 1rem;
    line-height: 1.65;
    color: var(--color-on-surface-variant);
  }

  /* UI / tool labels — not editorial headings */
  .pt-label,
  .pt-menu-select__label,
  .pt-usage-detail__col-label,
  .pt-usage-math__block-title {
    margin: 0;
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #6b7280;
  }

  /* Normal article prose between heading and data */
  .pt-prose {
    margin: 0 0 1.35rem;
  }

  .pt-prose__byline {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin: 0 0 0.45rem;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: #db2777;
  }

  .pt-prose__avatar {
    width: 22px;
    height: 22px;
    border-radius: 999px;
    object-fit: cover;
    background: #fff;
    box-shadow: 0 0 0 1px rgb(0 0 0 / 8%);
  }

  .pt-prose__body {
    margin: 0 0 1.35rem;
    max-width: 40rem;
    font-size: 1rem;
    line-height: 1.65;
    color: #374151;
  }

  .pt-prose__body--tight {
    margin-bottom: 1rem;
    font-size: 0.9375rem;
  }

  .pt-prose + .pt-bench,
  .pt-prose__body + .pt-bench,
  .pt-prose__body + .pt-plan-summary,
  .pt-prose__body + .pt-usage-cols,
  .pt-prose__body + .pt-usage-flat,
  .pt-prose__body + .pt-feature-list,
  .pt-prose__body + .pt-compare-wrap,
  .pt-section-head + .pt-bench,
  .pt-section-head + .pt-plan-overview,
  .pt-section-head + .pt-feature-list,
  .pt-section-head + .pt-compare-wrap,
  .pt-section-head + .pt-usage-flat,
  .pt-section-head + .pt-menu-select,
  .pt-major-head + .pt-bench,
  .pt-major-head + .pt-plan-overview,
  .pt-major-head + .pt-feature-list,
  .pt-major-head + .pt-compare-wrap,
  .pt-major-head + .pt-usage-flat,
  .pt-major-head + .pt-menu-select {
    margin-top: 0;
  }

  .pt-market__pct {
    font-weight: 800;
    color: #16a34a;
  }

  .pt-market__pct--bad {
    color: #dc2626;
  }

  .pt-market__pct--neutral {
    color: #6b7280;
  }

  #pricing-benchmark,
  #pricing-plans,
  #pricing-real-world-cost,
  #pricing-feature-costs,
  #pricing-comparison,
  #pricing-verdict {
    scroll-margin-top: calc(var(--review-tabbar-height) + 0.75rem);
  }

  /* —— Market bar —— */
  .pt-bench {
    max-width: 26rem;
    margin-top: 1.15rem;
  }

  .pt-bench__chart {
    position: relative;
    padding-top: 3.75rem;
    padding-bottom: 1.65rem;
  }

  .pt-bench.has-typical-below .pt-bench__chart,
  .pt-bench.is-overlap .pt-bench__chart {
    padding-top: 3.6rem;
    padding-bottom: 3.85rem;
  }

  .pt-bench__track {
    position: relative;
    height: 10px;
    border-radius: 999px;
    background: #d1d5db;
  }

  .pt-bench__axis {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 1.15rem;
    pointer-events: none;
  }

  .pt-bench.has-typical-below .pt-bench__axis,
  .pt-bench.is-overlap .pt-bench__axis {
    bottom: 2.2rem;
  }

  .pt-bench__tick {
    position: absolute;
    top: 0;
    transform: translateX(-50%);
  }

  .pt-bench__tick--start {
    transform: translateX(0);
  }

  .pt-bench__tick--end {
    transform: translateX(-100%);
  }

  .pt-bench__tick-label {
    font-size: 11px;
    font-weight: 700;
    color: #6b7280;
    white-space: nowrap;
  }

  .pt-bench__marker {
    position: absolute;
    top: 3.75rem;
    transform: translate(-50%, calc(1.5px - 50%));
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    pointer-events: none;
  }

  .pt-bench.is-overlap .pt-bench__marker {
    top: 3.6rem;
  }

  .pt-bench__marker--avg {
    z-index: 2;
  }

  .pt-bench__marker--product {
    z-index: 4;
  }

  /* Extremely close: keep both markers visible as ring + inner fill */
  .pt-bench.is-overlap.is-stacked .pt-bench__marker--avg {
    z-index: 3;
  }

  .pt-bench.is-overlap.is-stacked .pt-bench__marker--product {
    z-index: 5;
    transform: translate(-50%, calc(1.5px - 50%));
  }

  .pt-bench__float {
    position: absolute;
    bottom: calc(100% + 12px);
    display: flex;
    flex-direction: column;
    align-items: center;
    white-space: nowrap;
  }

  .pt-bench__leader {
    display: none;
    position: absolute;
    left: 50%;
    width: 1px;
    background: currentColor;
    opacity: 0.35;
    transform: translateX(-50%);
    pointer-events: none;
  }

  /* Product above, typical monthly price always below — see also global rules in pricing-tab.css */
  .pt-bench.is-overlap .pt-bench__marker--product .pt-bench__float {
    bottom: calc(100% + 16px);
    align-items: center;
  }

  .pt-bench__float--below,
  .pt-bench.has-typical-below .pt-bench__marker--avg .pt-bench__float,
  .pt-bench.is-overlap .pt-bench__marker--avg .pt-bench__float {
    bottom: auto;
    top: calc(100% + 16px);
    align-items: center;
  }

  .pt-bench.has-typical-below .pt-bench__leader--avg,
  .pt-bench.is-overlap .pt-bench__leader {
    display: block;
  }

  .pt-bench.is-overlap .pt-bench__leader--product {
    bottom: 100%;
    height: 16px;
    color: #db2777;
  }

  .pt-bench.has-typical-below .pt-bench__leader--avg,
  .pt-bench.is-overlap .pt-bench__leader--avg {
    top: 100%;
    height: 16px;
    color: #374151;
  }

  .pt-bench__float-name {
    font-size: 12px;
    font-weight: 800;
    color: #111827;
  }

  .pt-bench__float-price {
    font-size: 13px;
    font-weight: 900;
    color: #111827;
    font-variant-numeric: tabular-nums;
  }

  .pt-bench__float--product .pt-bench__float-name,
  .pt-bench__float--product .pt-bench__float-price {
    color: #db2777;
  }

  .pt-bench__float--avg .pt-bench__float-name,
  .pt-bench__float--avg .pt-bench__float-price {
    color: #374151;
  }

  .pt-bench__dot {
    display: block;
    width: 12px;
    height: 12px;
    border-radius: 999px;
    box-sizing: border-box;
  }

  .pt-bench__dot--product {
    width: 14px;
    height: 14px;
    background: #db2777;
    border: 2px solid #fff;
    box-shadow: 0 0 0 1px rgb(219 39 119 / 35%);
    animation: pt-bench-pulse 1.8s ease-out infinite;
  }

  .pt-bench__dot--avg {
    width: 14px;
    height: 14px;
    background: #fff;
    border: 2.5px solid #111827;
    box-shadow: none;
  }

  .pt-bench.is-overlap.is-stacked .pt-bench__dot--avg {
    width: 18px;
    height: 18px;
    border-width: 2.5px;
  }

  .pt-bench.is-overlap.is-stacked .pt-bench__dot--product {
    width: 10px;
    height: 10px;
    border-width: 0;
    box-shadow: none;
  }

  .pt-bench__takeaway {
    margin: 0.85rem 0 0;
    font-size: 0.875rem;
    font-weight: 800;
    text-align: center;
    color: var(--color-on-surface);
  }

  .pt-bench__takeaway--neutral {
    color: #6b7280;
  }

  .pt-bench__takeaway--good {
    color: #16a34a;
  }

  .pt-bench__takeaway--bad {
    color: #dc2626;
  }

  @keyframes pt-bench-pulse {
    0% {
      transform: scale(1);
      box-shadow: 0 0 0 0 rgb(219 39 119 / 50%);
    }
    70% {
      transform: scale(1.15);
      box-shadow: 0 0 0 12px rgb(219 39 119 / 0%);
    }
    100% {
      transform: scale(1);
      box-shadow: 0 0 0 0 rgb(219 39 119 / 0%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pt-bench__dot--product {
      animation: none;
    }
  }

  /* —— Plans (editorial: billing + summary + credit pool + limits) —— */
  .pt-plans-wrap {
    --pt-plan-cols: 2;
  }

  .pt-plans-wrap > .pt-section-head .pt-prose__body {
    margin: 0 0 1rem;
    max-width: 42rem;
  }

  .pt-billing {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.4rem;
    margin-bottom: 1.35rem;
  }

  .pt-billing__label {
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #6b7280;
  }

  .pt-billing__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.55rem 0.7rem;
  }

  .pt-billing__switch {
    display: inline-flex;
    gap: 0.2rem;
    padding: 3px;
    border-radius: 999px;
    background: #f3f4f6;
  }

  .pt-billing__btn {
    border: none;
    border-radius: 999px;
    background: transparent;
    padding: 0.42rem 0.9rem;
    font-size: 0.8125rem;
    font-weight: 700;
    color: #6b7280;
    cursor: pointer;
  }

  .pt-billing__btn.is-active {
    background: #fff;
    color: var(--color-on-surface);
    box-shadow: 0 1px 2px rgb(0 0 0 / 8%);
  }

  .pt-billing__badge {
    display: inline-flex;
    align-items: center;
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    background: rgb(219 39 119 / 10%);
    color: #db2777;
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.02em;
  }

  .pt-billing__save {
    display: block;
    margin-top: 0.1rem;
    font-size: 0.625rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #db2777;
    line-height: 1.1;
  }

  .pt-billing__btn:not(.is-active) .pt-billing__save {
    color: #9ca3af;
  }


  .pt-plan-overview {
    display: grid;
    grid-template-columns: repeat(var(--pt-plan-cols), minmax(0, 1fr));
    gap: 0;
    margin: 0;
    padding: 0 0 2rem;
    border-bottom: 1px solid #e5e7eb;
  }

  .pt-plan-overview__col {
    padding: 0.25rem 1rem 0.25rem 0;
  }

  .pt-plan-overview__col + .pt-plan-overview__col {
    border-left: 1px solid #e5e7eb;
    padding-left: 1.15rem;
  }

  .pt-plan-overview__name {
    margin: 0 0 0.25rem;
    font-size: 0.8125rem;
    font-weight: 800;
    color: var(--color-on-surface);
  }

  .pt-plan-overview__price {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.4rem;
    font-size: 1.05rem;
    font-weight: 900;
    font-variant-numeric: tabular-nums;
    color: var(--color-on-surface);
  }

  .pt-plan-overview__list {
    font-size: 0.8125rem;
    font-weight: 700;
    color: #9ca3af;
    text-decoration: line-through;
  }

  .pt-plan-overview__badge {
    display: inline-flex;
    padding: 0.1rem 0.4rem;
    border-radius: 999px;
    background: rgb(219 39 119 / 10%);
    color: #db2777;
    font-size: 0.625rem;
    font-weight: 800;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .pt-plan-overview__credits {
    margin: 0.3rem 0 0;
    font-size: 0.8125rem;
    font-weight: 600;
    color: #6b7280;
  }

  .pt-plan-overview__billed {
    margin: 0.2rem 0 0;
    font-size: 0.75rem;
    font-weight: 600;
    color: #6b7280;
    line-height: 1.35;
  }

  .pt-plan-overview__save {
    margin: 0.15rem 0 0;
    font-size: 0.75rem;
    font-weight: 800;
    color: #db2777;
    line-height: 1.3;
  }

  .pt-plan-overview__unavailable {
    margin: 0.2rem 0 0;
    font-size: 0.8125rem;
    font-weight: 600;
    color: #9ca3af;
    line-height: 1.35;
  }

  .pt-plan-overview__col.is-unavailable .pt-plan-overview__price {
    display: none;
  }

  .pt-compare-note {
    margin: 1.15rem 0 0;
    max-width: 42rem;
    font-size: 1rem;
    line-height: 1.65;
    color: var(--color-on-surface-variant);
  }

  .pt-tool-selects {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 0.85rem 1.35rem;
    margin: 0 0 1rem;
  }

  .pt-tool-selects .pt-menu-select {
    margin: 0;
  }

  .pt-free-limits {
    margin: 0.85rem 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .pt-free-limits li {
    font-size: 0.875rem;
    color: var(--color-on-surface);
    padding-left: 0.85rem;
    position: relative;
  }

  .pt-free-limits li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 0.35rem;
    height: 0.35rem;
    border-radius: 999px;
    background: #d1d5db;
  }

  @keyframes pt-num-flash {
    from { opacity: 0.35; transform: translateY(3px); }
    to { opacity: 1; transform: none; }
  }

  .pt-num-flash {
    animation: pt-num-flash 0.35s ease;
  }

  @media (max-width: 720px) {
    .pt-plan-overview {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.85rem 0;
    }

    .pt-plan-overview__col + .pt-plan-overview__col {
      border-left: none;
      padding-left: 0;
    }

    .pt-plan-overview__col:nth-child(2n) {
      padding-left: 0.85rem;
      border-left: 1px solid #e5e7eb;
    }
  }

  .pt-plan-pick {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.4rem;
    margin: 0 0 1rem;
  }

  .pt-plan-pick__label {
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #6b7280;
  }

  .pt-plan-pick__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.15rem 0.1rem;
    border-bottom: 1px solid #e5e7eb;
    width: 100%;
  }

  .pt-plan-chip {
    appearance: none;
    border: none;
    background: transparent;
    padding: 0.55rem 0.85rem 0.65rem;
    margin: 0;
    font-size: 0.875rem;
    font-weight: 700;
    color: #6b7280;
    cursor: pointer;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
  }

  .pt-plan-chip.is-active {
    color: var(--color-on-surface);
    border-bottom-color: #db2777;
  }

  .pt-plan-active {
    margin: 0 0 1.5rem;
    padding: 0 0 1.35rem;
    border-bottom: 1px solid #e5e7eb;
  }

  .pt-plan-active__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 0.65rem;
    margin: 0 0 0.35rem;
  }

  .pt-plan-active__name {
    margin: 0;
    font-size: 0.8125rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-on-surface);
  }

  .pt-plan-active__billing {
    margin: 0;
    font-size: 0.75rem;
    font-weight: 700;
    color: #9ca3af;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .pt-plan-active__price {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 0.55rem;
    font-size: 1.5rem;
    font-weight: 900;
    font-variant-numeric: tabular-nums;
    color: var(--color-on-surface);
    line-height: 1.15;
  }

  .pt-plan-active__list {
    font-size: 1rem;
    font-weight: 700;
    color: #9ca3af;
    text-decoration: line-through;
  }

  .pt-plan-active__badge {
    display: inline-flex;
    align-items: center;
    padding: 0.15rem 0.45rem;
    border-radius: 999px;
    background: rgb(219 39 119 / 10%);
    color: #db2777;
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .pt-plan-active__sale-note {
    margin: 0.2rem 0 0;
    font-size: 0.75rem;
    font-weight: 600;
    color: #6b7280;
  }

  .pt-plan-active__sub {
    margin: 0.25rem 0 0;
    font-size: 0.8125rem;
    color: #6b7280;
  }

  .pt-plan-active__credits {
    margin: 0.65rem 0 0;
    font-size: 0.9375rem;
    font-weight: 800;
    color: var(--color-on-surface);
  }

  .pt-plan-active__highlights {
    margin: 0.55rem 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .pt-plan-active__highlights li {
    font-size: 0.8125rem;
    color: #6b7280;
    padding-left: 0.85rem;
    position: relative;
  }

  .pt-plan-active__highlights li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 0.35rem;
    height: 0.35rem;
    border-radius: 999px;
    background: #d1d5db;
  }

  .pt-mixer-host {
    margin-top: 1rem;
  }

  .pt-credit-pool__empty {
    margin: 0.75rem 0 0;
    font-size: 0.875rem;
    color: #6b7280;
  }

  .pt-plan-summary {
    display: grid;
    grid-template-columns: repeat(var(--pt-plan-cols), minmax(0, 1fr));
    gap: 0;
    margin: 0 0 1.75rem;
    padding: 0.15rem 0 1.35rem;
    border-bottom: 1px solid #e5e7eb;
  }

  .pt-plan-summary__item {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0.35rem 1rem 0.35rem 0;
  }

  .pt-plan-summary__item + .pt-plan-summary__item {
    border-left: 1px solid #e5e7eb;
    padding-left: 1.25rem;
  }

  .pt-plan-summary__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 999px;
    flex-shrink: 0;
    margin-top: 0.15rem;
  }

  .pt-plan-summary__icon .material-symbols-outlined {
    font-size: 16px;
  }

  .pt-plan-summary__icon--paid {
    background: #db2777;
    color: #fff;
  }

  .pt-plan-summary__icon--free {
    background: #e5e7eb;
    color: #4b5563;
  }

  .pt-plan-summary__name {
    margin: 0;
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #6b7280;
  }

  .pt-plan-summary__price {
    margin: 0.2rem 0 0;
    font-size: 1.35rem;
    font-weight: 900;
    color: var(--color-on-surface);
    font-variant-numeric: tabular-nums;
    line-height: 1.15;
  }

  .pt-plan-summary__line {
    margin: 0.3rem 0 0;
    font-size: 0.875rem;
    font-weight: 600;
    color: #4b5563;
  }

  .pt-plan-summary__sub,
  .pt-plan-summary__save,
  .pt-plan-summary__unavailable {
    margin: 0.25rem 0 0;
    font-size: 0.75rem;
    font-weight: 600;
    color: #6b7280;
  }

  .pt-plan-summary__save {
    color: #db2777;
    font-weight: 800;
  }

  .pt-plan-summary__unavailable {
    color: #9ca3af;
  }

  .pt-credit-pool {
    margin: 0 0 1.75rem;
    padding: 4.5rem 0 1.5rem;
  }

  .pt-credit-pool > .pt-section-head {
    margin-bottom: 0.65rem;
  }

  .pt-credit-pool__intro {
    margin: 0 0 1.15rem;
    max-width: 36rem;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: #4b5563;
  }

  .pt-credit-pool__config {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    margin: 0 0 0.85rem;
  }

  .pt-credit-pool__field {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.4rem;
  }

  .pt-credit-pool [data-pt-plan-menu].pt-billing__switch {
    padding: 4px;
    gap: 0.25rem;
  }

  .pt-credit-pool [data-pt-plan-menu] .pt-billing__btn {
    padding: 0.55rem 1.15rem;
    font-size: 0.875rem;
    font-weight: 800;
    transition: background 0.15s ease, color 0.15s ease, box-shadow 0.15s ease, transform 0.12s ease;
  }

  .pt-credit-pool [data-pt-plan-menu] .pt-billing__btn:hover:not(.is-active) {
    color: var(--color-on-surface);
    background: rgb(255 255 255 / 70%);
  }

  .pt-credit-pool [data-pt-plan-menu] .pt-billing__btn.is-active {
    background: #fff;
    color: var(--color-on-surface);
    box-shadow: 0 1px 3px rgb(0 0 0 / 12%), 0 0 0 1px rgb(219 39 119 / 18%);
  }

  .pt-credit-pool [data-pt-plan-menu] .pt-billing__btn:active {
