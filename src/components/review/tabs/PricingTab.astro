    font-weight: normal;
    font-style: normal;
    line-height: 1;
    display: inline-block;
  }

  .pt-usage-math__row--subtotal th,
  .pt-usage-math__row--subtotal td {
    font-weight: 800;
  }

  .pt-usage-math__row--extra th,
  .pt-usage-math__row--extra td {
    font-weight: 800;
    color: #db2777;
