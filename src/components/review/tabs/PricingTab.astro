  .pt-mixer-host {
    margin-top: 1.35rem;
  }

  /* Full-bleed broken-white band (header surface) across content + sidebar */
  .pt-mixer-host:has([data-pt-mixer]) {
    position: relative;
    z-index: 0;
    margin-top: 1.75rem;
    padding: 1.5rem 0 1.65rem;
    border-top: none;
    background: var(--color-header-surface, #f8faf3);
    --pt-bleed-left: -1rem;
    --pt-bleed-right: -1rem;
  }

  .pt-mixer-host:has([data-pt-mixer])::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--pt-bleed-left);
    right: var(--pt-bleed-right);
    background: inherit;
    z-index: -1;
    pointer-events: none;
  }

  @media (min-width: 768px) {
    .pt-mixer-host:has([data-pt-mixer]) {
      --pt-bleed-left: -2rem;
      --pt-bleed-right: -2rem;
    }
  }

  @media (min-width: 1024px) {
    .pt-mixer-host:has([data-pt-mixer]) {
      /* Fallback before JS measures exact viewport edges */
      --pt-bleed-left: -2rem;
      --pt-bleed-right: calc(-1 * (280px + 2.5rem + 2rem));
    }
  }

