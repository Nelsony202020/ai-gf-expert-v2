    color: #4b5563;
  }

  .pt-topups__more {
    margin: 0.35rem 0 0;
    font-size: 0.75rem;
    color: #9ca3af;
  }

  .pt-usage-calc {
    margin: 0;
    display: grid;
    gap: 0.4rem;
  }

  .pt-usage-calc__row {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.875rem;
    color: #6b7280;
  }

  .pt-usage-calc__row dd {
    margin: 0;
    font-weight: 800;
    color: var(--color-on-surface);
    font-variant-numeric: tabular-nums;
  }

  .pt-usage-calc__row--total {
    margin-top: 0.15rem;
    padding-top: 0.5rem;
    border-top: 1px solid #e5e7eb;
    font-weight: 800;
