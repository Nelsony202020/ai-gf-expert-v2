---
import type { Product } from '../../../data/products';
import { getAuthor } from '../../../data/authors';
import InfoIcon from '../../ui/InfoIcon.astro';
import VerifiedCheck from '../../ui/VerifiedCheck.astro';
import { affiliateRel } from '../../../lib/affiliate/rel';
import { fmtMoney } from '../../../lib/pricing/calc';
import { fmtScore, getScoreVisual } from '../../../lib/scores';
import { clampBarPct, computeHeroComparison } from '../../../lib/pricing-tab/types';
import { splitUnitSuffix } from '../../../lib/pricing-tab/formatUnits';
import { loadPricingTabViewModel } from '../../../lib/pricing-tab/loadPricingTab';

interface Props {
  product: Product;
}

const PRICING_MODEL_LABELS: Record<string, string> = {
  subscription_only: 'Subscription only',
  subscription_credits: 'Subscription + tokens',
  credits_only: 'Token based',
  free_plus_credits: 'Freemium + tokens',
  mixed: 'Mixed pricing',
  custom: 'Custom pricing',
};

const { product } = Astro.props;
const vm = await loadPricingTabViewModel(product);
const herman = getAuthor('herman-carter');
const pricingTagline =
  product.verdicts?.find((v) => v.id === 'pricing')?.tagline
  ?? vm.scoreLabel
  ?? null;
const scoreVisual = getScoreVisual(vm.pricingScore);
const ctaRel = affiliateRel(product.affiliateRel);

const barMin = vm.barMin ?? 0;
const barMax = vm.barMax ?? 80;
const axisTicks = [
  { pct: 0, label: '$0' },
  { pct: 100, label: '$80+' },
];

const advertisedLabel =
  vm.advertisedMonthly != null ? `${fmtMoney(vm.advertisedMonthly, vm.currency)}/mo` : '—';
const advertisedShort =
  vm.advertisedMonthly != null ? fmtMoney(vm.advertisedMonthly, vm.currency) : '—';
const regularUseLabel =
  vm.regularUseMonthly != null ? `~${fmtMoney(vm.regularUseMonthly, vm.currency)}/mo` : '—';

/** Price-vs-market uses starting price vs category regular-use average (editorial benchmark). */
const marketAvgAmount = vm.categoryAvgMonthly;
const marketAvgLabel =
  marketAvgAmount != null ? `~${fmtMoney(marketAvgAmount, vm.currency)}` : '—';
const marketCompare = computeHeroComparison(vm.advertisedMonthly, marketAvgAmount);
const productBarPct =
  vm.advertisedMonthly != null ? clampBarPct(vm.advertisedMonthly, barMin, barMax) : null;
const avgBarPct =
  marketAvgAmount != null ? clampBarPct(marketAvgAmount, barMin, barMax) : null;
const cheaperPctAbs =
  marketCompare.cheaperPct != null ? Math.abs(marketCompare.cheaperPct) : null;
const cheaperIsGood = marketCompare.cheaperPct != null && marketCompare.cheaperPct >= 0;

const regularUseTip =
  'Estimated from our standard regular-use scenario (daily chat with images and some video). Includes subscription fees and typical credit spend.';

const pricingModelLabel =
  (vm.pricingModel && PRICING_MODEL_LABELS[vm.pricingModel]) ||
  (product.capabilities?.tokenSystem ? 'Subscription + tokens' : null) ||
  (vm.advertisedMonthly != null ? 'Subscription only' : null);

const pageIntro = vm.pageIntro;
const marketIntro = vm.marketIntro;
const plansIntro = vm.plansIntro;
const usageIntro =
  vm.usageIntro
  ?? `The advertised subscription price only tells part of the story. We estimate what light, regular, and heavy ${vm.productName} users would actually spend after accounting for credit usage.`;
const featureCostsIntro = vm.featureCostsIntro;
const compareIntro = vm.compareIntro;
const limitsHeading = vm.limitsHeading || 'Free vs. paid';

const usageCosts = vm.usageTiers
  .map((t) => t.monthlyCost)
  .filter((n): n is number => n != null && Number.isFinite(n));
const usageCostsIdentical =
  usageCosts.length >= 2
  && usageCosts.every((n) => Math.abs(n - usageCosts[0]) < 0.05);
const flatUsageCost = usageCostsIdentical ? usageCosts[0] : null;

const defaultUsage = vm.usageTiers.find((t) => t.id === 'regular') ?? vm.usageTiers[0] ?? null;

function topUpLabel(topUp: number | null | undefined): string {
  if (topUp == null) return '—';
  if (topUp > 0) return `~${fmtMoney(topUp, vm.currency)}`;
  return '$0';
}

const usagePayload = JSON.stringify(
  Object.fromEntries(
    vm.usageTiers.map((tier) => {
      const topUp =
        tier.topUpCost != null
          ? tier.topUpCost
          : tier.monthlyCost != null && tier.planCost != null
            ? Math.round((tier.monthlyCost - tier.planCost) * 100) / 100
            : null;
      return [
        tier.id,
        {
          title: tier.title,
          description: tier.description,
          costLabel: tier.costLabel,
          icon: tier.icon,
          planLabel:
            tier.planCost != null ? `${fmtMoney(tier.planCost, vm.currency)}` : advertisedLabel.replace(/\/mo$/, ''),
          topUpLabel: topUpLabel(topUp),
          totalLabel: tier.costLabel,
          chat: tier.assumptions.chat,
          images: tier.assumptions.images,
          videos: tier.assumptions.videos,
          voice: tier.assumptions.voice,
          character: tier.assumptions.character,
          calculation: tier.calculation,
        },
      ];
    }),
  ),
);

const defaultPlanLabel =
  defaultUsage?.planCost != null
    ? fmtMoney(defaultUsage.planCost, vm.currency)
    : advertisedLabel.replace(/\/mo$/, '');
const defaultTopUpLabel = topUpLabel(defaultUsage?.topUpCost);
const defaultCalculation = defaultUsage?.calculation ?? null;

const defaultPlanKey =
  vm.creditPool?.defaultPlanKey
  ?? vm.plans.find((p) => !p.isFree && p.isRecommended)?.key
  ?? vm.plans.find((p) => !p.isFree)?.key
  ?? vm.plans[0]?.key
  ?? '';
const defaultPlan = vm.plans.find((p) => p.key === defaultPlanKey) ?? null;
const defaultBudget = vm.creditPool?.byPlan?.[defaultPlanKey] ?? null;
const defaultBilling: 'monthly' | 'quarterly' | 'yearly' =
  vm.creditPool?.defaultInterval
  ?? (defaultPlan?.billing?.monthly
    ? 'monthly'
    : defaultPlan?.billing?.quarterly
      ? 'quarterly'
      : 'yearly');
const defaultPlanHasBilling = Boolean(
  defaultPlan
  && !defaultPlan.isFree
  && [
      defaultPlan.billing?.monthly,
      defaultPlan.billing?.quarterly,
      defaultPlan.billing?.yearly,
    ].filter(Boolean).length > 1,
);
const defaultBillingOpt =
  defaultBilling === 'yearly'
    ? defaultPlan?.billing?.yearly
    : defaultBilling === 'quarterly'
      ? defaultPlan?.billing?.quarterly
      : defaultPlan?.billing?.monthly;
const defaultPlanPrice =
  defaultPlan?.isFree
    ? defaultPlan.priceLabel
    : defaultBillingOpt?.monthlyPriceLabel ?? defaultPlan?.priceLabel ?? '—';
const defaultPlanSub =
  defaultPlan?.isFree
    ? defaultPlan.priceSub ?? 'Try before paying'
    : defaultBillingOpt?.priceSub ?? defaultPlan?.priceSub ?? '';
const defaultYearlySave = defaultPlan?.billing?.yearly?.savingsLabel ?? null;
const defaultQuarterlySave = defaultPlan?.billing?.quarterly?.savingsLabel ?? null;
const defaultSale = defaultBillingOpt?.sale ?? null;
const defaultCreditsLine = defaultBudget?.creditsLine ?? null;

const freePlan = vm.plans.find((p) => p.isFree) ?? null;
const defaultComparePaid =
  defaultPlan && !defaultPlan.isFree
    ? defaultPlan
    : vm.plans.find((p) => !p.isFree && p.isRecommended)
      ?? vm.plans.find((p) => !p.isFree)
      ?? null;
const defaultLimitPlans = [freePlan, defaultComparePaid].filter(Boolean) as typeof vm.plans;
const defaultLimitsHeading =
  freePlan && defaultComparePaid
    ? `Free vs. ${defaultComparePaid.displayName}`
    : limitsHeading;

const plansPayload = JSON.stringify({
  plans: vm.plans.map((plan) => ({
    key: plan.key,
    displayName: plan.displayName,
    isFree: plan.isFree,
    priceLabel: plan.priceLabel,
    priceSub: plan.priceSub ?? '',
    summaryLine: plan.summaryLine,
    billing: plan.billing
      ? {
          monthly: plan.billing.monthly
            ? {
                monthlyPriceLabel: plan.billing.monthly.monthlyPriceLabel,
                priceSub: plan.billing.monthly.priceSub,
                savingsLabel: plan.billing.monthly.savingsLabel,
                sale: plan.billing.monthly.sale,
              }
            : null,
          quarterly: plan.billing.quarterly
            ? {
                monthlyPriceLabel: plan.billing.quarterly.monthlyPriceLabel,
                priceSub: plan.billing.quarterly.priceSub,
                savingsLabel: plan.billing.quarterly.savingsLabel,
                sale: plan.billing.quarterly.sale,
              }
            : null,
          yearly: plan.billing.yearly
            ? {
                monthlyPriceLabel: plan.billing.yearly.monthlyPriceLabel,
                priceSub: plan.billing.yearly.priceSub,
                savingsLabel: plan.billing.yearly.savingsLabel,
                sale: plan.billing.yearly.sale,
              }
            : null,
        }
      : null,
  })),
  freePlanKey: freePlan?.key ?? null,
  limitRows: vm.limitRows.map((row) => ({
    key: row.key,
    cells: Object.fromEntries(
      vm.plans.map((plan, idx) => [plan.key, row.cells[idx] ?? '—']),
    ),
  })),
  byPlan: vm.creditPool?.byPlan ?? {},
  defaultPlanKey,
  defaultInterval: defaultBilling,
});
function withUnit(value: string) {
  return splitUnitSuffix(value);
}
---

<section class="py-12 md:py-14 bg-background dark-section pricing-tab">
  <div class="section-container px-4 md:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_280px] gap-8 lg:gap-10">
      <div class="min-w-0">
        <header class="pt-page-head pt-section-head mb-10">
          <p class="pt-eyebrow">Pricing &amp; value</p>
          <h2 class="pt-title">{vm.productName} pricing</h2>
          {pageIntro && <p class="pt-lead">{pageIntro}</p>}
          {
            vm.pricingEvidence?.main && (
              <p class="pt-evidence">
                <VerifiedCheck class="w-[14px] h-[14px]" />
                <span>{vm.pricingEvidence.verifiedLabel}</span>
                <span class="pt-evidence__sep" aria-hidden="true">·</span>
                <button
                  type="button"
                  class="pt-evidence__view"
                  data-lightbox-open={vm.pricingEvidence.main.src}
                  data-lightbox-alt={vm.pricingEvidence.main.alt}
                  data-lightbox-caption={`${vm.pricingEvidence.verifiedLabel}. ${vm.pricingEvidence.capturedLabel}`}
                >
                  <span class="material-symbols-outlined" aria-hidden="true">image</span>
                  View screenshot
                </button>
                {
                  vm.pricingEvidence.sourceUrl && (
                    <>
                      <span class="pt-evidence__sep" aria-hidden="true">·</span>
                      <a
                        href={vm.pricingEvidence.sourceUrl}
                        class="pt-evidence__source"
                        target="_blank"
                        rel={ctaRel}
                      >
                        Open original pricing page
                      </a>
                    </>
                  )
                }
              </p>
            )
          }
        </header>

        <!-- Is [Product] expensive? -->
        <section class="pt-block" id="pricing-benchmark" aria-labelledby="pt-market-title">
          <header class="pt-section-head">
            <p class="pt-eyebrow">Market position</p>
            <h3 id="pt-market-title" class="pt-title">Is {vm.productName} expensive?</h3>
          </header>

          {
            marketIntro ? (
              <p class="pt-prose__body">{marketIntro}</p>
            ) : cheaperPctAbs != null ? (
              <p class="pt-prose__body">
                {
                  cheaperIsGood ? (
                    <>
                      {vm.productName} is <span class="pt-market__pct">{cheaperPctAbs}%</span> cheaper
                      than most AI girlfriend apps we tested.
                    </>
                  ) : (
                    <>
                      {vm.productName} is <span class="pt-market__pct pt-market__pct--bad">{cheaperPctAbs}%</span> more
                      expensive than most AI girlfriend apps we tested.
                    </>
                  )
                }
              </p>
            ) : null
          }

          {
            productBarPct != null && (
              <div class="pt-bench" aria-label="Starting price market position">
                <div class="pt-bench__chart">
                  {
                    avgBarPct != null && (
                      <div
                        class="pt-bench__marker pt-bench__marker--avg"
                        style={`left: ${avgBarPct}%`}
                        aria-label={`Market average ${marketAvgLabel}`}
                      >
                        <span class="pt-bench__float">
                          <span class="pt-bench__float-name">Market average</span>
                          <span class="pt-bench__float-price">{marketAvgLabel}</span>
                        </span>
                        <span class="pt-bench__dot pt-bench__dot--avg" />
                      </div>
                    )
                  }
                  <div
                    class="pt-bench__marker pt-bench__marker--product"
                    style={`left: ${productBarPct}%`}
                    aria-label={`${vm.productName} ${advertisedShort}`}
                  >
                    <span class="pt-bench__float pt-bench__float--product">
                      <span class="pt-bench__float-name">{vm.productName}</span>
                      <span class="pt-bench__float-price">{advertisedShort}</span>
                    </span>
                    <span class="pt-bench__dot pt-bench__dot--product" />
                  </div>

                  <div class="pt-bench__track" />

                  <div class="pt-bench__axis">
                    {
                      axisTicks.map((tick) => (
                        <span
                          class:list={[
                            'pt-bench__tick',
                            tick.pct === 0 && 'pt-bench__tick--start',
                            tick.pct === 100 && 'pt-bench__tick--end',
                          ]}
                          style={`left: ${tick.pct}%`}
                        >
                          <span class="pt-bench__tick-label">{tick.label}</span>
                        </span>
                      ))
                    }
                  </div>
                </div>
              </div>
            )
          }
        </section>

        <!-- Plans -->
        <section
          class="pt-block"
          id="pricing-plans"
          aria-labelledby="pt-plans-title"
          data-pt-plans
          data-pt-billing={vm.billingToggle.defaultInterval}
          data-pt-selected-plan={defaultPlanKey}
          data-pt-plan-count={vm.plans.length}
          data-pt-plans-payload={plansPayload}
        >
          {
            vm.plans.length > 0 ? (
              <div class="pt-plans-wrap">
                <header class="pt-section-head">
                  <p class="pt-eyebrow">Plans</p>
                  <h3 id="pt-plans-title" class="pt-title">Plans & what you get</h3>
                  {plansIntro && <p class="pt-lead pt-lead--tight">{plansIntro}</p>}
                </header>

                <div
                  class="pt-plan-overview"
                  style={`--pt-plan-cols: ${Math.max(vm.plans.length, 1)}`}
                  aria-label="Plan comparison"
                >
                  {
                    vm.plans.map((plan) => {
                      const monthly = plan.billing?.monthly;
                      const yearly = plan.billing?.yearly;
                      const sale = monthly?.sale ?? yearly?.sale ?? null;
                      const price = plan.isFree
                        ? plan.priceLabel
                        : monthly?.monthlyPriceLabel ?? plan.priceLabel;
                      return (
                        <div class="pt-plan-overview__col" data-pt-overview-plan={plan.key}>
                          <p class="pt-plan-overview__name">{plan.displayName}</p>
                          <p class="pt-plan-overview__price">
                            {
                              sale?.listPriceLabel ? (
                                <span class="pt-plan-overview__list">
                                  {sale.listPriceLabel}
                                  {!plan.isFree && <span class="pt-unit">/mo</span>}
                                </span>
                              ) : null
                            }
                            <span>
                              {price}
                              {!plan.isFree && <span class="pt-unit">/mo</span>}
                            </span>
                            {
                              sale?.badge ? (
                                <span class="pt-plan-overview__badge">{sale.badge}</span>
                              ) : null
                            }
                          </p>
                          <p class="pt-plan-overview__credits">{plan.summaryLine}</p>
                        </div>
                      );
                    })
                  }
                </div>

                                {
                  vm.creditPool && (
                    <div
                      class="pt-credit-pool"
                      data-pt-credit-pool
                      data-pt-credit-mixer={defaultBudget?.mixer ? 'true' : 'false'}
                      data-pt-mixer-payload={
                        defaultBudget?.mixer ? JSON.stringify(defaultBudget.mixer) : undefined
                      }
                      data-pt-pool-by-plan={JSON.stringify(vm.creditPool.byPlan)}
                    >
                      <header class="pt-section-head">
                        <p class="pt-eyebrow">Credit value</p>
                        <h4 class="pt-title">What your credits can buy</h4>
                      </header>

                      <div class="pt-tool-selects">
                        <div
                          class="pt-menu-select pt-menu-select--inline"
                          data-pt-tool-plan-select
                          hidden={vm.plans.length <= 1}
                        >
                          <span class="pt-label" id="pt-tool-plan-label">Plan</span>
                          <div class="pt-menu-select__wrap">
                            <button
                              type="button"
                              class="pt-menu-select__trigger"
                              data-pt-plan-open
                              aria-haspopup="listbox"
                              aria-expanded="false"
                              aria-labelledby="pt-tool-plan-label"
                            >
                              <span class="pt-menu-select__value" data-pt-plan-label>
                                {defaultPlan?.displayName ?? 'Plan'}
                              </span>
                              <span class="material-symbols-outlined pt-menu-select__chevron" aria-hidden="true">expand_more</span>
                            </button>
                            <div class="pt-menu-select__menu" data-pt-plan-menu role="listbox" hidden>
                              {
                                vm.plans.map((plan) => (
                                  <button
                                    type="button"
                                    role="option"
                                    class:list={[
                                      'pt-menu-select__option',
                                      plan.key === defaultPlanKey && 'is-active',
                                    ]}
                                    data-pt-plan-select={plan.key}
                                    aria-selected={plan.key === defaultPlanKey ? 'true' : 'false'}
                                  >
                                    {plan.displayName}
                                  </button>
                                ))
                              }
                            </div>
                          </div>
                        </div>

                        <div
                          class="pt-menu-select pt-menu-select--inline"
                          data-pt-billing-group
                          hidden={!defaultPlanHasBilling}
                        >
                          <span class="pt-label" id="pt-tool-billing-label">Billing</span>
                          <div class="pt-menu-select__wrap">
                            <button
                              type="button"
                              class="pt-menu-select__trigger"
                              data-pt-billing-open
                              aria-haspopup="listbox"
                              aria-expanded="false"
                              aria-labelledby="pt-tool-billing-label"
                            >
                              <span class="pt-menu-select__value" data-pt-billing-label>
                                {
                                  defaultBilling === 'yearly'
                                    ? 'Annual'
                                    : defaultBilling === 'quarterly'
                                      ? 'Quarterly'
                                      : 'Monthly'
                                }
                              </span>
                              <span class="material-symbols-outlined pt-menu-select__chevron" aria-hidden="true">expand_more</span>
                            </button>
                            <div class="pt-menu-select__menu" data-pt-billing-menu role="listbox" hidden>
                              <button
                                type="button"
                                role="option"
                                class:list={['pt-menu-select__option', defaultBilling === 'monthly' && 'is-active']}
                                data-pt-billing-select="monthly"
                                data-pt-billing-opt="monthly"
                                aria-selected={defaultBilling === 'monthly' ? 'true' : 'false'}
                                hidden={!defaultPlan?.billing?.monthly}
                              >
                                Monthly
                              </button>
                              <button
                                type="button"
                                role="option"
                                class:list={['pt-menu-select__option', defaultBilling === 'quarterly' && 'is-active']}
                                data-pt-billing-select="quarterly"
                                data-pt-billing-opt="quarterly"
                                aria-selected={defaultBilling === 'quarterly' ? 'true' : 'false'}
                                hidden={!defaultPlan?.billing?.quarterly}
                              >
                                Quarterly
                              </button>
                              <button
                                type="button"
                                role="option"
                                class:list={['pt-menu-select__option', defaultBilling === 'yearly' && 'is-active']}
                                data-pt-billing-select="yearly"
                                data-pt-billing-opt="yearly"
                                aria-selected={defaultBilling === 'yearly' ? 'true' : 'false'}
                                hidden={!defaultPlan?.billing?.yearly}
                              >
                                Annual
                                {
                                  defaultYearlySave ? (
                                    <span class="pt-billing__save" data-pt-billing-save>
                                      {defaultYearlySave}
                                    </span>
                                  ) : null
                                }
                              </button>
                            </div>
                          </div>
                        </div>
                      </div>

                      <p
                        class="pt-credit-pool__credits"
                        data-pt-active-credits
                        data-pt-pool-credits
                        hidden={!defaultCreditsLine}
                      >
                        {defaultCreditsLine}
                      </p>
                      <p
                        class="pt-plan-active__sale-note"
                        data-pt-active-sale-note
                        hidden={!defaultSale?.note}
                      >
                        {defaultSale?.note}
                      </p>

                      <p class="pt-credit-pool__lead" data-pt-pool-lead hidden={!defaultBudget?.mixer}>
                        If you spent all <span data-pt-pool-credit-n>{(defaultBudget?.credits ?? 0).toLocaleString('en-US')}</span> credits on one feature:
                      </p>
                      <p class="pt-credit-pool__note" data-pt-pool-note hidden={Boolean(defaultBudget?.mixer)}>
                        {defaultBudget?.isFree
                          ? 'This plan uses hard daily limits instead of a shared credit pool.'
                          : vm.creditPool.note}
                      </p>

                      <div class="pt-credit-pool__skim" aria-label="Maximum equivalents" data-pt-pool-skim>
                        {
                          (defaultBudget?.items ?? []).map((item) => (
                            <span class="pt-credit-pool__skim-item">{item.value.replace(/\/mo$/, '')}</span>
                          ))
                        }
                      </div>
                      <div class="pt-mixer-host" data-pt-mixer-host>
                        {
                          defaultBudget?.mixer ? (
                            <>
                            <div class="pt-mixer" data-pt-mixer>
                              <div class="pt-mixer__tool-head">
                                <p class="pt-mixer__tool-eyebrow">Interactive tool</p>
                                <p class="pt-mixer__tool-title">
                                  <span class="material-symbols-outlined" aria-hidden="true">tune</span>
                                  Build your mix
                                </p>
                                <p class="pt-mixer__tool-help">
                                  Adjust each feature to see how your{' '}
                                  <span data-pt-mixer-help-n>
                                    {(defaultBudget.mixer.credits ?? 0).toLocaleString('en-US')}
                                  </span>{' '}
                                  credits could be split.
                                </p>
                              </div>

                              <div class="pt-mixer-mobile" data-pt-mixer-mobile>
                                <div class="pt-mixer-mobile__meta">
                                  <span class="pt-label">Preset</span>
                                  <strong data-pt-mixer-mobile-preset>Custom mix</strong>
                                </div>
                                <p class="pt-mixer-mobile__used">
                                  <span data-pt-mixer-mobile-used-line>0 / {defaultBudget.mixer.credits} credits used</span>
                                </p>
                                <p class="pt-mixer-mobile__mix" data-pt-mixer-mobile-mix>
                                  Adjust to build a mix
                                </p>
                                <div class="pt-mixer-mobile__viz">
                                  <div class="pt-mixer__donut pt-mixer__donut--sm" data-pt-mixer-mobile-donut role="img" aria-label="Credit allocation">
                                    <div class="pt-mixer__donut-ring" data-pt-mixer-mobile-donut-ring />
                                    <div class="pt-mixer__donut-hole" aria-hidden="true" />
                                    <div class="pt-mixer__donut-center">
                                      <strong data-pt-mixer-mobile-center>{defaultBudget.mixer.credits}</strong>
                                      <span>left</span>
                                    </div>
                                  </div>
                                  <ul class="pt-mixer-mobile__legend" data-pt-mixer-mobile-legend>
                                    {
                                      defaultBudget.mixer.channels.map((ch) => (
                                        <li
                                          class={`pt-mixer__legend-item pt-mixer__legend-item--${ch.key}`}
                                          data-pt-mixer-mobile-legend-item={ch.key}
                                          hidden
                                        >
                                          <span class="pt-mixer__legend-swatch" aria-hidden="true" />
                                          <span class="pt-mixer__legend-name">{ch.label}</span>
                                          <span class="pt-mixer__legend-cr" data-pt-mixer-mobile-legend-cr>0</span>
                                        </li>
                                      ))
                                    }
                                    <li
                                      class="pt-mixer__legend-item pt-mixer__legend-item--remaining"
                                      data-pt-mixer-mobile-legend-item="remaining"
                                    >
