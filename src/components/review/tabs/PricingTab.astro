                                          Custom mix
                                        </button>
                                        {
                                          defaultBudget.mixer.presets
                                            .filter((p) => p.id !== 'reset')
                                            .map((preset) => (
                                              <button
                                                type="button"
                                                role="option"
                                                class="pt-menu-select__option"
                                                data-pt-mixer-sheet-preset={preset.id}
                                                aria-selected="false"
                                              >
                                                {preset.label}
                                              </button>
                                            ))
                                        }
                                      </div>
                                    </div>
                                  </div>
                                  <div class="pt-mixer-sheet__controls">
                                    {
                                      defaultBudget.mixer.channels.map((ch) => (
                                        <div
                                          class="pt-mixer__control pt-mixer-sheet__control"
                                          data-pt-mixer-sheet-control={ch.key}
                                          data-credits-per-unit={ch.creditsPerUnit}
                                          data-step={ch.step}
                                          data-format={ch.format}
                                          data-unit-label={ch.unitLabel}
                                        >
                                          <div class="pt-mixer__control-meta">
                                            <span class="pt-mixer__control-label">{ch.label}</span>
                                            {(ch.unitMoneyLabel || ch.sublabel) && (
                                              <span class="pt-mixer__control-rate">
                                                {ch.unitMoneyLabel || ch.sublabel}
                                              </span>
                                            )}
                                          </div>
                                          <div class="pt-mixer__stepper pt-mixer-sheet__stepper">
                                            <button
                                              type="button"
                                              class="pt-mixer__step"
