    margin-left: 0.15rem;
    font-weight: 700;
  }

  .pt-usage-calc-details[open] > summary::after {
    content: '↑';
  }

  .pt-usage-math {
    margin-top: 1rem;
    max-width: 40rem;
  }

  .pt-usage-math__heading {
    margin: 0 0 0.4rem;
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 800;
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--color-on-surface);
  }

  .pt-usage-math__intro {
    margin: 0 0 1.35rem;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: #6b7280;
  }

  .pt-usage-math__block {
    margin: 0 0 1.5rem;
  }

  .pt-usage-math__block--final {
    margin-bottom: 0.25rem;
  }

  .pt-usage-math__step {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    margin-bottom: 0.75rem;
  }

  .pt-usage-math__num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.35rem;
    height: 1.35rem;
    border-radius: 999px;
    background: #db2777;
    color: #fff;
    font-size: 0.6875rem;
    font-weight: 800;
    flex-shrink: 0;
    margin-top: 0.05rem;
  }

  .pt-usage-math__block-title {
    margin: 0 0 0.2rem;
