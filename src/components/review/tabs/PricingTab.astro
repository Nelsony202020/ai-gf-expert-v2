  .pt-menu-select__option {
    display: flex;
    align-items: center;
    width: 100%;
    min-height: 40px;
    padding: 0.45rem 0.7rem;
    border: none;
    border-radius: 8px;
    background: transparent;
    color: var(--color-on-surface);
    font: inherit;
    font-size: 0.8125rem;
    font-weight: 700;
    text-align: left;
    cursor: pointer;
  }

  .pt-menu-select__option:hover,
  .pt-menu-select__option:focus-visible {
    background: #f3f4f6;
    outline: none;
  }

  .pt-menu-select__option.is-active {
    background: rgb(252 231 243 / 55%);
    color: #db2777;
  }

