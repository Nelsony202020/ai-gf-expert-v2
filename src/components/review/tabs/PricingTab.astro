<script>
  document.querySelectorAll<HTMLElement>('[data-pt-usage]').forEach((root) => {
    const raw = root.getAttribute('data-pt-usage-payload');
    if (!raw) return;

    type TierDiff = { realLabel: string; realValue: string; diffValue: string };
    let payload: Record<string, TierDiff> = {};
    try {
      payload = JSON.parse(raw) as Record<string, TierDiff>;
    } catch {
      return;
    }

    const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-pt-usage-select]'));
    const realLabel = root.querySelector<HTMLElement>('[data-pt-diff-real-label]');
    const realValue = root.querySelector<HTMLElement>('[data-pt-diff-real-value]');
    const diffValue = root.querySelector<HTMLElement>('[data-pt-diff-delta]');

    function selectTier(id: string) {
      const data = payload[id];
      if (!data) return;
      buttons.forEach((btn) => {
        const active = btn.dataset.ptUsageId === id;
        btn.classList.toggle('pt-usage-row--active', active);
        btn.setAttribute('aria-selected', active ? 'true' : 'false');
      });
      if (realLabel) realLabel.textContent = data.realLabel;
      if (realValue) realValue.textContent = data.realValue;
      if (diffValue) diffValue.textContent = data.diffValue;
    }

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.dataset.ptUsageId;
        if (id) selectTier(id);
      });
    });
  });

  // Tap-to-toggle marker tips on touch devices (hover still works on desktop).
  const markers = Array.from(document.querySelectorAll<HTMLElement>('[data-pt-bench-marker]'));
  markers.forEach((marker) => {
    marker.addEventListener('click', (event) => {
      const coarse = window.matchMedia('(hover: none)').matches;
      if (!coarse) return;
      event.preventDefault();
      const wasOpen = marker.classList.contains('is-open');
      markers.forEach((m) => m.classList.remove('is-open'));
      if (!wasOpen) marker.classList.add('is-open');
    });
  });
  document.addEventListener('click', (event) => {
    const target = event.target as Node | null;
    if (!target) return;
    if (markers.some((m) => m.contains(target))) return;
    markers.forEach((m) => m.classList.remove('is-open'));
  });
</script>
