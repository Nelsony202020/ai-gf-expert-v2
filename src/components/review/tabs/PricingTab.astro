                                        <span class="pt-mixer__legend-cr" data-pt-mixer-legend-cr>
                                          {defaultBudget.mixer.credits}
                                        </span>
                                      </li>
                                    </ul>
                                  </div>
                                  <div class="pt-mixer__totals">
                                    <div class="pt-mixer__total">
                                      <span>Total used</span>
                                      <strong data-pt-mixer-used>0 credits</strong>
                                    </div>
                                    <div class="pt-mixer__total pt-mixer__total--remain">
                                      <span>Remaining</span>
                                      <strong data-pt-mixer-remaining-strong>
