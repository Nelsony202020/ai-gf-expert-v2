  .pt-usage-includes__item dt {
    margin: 0;
    font-size: 0.75rem;
    font-weight: 700;
    color: #6b7280;
  }

  .pt-usage-includes__item dd {
    margin: 0;
    font-size: 0.875rem;
    font-weight: 800;
    color: var(--color-on-surface);
