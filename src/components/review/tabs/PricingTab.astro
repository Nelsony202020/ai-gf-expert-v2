</style>

<script>
  import { closeSheet, openSheet } from '../../../lib/ui/bottomSheet.ts';
  import { deferUntilIdle } from '../../../lib/ui/deferUntilIdle';

  // Hidden tab panel (not shown until the Pricing tab is clicked) — this is by
  // far the largest script on the review page, so its setup is deferred to idle
  // rather than run during the initial load. See deferUntilIdle.ts.
  function initPricingTab() {

  type PlanBillingOpt = {
    monthlyPriceLabel: string;
    periodPriceLabel?: string | null;
    priceSub: string;
    savingsLabel: string | null;
    sale: { listPriceLabel: string; badge: string; note: string } | null;
  };

  type PlanPayload = {
    key: string;
    displayName: string;
    isFree: boolean;
    priceLabel: string;
    priceSub: string;
    summaryLine: string;
    billing: {
      monthly: PlanBillingOpt | null;
      quarterly: PlanBillingOpt | null;
      yearly: PlanBillingOpt | null;
    } | null;
  };

  type MixerChannel = {
    key: string;
    label: string;
    creditsPerUnit: number;
    step: number;
    unitLabel: string;
    format: 'count' | 'hours' | 'minutes';
    maxUnits: number;
    sublabel?: string | null;
    unitMoneyLabel?: string | null;
  };

  type MixerPayload = {
    credits: number;
    channels: MixerChannel[];
    presets: Array<{ id: string; label: string; quantities: Record<string, number> }>;
    footnote?: string;
  };

  type PlanBudget = {
    planKey: string;
    displayName: string;
    isFree: boolean;
    credits: number | null;
    creditsLine: string | null;
    items: Array<{ key: string; value: string; label?: string; icon?: string; amount?: string }>;
    mixer: MixerPayload | null;
    highlights: string[];
  };

  type PlansPayload = {
    plans: PlanPayload[];
    freePlanKey: string | null;
    billingIntervals?: Array<'monthly' | 'quarterly' | 'yearly'>;
    limitRows: Array<{ key: string; cells: Record<string, string> }>;
    byPlan: Record<string, PlanBudget>;
    defaultPlanKey: string;
    defaultInterval: 'monthly' | 'quarterly' | 'yearly';
  };

  function escapeHtml(value: string) {
    return value
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function splitUnitClient(value: string): { main: string; unit: string | null } {
    const match = value.match(/^(.*?)(\/(?:day|min|mo|msg|character|hr|hrs|sec|ea))?$/i);
    if (!match) return { main: value, unit: null };
    return { main: (match[1] ?? value).trimEnd(), unit: match[2] ?? null };
  }

  function astroScopeAttr(el: Element): string | null {
    return el.getAttributeNames().find((n) => n.startsWith('data-astro-cid-')) ?? null;
  }

  function stampAstroScope(root: Element, scopeAttr: string | null) {
    if (!scopeAttr) return;
    root.setAttribute(scopeAttr, '');
    root.querySelectorAll('*').forEach((node) => node.setAttribute(scopeAttr, ''));
  }

  function buildMixerMarkup(mixer: MixerPayload): string {
    const presetOptions = [
      { id: 'custom', label: 'Custom mix' },
      ...mixer.presets.filter((p) => p.id !== 'reset').map((p) => ({ id: p.id, label: p.label })),
    ]
      .map(
        (preset, idx) =>
          `<button type="button" role="option" class="pt-menu-select__option${idx === 0 ? ' is-active' : ''}" data-pt-mixer-preset="${escapeHtml(preset.id)}" aria-selected="${idx === 0 ? 'true' : 'false'}">${escapeHtml(preset.label)}</button>`,
      )
      .join('');

    const sheetPresetOptions = [
      { id: 'custom', label: 'Custom mix' },
      ...mixer.presets.filter((p) => p.id !== 'reset').map((p) => ({ id: p.id, label: p.label })),
    ]
      .map(
        (preset, idx) =>
          `<button type="button" role="option" class="pt-menu-select__option${idx === 0 ? ' is-active' : ''}" data-pt-mixer-sheet-preset="${escapeHtml(preset.id)}" aria-selected="${idx === 0 ? 'true' : 'false'}">${escapeHtml(preset.label)}</button>`,
      )
      .join('');

    const controls = mixer.channels
      .map((ch) => {
        const rate = ch.unitMoneyLabel || ch.sublabel;
        const rateHtml = rate
          ? `<span class="pt-mixer__control-rate">${escapeHtml(rate)}</span>`
          : '';
        return `<div class="pt-mixer__control" data-pt-mixer-control="${escapeHtml(ch.key)}" data-credits-per-unit="${ch.creditsPerUnit}" data-step="${ch.step}" data-format="${escapeHtml(ch.format)}" data-unit-label="${escapeHtml(ch.unitLabel)}">
  <div class="pt-mixer__control-meta">
    <span class="pt-mixer__control-label">${escapeHtml(ch.label)}</span>
    ${rateHtml}
  </div>
  <div class="pt-mixer__stepper">
    <button type="button" class="pt-mixer__step" data-pt-mixer-dec aria-label="Decrease ${escapeHtml(ch.label)}">−</button>
    <button type="button" class="pt-mixer__qty" data-pt-mixer-qty title="Double-click to type an amount" aria-label="${escapeHtml(ch.label)} amount — double-click to type">0</button>
    <button type="button" class="pt-mixer__step" data-pt-mixer-inc aria-label="Increase ${escapeHtml(ch.label)}">+</button>
  </div>
  <p class="pt-mixer__spent" data-pt-mixer-spent>0 credits</p>
</div>`;
      })
      .join('');

    const sheetControls = mixer.channels
      .map((ch) => {
        const rate = ch.unitMoneyLabel || ch.sublabel;
        const rateHtml = rate
          ? `<span class="pt-mixer__control-rate">${escapeHtml(rate)}</span>`
          : '';
        return `<div class="pt-mixer__control pt-mixer-sheet__control" data-pt-mixer-sheet-control="${escapeHtml(ch.key)}" data-credits-per-unit="${ch.creditsPerUnit}" data-step="${ch.step}" data-format="${escapeHtml(ch.format)}" data-unit-label="${escapeHtml(ch.unitLabel)}">
  <div class="pt-mixer__control-meta">
    <span class="pt-mixer__control-label">${escapeHtml(ch.label)}</span>
    ${rateHtml}
  </div>
  <div class="pt-mixer__stepper pt-mixer-sheet__stepper">
    <button type="button" class="pt-mixer__step" data-pt-mixer-sheet-dec aria-label="Decrease ${escapeHtml(ch.label)}">−</button>
    <button type="button" class="pt-mixer__qty" data-pt-mixer-sheet-qty title="Double-click to type an amount" aria-label="${escapeHtml(ch.label)} amount — double-click to type">0</button>
    <button type="button" class="pt-mixer__step" data-pt-mixer-sheet-inc aria-label="Increase ${escapeHtml(ch.label)}">+</button>
  </div>
  <p class="pt-mixer__spent" data-pt-mixer-sheet-spent>0 credits</p>
</div>`;
      })
      .join('');

    const legend = mixer.channels
      .map(
        (ch) =>
          `<li class="pt-mixer__legend-item pt-mixer__legend-item--${escapeHtml(ch.key)}" data-pt-mixer-legend-item="${escapeHtml(ch.key)}" hidden>
  <span class="pt-mixer__legend-swatch" aria-hidden="true"></span>
  <span class="pt-mixer__legend-name">${escapeHtml(ch.label)}</span>
  <span class="pt-mixer__legend-cr" data-pt-mixer-legend-cr>0</span>
</li>`,
      )
      .join('');

    const mobileLegend = mixer.channels
      .map(
        (ch) =>
          `<li class="pt-mixer__legend-item pt-mixer__legend-item--${escapeHtml(ch.key)}" data-pt-mixer-mobile-legend-item="${escapeHtml(ch.key)}" hidden>
  <span class="pt-mixer__legend-swatch" aria-hidden="true"></span>
  <span class="pt-mixer__legend-name">${escapeHtml(ch.label)}</span>
  <span class="pt-mixer__legend-cr" data-pt-mixer-mobile-legend-cr>0</span>
</li>`,
      )
      .join('');

    const footnote = mixer.footnote
      ? `<p class="pt-mixer__footnote">${escapeHtml(mixer.footnote)}</p>`
      : '';

    return `<div class="pt-mixer" data-pt-mixer>
  <div class="pt-mixer__tool-head">
    <p class="pt-mixer__tool-eyebrow">Interactive tool</p>
    <h4 class="pt-mixer__tool-title">
      <span class="material-symbols-outlined" aria-hidden="true">tune</span>
      Build your mix
    </h4>
    <p class="pt-mixer__tool-help">
      Adjust each feature to see how your <span data-pt-mixer-help-n>${mixer.credits.toLocaleString('en-US')}</span> credits could be split.
    </p>
  </div>
  <div class="pt-mixer-mobile" data-pt-mixer-mobile>
    <div class="pt-mixer-mobile__meta">
      <span class="pt-label">Preset</span>
      <strong data-pt-mixer-mobile-preset>Custom mix</strong>
    </div>
    <p class="pt-mixer-mobile__used">
      <span data-pt-mixer-mobile-used-line>0 / ${mixer.credits} credits used</span>
    </p>
    <p class="pt-mixer-mobile__mix" data-pt-mixer-mobile-mix>Adjust to build a mix</p>
    <div class="pt-mixer-mobile__viz">
      <div class="pt-mixer__donut pt-mixer__donut--sm" data-pt-mixer-mobile-donut role="img" aria-label="Credit allocation">
        <div class="pt-mixer__donut-ring" data-pt-mixer-mobile-donut-ring></div>
        <div class="pt-mixer__donut-hole" aria-hidden="true"></div>
        <div class="pt-mixer__donut-center">
          <strong data-pt-mixer-mobile-center>${mixer.credits}</strong>
          <span>left</span>
        </div>
      </div>
      <ul class="pt-mixer-mobile__legend" data-pt-mixer-mobile-legend>
        ${mobileLegend}
        <li class="pt-mixer__legend-item pt-mixer__legend-item--remaining" data-pt-mixer-mobile-legend-item="remaining">
          <span class="pt-mixer__legend-swatch" aria-hidden="true"></span>
          <span class="pt-mixer__legend-name">Remaining</span>
          <span class="pt-mixer__legend-cr" data-pt-mixer-mobile-legend-cr>${mixer.credits}</span>
        </li>
      </ul>
    </div>
    <button type="button" class="pt-mixer-mobile__customize" data-pt-mixer-customize>
      <span class="material-symbols-outlined" aria-hidden="true">tune</span>
      Customize mix
    </button>
  </div>
  <div class="pt-mixer__layout">
    <div class="pt-mixer__build">
      <div class="pt-mixer__toolbar">
        <div class="pt-menu-select" data-pt-mixer-preset-select>
          <span class="pt-label">Preset</span>
          <div class="pt-menu-select__wrap">
            <button type="button" class="pt-menu-select__trigger" data-pt-mixer-preset-open aria-haspopup="listbox" aria-expanded="false">
              <span class="pt-menu-select__value" data-pt-mixer-preset-label>Custom mix</span>
              <span class="material-symbols-outlined pt-menu-select__chevron" aria-hidden="true">expand_more</span>
            </button>
            <div class="pt-menu-select__menu" data-pt-mixer-preset-menu role="listbox" hidden>${presetOptions}</div>
          </div>
        </div>
        <button type="button" class="pt-mixer__reset" data-pt-mixer-reset hidden>Reset</button>
      </div>
      <p class="pt-mixer__budget"><strong>${mixer.credits}</strong> credits available</p>
      <div class="pt-mixer__controls">${controls}</div>
    </div>
    <aside class="pt-mixer__summary" aria-label="Your mix">
      <p class="pt-mixer__panel-title">Your mix</p>
      <div class="pt-mixer__viz">
        <div class="pt-mixer__donut" data-pt-mixer-donut role="img" aria-label="Credit allocation">
          <div class="pt-mixer__donut-ring" data-pt-mixer-donut-ring></div>
          <div class="pt-mixer__donut-hole" aria-hidden="true"></div>
          <div class="pt-mixer__donut-center">
            <strong data-pt-mixer-center-value>${mixer.credits}</strong>
            <span data-pt-mixer-center-label>credits remaining</span>
          </div>
        </div>
        <ul class="pt-mixer__legend" data-pt-mixer-legend>
          ${legend}
          <li class="pt-mixer__legend-item pt-mixer__legend-item--remaining" data-pt-mixer-legend-item="remaining">
            <span class="pt-mixer__legend-swatch" aria-hidden="true"></span>
            <span class="pt-mixer__legend-name">Remaining</span>
            <span class="pt-mixer__legend-cr" data-pt-mixer-legend-cr>${mixer.credits}</span>
          </li>
        </ul>
      </div>
      <div class="pt-mixer__totals">
        <div class="pt-mixer__total">
          <span>Total used</span>
          <strong data-pt-mixer-used>0 credits</strong>
        </div>
        <div class="pt-mixer__total pt-mixer__total--remain">
          <span>Remaining</span>
          <strong data-pt-mixer-remaining-strong>${mixer.credits} credits</strong>
        </div>
      </div>
    </aside>
  </div>
  ${footnote}
</div>
<div class="mobile-sheet pt-mixer-sheet" data-pt-mixer-sheet hidden aria-hidden="true">
  <button type="button" class="mobile-sheet__backdrop" data-pt-mixer-sheet-close aria-label="Close"></button>
  <div class="mobile-sheet__panel" role="dialog" aria-modal="true" aria-labelledby="pt-mixer-sheet-title">
    <div class="mobile-sheet__handle" aria-hidden="true"></div>
    <header class="mobile-sheet__head">
      <p id="pt-mixer-sheet-title" class="mobile-sheet__title">Customize mix</p>
      <button type="button" class="mobile-sheet__close" data-pt-mixer-sheet-close aria-label="Close">
        <span class="material-symbols-outlined" aria-hidden="true">close</span>
      </button>
    </header>
    <div class="mobile-sheet__body pt-mixer-sheet__body">
      <p class="pt-mixer-sheet__budget"><strong data-pt-mixer-sheet-credits>${mixer.credits}</strong> credits available</p>
      <div class="pt-menu-select" data-pt-mixer-sheet-preset-select>
        <span class="pt-label">Preset</span>
        <div class="pt-menu-select__wrap">
          <button type="button" class="pt-menu-select__trigger" data-pt-mixer-sheet-preset-open aria-haspopup="listbox" aria-expanded="false">
            <span class="pt-menu-select__value" data-pt-mixer-sheet-preset-label>Custom mix</span>
            <span class="material-symbols-outlined pt-menu-select__chevron" aria-hidden="true">expand_more</span>
          </button>
          <div class="pt-menu-select__menu" data-pt-mixer-sheet-preset-menu role="listbox" hidden>${sheetPresetOptions}</div>
        </div>
      </div>
      <div class="pt-mixer-sheet__controls">${sheetControls}</div>
    </div>
    <footer class="pt-mixer-sheet__footer">
      <p class="pt-mixer-sheet__live" data-pt-mixer-sheet-live>0 used · ${mixer.credits} remaining</p>
      <button type="button" class="pt-mixer-sheet__apply" data-pt-mixer-sheet-apply>Apply mix</button>
    </footer>
  </div>
</div>`;
  }

  function mountCreditMixer(root: HTMLElement) {
    const raw = root.getAttribute('data-pt-mixer-payload');
    if (!raw) return;

    let mixer: MixerPayload;
    try {
      mixer = JSON.parse(raw) as MixerPayload;
    } catch {
      return;
    }

    const host = (root.closest('[data-pt-mixer-host]') as HTMLElement | null) ?? root;
    const sheet = host.querySelector<HTMLElement>('[data-pt-mixer-sheet]');
    const sheetPanel = sheet?.querySelector<HTMLElement>('.mobile-sheet__panel') ?? null;

    const qty: Record<string, number> = {};
    mixer.channels.forEach((ch) => {
      qty[ch.key] = 0;
    });

    const donutRing = root.querySelector<HTMLElement>('[data-pt-mixer-donut-ring]');
    const centerValue = root.querySelector<HTMLElement>('[data-pt-mixer-center-value]');
    const centerLabel = root.querySelector<HTMLElement>('[data-pt-mixer-center-label]');
    const usedEl = root.querySelector<HTMLElement>('[data-pt-mixer-used]');
    const remainingStrong = root.querySelector<HTMLElement>('[data-pt-mixer-remaining-strong]');

    const mobileUsedLine = root.querySelector<HTMLElement>('[data-pt-mixer-mobile-used-line]');
    const mobileMix = root.querySelector<HTMLElement>('[data-pt-mixer-mobile-mix]');
    const mobilePreset = root.querySelector<HTMLElement>('[data-pt-mixer-mobile-preset]');
    const mobileDonutRing = root.querySelector<HTMLElement>('[data-pt-mixer-mobile-donut-ring]');
    const mobileCenter = root.querySelector<HTMLElement>('[data-pt-mixer-mobile-center]');
    const sheetLive = sheet?.querySelector<HTMLElement>('[data-pt-mixer-sheet-live]') ?? null;
    const sheetCredits = sheet?.querySelector<HTMLElement>('[data-pt-mixer-sheet-credits]') ?? null;
    if (sheetCredits) sheetCredits.textContent = String(mixer.credits);

    const DONUT_COLORS: Record<string, string> = {
      images: '#db2777',
      videos: '#8b5cf6',
      voice_messages: '#3b82f6',
      voice_calls: '#14b8a6',
      custom_character: '#6b7280',
      remaining: '#e5e7eb',
    };

    function remainingColor() {
      return document.documentElement.getAttribute('data-theme') === 'dark'
        ? 'rgb(71 85 105 / 70%)'
        : DONUT_COLORS.remaining!;
    }

    function round2(n: number) {
      return Math.round(n * 100) / 100;
    }

    function formatQty(ch: MixerChannel, value: number): string {
      if (ch.format === 'hours') {
        const v = Math.round(value * 10) / 10;
        return `${v} ${ch.unitLabel}`;
      }
      if (ch.format === 'minutes') return `${Math.round(value)} ${ch.unitLabel}`;
      return `${Math.round(value)}`;
    }

    function mixSummaryLine(): string {
      const parts: string[] = [];
      for (const ch of mixer.channels) {
        const value = qty[ch.key] ?? 0;
        if (value <= 0) continue;
        if (ch.key === 'images') {
          const n = Math.round(value);
          parts.push(`${n} image${n === 1 ? '' : 's'}`);
        } else if (ch.key === 'videos') {
          const n = Math.round(value);
          parts.push(`${n} video${n === 1 ? '' : 's'}`);
        } else if (ch.key === 'voice_calls') {
          parts.push(`${Math.round(value)} min calls`);
        } else if (ch.key === 'voice_messages') {
          const n = Math.round(value);
          parts.push(`${n} voice msg${n === 1 ? '' : 's'}`);
        } else if (ch.key === 'custom_character') {
          const n = Math.round(value);
          parts.push(`${n} character${n === 1 ? '' : 's'}`);
        } else if (ch.format === 'minutes') {
          parts.push(`${Math.round(value)} min`);
        } else if (ch.format === 'hours') {
          parts.push(`${Math.round(value * 10) / 10} ${ch.unitLabel}`);
        } else {
          parts.push(`${Math.round(value)} ${ch.label.toLowerCase()}`);
        }
      }
      return parts.length > 0 ? parts.join(' · ') : 'Adjust to build a mix';
    }

    function spentFor(ch: MixerChannel, value: number) {
      return round2(value * ch.creditsPerUnit);
    }

    function totalSpent() {
      return mixer.channels.reduce((sum, ch) => sum + spentFor(ch, qty[ch.key] ?? 0), 0);
    }

    function remaining() {
      return round2(Math.max(0, mixer.credits - totalSpent()));
    }

    function canIncrement(ch: MixerChannel) {
      const next = round2((qty[ch.key] ?? 0) + ch.step);
      if (next > ch.maxUnits + 1e-9) return false;
      const other = totalSpent() - spentFor(ch, qty[ch.key] ?? 0);
      return other + spentFor(ch, next) <= mixer.credits + 1e-9;
    }

    function paintDonut(ring: HTMLElement | null) {
      if (!ring) return;
      const totalCredits = Math.max(mixer.credits, 0.0001);

      const parts: Array<{ key: string; credits: number }> = [];
      let used = 0;
      for (const ch of mixer.channels) {
        const credits = spentFor(ch, qty[ch.key] ?? 0);
        if (credits > 0) {
          parts.push({ key: ch.key, credits });
          used = round2(used + credits);
        }
      }
      const rem = round2(Math.max(0, mixer.credits - used));
      if (rem > 0 || parts.length === 0) {
        parts.push({ key: 'remaining', credits: rem > 0 ? rem : totalCredits });
      }

      const rawPct = parts.map((p) => (p.credits / totalCredits) * 100);
      const pcts = rawPct.map((n) => Math.max(0, n));
      const sumPct = pcts.reduce((a, b) => a + b, 0);
      if (pcts.length > 0 && sumPct > 0) {
        pcts[pcts.length - 1] = Math.max(0, 100 - (sumPct - pcts[pcts.length - 1]!));
      }

      let cursor = 0;
      const stops: string[] = [];
      for (let i = 0; i < parts.length; i++) {
        const pct = pcts[i] ?? 0;
        const color =
          parts[i]!.key === 'remaining'
            ? remainingColor()
            : (DONUT_COLORS[parts[i]!.key] ?? '#9ca3af');
        const start = cursor;
        const end = cursor + pct;
        stops.push(`${color} ${start}% ${end}%`);
        cursor = end;
      }

      ring.style.background =
        stops.length > 0
          ? `conic-gradient(from -90deg, ${stops.join(', ')})`
          : remainingColor();
    }

    function maxAffordable(ch: MixerChannel) {
      const other = totalSpent() - spentFor(ch, qty[ch.key] ?? 0);
      const budgetLeft = Math.max(0, mixer.credits - other);
      const byCredits =
        ch.creditsPerUnit > 0 ? Math.floor((budgetLeft + 1e-9) / ch.creditsPerUnit) : ch.maxUnits;
      return Math.max(0, Math.min(ch.maxUnits, byCredits));
    }

    function clampQty(ch: MixerChannel, raw: number) {
      if (!Number.isFinite(raw) || raw < 0) return 0;
      const capped = Math.min(raw, maxAffordable(ch));
      if (ch.format === 'hours') return round2(Math.round(capped * 10) / 10);
      return Math.round(capped);
    }

    let editingKey: string | null = null;

    function updateControl(
      control: HTMLElement,
      ch: MixerChannel,
      value: number,
      qtySel: string,
      spentSel: string,
      decSel: string,
      incSel: string,
    ) {
      const cr = spentFor(ch, value);
      const qtyEl = control.querySelector<HTMLElement>(qtySel);
      const spentEl = control.querySelector<HTMLElement>(spentSel);
      const dec = control.querySelector<HTMLButtonElement>(decSel);
      const inc = control.querySelector<HTMLButtonElement>(incSel);
      if (qtyEl && editingKey !== ch.key) qtyEl.textContent = formatQty(ch, value);
      if (spentEl) spentEl.textContent = `${cr} credit${cr === 1 ? '' : 's'}`;
      if (dec) dec.disabled = value <= 0;
      if (inc) inc.disabled = !canIncrement(ch);
    }

    function bindHoldStep(btn: HTMLElement | null | undefined, onStep: () => boolean) {
      if (!btn) return;
      let timer: number | null = null;
      let delay = 380;
      let active = false;

      const clear = () => {
        active = false;
        if (timer != null) {
          window.clearTimeout(timer);
          timer = null;
        }
        delay = 380;
      };

      const schedule = () => {
        timer = window.setTimeout(() => {
          if (!active) return;
          if (!onStep()) {
            clear();
            return;
          }
          delay = Math.max(36, Math.floor(delay * 0.82));
          schedule();
        }, delay);
      };

      btn.addEventListener('pointerdown', (event) => {
        if (event.button !== 0) return;
        if ((btn as HTMLButtonElement).disabled) return;
        event.preventDefault();
        clear();
        active = true;
        if (!onStep()) {
          clear();
          return;
        }
        try {
          btn.setPointerCapture(event.pointerId);
        } catch {
          /* ignore */
        }
        timer = window.setTimeout(() => {
          if (!active) return;
          schedule();
        }, 340);
      });

      btn.addEventListener('pointerup', clear);
      btn.addEventListener('pointercancel', clear);
      btn.addEventListener('lostpointercapture', clear);
      btn.addEventListener('click', (event) => {
        event.preventDefault();
      });
    }

    function bindQtyEdit(
      control: HTMLElement,
      ch: MixerChannel,
      key: string,
      qtySel: string,
      onCommit: () => void,
    ) {
      const qtyBtn = control.querySelector<HTMLElement>(qtySel);
      if (!qtyBtn) return;

      const startEdit = () => {
        if (editingKey) return;
        editingKey = key;
        const w = Math.round(qtyBtn.getBoundingClientRect().width);
        const h = Math.round(qtyBtn.getBoundingClientRect().height);
        const input = document.createElement('input');
        input.type = 'text';
        input.inputMode = ch.format === 'hours' ? 'decimal' : 'numeric';
        input.className = 'pt-mixer__qty-input';
        input.value = String(qty[key] ?? 0);
        input.setAttribute('aria-label', `Type ${ch.label} amount`);
        input.style.width = `${w}px`;
        input.style.minWidth = `${w}px`;
        input.style.maxWidth = `${w}px`;
        input.style.height = `${h}px`;
        input.style.minHeight = `${h}px`;
        qtyBtn.replaceWith(input);
        input.focus();
        input.select();

        const finish = (commit: boolean) => {
          if (editingKey !== key) return;
          editingKey = null;
          if (commit) {
            const parsed = Number(String(input.value).replace(/,/g, '').trim());
            qty[key] = clampQty(ch, parsed);
            onCommit();
          }
          const nextBtn = document.createElement('button');
          nextBtn.type = 'button';
          nextBtn.className = 'pt-mixer__qty';
          if (qtySel.includes('sheet')) nextBtn.setAttribute('data-pt-mixer-sheet-qty', '');
          else nextBtn.setAttribute('data-pt-mixer-qty', '');
          nextBtn.title = 'Double-click to type an amount';
          nextBtn.setAttribute('aria-label', `${ch.label} amount — double-click to type`);
          nextBtn.textContent = formatQty(ch, qty[key] ?? 0);
          input.replaceWith(nextBtn);
          bindQtyEdit(control, ch, key, qtySel, onCommit);
          render();
        };

        input.addEventListener('keydown', (event) => {
          if (event.key === 'Enter') {
            event.preventDefault();
            finish(true);
          } else if (event.key === 'Escape') {
            event.preventDefault();
            finish(false);
          }
        });
        input.addEventListener('blur', () => finish(true));
      };

      qtyBtn.addEventListener('dblclick', (event) => {
        event.preventDefault();
        startEdit();
      });
    }

    function render() {
      const left = remaining();
      const spent = totalSpent();
      const spentRounded = Math.round(spent * 10) / 10;
      const leftRounded = Math.round(left * 10) / 10;

      if (centerValue) centerValue.textContent = String(leftRounded);
      if (centerLabel) {
        centerLabel.textContent = left === 1 ? 'credit remaining' : 'credits remaining';
      }
      if (usedEl) {
        usedEl.textContent = `${spentRounded} credit${spent === 1 ? '' : 's'}`;
      }
      if (remainingStrong) {
        remainingStrong.textContent = `${leftRounded} credit${left === 1 ? '' : 's'}`;
      }

      paintDonut(donutRing);
      paintDonut(mobileDonutRing);
      if (mobileCenter) mobileCenter.textContent = String(leftRounded);
      if (mobileUsedLine) {
        mobileUsedLine.textContent = `${spentRounded} / ${mixer.credits} credits used`;
      }
      if (mobileMix) mobileMix.textContent = mixSummaryLine();
      if (sheetLive) {
        sheetLive.textContent = `${spentRounded} used · ${leftRounded} remaining`;
      }

      for (const ch of mixer.channels) {
        const value = qty[ch.key] ?? 0;
        const control = root.querySelector<HTMLElement>(`[data-pt-mixer-control="${ch.key}"]`);
        if (control) {
          updateControl(control, ch, value, '[data-pt-mixer-qty]', '[data-pt-mixer-spent]', '[data-pt-mixer-dec]', '[data-pt-mixer-inc]');
        }
        const sheetControl = sheet?.querySelector<HTMLElement>(`[data-pt-mixer-sheet-control="${ch.key}"]`);
        if (sheetControl) {
          updateControl(
            sheetControl,
            ch,
            value,
            '[data-pt-mixer-sheet-qty]',
            '[data-pt-mixer-sheet-spent]',
            '[data-pt-mixer-sheet-dec]',
            '[data-pt-mixer-sheet-inc]',
          );
        }

        const cr = spentFor(ch, value);
        const legend = root.querySelector<HTMLElement>(`[data-pt-mixer-legend-item="${ch.key}"]`);
        if (legend) {
          legend.hidden = cr <= 0;
          const crEl = legend.querySelector<HTMLElement>('[data-pt-mixer-legend-cr]');
          if (crEl) crEl.textContent = `${cr}`;
        }
        const mobileLegend = root.querySelector<HTMLElement>(`[data-pt-mixer-mobile-legend-item="${ch.key}"]`);
        if (mobileLegend) {
          mobileLegend.hidden = cr <= 0;
          const crEl = mobileLegend.querySelector<HTMLElement>('[data-pt-mixer-mobile-legend-cr]');
          if (crEl) crEl.textContent = `${cr}`;
        }
      }

      const remLegend = root.querySelector<HTMLElement>('[data-pt-mixer-legend-item="remaining"]');
      if (remLegend) {
        const crEl = remLegend.querySelector<HTMLElement>('[data-pt-mixer-legend-cr]');
        if (crEl) crEl.textContent = `${leftRounded}`;
      }
      const mobileRem = root.querySelector<HTMLElement>('[data-pt-mixer-mobile-legend-item="remaining"]');
      if (mobileRem) {
        const crEl = mobileRem.querySelector<HTMLElement>('[data-pt-mixer-mobile-legend-cr]');
        if (crEl) crEl.textContent = `${leftRounded}`;
      }
    }

    function bindDesktopSteppers() {
      root.querySelectorAll<HTMLElement>('[data-pt-mixer-control]').forEach((control) => {
        const key = control.dataset.ptMixerControl;
        const ch = mixer.channels.find((c) => c.key === key);
        if (!ch || !key) return;
        bindHoldStep(control.querySelector('[data-pt-mixer-dec]'), () => {
          const next = Math.max(0, round2((qty[key] ?? 0) - ch.step));
          if (next === (qty[key] ?? 0)) return false;
          qty[key] = next;
          markCustom();
          render();
          return true;
        });
        bindHoldStep(control.querySelector('[data-pt-mixer-inc]'), () => {
          if (!canIncrement(ch)) return false;
          qty[key] = round2((qty[key] ?? 0) + ch.step);
          markCustom();
          render();
          return canIncrement(ch);
        });
        bindQtyEdit(control, ch, key, '[data-pt-mixer-qty]', () => markCustom());
      });
    }

    function bindSheetSteppers() {
      sheet?.querySelectorAll<HTMLElement>('[data-pt-mixer-sheet-control]').forEach((control) => {
        const key = control.dataset.ptMixerSheetControl;
        const ch = mixer.channels.find((c) => c.key === key);
        if (!ch || !key) return;
        bindHoldStep(control.querySelector('[data-pt-mixer-sheet-dec]'), () => {
          const next = Math.max(0, round2((qty[key] ?? 0) - ch.step));
          if (next === (qty[key] ?? 0)) return false;
          qty[key] = next;
          markCustom();
          render();
          return true;
        });
        bindHoldStep(control.querySelector('[data-pt-mixer-sheet-inc]'), () => {
          if (!canIncrement(ch)) return false;
          qty[key] = round2((qty[key] ?? 0) + ch.step);
          markCustom();
          render();
          return canIncrement(ch);
        });
        bindQtyEdit(control, ch, key, '[data-pt-mixer-sheet-qty]', () => markCustom());
      });
    }

    bindDesktopSteppers();
    bindSheetSteppers();

    const presetOpen = root.querySelector<HTMLButtonElement>('[data-pt-mixer-preset-open]');
    const presetMenu = root.querySelector<HTMLElement>('[data-pt-mixer-preset-menu]');
    const presetLabel = root.querySelector<HTMLElement>('[data-pt-mixer-preset-label]');
    const resetBtn = root.querySelector<HTMLButtonElement>('[data-pt-mixer-reset]');
    const sheetPresetOpen = sheet?.querySelector<HTMLButtonElement>('[data-pt-mixer-sheet-preset-open]');
    const sheetPresetMenu = sheet?.querySelector<HTMLElement>('[data-pt-mixer-sheet-preset-menu]');
    const sheetPresetLabel = sheet?.querySelector<HTMLElement>('[data-pt-mixer-sheet-preset-label]');
    let activePresetId = 'custom';
    let lastNamedPresetId: string | null = null;
    let dirty = false;
    let releaseFocus: (() => void) | null = null;

    function setPresetUi(id: string, label: string) {
      activePresetId = id;
      if (presetLabel) presetLabel.textContent = label;
      if (sheetPresetLabel) sheetPresetLabel.textContent = label;
      if (mobilePreset) mobilePreset.textContent = label;
      root.querySelectorAll<HTMLButtonElement>('[data-pt-mixer-preset]').forEach((btn) => {
        const on = btn.dataset.ptMixerPreset === id;
        btn.classList.toggle('is-active', on);
        btn.setAttribute('aria-selected', on ? 'true' : 'false');
      });
      sheet?.querySelectorAll<HTMLButtonElement>('[data-pt-mixer-sheet-preset]').forEach((btn) => {
        const on = btn.dataset.ptMixerSheetPreset === id;
        btn.classList.toggle('is-active', on);
        btn.setAttribute('aria-selected', on ? 'true' : 'false');
      });
      if (resetBtn) resetBtn.hidden = !dirty;
    }

    function closePresetMenu() {
      if (presetMenu && presetOpen) {
        presetMenu.hidden = true;
        presetOpen.setAttribute('aria-expanded', 'false');
      }
      if (sheetPresetMenu && sheetPresetOpen) {
        sheetPresetMenu.hidden = true;
        sheetPresetOpen.setAttribute('aria-expanded', 'false');
      }
    }

    function applyPreset(id: string) {
      if (id === 'custom') {
        mixer.channels.forEach((ch) => {
          qty[ch.key] = 0;
        });
        dirty = false;
        setPresetUi('custom', 'Custom mix');
        render();
        return;
      }
      const preset = mixer.presets.find((p) => p.id === id);
      if (!preset) return;
      mixer.channels.forEach((ch) => {
        qty[ch.key] = preset.quantities[ch.key] ?? 0;
      });
      lastNamedPresetId = preset.id;
      dirty = false;
      setPresetUi(preset.id, preset.label);
      render();
    }

    function markCustom() {
      dirty = true;
      setPresetUi('custom', 'Custom mix');
    }

    presetOpen?.addEventListener('click', (e) => {
      e.stopPropagation();
      if (!presetMenu || !presetOpen) return;
      const open = presetMenu.hidden;
      presetMenu.hidden = !open;
      presetOpen.setAttribute('aria-expanded', open ? 'true' : 'false');
    });

    sheetPresetOpen?.addEventListener('click', (e) => {
      e.stopPropagation();
      if (!sheetPresetMenu || !sheetPresetOpen) return;
      const open = sheetPresetMenu.hidden;
      sheetPresetMenu.hidden = !open;
      sheetPresetOpen.setAttribute('aria-expanded', open ? 'true' : 'false');
    });

    root.querySelectorAll<HTMLButtonElement>('[data-pt-mixer-preset]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.dataset.ptMixerPreset;
        if (!id) return;
        applyPreset(id);
        closePresetMenu();
      });
    });

    sheet?.querySelectorAll<HTMLButtonElement>('[data-pt-mixer-sheet-preset]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.dataset.ptMixerSheetPreset;
        if (!id) return;
        applyPreset(id);
        closePresetMenu();
      });
    });

    resetBtn?.addEventListener('click', () => {
      if (lastNamedPresetId) applyPreset(lastNamedPresetId);
      else applyPreset('custom');
    });

    document.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      if (presetMenu && !presetMenu.hidden) {
        if (!t.closest('[data-pt-mixer-preset-select]')) closePresetMenu();
      }
      if (sheetPresetMenu && !sheetPresetMenu.hidden) {
        if (!t.closest('[data-pt-mixer-sheet-preset-select]')) {
          sheetPresetMenu.hidden = true;
          sheetPresetOpen?.setAttribute('aria-expanded', 'false');
        }
      }
    });

    function closeMixerSheet() {
      if (!sheet) return;
      closeSheet(sheet, () => {
        releaseFocus?.();
        releaseFocus = null;
      });
    }

    function openMixerSheet() {
      if (!sheet || !sheetPanel) return;
      if (sheet.parentElement !== document.body) {
        document.body.appendChild(sheet);
      }
      releaseFocus?.();
      releaseFocus = openSheet(sheet, sheetPanel, {
        focusSelector: '[data-pt-mixer-sheet-apply]',
      });
      render();
    }

    root.querySelector('[data-pt-mixer-customize]')?.addEventListener('click', () => {
      openMixerSheet();
    });
    sheet?.querySelectorAll('[data-pt-mixer-sheet-close]').forEach((btn) => {
      btn.addEventListener('click', () => closeMixerSheet());
    });
    sheet?.querySelector('[data-pt-mixer-sheet-apply]')?.addEventListener('click', () => {
      render();
      closeMixerSheet();
    });

    const starter = mixer.presets.find((p) => p.id === 'image-heavy') ?? mixer.presets.find((p) => p.id !== 'reset');
    if (starter) applyPreset(starter.id);
    else render();
  }

  document.querySelectorAll<HTMLElement>('[data-pt-plans]').forEach((root) => {
    const raw = root.getAttribute('data-pt-plans-payload');
    if (!raw) return;

    let payload: PlansPayload;
    try {
      payload = JSON.parse(raw) as PlansPayload;
    } catch {
      return;
    }

    const scopeAttr = astroScopeAttr(root);
    const planButtons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-pt-plan-select]'));
    const billingGroup = root.querySelector<HTMLElement>('[data-pt-billing-group]');
    const billingButtons = Array.from(
      root.querySelectorAll<HTMLButtonElement>('[data-pt-billing-select]'),
    );
    const poolRoot = root.querySelector<HTMLElement>('[data-pt-credit-pool]');
    const poolSkim = root.querySelector<HTMLElement>('[data-pt-pool-skim]');
    const mixerHost = root.querySelector<HTMLElement>('[data-pt-mixer-host]');
    const poolAwait = root.querySelector<HTMLElement>('[data-pt-pool-await]');
    const poolResults = root.querySelector<HTMLElement>('[data-pt-pool-results]');
    const poolGhost = root.querySelector<HTMLElement>('[data-pt-pool-ghost]');
    const poolLive = root.querySelector<HTMLElement>('[data-pt-pool-live]');
    const poolIntro = root.querySelector<HTMLElement>('[data-pt-pool-intro]');
    const limitsTitle = root.querySelector<HTMLElement>('[data-pt-limits-title]');
    const plansBillingBtns = Array.from(
      root.querySelectorAll<HTMLButtonElement>('[data-pt-plans-billing-select]'),
    );

    const creditToolKeys = new Set(
      Object.keys(payload.byPlan).filter((k) => Boolean(payload.byPlan[k]?.mixer)),
    );
    const creditToolCount = creditToolKeys.size;
    const poolNeedsPlanPick = creditToolCount > 1;

    /** Overview selection can stay on a default plan; pool waits when multi-plan. */
    let selectedPlanKey = root.dataset.ptSelectedPlan || payload.defaultPlanKey;
    let selectedInterval: 'monthly' | 'quarterly' | 'yearly' =
      (root.dataset.ptBilling as 'monthly' | 'quarterly' | 'yearly') || payload.defaultInterval;
    let poolPlanKey = poolRoot?.dataset.ptPoolPlan ?? (creditToolCount === 1 ? [...creditToolKeys][0] : '');

    const poolIntroAwaiting = 'Choose your plan to see how far your included credits can go.';
    const poolIntroReady =
      'Your credits are shared across paid features. Spend them all on one feature, or mix them however you want.';

    function planByKey(key: string) {
      return payload.plans.find((p) => p.key === key) ?? null;
    }

    function budgetFor(key: string) {
      return payload.byPlan[key] ?? null;
    }

    function billingOptions(plan: PlanPayload | null): Array<'monthly' | 'quarterly' | 'yearly'> {
      if (!plan?.billing || plan.isFree) return [];
      const out: Array<'monthly' | 'quarterly' | 'yearly'> = [];
      if (plan.billing.monthly) out.push('monthly');
      if (plan.billing.quarterly) out.push('quarterly');
      if (plan.billing.yearly) out.push('yearly');
      return out;
    }

    function billingLabel(interval: 'monthly' | 'quarterly' | 'yearly') {
      return interval === 'yearly' ? 'Annual' : interval === 'quarterly' ? 'Quarterly' : 'Monthly';
    }

    function notOfferedLabel(interval: 'monthly' | 'quarterly' | 'yearly') {
      if (interval === 'yearly') return 'Not offered annually';
      if (interval === 'quarterly') return 'Not offered quarterly';
      return 'Not offered monthly';
    }

    function optFor(
      plan: PlanPayload | null,
      interval: 'monthly' | 'quarterly' | 'yearly',
    ): PlanBillingOpt | null {
      if (!plan?.billing) return null;
      return plan.billing[interval] ?? null;
    }

    function pickIntervalForPlan(plan: PlanPayload | null): 'monthly' | 'quarterly' | 'yearly' | '' {
      const opts = billingOptions(plan);
      if (opts.length === 0) return '';
      if (opts.length === 1) return opts[0];
      if (opts.includes(selectedInterval)) return selectedInterval;
      if (opts.includes('monthly')) return 'monthly';
      return opts[0];
    }

    function poolIsReady() {
      if (!poolPlanKey || !creditToolKeys.has(poolPlanKey)) return false;
      const plan = planByKey(poolPlanKey);
      const opts = billingOptions(plan);
      if (opts.length === 0) return false;
      return opts.includes(selectedInterval);
    }

    function flashNum(el: HTMLElement | null) {
      if (!el) return;
      el.classList.remove('pt-num-flash');
      void el.offsetWidth;
      el.classList.add('pt-num-flash');
    }

    function syncOverview() {
      root.querySelectorAll<HTMLElement>('[data-pt-overview-plan]').forEach((col) => {
        const key = col.dataset.ptOverviewPlan;
        if (!key) return;
        const plan = planByKey(key);
        if (!plan) return;

        const priceEl = col.querySelector<HTMLElement>('[data-pt-overview-price]');
        const priceMain = col.querySelector<HTMLElement>('[data-pt-overview-price-main]');
        const listEl = col.querySelector<HTMLElement>('[data-pt-overview-list]');
        const badgeEl = col.querySelector<HTMLElement>('[data-pt-overview-badge]');
        const billedEl = col.querySelector<HTMLElement>('[data-pt-overview-billed]');
        const saveEl = col.querySelector<HTMLElement>('[data-pt-overview-save]');
        const unavailableEl = col.querySelector<HTMLElement>('[data-pt-overview-unavailable]');
        const creditsEl = col.querySelector<HTMLElement>('[data-pt-overview-credits]');

        if (creditsEl) creditsEl.textContent = plan.summaryLine;

        if (plan.isFree) {
          col.classList.remove('is-unavailable');
          if (priceEl) priceEl.hidden = false;
          if (priceMain) {
            priceMain.textContent = '';
            priceMain.append(document.createTextNode(plan.priceLabel || '$0'));
          }
          if (listEl) {
            listEl.hidden = true;
            listEl.textContent = '';
          }
          if (badgeEl) {
            badgeEl.hidden = true;
            badgeEl.textContent = '';
          }
          if (billedEl) {
            billedEl.hidden = true;
            billedEl.textContent = '';
          }
          if (saveEl) {
            saveEl.hidden = true;
            saveEl.textContent = '';
          }
          if (unavailableEl) {
            unavailableEl.hidden = true;
            unavailableEl.textContent = '';
          }
          return;
        }

        const opt = optFor(plan, selectedInterval);
        if (!opt) {
          col.classList.add('is-unavailable');
          if (priceEl) priceEl.hidden = true;
          if (billedEl) {
            billedEl.hidden = true;
            billedEl.textContent = '';
          }
          if (saveEl) {
            saveEl.hidden = true;
            saveEl.textContent = '';
          }
          if (unavailableEl) {
            unavailableEl.hidden = false;
            unavailableEl.textContent = notOfferedLabel(selectedInterval);
          }
          return;
        }

        col.classList.remove('is-unavailable');
        if (priceEl) priceEl.hidden = false;
        if (unavailableEl) {
          unavailableEl.hidden = true;
          unavailableEl.textContent = '';
        }

        if (priceMain) {
          priceMain.textContent = '';
          priceMain.append(document.createTextNode(opt.monthlyPriceLabel));
          const unit = document.createElement('span');
          unit.className = 'pt-unit';
          unit.textContent = '/mo';
          priceMain.append(unit);
          stampAstroScope(unit, scopeAttr);
          flashNum(priceMain);
        }

        const sale = opt.sale;
        if (listEl) {
          if (sale?.listPriceLabel) {
            listEl.hidden = false;
            listEl.textContent = '';
            listEl.append(document.createTextNode(sale.listPriceLabel));
            const unit = document.createElement('span');
            unit.className = 'pt-unit';
            unit.textContent = '/mo';
            listEl.append(unit);
            stampAstroScope(unit, scopeAttr);
          } else {
            listEl.hidden = true;
            listEl.textContent = '';
          }
        }
        if (badgeEl) {
          if (sale?.badge) {
            badgeEl.hidden = false;
            badgeEl.textContent = sale.badge;
          } else {
            badgeEl.hidden = true;
            badgeEl.textContent = '';
          }
        }

        const showBilled =
          selectedInterval !== 'monthly'
          && opt.priceSub
          && !/^billed monthly$/i.test(opt.priceSub.trim());
        if (billedEl) {
          if (showBilled) {
            billedEl.hidden = false;
            billedEl.textContent = opt.priceSub;
          } else {
            billedEl.hidden = true;
            billedEl.textContent = '';
          }
        }
        if (saveEl) {
          if (opt.savingsLabel) {
            saveEl.hidden = false;
            saveEl.textContent = opt.savingsLabel;
          } else {
            saveEl.hidden = true;
            saveEl.textContent = '';
          }
        }
      });
    }

    function syncPlanMenu() {
      planButtons.forEach((btn) => {
        const active = Boolean(poolPlanKey) && btn.dataset.ptPlanSelect === poolPlanKey;
        btn.classList.toggle('is-active', active);
        btn.setAttribute('aria-checked', active ? 'true' : 'false');
      });
    }

    function syncBillingAvailability(plan: PlanPayload | null) {
      if (!billingGroup) return;
      const available = billingOptions(plan);
      billingGroup.hidden = !plan || available.length <= 1;
      billingButtons.forEach((btn) => {
        const key = btn.dataset.ptBillingSelect as 'monthly' | 'quarterly' | 'yearly' | undefined;
        if (!key) return;
        btn.hidden = !available.includes(key);
      });
    }

    function syncBillingMenu() {
      root.dataset.ptBilling = selectedInterval;
      billingButtons.forEach((btn) => {
        const active = btn.dataset.ptBillingSelect === selectedInterval;
        btn.classList.toggle('is-active', active);
        btn.setAttribute('aria-checked', active ? 'true' : 'false');
      });
      plansBillingBtns.forEach((btn) => {
        const active = btn.dataset.ptPlansBillingSelect === selectedInterval;
        btn.classList.toggle('is-active', active);
        btn.setAttribute('aria-pressed', active ? 'true' : 'false');
      });
    }

    function setBillingInterval(next: 'monthly' | 'quarterly' | 'yearly') {
      selectedInterval = next;
      applySelection();
    }

    function poolMetaLine(plan: PlanPayload | null, budget: PlanBudget | null): string | null {
      const parts: string[] = [];
      if (budget?.creditsLine) parts.push(budget.creditsLine);
      else if (budget?.isFree) parts.push('Hard limits (no shared credit pool)');
      const opt = plan && !plan.isFree ? optFor(plan, selectedInterval) : null;
      if (opt?.monthlyPriceLabel) parts.push(`${opt.monthlyPriceLabel}/mo`);
      return parts.length > 0 ? parts.join(' · ') : null;
    }

    function syncPoolContext(plan: PlanPayload | null, budget?: PlanBudget | null) {
      const planLine = root.querySelector<HTMLElement>('[data-pt-pool-context-plan]');
      const metaEl = root.querySelector<HTMLElement>('[data-pt-pool-context-meta]');
      const resolvedBudget = budget ?? (plan ? budgetFor(plan.key) : null);
      if (planLine) {
        if (plan) {
          const next = `${plan.displayName} · ${billingLabel(selectedInterval)}`;
          planLine.hidden = false;
          if (planLine.textContent !== next) planLine.textContent = next;
        } else {
          planLine.hidden = true;
          planLine.textContent = '';
        }
      }
      if (metaEl) {
        const next = poolMetaLine(plan, resolvedBudget);
        if (next) {
          metaEl.hidden = false;
          if (metaEl.textContent !== next) {
            metaEl.textContent = next;
            flashNum(metaEl);
          }
        } else {
          metaEl.hidden = true;
          metaEl.textContent = '';
        }
      }
    }

    function syncSaleNote(plan: PlanPayload | null) {
      const saleNoteEl = root.querySelector<HTMLElement>('[data-pt-active-sale-note]');
      if (!saleNoteEl) return;
      if (!plan) {
        saleNoteEl.hidden = true;
        saleNoteEl.textContent = '';
        return;
      }
      const opt =
        selectedInterval === 'yearly'
          ? plan.billing?.yearly
          : selectedInterval === 'quarterly'
            ? plan.billing?.quarterly
            : plan.billing?.monthly;
      const sale = opt?.sale ?? null;
      if (sale?.note) {
        saleNoteEl.hidden = false;
        saleNoteEl.textContent = sale.note;
      } else {
        saleNoteEl.hidden = true;
        saleNoteEl.textContent = '';
      }
    }

    function syncPoolReadyUi(ready: boolean) {
      if (poolRoot) {
        poolRoot.dataset.ptPoolReady = ready ? 'true' : 'false';
        poolRoot.dataset.ptPoolPlan = poolPlanKey;
      }
      const awaiting = !ready && poolNeedsPlanPick;
      if (poolAwait) poolAwait.hidden = !awaiting;
      if (poolGhost) poolGhost.hidden = !awaiting;
      if (poolLive) poolLive.hidden = !ready;
      if (poolResults) {
        poolResults.classList.toggle('is-locked', awaiting);
        if (awaiting) poolResults.setAttribute('aria-disabled', 'true');
        else poolResults.removeAttribute('aria-disabled');
      }
      if (poolIntro) {
        poolIntro.textContent = ready ? poolIntroReady : poolIntroAwaiting;
      }
    }

    function syncCreditPool(budget: PlanBudget | null) {
      if (!poolRoot || !mixerHost) return;

      const ready = poolIsReady();
      syncPoolReadyUi(ready);

      if (!ready) {
        poolRoot.setAttribute('data-pt-credit-mixer', 'false');
        poolRoot.removeAttribute('data-pt-mixer-payload');
        document.querySelectorAll('[data-pt-mixer-sheet]').forEach((el) => {
          if (!mixerHost.contains(el)) el.remove();
        });
        document.body.classList.remove('mobile-sheet-open');
        mixerHost.innerHTML = '';
        return;
      }

      const plan = planByKey(poolPlanKey);
      syncPoolContext(plan, budget);

      const poolLead = root.querySelector<HTMLElement>('[data-pt-pool-lead]');
      const poolNote = root.querySelector<HTMLElement>('[data-pt-pool-note]');
      const poolCreditNs = root.querySelectorAll<HTMLElement>('[data-pt-pool-credit-n]');
      const mixerHelpN = root.querySelector<HTMLElement>('[data-pt-mixer-help-n]');
      const toolRule = root.querySelector<HTMLElement>('[data-pt-pool-tool-rule]');
      if (budget?.credits) {
        const nextCredits = budget.credits.toLocaleString('en-US');
        poolCreditNs.forEach((el) => {
          if (el.textContent !== nextCredits) {
            el.textContent = nextCredits;
            flashNum(el);
          }
        });
      }
      if (poolLead) {
        if (budget?.mixer && budget.credits) {
          poolLead.hidden = false;
          const next = budget.credits.toLocaleString('en-US');
          if (poolCreditNs.length > 0) {
            poolCreditNs.forEach((el) => {
              if (el.textContent !== next) {
                el.textContent = next;
                flashNum(el);
              }
            });
          } else {
            poolLead.innerHTML = `If you spent all <span data-pt-pool-credit-n>${next}</span> credits on one feature:`;
            stampAstroScope(poolLead, scopeAttr);
          }
        } else {
          poolLead.hidden = true;
        }
      }
      if (mixerHelpN && budget?.credits) {
        const next = budget.credits.toLocaleString('en-US');
        if (mixerHelpN.textContent !== next) {
          mixerHelpN.textContent = next;
          flashNum(mixerHelpN);
        }
      }
      if (poolNote) {
        poolNote.hidden = Boolean(budget?.mixer);
        if (!budget?.mixer) {
          poolNote.textContent = budget?.isFree
            ? 'This plan uses hard daily limits instead of a shared credit pool.'
            : 'This plan does not use a shared credit pool.';
        }
      }

      if (poolSkim) {
        const items = budget?.items ?? [];
        const equivWrap = root.querySelector<HTMLElement>('[data-pt-pool-equiv]');
        if (items.length > 0) {
          if (equivWrap) equivWrap.hidden = false;
          poolSkim.hidden = false;
          poolSkim.innerHTML = items
            .map((item) => {
              const amount = escapeHtml(item.amount ?? item.value.replace(/\/mo$/, ''));
              const label = escapeHtml(item.label ?? item.value);
              return `<div class="pt-credit-pool__skim-stat">
                <span class="pt-credit-pool__skim-amount">${amount}</span>
                <span class="pt-credit-pool__skim-label">${label}</span>
              </div>`;
            })
            .join('');
          stampAstroScope(poolSkim, scopeAttr);
          flashNum(poolSkim);
          const compact = root.querySelector<HTMLElement>('[data-pt-pool-skim-compact]');
          if (compact) {
            compact.textContent = items
              .map((item) => `${item.amount ?? item.value.replace(/\/mo$/, '')} ${item.label ?? item.value}`)
              .join(' · ');
          }
        } else {
          if (equivWrap && !budget?.mixer) equivWrap.hidden = true;
          poolSkim.hidden = true;
          poolSkim.innerHTML = '';
        }
      }

      const poolOr = root.querySelector<HTMLElement>('[data-pt-pool-or]');
      if (poolOr) poolOr.hidden = !budget?.mixer;
      if (toolRule) toolRule.hidden = !budget?.mixer;

      if (budget?.mixer) {
        poolRoot.setAttribute('data-pt-credit-mixer', 'true');
        poolRoot.setAttribute('data-pt-mixer-payload', JSON.stringify(budget.mixer));
        document.querySelectorAll('[data-pt-mixer-sheet]').forEach((el) => {
          if (!mixerHost.contains(el)) el.remove();
        });
        document.body.classList.remove('mobile-sheet-open');
        mixerHost.innerHTML = buildMixerMarkup(budget.mixer);
        stampAstroScope(mixerHost, scopeAttr);
        const mixerRoot = mixerHost.querySelector<HTMLElement>('[data-pt-mixer]');
        if (mixerRoot) {
          mixerRoot.setAttribute('data-pt-mixer-payload', JSON.stringify(budget.mixer));
          mountCreditMixer(mixerRoot);
        }
      } else {
        poolRoot.setAttribute('data-pt-credit-mixer', 'false');
        poolRoot.removeAttribute('data-pt-mixer-payload');
        mixerHost.innerHTML =
          '<p class="pt-credit-pool__empty" data-pt-pool-empty>This plan does not use a shared credit pool.</p>';
        stampAstroScope(mixerHost, scopeAttr);
      }
    }

    function syncLimits(_plan: PlanPayload | null) {
      if (limitsTitle) limitsTitle.textContent = 'What’s included in each plan';
    }

    function applySelection() {
      root.dataset.ptSelectedPlan = selectedPlanKey;
      const overviewPlan = planByKey(selectedPlanKey);
      const poolPlan = poolPlanKey ? planByKey(poolPlanKey) : null;
      const poolBudget = poolPlanKey ? budgetFor(poolPlanKey) : null;

      if (poolPlan) {
        const nextInterval = pickIntervalForPlan(poolPlan);
        if (nextInterval && nextInterval !== selectedInterval) {
          selectedInterval = nextInterval;
        }
      }

      syncPlanMenu();
      syncBillingAvailability(poolPlan);
      syncBillingMenu();
      syncOverview();
      syncSaleNote(poolPlan);
      syncCreditPool(poolBudget);
      syncLimits(overviewPlan);
    }

    planButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const key = btn.dataset.ptPlanSelect;
        if (!key) return;
        poolPlanKey = key;
        selectedPlanKey = key;
        const plan = planByKey(key);
        const nextInterval = pickIntervalForPlan(plan);
        if (nextInterval) selectedInterval = nextInterval;
        applySelection();
      });
    });

    billingButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const interval = btn.dataset.ptBillingSelect;
        if (interval !== 'monthly' && interval !== 'quarterly' && interval !== 'yearly') return;
        if (btn.hidden) return;
        selectedInterval = interval;
        applySelection();
      });
    });

    plansBillingBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const interval = btn.dataset.ptPlansBillingSelect;
        if (interval !== 'monthly' && interval !== 'quarterly' && interval !== 'yearly') return;
        setBillingInterval(interval);
      });
    });

    applySelection();
  });

  document.querySelectorAll<HTMLElement>('[data-pt-usage]').forEach((root) => {
    if (root.getAttribute('data-pt-usage-flat') === 'true') return;

    const raw = root.getAttribute('data-pt-usage-payload');
    if (!raw) return;

    type CalcFeature = {
      key: string;
      label: string;
      icon: string;
      assumptionLabel: string;
      unitCostLabel: string;
      cost: number;
      costLabel: string;
      mathDetail: string | null;
      patternLead?: string | null;
      monthlyTotalLabel?: string | null;
      qtyPhrase?: string | null;
      ratePhrase?: string | null;
      accent?: string;
    };

    type UsageCalculation = {
      heading: string;
      intro: string;
      summaryLabel: string;
      features: CalcFeature[];
      mediaValueLabel: string;
      includedValueLabel: string;
      extraValueLabel: string;
      requiredCreditsLabel?: string;
      includedCreditsLabel?: string;
      extraCreditsLabel?: string;
      includedCredits: number;
      extraCredits: number;
      packageLines?: Array<{ creditsLabel: string; priceLabel: string }>;
      purchasedCreditsLabel?: string;
      leftoverCreditsLabel?: string;
      planCostLabel: string;
      topUpCostLabel: string;
      topUpCost: number;
      totalLabel: string;
      levelName: string;
      planName: string;
      chatIncludedNote: string | null;
      packHeadline: string | null;
      packFoot: string | null;
    };

    type UsageDetail = {
      title: string;
      description: string;
      costLabel: string;
      icon?: string;
      planLabel: string;
      topUpLabel: string;
      totalLabel: string;
      chat: string;
      images: string;
      videos: string;
      voice: string;
      character: string;
      packNote?: string | null;
      subline?: string | null;
      calculation: UsageCalculation | null;
    };

    let payload: Record<string, UsageDetail> = {};
    try {
      payload = JSON.parse(raw) as Record<string, UsageDetail>;
    } catch {
      return;
    }

    const scopeAttr = astroScopeAttr(root);
    const usageOpen = root.querySelector<HTMLButtonElement>('[data-pt-usage-open]');
    const usageMenu = root.querySelector<HTMLElement>('[data-pt-usage-menu]');
    const usageLabel = root.querySelector<HTMLElement>('[data-pt-usage-label]');
    const usageOptions = Array.from(
      root.querySelectorAll<HTMLButtonElement>('[data-pt-usage-option]'),
    );
    const title = root.querySelector<HTMLElement>('[data-pt-usage-detail-title]');
    const icon = root.querySelector<HTMLElement>('[data-pt-usage-detail-icon]');
    const total = root.querySelector<HTMLElement>('[data-pt-usage-detail-total]');
    const totalRow = root.querySelector<HTMLElement>('[data-pt-usage-detail-total-row]');
    const desc = root.querySelector<HTMLElement>('[data-pt-usage-detail-desc]');
    const plan = root.querySelector<HTMLElement>('[data-pt-usage-detail-plan]');
    const topup = root.querySelector<HTMLElement>('[data-pt-usage-detail-topup]');
    const chat = root.querySelector<HTMLElement>('[data-pt-usage-detail-chat]');
    const images = root.querySelector<HTMLElement>('[data-pt-usage-detail-images]');
    const videos = root.querySelector<HTMLElement>('[data-pt-usage-detail-videos]');
    const voice = root.querySelector<HTMLElement>('[data-pt-usage-detail-voice]');
    const character = root.querySelector<HTMLElement>('[data-pt-usage-detail-character]');

    const calcSummary = root.querySelector<HTMLElement>('[data-pt-usage-calc-summary]');
    const calcRoot = root.querySelector<HTMLElement>('[data-pt2-calc]');

    function escapeHtml(value: string): string {
      return value
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    function splitUnit(value: string): { main: string; unit: string | null } {
      const trimmed = String(value ?? '').trim();
      const match = trimmed.match(
        /^(.*?)(\s*\/\s*(?:day|mo|min|sec|secs?|hr|hrs|ea|msg|msgs?|message|messages?|character)s?\b.*)$/i,
      );
      if (match && match[1].trim().length > 0) {
        return { main: match[1].trimEnd(), unit: match[2].replace(/^\s+/, '') };
      }
      return { main: trimmed, unit: null };
    }

    function unitHtml(value: string): string {
      const parts = splitUnit(value);
      if (!parts.unit) return escapeHtml(parts.main);
      return `${escapeHtml(parts.main)}<span class="pt-unit">${escapeHtml(parts.unit)}</span>`;
    }

    function setUnitText(el: HTMLElement | null, value: string) {
      if (!el) return;
      el.innerHTML = unitHtml(value);
    }

    function renderCalculation(calc: UsageCalculation) {
      if (calcSummary) calcSummary.textContent = calc.summaryLabel;
      if (!calcRoot) return;
      const patternCards = calc.features
        .filter((row) => row.key !== 'chat' && row.monthlyTotalLabel)
        .map(
          (row) => `<article class="pt2-calc__card is-${escapeHtml(row.accent ?? row.key)}">
            <p class="pt2-calc__card-name"><span class="pt2-calc__dot" aria-hidden="true"></span>${escapeHtml(row.label)}</p>
            ${row.patternLead ? `<p class="pt2-calc__card-lead">${escapeHtml(row.patternLead)}</p>` : ''}
            <p class="pt2-calc__card-total">${escapeHtml(row.monthlyTotalLabel!)}</p>
          </article>`,
        )
        .join('');
      const eqRows = calc.features
        .filter((row) => row.cost > 0 && row.qtyPhrase && row.ratePhrase)
        .map(
          (row) => `<div class="pt2-calc__eq is-${escapeHtml(row.accent ?? row.key)}">
            <p class="pt2-calc__eq-k">${escapeHtml(row.label)}</p>
            <p class="pt2-calc__eq-line"><span>${escapeHtml(row.qtyPhrase!)}</span><span class="pt2-calc__op">×</span><span>${escapeHtml(row.ratePhrase!)}</span><span class="pt2-calc__op">=</span><strong>${escapeHtml(row.costLabel)}</strong></p>
          </div>`,
        )
        .join('');
      const reqLabel = calc.requiredCreditsLabel ?? calc.mediaValueLabel;
      const extraLabel = calc.extraCreditsLabel ?? calc.extraValueLabel;
      const includedPlain = `${calc.includedCredits.toLocaleString('en-US')} credits`;
      const totalDisplay = calc.totalLabel.replace(/\/mo$/, '');
      const topUpLine =
        calc.topUpCost > 0
          ? ` + <span data-pt-usage-calc-topup>${escapeHtml(calc.topUpCostLabel)}</span> credit top-ups`
          : '';
      calcRoot.innerHTML = `
        <section class="pt2-calc__step">
          <p class="pt2-calc__kicker">Step 1</p>
          <h4 class="pt2-calc__h">What ${escapeHtml(calc.levelName)} looks like</h4>
          <p class="pt2-calc__lead">The usage pattern we model for a typical paying reader.</p>
          <div class="pt2-calc__cards">${patternCards}</div>
          ${calc.chatIncludedNote ? `<p class="pt2-calc__note">${escapeHtml(calc.chatIncludedNote)}</p>` : ''}
        </section>
        <section class="pt2-calc__step">
          <p class="pt2-calc__kicker">Step 2</p>
          <h4 class="pt2-calc__h">How many credits that uses</h4>
          <p class="pt2-calc__lead">These features drive the total.</p>
          <div class="pt2-calc__eqs">${eqRows}</div>
          <p class="pt2-calc__total-pill"><span>Total monthly usage</span><strong>${escapeHtml(reqLabel)}</strong></p>
        </section>
        <section class="pt2-calc__step">
          <p class="pt2-calc__kicker">Step 3</p>
          <h4 class="pt2-calc__h">What you’ll actually pay</h4>
          <div class="pt2-calc__pay">
            <div class="pt2-calc__pay-card">
              <p><strong>${escapeHtml(reqLabel)}</strong><span>needed for ${escapeHtml(calc.levelName)}</span></p>
              <p><strong>${escapeHtml(includedPlain)}</strong><span>included with ${escapeHtml(calc.planName)}</span></p>
              <p><strong>${escapeHtml(extraLabel)}</strong><span>still to buy</span></p>
            </div>
            <div class="pt2-calc__pay-card">
              <p class="pt2-calc__micro">Smallest pack combination you can buy</p>
              <p class="pt2-calc__pack-head">${escapeHtml(calc.packHeadline ?? 'No top-up needed')}</p>
              ${calc.packFoot ? `<p class="pt2-calc__card-lead">${escapeHtml(calc.packFoot)}</p>` : ''}
            </div>
          </div>
          <div class="pt2-calc__banner">
            <p class="pt2-calc__micro">Estimated ${escapeHtml(calc.levelName)} cost</p>
            <p class="pt2-calc__banner-price"><span>${escapeHtml(totalDisplay)}</span><span class="pt2-calc__banner-u">/ month</span></p>
            <p class="pt2-calc__banner-sub"><span>${escapeHtml(calc.planCostLabel)}</span> ${escapeHtml(calc.planName)}${topUpLine}</p>
          </div>
        </section>`;
      stampAstroScope(calcRoot, scopeAttr);
    }

    function selectTier(id: string) {
      const data = payload[id];
      if (!data) return;
      const optionLabel =
        id === 'casual' ? 'Light' : id === 'power' ? 'Heavy' : 'Regular (most users)';
      if (usageLabel) usageLabel.textContent = optionLabel;
      usageOptions.forEach((btn) => {
        const active = btn.dataset.ptUsageOption === id;
        btn.classList.toggle('is-active', active);
        btn.setAttribute('aria-selected', active ? 'true' : 'false');
      });
      if (title) title.textContent = data.title.endsWith(' use') ? data.title : `${data.title} use`;
      if (icon && data.icon) icon.textContent = data.icon;
      if (total) total.textContent = data.totalLabel;
      if (totalRow) totalRow.textContent = data.totalLabel;
      if (desc) desc.textContent = data.description;
      if (plan) plan.textContent = data.planLabel;
      if (topup) topup.textContent = data.topUpLabel;
      const subline = root.querySelector<HTMLElement>('[data-pt-usage-subline]');
      if (subline && data.subline) subline.textContent = data.subline;
      const packNote = root.querySelector<HTMLElement>('[data-pt-usage-pack-note]');
      if (packNote) {
        if (data.packNote) {
          packNote.textContent = data.packNote;
          packNote.hidden = false;
        } else {
          packNote.textContent = '';
          packNote.hidden = true;
        }
      }
      const estimateTitleEl = root.querySelector<HTMLElement>('[data-pt-estimate-title]');
      if (estimateTitleEl) {
        estimateTitleEl.textContent = `How we estimated ${data.totalLabel.replace(/\/mo$/, '')} a month`;
      }
      setUnitText(chat, data.chat);
      setUnitText(images, data.images);
      setUnitText(videos, data.videos);
      setUnitText(voice, data.voice);
      setUnitText(character, data.character ?? '—');
      if (data.calculation) renderCalculation(data.calculation);
    }

    function closeUsageMenu() {
      if (!usageMenu || !usageOpen) return;
      usageMenu.hidden = true;
      usageOpen.setAttribute('aria-expanded', 'false');
    }

    usageOpen?.addEventListener('click', (e) => {
      e.stopPropagation();
      if (!usageMenu || !usageOpen) return;
      const open = usageMenu.hidden;
      usageMenu.hidden = !open;
      usageOpen.setAttribute('aria-expanded', open ? 'true' : 'false');
    });

    usageOptions.forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.dataset.ptUsageOption;
        if (id) selectTier(id);
        closeUsageMenu();
      });
    });

    document.addEventListener('click', (e) => {
      if (!usageMenu || usageMenu.hidden) return;
      if ((e.target as HTMLElement).closest('[data-pt-usage-select]')) return;
      closeUsageMenu();
    });
  });

  function syncBenchCollision() {
    document.querySelectorAll<HTMLElement>('[data-pt-bench]').forEach((bench) => {
      const chart = bench.querySelector<HTMLElement>('[data-pt-bench-chart]');
      const product = bench.querySelector<HTMLElement>('[data-pt-bench-marker="product"]');
      const avg = bench.querySelector<HTMLElement>('[data-pt-bench-marker="avg"]');
      const avgFloat = bench.querySelector<HTMLElement>('[data-pt-bench-float="avg"]');
      if (!chart || !product || !avg) return;

      const productPct = Number(bench.dataset.ptProductPct);
      const avgPct = Number(bench.dataset.ptAvgPct);
      if (!Number.isFinite(productPct) || !Number.isFinite(avgPct)) return;

      // Pricing tab is often hidden on first paint — don't wipe SSR overlap until measurable.
      const width = chart.clientWidth;
      if (width <= 0) return;

      const pxApart = (Math.abs(productPct - avgPct) / 100) * width;
      // Labels are wide; use a generous threshold so near prices never share a row.
      const overlap = pxApart < 72;
      const stacked = pxApart < 12;
      bench.classList.toggle('is-overlap', overlap);
      bench.classList.toggle('is-stacked', stacked);
      // Typical monthly price always sits below so labels never stack on top of each other.
      bench.classList.add('has-typical-below');
      avgFloat?.classList.add('pt-bench__float--below');
    });
  }

  document.querySelectorAll<HTMLElement>('[data-pt2-disclose]').forEach((block) => {
    const btn = block.querySelector<HTMLButtonElement>('.pt2-disclose__btn');
    const panel = block.querySelector<HTMLElement>('.pt2-disclose__panel');
    const action = block.querySelector<HTMLElement>('.pt2-disclose__action');
    if (!btn || !panel) return;
    const label = action?.querySelector<HTMLElement>('[data-pt2-action-label]');
    const closed = (action?.dataset.closed || label?.textContent || 'View').replace(/\s+/g, ' ').trim();
    const opened = (action?.dataset.open || 'Hide').trim();
    const setLabel = (open: boolean) => {
      if (label) label.textContent = open ? opened : closed;
    };
    setLabel(false);
    btn.addEventListener('click', () => {
      const open = !block.classList.contains('is-open');
      block.classList.toggle('is-open', open);
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      panel.hidden = !open;
      setLabel(open);
    });
  });

  document.querySelectorAll<HTMLElement>('[data-pt2-mixer-tool]').forEach((tool) => {
    tool.querySelector('[data-pt2-mixer-open]')?.addEventListener('click', () => {
      tool.classList.add('is-open');
    });
    tool.querySelector('[data-pt2-mixer-close]')?.addEventListener('click', () => {
      tool.classList.remove('is-open');
    });
  });

  syncBenchCollision();
  window.addEventListener('resize', () => syncBenchCollision());
  requestAnimationFrame(() => syncBenchCollision());

  // Re-measure when the Pricing tab becomes visible (hidden panels report width 0).
  document.querySelectorAll('[data-tab="pricing"], [data-tabbar] [data-tab]').forEach((el) => {
    el.addEventListener('click', () => {
      requestAnimationFrame(() => syncBenchCollision());
      setTimeout(syncBenchCollision, 50);
      setTimeout(syncBenchCollision, 200);
    });
  });
  const pricingPanel = document.querySelector('[data-tab-panel="pricing"]');
  if (pricingPanel && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting && e.intersectionRatio > 0)) {
          syncBenchCollision();
        }
      },
      { threshold: 0.01 },
    );
    io.observe(pricingPanel);
  }
  }

  deferUntilIdle(initPricingTab);
</script>
