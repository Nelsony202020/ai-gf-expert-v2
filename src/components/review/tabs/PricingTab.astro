  .pt-usage-col__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    margin-bottom: 0.2rem;
    border-radius: 999px;
    color: #9ca3af;
  }

  .pt-usage-col__icon .material-symbols-outlined {
    font-size: 18px;
    font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 20;
  }

  .pt-usage-col.is-active .pt-usage-col__icon {
    background: rgb(219 39 119 / 12%);
    color: #db2777;
  }

  .pt-usage-col__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    width: 100%;
  }

  .pt-usage-col__title {
    font-size: 0.9375rem;
    font-weight: 900;
    color: var(--color-on-surface);
  }

  .pt-usage-col__badge {
    padding: 2px 7px;
    border-radius: 999px;
    background: #db2777;
    color: #fff;
    font-size: 8px;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .pt-unit {
    margin-left: 0.05em;
    font-size: 0.82em;
    font-weight: 600;
    color: #9ca3af;
  }

  .pt-menu-select {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.35rem;
    margin: 0 0 0.85rem;
  }

  .pt-menu-select--inline {
    flex-direction: row;
    align-items: center;
    gap: 0.55rem 0.7rem;
  }

  .pt-menu-select__wrap {
    position: relative;
    min-width: 0;
  }

  .pt-menu-select__trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    max-width: 100%;
    min-height: 32px;
    padding: 0.3rem 0.45rem 0.3rem 0.7rem;
    border: 1px solid #e5e7eb;
    border-radius: 999px;
    background: #fff;
    color: var(--color-on-surface);
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition: border-color 0.15s ease;
  }

  .pt-menu-select__trigger:hover,
  .pt-menu-select__trigger:focus-visible {
    border-color: color-mix(in srgb, #db2777 45%, #e5e7eb);
    outline: none;
  }

  .pt-menu-select__trigger[aria-expanded='true'] {
    border-color: color-mix(in srgb, #db2777 55%, #e5e7eb);
  }

  .pt-menu-select__value {
    min-width: 0;
    font-size: 0.8125rem;
    font-weight: 700;
    line-height: 1.2;
    white-space: nowrap;
  }

  .pt-menu-select__chevron {
    flex-shrink: 0;
    font-size: 1.125rem;
    color: #db2777;
  }

  .pt-menu-select__menu {
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    z-index: 40;
    min-width: 100%;
    width: max-content;
    max-width: min(16rem, calc(100vw - 2rem));
    padding: 0.35rem;
    border: 1px solid #e5e7eb;
    border-radius: 0.75rem;
    background: #fff;
    box-shadow: 0 10px 28px rgb(15 23 42 / 12%);
