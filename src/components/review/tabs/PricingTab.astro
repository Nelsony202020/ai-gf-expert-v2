<script>
  import { closeSheet, openSheet } from '../../../lib/ui/bottomSheet.ts';

  type PlanBillingOpt = {
    monthlyPriceLabel: string;
    priceSub: string;
    savingsLabel: string | null;
    sale: { listPriceLabel: string; badge: string; note: string } | null;
  };

  type PlanPayload = {
    key: string;
    displayName: string;
    isFree: boolean;
    priceLabel: string;
    priceSub: string;
    summaryLine: string;
    billing: {
      monthly: PlanBillingOpt | null;
      quarterly: PlanBillingOpt | null;
      yearly: PlanBillingOpt | null;
    } | null;
  };

  type MixerChannel = {
    key: string;
    label: string;
    creditsPerUnit: number;
    step: number;
    unitLabel: string;
    format: 'count' | 'hours' | 'minutes';
    maxUnits: number;
    sublabel?: string | null;
    unitMoneyLabel?: string | null;
  };

  type MixerPayload = {
    credits: number;
    channels: MixerChannel[];
    presets: Array<{ id: string; label: string; quantities: Record<string, number> }>;
    footnote?: string;
  };

  type PlanBudget = {
    planKey: string;
    displayName: string;
    isFree: boolean;
    credits: number | null;
    creditsLine: string | null;
    items: Array<{ key: string; value: string; label?: string }>;
    mixer: MixerPayload | null;
    highlights: string[];
  };

  type PlansPayload = {
    plans: PlanPayload[];
    freePlanKey: string | null;
    limitRows: Array<{ key: string; cells: Record<string, string> }>;
    byPlan: Record<string, PlanBudget>;
    defaultPlanKey: string;
    defaultInterval: 'monthly' | 'quarterly' | 'yearly';
  };

  function escapeHtml(value: string) {
    return value
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function splitUnitClient(value: string): { main: string; unit: string | null } {
    const match = value.match(/^(.*?)(\/(?:day|min|mo|msg|character|hr|hrs|sec|ea))?$/i);
    if (!match) return { main: value, unit: null };
    return { main: (match[1] ?? value).trimEnd(), unit: match[2] ?? null };
  }

  function astroScopeAttr(el: Element): string | null {
    return el.getAttributeNames().find((n) => n.startsWith('data-astro-cid-')) ?? null;
  }

  function stampAstroScope(root: Element, scopeAttr: string | null) {
    if (!scopeAttr) return;
    root.setAttribute(scopeAttr, '');
    root.querySelectorAll('*').forEach((node) => node.setAttribute(scopeAttr, ''));
  }

  function buildMixerMarkup(mixer: MixerPayload): string {
    const presetOptions = [
      { id: 'custom', label: 'Custom mix' },
      ...mixer.presets.filter((p) => p.id !== 'reset').map((p) => ({ id: p.id, label: p.label })),
    ]
      .map(
        (preset, idx) =>
          `<button type="button" role="option" class="pt-menu-select__option${idx === 0 ? ' is-active' : ''}" data-pt-mixer-preset="${escapeHtml(preset.id)}" aria-selected="${idx === 0 ? 'true' : 'false'}">${escapeHtml(preset.label)}</button>`,
      )
      .join('');

    const sheetPresetOptions = [
      { id: 'custom', label: 'Custom mix' },
      ...mixer.presets.filter((p) => p.id !== 'reset').map((p) => ({ id: p.id, label: p.label })),
    ]
      .map(
        (preset, idx) =>
          `<button type="button" role="option" class="pt-menu-select__option${idx === 0 ? ' is-active' : ''}" data-pt-mixer-sheet-preset="${escapeHtml(preset.id)}" aria-selected="${idx === 0 ? 'true' : 'false'}">${escapeHtml(preset.label)}</button>`,
      )
      .join('');

    const controls = mixer.channels
      .map((ch) => {
        const rate = ch.unitMoneyLabel || ch.sublabel;
        const rateHtml = rate
          ? `<span class="pt-mixer__control-rate">${escapeHtml(rate)}</span>`
          : '';
        return `<div class="pt-mixer__control" data-pt-mixer-control="${escapeHtml(ch.key)}" data-credits-per-unit="${ch.creditsPerUnit}" data-step="${ch.step}" data-format="${escapeHtml(ch.format)}" data-unit-label="${escapeHtml(ch.unitLabel)}">
  <div class="pt-mixer__control-meta">
    <span class="pt-mixer__control-label">${escapeHtml(ch.label)}</span>
    ${rateHtml}
  </div>
  <div class="pt-mixer__stepper">
    <button type="button" class="pt-mixer__step" data-pt-mixer-dec aria-label="Decrease ${escapeHtml(ch.label)}">−</button>
    <span class="pt-mixer__qty" data-pt-mixer-qty>0</span>
    <button type="button" class="pt-mixer__step" data-pt-mixer-inc aria-label="Increase ${escapeHtml(ch.label)}">+</button>
  </div>
  <p class="pt-mixer__spent" data-pt-mixer-spent>0 credits</p>
</div>`;
      })
      .join('');

    const sheetControls = mixer.channels
      .map((ch) => {
        const rate = ch.unitMoneyLabel || ch.sublabel;
        const rateHtml = rate
          ? `<span class="pt-mixer__control-rate">${escapeHtml(rate)}</span>`
          : '';
        return `<div class="pt-mixer__control pt-mixer-sheet__control" data-pt-mixer-sheet-control="${escapeHtml(ch.key)}" data-credits-per-unit="${ch.creditsPerUnit}" data-step="${ch.step}" data-format="${escapeHtml(ch.format)}" data-unit-label="${escapeHtml(ch.unitLabel)}">
  <div class="pt-mixer__control-meta">
    <span class="pt-mixer__control-label">${escapeHtml(ch.label)}</span>
    ${rateHtml}
  </div>
  <div class="pt-mixer__stepper pt-mixer-sheet__stepper">
    <button type="button" class="pt-mixer__step" data-pt-mixer-sheet-dec aria-label="Decrease ${escapeHtml(ch.label)}">−</button>
    <span class="pt-mixer__qty" data-pt-mixer-sheet-qty>0</span>
    <button type="button" class="pt-mixer__step" data-pt-mixer-sheet-inc aria-label="Increase ${escapeHtml(ch.label)}">+</button>
  </div>
  <p class="pt-mixer__spent" data-pt-mixer-sheet-spent>0 credits</p>
</div>`;
      })
      .join('');

    const legend = mixer.channels
      .map(
        (ch) =>
          `<li class="pt-mixer__legend-item pt-mixer__legend-item--${escapeHtml(ch.key)}" data-pt-mixer-legend-item="${escapeHtml(ch.key)}" hidden>
  <span class="pt-mixer__legend-swatch" aria-hidden="true"></span>
  <span class="pt-mixer__legend-name">${escapeHtml(ch.label)}</span>
  <span class="pt-mixer__legend-cr" data-pt-mixer-legend-cr>0</span>
</li>`,
      )
      .join('');

    const mobileLegend = mixer.channels
      .map(
        (ch) =>
          `<li class="pt-mixer__legend-item pt-mixer__legend-item--${escapeHtml(ch.key)}" data-pt-mixer-mobile-legend-item="${escapeHtml(ch.key)}" hidden>
  <span class="pt-mixer__legend-swatch" aria-hidden="true"></span>
  <span class="pt-mixer__legend-name">${escapeHtml(ch.label)}</span>
  <span class="pt-mixer__legend-cr" data-pt-mixer-mobile-legend-cr>0</span>
</li>`,
      )
      .join('');

    const footnote = mixer.footnote
      ? `<p class="pt-mixer__footnote">${escapeHtml(mixer.footnote)}</p>`
      : '';

    return `<div class="pt-mixer" data-pt-mixer>
  <div class="pt-mixer__tool-head">
    <p class="pt-mixer__tool-eyebrow">Interactive tool</p>
    <p class="pt-mixer__tool-title">
      <span class="material-symbols-outlined" aria-hidden="true">tune</span>
      Build your mix
    </p>
    <p class="pt-mixer__tool-help">
      Adjust each feature to see how your <span data-pt-mixer-help-n>${mixer.credits.toLocaleString('en-US')}</span> credits could be split.
    </p>
  </div>
  <div class="pt-mixer-mobile" data-pt-mixer-mobile>
    <div class="pt-mixer-mobile__meta">
      <span class="pt-label">Preset</span>
      <strong data-pt-mixer-mobile-preset>Custom mix</strong>
    </div>
    <p class="pt-mixer-mobile__used">
      <span data-pt-mixer-mobile-used-line>0 / ${mixer.credits} credits used</span>
    </p>
    <p class="pt-mixer-mobile__mix" data-pt-mixer-mobile-mix>Adjust to build a mix</p>
    <div class="pt-mixer-mobile__viz">
      <div class="pt-mixer__donut pt-mixer__donut--sm" data-pt-mixer-mobile-donut role="img" aria-label="Credit allocation">
        <div class="pt-mixer__donut-ring" data-pt-mixer-mobile-donut-ring></div>
        <div class="pt-mixer__donut-hole" aria-hidden="true"></div>
        <div class="pt-mixer__donut-center">
          <strong data-pt-mixer-mobile-center>${mixer.credits}</strong>
          <span>left</span>
        </div>
      </div>
      <ul class="pt-mixer-mobile__legend" data-pt-mixer-mobile-legend>
        ${mobileLegend}
        <li class="pt-mixer__legend-item pt-mixer__legend-item--remaining" data-pt-mixer-mobile-legend-item="remaining">
          <span class="pt-mixer__legend-swatch" aria-hidden="true"></span>
          <span class="pt-mixer__legend-name">Remaining</span>
          <span class="pt-mixer__legend-cr" data-pt-mixer-mobile-legend-cr>${mixer.credits}</span>
        </li>
      </ul>
    </div>
    <button type="button" class="pt-mixer-mobile__customize" data-pt-mixer-customize>
      <span class="material-symbols-outlined" aria-hidden="true">tune</span>
      Customize mix
    </button>
  </div>
  <div class="pt-mixer__layout">
    <div class="pt-mixer__build">
      <div class="pt-mixer__toolbar">
        <div class="pt-menu-select" data-pt-mixer-preset-select>
          <span class="pt-label">Preset</span>
          <div class="pt-menu-select__wrap">
            <button type="button" class="pt-menu-select__trigger" data-pt-mixer-preset-open aria-haspopup="listbox" aria-expanded="false">
              <span class="pt-menu-select__value" data-pt-mixer-preset-label>Custom mix</span>
              <span class="material-symbols-outlined pt-menu-select__chevron" aria-hidden="true">expand_more</span>
            </button>
            <div class="pt-menu-select__menu" data-pt-mixer-preset-menu role="listbox" hidden>${presetOptions}</div>
          </div>
        </div>
        <button type="button" class="pt-mixer__reset" data-pt-mixer-reset hidden>Reset</button>
      </div>
      <p class="pt-mixer__budget"><strong>${mixer.credits}</strong> credits available</p>
      <div class="pt-mixer__controls">${controls}</div>
    </div>
    <aside class="pt-mixer__summary" aria-label="Your mix">
      <p class="pt-mixer__panel-title">Your mix</p>
      <div class="pt-mixer__viz">
        <div class="pt-mixer__donut" data-pt-mixer-donut role="img" aria-label="Credit allocation">
          <div class="pt-mixer__donut-ring" data-pt-mixer-donut-ring></div>
          <div class="pt-mixer__donut-hole" aria-hidden="true"></div>
          <div class="pt-mixer__donut-center">
            <strong data-pt-mixer-center-value>${mixer.credits}</strong>
            <span data-pt-mixer-center-label>credits remaining</span>
          </div>
        </div>
        <ul class="pt-mixer__legend" data-pt-mixer-legend>
          ${legend}
          <li class="pt-mixer__legend-item pt-mixer__legend-item--remaining" data-pt-mixer-legend-item="remaining">
            <span class="pt-mixer__legend-swatch" aria-hidden="true"></span>
            <span class="pt-mixer__legend-name">Remaining</span>
            <span class="pt-mixer__legend-cr" data-pt-mixer-legend-cr>${mixer.credits}</span>
          </li>
        </ul>
      </div>
      <div class="pt-mixer__totals">
        <div class="pt-mixer__total">
          <span>Total used</span>
          <strong data-pt-mixer-used>0 credits</strong>
        </div>
        <div class="pt-mixer__total pt-mixer__total--remain">
          <span>Remaining</span>
          <strong data-pt-mixer-remaining-strong>${mixer.credits} credits</strong>
        </div>
      </div>
    </aside>
  </div>
  ${footnote}
</div>
<div class="mobile-sheet pt-mixer-sheet" data-pt-mixer-sheet hidden aria-hidden="true">
  <button type="button" class="mobile-sheet__backdrop" data-pt-mixer-sheet-close aria-label="Close"></button>
  <div class="mobile-sheet__panel" role="dialog" aria-modal="true" aria-labelledby="pt-mixer-sheet-title">
    <div class="mobile-sheet__handle" aria-hidden="true"></div>
    <header class="mobile-sheet__head">
      <h2 id="pt-mixer-sheet-title" class="mobile-sheet__title">Customize mix</h2>
      <button type="button" class="mobile-sheet__close" data-pt-mixer-sheet-close aria-label="Close">
        <span class="material-symbols-outlined" aria-hidden="true">close</span>
      </button>
    </header>
    <div class="mobile-sheet__body pt-mixer-sheet__body">
      <p class="pt-mixer-sheet__budget"><strong data-pt-mixer-sheet-credits>${mixer.credits}</strong> credits available</p>
