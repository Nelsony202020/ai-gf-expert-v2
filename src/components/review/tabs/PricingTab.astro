    <section class="pt2-section" id="pricing-detail">
      {vm.featureCosts.length > 0 && (
        <div class="pt2-disclose pt2-disclose--tight" data-pt2-disclose>
          <button type="button" class="pt2-disclose__btn" aria-expanded="false">
            <span class="pt2-disclose__copy">
              <span class="pt2-disclose__title">What each feature costs</span>
              <span class="pt2-disclose__sum">{featureCostsIntro || 'See how credits translate into real money.'}</span>
            </span>
            <span class="pt2-disclose__action" data-closed="View breakdown" data-open="Hide breakdown">
              <span data-pt2-action-label>View breakdown</span>
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
          </button>
          <div class="pt2-disclose__panel" hidden>
            <table class="pt2-cost-table">
              <thead>
                <tr>
                  <th scope="col">Feature</th>
                  <th scope="col">Credits</th>
                  <th scope="col">Approx. cost</th>
                </tr>
              </thead>
              <tbody>
                {
                  vm.featureCosts.map((row) => (
                    <tr>
                      <th scope="row">{row.label}</th>
                      <td>{row.secondaryValue || '—'}</td>
                      <td>{row.value}</td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
            {vm.pricingEvidence?.featureCosts && (
              <p class="pt2-evidence">
                <button
                  type="button"
                  class="pt-evidence__view"
                  data-lightbox-open={vm.pricingEvidence.featureCosts.src}
                  data-lightbox-alt={vm.pricingEvidence.featureCosts.alt}
                  data-lightbox-caption={`${vm.pricingEvidence.verifiedLabel}. ${vm.pricingEvidence.capturedLabel}`}
                >
                  View feature costs screenshot ↗
                </button>
              </p>
            )}
          </div>
        </div>
      )}

      {vm.topUps && (
        <div class="pt2-disclose pt2-disclose--tight" data-pt2-disclose>
          <button type="button" class="pt2-disclose__btn" aria-expanded="false">
            <span class="pt2-disclose__copy">
              <span class="pt2-disclose__title">Dreamcoin top-up prices</span>
              <span class="pt2-disclose__sum">{vm.topUps.intro}</span>
            </span>
            <span class="pt2-disclose__action" data-closed="View prices" data-open="Hide prices">
              <span data-pt2-action-label>View prices</span>
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
          </button>
          <div class="pt2-disclose__panel" hidden>
            <div class="pt-topups" data-pt-topups>
                      <div class="pt-topups__scroll">
                        <table class="pt-topups__table pt2-cost-table">
                          <thead>
                            <tr>
                              <th scope="col">Credits you get</th>
                              <th scope="col">Price</th>
                              <th scope="col">{vm.topUps.valueColumnLabel || 'Value vs the 1,000 pack'}</th>
                            </tr>
                          </thead>
                          <tbody>
                            {
                              vm.topUps.packages.map((pkg) => (
                                <tr class:list={[pkg.isEstimatePackage && 'is-estimate']}>
                                  <th scope="row">
                                    <span class="pt-topups__credits">{pkg.creditsLabel}</span>
                                    {
                                      pkg.bonusDetail && (
                                        <span class="pt-topups__bonus">{pkg.bonusDetail}</span>
                                      )
                                    }
                                    {
                                      pkg.isEstimatePackage && (
                                        <span class="pt-topups__estimate-tag">
                                          Used in our regular-use estimate
                                        </span>
                                      )
                                    }
                                  </th>
                                  <td>{pkg.priceLabel}</td>
                                  <td>
                                    {
                                      pkg.isBestValue ? (
                                        <>
                                          <span class="pt-topups__best">Best value</span>
                                          {
                                            pkg.valueLabel !== '—' && (
                                              <span class="pt-topups__value-detail">{pkg.valueLabel}</span>
                                            )
                                          }
                                        </>
                                      ) : (
                                        pkg.valueLabel
                                      )
                                    }
                                  </td>
                                </tr>
                              ))
                            }
                          </tbody>
                        </table>
                      </div>
                      {
                        vm.topUps.estimateNote && (
                          <p class="pt-topups__note">{vm.topUps.estimateNote}</p>
