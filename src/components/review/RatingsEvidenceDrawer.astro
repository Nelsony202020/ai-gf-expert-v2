---
import type { DraftEvidenceCategory } from '../../lib/draft-ratings/types';
import { proofShortCaption, enhancedScopeDescription, interpretScoreBand } from '../../lib/draft-ratings/evidenceDrawerContent';
import {
  getEvidenceMethodology,
  getSubscoreMethodology,
} from '../../data/evidence-drawer-methodology';
import { getSubscoreDescription } from '../../data/subscore-descriptions';
import { fmtScore } from '../../lib/scores';
import { getFigmaScoreTone } from '../../lib/ratings/figmaScoreTone';
import DrawerNavFooter from './DrawerNavFooter.astro';
import type { DrawerNav } from '../../lib/draft-ratings/drawerNav';

interface SubscoreCalcItem {
  name: string;
  score: number | null;
  weight: number;
  icon: string;
  contribution: number | null;
  excluded?: boolean;
}

interface SubscoreCalc {
  drawerId: string;
  categorySlug: string;
  subscoreSlug: string;
  categoryName: string;
  categoryWeight?: number;
  subscoreName: string;
  subscoreScore: number | null;
  scopeDescription: string;
  headlineConclusion: string;
  keyTakeaways: string;
  items: SubscoreCalcItem[];
  excludedNote?: string;
  prevDrawerId?: string;
  prevLabel?: string;
  nextDrawerId?: string;
  nextLabel?: string;
}

interface Props {
  evidenceCategories: DraftEvidenceCategory[];
  subscoreCalcs: SubscoreCalc[];
  drawerNavById: Record<string, DrawerNav>;
  productName: string;
  lastTested?: string;
  methodologyVersion?: string;
}

const { evidenceCategories, subscoreCalcs, drawerNavById } = Astro.props;

const calcByKey = new Map(
  subscoreCalcs.map((calc) => [`${calc.categorySlug}/${calc.subscoreSlug}`, calc]),
);

function relatedMeasurement(ec: DraftEvidenceCategory, proofCaption?: string) {
  if (!proofCaption) return ec.testResults[0];
  const lower = proofCaption.toLowerCase();
  return (
    ec.testResults.find(
      (m) => lower.includes(m.label.toLowerCase()) || lower.includes(m.slug.replace(/-/g, ' ')),
    ) ?? ec.testResults[0]
  );
}

function formatWeight(weight: number | null | undefined): string {
  if (weight == null || Number.isNaN(weight)) return '—';
  const rounded = Math.round(weight * 100) / 100;
  return Number.isInteger(rounded) ? `${rounded}%` : `${rounded.toFixed(2)}%`;
}

function calcScoreLine(score: number | null, items: SubscoreCalcItem[]): string {
  if (score == null || Number.isNaN(score)) return 'Pending';
  const band = interpretScoreBand(score);
  const scored = items.filter((item) => item.score != null && !item.excluded);
  if (scored.length === 0) return band;
  const highest = [...scored].sort((a, b) => (b.score ?? 0) - (a.score ?? 0))[0];
  if (score >= 7 && highest) return `${band} — strongest on ${highest.name.toLowerCase()}`;
  return band;
}

function evidenceWeight(ec: DraftEvidenceCategory): number | null {
  const calc = calcByKey.get(`${ec.categorySlug}/${ec.subscoreSlug}`);
  const item = calc?.items.find((row) => row.name === ec.name);
  return item?.weight ?? null;
}
---

<div data-ratings-drawer-root hidden>
  <div class="ratings-drawer-backdrop" data-ratings-drawer-backdrop aria-hidden="true"></div>
  <div data-ratings-drawer-mount class="ratings-drawer-mount"></div>

  {
    evidenceCategories.map((ec) => {
      const proofItems = ec.selectedProof
        .filter((p) => p.kind === 'image' || p.kind === 'video')
        .map((proof) => {
          const related = relatedMeasurement(ec, proof.caption);
          return {
            src: proof.fullUrl ?? proof.thumbUrl,
            alt: proofShortCaption(proof, related),
            caption: proofShortCaption(proof, related),
            proof,
          };
        });
      const nav = drawerNavById[ec.drawerId] ?? {};
      const methodology = getEvidenceMethodology(
        ec.categorySlug ?? '',
        ec.subscoreSlug ?? '',
        ec.slug,
      );
      const whatItMeasures =
        methodology?.whatItMeasures ?? enhancedScopeDescription(ec.slug);
      const howWeTested = methodology?.howWeTested;
      const tone = getFigmaScoreTone(ec.score);
      const bandLabel = ec.score != null ? interpretScoreBand(ec.score) : 'Pending';
      const weightLabel = formatWeight(evidenceWeight(ec));
      const eyebrow = [ec.categoryName, ec.subscoreName].filter(Boolean).join(' · ');
      const collapsedGallery = proofItems.length > 6;
      const extraCount = Math.max(0, proofItems.length - 6);
      const resultRows = [
        ...ec.testResults.map((m) => ({
          label: m.label,
          value: m.value,
        })),
        { label: 'Score', value: ec.score != null ? `${fmtScore(ec.score)} / 10` : '—' },
        {
          label: 'Interpretation',
          value: ec.testResults.find((m) => m.interpretation)?.interpretation || bandLabel,
        },
      ];

      return (
        <template data-ratings-drawer-template={ec.drawerId}>
        <aside
          class="ratings-drawer-panel rdv"
          role="dialog"
          aria-modal="true"
          aria-labelledby={`ratings-drawer-title-${ec.drawerId}`}
          data-ratings-drawer-panel={ec.drawerId}
          hidden
        >
          <div class="rdv-head">
            <div class="rdv-head__top">
              <p class="rdv-eyebrow">{eyebrow || 'Evidence'}</p>
              <button
                type="button"
                class="rdv-close"
                data-ratings-close-drawer
                aria-label="Close evidence details"
              >
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path d="M3 3l10 10M13 3L3 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
                </svg>
              </button>
            </div>
            <h2 id={`ratings-drawer-title-${ec.drawerId}`} class="rdv-title">{ec.name}</h2>
            <div class="rdv-scoreline">
              <span class:list={['rdv-score', `rdv-score--${tone}`]}>{fmtScore(ec.score)}</span>
              <span class="rdv-scoremeta">
                <span class="rdv-kicker">Evidence score</span>
                <span class="rdv-scoremeta__value">{bandLabel}</span>
              </span>
              <span class="rdv-scoreline__grow" aria-hidden="true"></span>
              <span class="rdv-scoremeta rdv-scoremeta--end">
                <span class="rdv-kicker">Weight in {ec.subscoreName || 'subscore'}</span>
                <span class="rdv-scoremeta__value">{weightLabel}</span>
              </span>
            </div>
          </div>

          <div class="rdv-rule" aria-hidden="true"></div>

          <div class="ratings-drawer-panel__body rdv-body">
            {whatItMeasures && (
              <section class="rdv-block">
                <h3 class="rdv-kicker">What this measures</h3>
                <p class="rdv-copy">{whatItMeasures}</p>
              </section>
            )}

            {resultRows.length > 0 && (
              <section class="rdv-block">
                <h3 class="rdv-kicker">Test result</h3>
                <div class="rdv-kv">
                  {resultRows.map((row) => (
                    <div class="rdv-kv__row">
                      <span class="rdv-kv__label">{row.label}</span>
                      <span class="rdv-kv__value">{row.value || '—'}</span>
                    </div>
                  ))}
                </div>
              </section>
            )}

            {howWeTested && (
              <section class="rdv-block">
                <h3 class="rdv-kicker">How we tested</h3>
                <p class="rdv-copy">{howWeTested}</p>
                {ec.methodologyUrl && (
                  <a href={ec.methodologyUrl} class="rdv-link">
                    View full {ec.name} methodology →
                  </a>
                )}
              </section>
            )}

            {ec.calculation && (
              <details class="rdv-calc">
                <summary class="rdv-calc__summary">
                  <span>How the {ec.name} score was calculated</span>
                  <svg class="rdv-calc__chevron" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
                    <path d="M4 7l5 5 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                  </svg>
                </summary>
                <div class="rdv-calc__body">
                  {ec.calculation.rows.length > 0 && (
                    <div class="rdv-kv">
                      {ec.calculation.rows.map((row) => (
                        <div class="rdv-kv__row">
                          <span class="rdv-kv__label">{row.label}</span>
                          <span class="rdv-kv__value">
                            {row.measuredValue}
                            {row.internalScore != null ? ` · ${fmtScore(row.internalScore)}` : ''}
                          </span>
                        </div>
                      ))}
                    </div>
                  )}
                  {ec.calculation.method !== 'single' && ec.calculation.formulaParts.length > 0 && (
                    <p class="rdv-formula">
                      {ec.calculation.formulaParts.join(' + ')} = {ec.calculation.formulaTotal?.toFixed(2)} → {fmtScore(ec.calculation.finalScore ?? ec.calculation.formulaTotal)}
                    </p>
                  )}
                </div>
              </details>
            )}

            {proofItems.length > 0 && (
              <section class="rdv-block">
                <div class="rdv-evidence-head">
                  <svg class="rdv-evidence-head__icon" width="15" height="15" viewBox="0 0 15 15" fill="none" aria-hidden="true">
                    <rect x="1.25" y="1.25" width="12.5" height="12.5" rx="1.5" stroke="currentColor" stroke-width="1.5"></rect>
                    <circle cx="5.25" cy="5.25" r="1.25" stroke="currentColor" stroke-width="1.2"></circle>
                    <path d="M13.5 10.25l-3.1-3.1a1.7 1.7 0 00-2.4 0L2.5 12.65" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
                  </svg>
                  <h3 class="rdv-kicker">Evidence</h3>
                  <span class="rdv-evidence-head__count">
                    {proofItems.length} screenshot{proofItems.length === 1 ? '' : 's'}
                  </span>
                </div>
                <div
                  class:list={['rdv-gallery', proofItems.length === 1 && 'rdv-gallery--single']}
                  data-rdv-gallery
                  data-gallery-collapsed={collapsedGallery ? 'true' : 'false'}
                >
                  {proofItems.map((item, index) => (
                    <button
                      type="button"
                      class:list={['rdv-shot', index >= 6 && 'rdv-shot--more']}
                      data-lightbox-open={item.src}
                      data-lightbox-alt={item.alt}
                      data-lightbox-caption={item.caption}
                    >
                      <img
                        src={item.proof.thumbUrl || item.proof.fullUrl}
                        alt={item.alt}
                        loading="lazy"
                      />
                    </button>
                  ))}
                </div>
                {collapsedGallery && (
                  <button type="button" class="rdv-more" data-rdv-gallery-more>
                    Show {extraCount} more ↓
                  </button>
                )}
                <p class="rdv-hint">Tap a screenshot to open the full-size viewer</p>
              </section>
            )}
          </div>

          <div class="rdv-rule" aria-hidden="true"></div>
          <DrawerNavFooter {...nav} />
        </aside>
        </template>
      );
    })
  }

  {
    subscoreCalcs.map((calc) => {
      const subscoreMethodology = getSubscoreMethodology(calc.categorySlug, calc.subscoreSlug);
      const calcWhatItMeasures =
        subscoreMethodology?.whatItMeasures ??
        getSubscoreDescription(calc.categorySlug, calc.subscoreName);
      const scoreCalculation = subscoreMethodology?.scoreCalculation;
      const parts = calc.items
        .filter((i) => i.contribution != null)
        .map((i) => i.contribution!.toFixed(2));
      const rawTotal = calc.items
        .filter((i) => i.contribution != null)
        .reduce((sum, i) => sum + i.contribution!, 0);
      const tone = getFigmaScoreTone(calc.subscoreScore);
      const scoreLine = calcScoreLine(calc.subscoreScore, calc.items);

      return (
        <template data-ratings-drawer-template={calc.drawerId}>
        <aside
          class="ratings-drawer-panel rdv rdv--calc"
          role="dialog"
          aria-modal="true"
          aria-labelledby={`ratings-calc-title-${calc.drawerId}`}
          data-ratings-drawer-panel={calc.drawerId}
          hidden
        >
          <div class="rdv-head">
            <div class="rdv-head__top">
              <p class="rdv-eyebrow">{calc.categoryName}</p>
              <button
                type="button"
                class="rdv-close"
                data-ratings-close-drawer
                aria-label="Close score calculation"
              >
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path d="M3 3l10 10M13 3L3 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
                </svg>
              </button>
            </div>
            <h2 id={`ratings-calc-title-${calc.drawerId}`} class="rdv-title">{calc.subscoreName}</h2>
            <div class="rdv-scoreline">
              <span class:list={['rdv-score', `rdv-score--${tone}`]}>{fmtScore(calc.subscoreScore)}</span>
              <span class="rdv-scoremeta">
                <span class="rdv-kicker">Subscore</span>
                <span class="rdv-scoremeta__value">{scoreLine}</span>
              </span>
              <span class="rdv-scoreline__grow" aria-hidden="true"></span>
              <span class="rdv-scoremeta rdv-scoremeta--end">
                <span class="rdv-kicker">Weight in {calc.categoryName}</span>
                <span class="rdv-scoremeta__value">{formatWeight(calc.categoryWeight)}</span>
              </span>
            </div>
          </div>

          <div class="rdv-rule" aria-hidden="true"></div>

          <div class="ratings-drawer-panel__body rdv-body">
            {calcWhatItMeasures && (
              <section class="rdv-block">
                <h3 class="rdv-kicker">What this measures</h3>
                <p class="rdv-copy">{calcWhatItMeasures}</p>
              </section>
            )}

            <section class="rdv-block">
              <h3 class="rdv-kicker">Breakdown</h3>
              <div class="rdv-table" role="table">
                <div class="rdv-table__row rdv-table__row--head" role="row">
                  <span class="rdv-table__cell rdv-table__cell--name">Evidence</span>
                  <span class="rdv-table__cell">Score</span>
                  <span class="rdv-table__cell">Weight</span>
                  <span class="rdv-table__cell">Contrib.</span>
                </div>
                {calc.items.map((item) => (
                  <div class:list={['rdv-table__row', item.excluded && 'rdv-table__row--muted']} role="row">
                    <span class="rdv-table__cell rdv-table__cell--name">{item.name}</span>
                    <span class="rdv-table__cell">{item.excluded ? 'N/A' : fmtScore(item.score)}</span>
                    <span class="rdv-table__cell">{item.excluded ? '—' : formatWeight(item.weight)}</span>
                    <span class="rdv-table__cell">{item.contribution != null ? item.contribution.toFixed(2) : '—'}</span>
                  </div>
                ))}
                <div class="rdv-table__row rdv-table__row--total" role="row">
                  <span class="rdv-table__cell rdv-table__cell--name">Final score</span>
                  <span class="rdv-table__cell"></span>
                  <span class="rdv-table__cell">100%</span>
                  <span class="rdv-table__cell">{rawTotal.toFixed(2)}</span>
                </div>
              </div>
              {parts.length > 0 && (
                <p class="rdv-formula">
                  {parts.join(' + ')} = {rawTotal.toFixed(2)} → {fmtScore(calc.subscoreScore)}
                </p>
              )}
              {calc.excludedNote && <p class="rdv-hint">{calc.excludedNote}</p>}
            </section>

            <section class="rdv-block">
              <h3 class="rdv-kicker">How this score is calculated</h3>
              <p class="rdv-copy">
                {scoreCalculation ??
                  'Each evidence test is scored out of 10 and weighted, then the weighted contributions are added together. Weights come from the global testing taxonomy, not from this review.'}
              </p>
              {calc.subscoreSlug && (
                <a href={`/test/${calc.categorySlug}/${calc.subscoreSlug}/`} class="rdv-link">
                  View full {calc.subscoreName} methodology →
                </a>
              )}
            </section>
          </div>

          <div class="rdv-rule" aria-hidden="true"></div>
          <DrawerNavFooter
            prevLabel={calc.prevLabel}
            nextDrawerId={calc.nextDrawerId}
            nextLabel={calc.nextLabel}
          />
        </aside>
        </template>
      );
    })
  }
</div>

<script src="./ratings-drawer.client.ts"></script>
