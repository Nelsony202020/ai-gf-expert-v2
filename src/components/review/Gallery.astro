---
import type { Product } from '../../data/products';
import { getAuthor } from '../../data/authors';
import { heroGalleryImages, featuredHeroImage } from '../../lib/review-shell';
import { optimizedHeroImageUrl } from '../../lib/media/optimize';

interface Props {
  product: Product;
}

const { product } = Astro.props;
const images = heroGalleryImages(product);
const cover = featuredHeroImage(product);
const coverSrc = cover?.full ? optimizedHeroImageUrl(cover.full, 792) || cover.full : undefined;
const videoUrl = product.videoReview?.embedUrl;
const videoAuthor =
  getAuthor(product.authors[0]?.slug || 'herman-carter') ?? getAuthor('herman-carter');
const videoAuthorAvatar = videoAuthor?.avatar || '/brand/herman-main-icon.svg';
---

{cover && (
  <div class="review-hero-gallery rs-gallery">
    <button
      type="button"
      class="review-hero-media-open"
      data-lightbox-open={cover.full}
      data-lightbox-alt={cover.alt || `${product.name} screenshot`}
      aria-label="Enlarge featured image"
    >
      <img
        class="rs-gallery-img"
        src={coverSrc}
        alt={cover.alt || `${product.name} screenshot`}
        width="792"
        height="429"
      />
    </button>
    <button
      type="button"
      class="review-hero-enlarge rs-gallery-enlarge"
      data-lightbox-open={cover.full}
      data-lightbox-alt={cover.alt || `${product.name} screenshot`}
      aria-label="Enlarge featured image"
    >
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
        <path d="M8 2h4v4M6 12H2V8M12 2 8.2 5.8M2 12l3.8-3.8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      <span class="rs-gallery-enlarge-label">Enlarge</span>
    </button>
    {videoUrl && (
      <div class="video-review-trigger-wrap">
        <button
          type="button"
          class="video-review-trigger"
          data-video-lightbox-open
          aria-haspopup="dialog"
          aria-label="Watch full video review"
        >
          <span class="video-review-trigger__mascot" aria-hidden="true">
            <img
              src={videoAuthorAvatar}
              alt=""
              width="42"
              height="42"
              onerror="this.onerror=null;this.src='/brand/herman-main-icon.svg'"
            />
            <span class="video-review-trigger__play" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect x="1" y="1" width="20" height="20" rx="10" fill="#FF0033" stroke="#0E0E12" stroke-width="2"/>
                <path
                  d="M8.29163 7.79164C8.29163 7.63031 8.33425 7.47172 8.41492 7.33239C8.49558 7.1926 8.612 7.07664 8.75179 6.99643C8.89158 6.91622 9.05017 6.87406 9.2115 6.87452C9.37283 6.87543 9.53096 6.91852 9.67029 6.99964L15.1689 10.2071C15.3078 10.2877 15.4228 10.4032 15.503 10.5421C15.5833 10.681 15.6254 10.8386 15.6254 10.9991C15.6259 11.1595 15.5837 11.3171 15.504 11.4565C15.4238 11.5953 15.3087 11.7113 15.1703 11.792L9.67029 15.0003C9.53096 15.0814 9.37283 15.1245 9.2115 15.1254C9.05017 15.1259 8.89158 15.0837 8.75179 15.0035C8.612 14.9233 8.49558 14.8073 8.41492 14.6676C8.33425 14.5282 8.29163 14.3696 8.29163 14.2083V7.79164Z"
                  fill="white" stroke="white" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
          </span>
          <svg class="video-review-trigger__yt" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
            <path d="M16.2 5.4a2.1 2.1 0 0 0-1.48-1.48C13.5 3.6 9 3.6 9 3.6s-4.5 0-5.72.32A2.1 2.1 0 0 0 1.8 5.4 22 22 0 0 0 .3 3.6 2.1 2.1 0 0 0 1.48 1.48C4.5 14.4 9 14.4 9 14.4s4.5 0 5.72-.32A2.1 2.1 0 0 0 16.2 12.6 22 22 0 0 0 16.5 9a22 22 0 0 0-.3-3.6Z" stroke="#f7f7f6" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="m7.5 11.25 3.75-2.25L7.5 6.75v4.5Z" stroke="#f7f7f6" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span class="video-review-trigger__label video-review-trigger__label--desktop">Watch full video review</span>
          <span class="video-review-trigger__label video-review-trigger__label--mobile">Watch video review</span>
          <svg class="video-review-trigger__arrow" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M6 3.5 11 8l-5 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>
    )}
    {images.length > 1 && (
      <script type="application/json" data-gallery-images set:html={JSON.stringify(images)} />
    )}
  </div>
)}
