---
import type { GalleryImage, Product } from '../../data/products';
import { imageSrcSet, optimizedImageUrl } from '../../lib/media/optimize';
import VideoReviewLightbox from './VideoReviewLightbox.astro';

interface Props {
  images: GalleryImage[];
  product: Product;
}

const { images, product } = Astro.props;
const hero = images[0];
const heroIsVideo = (hero?.mediaType ?? 'image') === 'video';
const heroImgSrc = heroIsVideo ? undefined : optimizedImageUrl(hero?.full, { width: 800, quality: 72, dpr: 1 });
const heroImgSrcSet = heroIsVideo || !hero?.full ? '' : imageSrcSet(hero.full, [480, 800], 72);
const galleryLightboxItems = JSON.stringify(
  images
    .filter((image) => image.full)
    .map((image) => ({
      src: image.full,
      alt: image.alt,
      caption: image.alt,
      type: image.mediaType ?? 'image',
    })),
);
---

<div class="space-y-3" data-gallery data-gallery-images={galleryLightboxItems}>
  <div class="relative rounded-xl overflow-hidden aspect-video shadow-lg border border-surface-variant/40 bg-surface-container w-full">
    <button
      type="button"
      class="relative w-full h-full block group cursor-zoom-in"
      data-lightbox-open={hero?.full}
      data-lightbox-alt={hero?.alt}
      data-lightbox-type={hero?.mediaType ?? 'image'}
      data-gallery-main-trigger
    >
      <img
        data-gallery-main-img
        alt={hero?.alt ?? ''}
        class:list={[
          'w-full h-full object-cover transition group-hover:scale-[1.01]',
          heroIsVideo ? 'hidden' : '',
        ]}
        src={heroImgSrc}
        srcset={heroImgSrcSet || undefined}
        sizes="(max-width: 767px) 100vw, 640px"
        width="1280"
        height="720"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
      <video
        data-gallery-main-video
        src={heroIsVideo ? hero?.full : undefined}
        class:list={['w-full h-full object-cover pointer-events-none', heroIsVideo ? '' : 'hidden']}
        muted
        playsinline
        preload="metadata"
        aria-hidden="true"
      />
      <span
        data-gallery-play-overlay
        class:list={[
          'absolute inset-0 flex items-center justify-center bg-black/25 group-hover:bg-black/35 transition-colors pointer-events-none',
          heroIsVideo ? '' : 'hidden',
        ]}
      >
        <span class="material-symbols-outlined text-white text-6xl drop-shadow-lg">play_circle</span>
      </span>
      <span
        data-gallery-action-hint
        class="absolute bottom-3 right-3 inline-flex items-center gap-1 px-2 py-1 rounded-md bg-black/50 text-white text-[11px] font-semibold opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none"
      >
        <span data-gallery-action-icon class="material-symbols-outlined text-[14px]">
          {heroIsVideo ? 'play_arrow' : 'zoom_in'}
        </span>
        <span data-gallery-action-label>{heroIsVideo ? 'Play' : 'Enlarge'}</span>
      </span>
    </button>
    <VideoReviewLightbox product={product} />
  </div>

  <div class="relative">
    <div class="flex overflow-x-auto gap-2 pb-1 no-scrollbar" data-thumb-track>
      {
        images.map((image, i) => {
          const isVideo = (image.mediaType ?? 'image') === 'video';
          return (
            <button
              type="button"
              data-thumb
              data-full={image.full}
              data-alt={image.alt}
              data-media-type={image.mediaType ?? 'image'}
              aria-current={image.full === hero?.full ? 'true' : 'false'}
              aria-label={`Show ${isVideo ? 'video' : 'image'} ${i + 1}`}
              class="thumb relative flex-none w-24 h-16 sm:w-28 sm:h-18 rounded-lg overflow-hidden"
            >
              {
                isVideo ? (
                  <>
                    <video
                      src={image.thumb}
                      class="w-full h-full object-cover pointer-events-none"
                      muted
                      playsinline
                      preload="metadata"
                      aria-hidden="true"
                    />
                    <span class="absolute inset-0 flex items-center justify-center bg-black/30 pointer-events-none">
                      <span class="material-symbols-outlined text-white text-xl drop-shadow">play_circle</span>
                    </span>
                  </>
                ) : (
                  <img
                    alt={image.alt}
                    class="w-full h-full object-cover"
                    src={optimizedImageUrl(image.thumb, { width: 160, quality: 70 })}
                    width="112"
                    height="72"
                    loading="lazy"
                    decoding="async"
                  />
                )
              }
            </button>
          );
        })
      }
    </div>
  </div>
</div>

<style>
  .thumb {
    border: 1px solid var(--color-surface-variant);
    transition: border-color 0.15s ease;
  }
  .thumb[aria-current='true'] {
    border: 2px solid var(--color-primary-container);
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((root) => {
    if (root.dataset.bound === 'true') return;
    root.dataset.bound = 'true';

    const mainImg = root.querySelector<HTMLImageElement>('[data-gallery-main-img]');
    const mainVideo = root.querySelector<HTMLVideoElement>('[data-gallery-main-video]');
    const playOverlay = root.querySelector<HTMLElement>('[data-gallery-play-overlay]');
    const actionIcon = root.querySelector<HTMLElement>('[data-gallery-action-icon]');
    const actionLabel = root.querySelector<HTMLElement>('[data-gallery-action-label]');
    const mainTrigger = root.querySelector<HTMLButtonElement>('[data-gallery-main-trigger]');
    const thumbs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-thumb]'));

    function setMain(full: string, alt: string, mediaType: string) {
      const isVideo = mediaType === 'video';
      if (mainImg) {
        if (isVideo) {
          mainImg.classList.add('hidden');
          mainImg.removeAttribute('src');
        } else {
          mainImg.classList.remove('hidden');
          mainImg.src = full;
          mainImg.alt = alt;
        }
      }
      if (mainVideo) {
        if (isVideo) {
          mainVideo.classList.remove('hidden');
          mainVideo.src = full;
          mainVideo.setAttribute('aria-label', alt || 'Gallery video');
        } else {
          mainVideo.pause();
          mainVideo.classList.add('hidden');
          mainVideo.removeAttribute('src');
        }
      }
      playOverlay?.classList.toggle('hidden', !isVideo);
      if (actionIcon) actionIcon.textContent = isVideo ? 'play_arrow' : 'zoom_in';
      if (actionLabel) actionLabel.textContent = isVideo ? 'Play' : 'Enlarge';
      if (mainTrigger) {
        mainTrigger.disabled = false;
        mainTrigger.classList.add('cursor-zoom-in');
        mainTrigger.classList.remove('cursor-default');
        mainTrigger.dataset.lightboxOpen = full;
        mainTrigger.dataset.lightboxAlt = alt;
        mainTrigger.dataset.lightboxType = mediaType;
      }

    }

    thumbs.forEach((thumb) => {
      thumb.addEventListener('click', () => {
        const full = thumb.dataset.full ?? '';
        const alt = thumb.dataset.alt ?? '';
        const mediaType = thumb.dataset.mediaType ?? 'image';
        setMain(full, alt, mediaType);
        thumbs.forEach((t) => t.setAttribute('aria-current', 'false'));
        thumb.setAttribute('aria-current', 'true');
      });
    });

  });
</script>
