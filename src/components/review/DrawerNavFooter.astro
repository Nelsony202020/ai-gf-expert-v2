---
interface Props {
  prevDrawerId?: string;
  prevLabel?: string;
  nextDrawerId?: string;
  nextLabel?: string;
}

const { prevDrawerId, prevLabel, nextDrawerId, nextLabel } = Astro.props;
const hasPrev = Boolean(prevLabel);
const hasNext = Boolean(nextDrawerId && nextLabel);
---

{
  (hasPrev || hasNext) && (
    <footer
      class:list={[
        'rdv-foot',
        {
          'rdv-foot--both': hasPrev && hasNext,
          'rdv-foot--prev-only': hasPrev && !hasNext,
        },
      ]}
    >
      {hasPrev &&
        (prevDrawerId ? (
          <button
            type="button"
            class="rdv-foot__back"
            data-ratings-open-drawer={prevDrawerId}
            data-ratings-drawer-nav="back"
          >
            ← Back: {prevLabel}
          </button>
        ) : (
          <button type="button" class="rdv-foot__back" data-ratings-close-drawer>
            ← Back: {prevLabel}
          </button>
        ))}
      <span class="rdv-foot__spacer" aria-hidden="true"></span>
      {hasNext && (
        <button
          type="button"
          class="rdv-foot__next"
          data-ratings-open-drawer={nextDrawerId}
          data-ratings-drawer-nav="next"
        >
          Next: {nextLabel} →
        </button>
      )}
    </footer>
  )
}
