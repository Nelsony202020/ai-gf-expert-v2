---
import AffiliateLink from '../ui/AffiliateLink.astro';

export type Tab = { id: string; label: string; tocLabel?: string };

interface Props {
  tabs: Tab[];
  hiddenTabs?: Tab[];
  /** Product whose affiliate CTA rides along in the sticky state. */
  ctaLabel?: string;
  ctaShortLabel?: string;
  ctaHref?: string;
}

const { tabs, hiddenTabs = [], ctaLabel, ctaShortLabel, ctaHref } = Astro.props;
const showCta = Boolean(ctaHref && ctaLabel);
---

{/* Sentinel: sits in flow directly above the bar so we can tell when the bar
    has actually stuck, without listening to scroll. */}
<div data-tabbar-sentinel aria-hidden="true"></div>

<nav
  class="review-tabbar z-40"
  data-tabbar
  data-tabbar-has-cta={showCta ? 'true' : 'false'}
  aria-label="Review sections"
>
  <div class="review-tabbar__shell section-container px-4 md:px-8">
    <div class="review-tabbar__rail" data-tabbar-rail>
      <div class="review-tabbar__fade review-tabbar__fade--start" data-tabbar-fade="start" aria-hidden="true"></div>
      <ul class="review-tabbar__list" role="tablist" data-tabbar-list>
        {
          tabs.map((tab, i) => (
            <li role="presentation" class="review-tabbar__item">
              <button
                type="button"
                role="tab"
                class="review-tabbar__btn"
                data-tab={tab.id}
                aria-current={i === 0 ? 'true' : 'false'}
                aria-selected={i === 0 ? 'true' : 'false'}
              >
                {tab.label}
              </button>
            </li>
          ))
        }
        {
          hiddenTabs.map((tab) => (
            <li role="presentation" class="review-tabbar__item" hidden>
              <button
                type="button"
                role="tab"
                class="review-tabbar__btn"
                data-tab={tab.id}
                aria-selected="false"
                hidden
              >
                {tab.tocLabel ?? tab.label}
              </button>
            </li>
          ))
        }
      </ul>
      {/* Rendered here rather than created in JS so the scoped styles below
          actually apply to it. */}
      <div class="review-tabbar__indicator" data-tab-indicator aria-hidden="true"></div>
      <div class="review-tabbar__fade review-tabbar__fade--end" data-tabbar-fade="end" aria-hidden="true"></div>
    </div>

    {
      showCta && (
        <div class="review-tabbar__cta" data-tabbar-cta aria-hidden="true">
          <span class="review-tabbar__cta-divider" aria-hidden="true" />
          <AffiliateLink href={ctaHref!} class="review-tabbar__cta-btn" data-cta="tabbar-visit" tabindex="-1">
            <span class="review-tabbar__cta-label">{ctaLabel}</span>
            <span class="review-tabbar__cta-label review-tabbar__cta-label--short">
              {ctaShortLabel ?? 'Visit'}
            </span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path
                d="M7 17 17 7M9 7h8v8"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </AffiliateLink>
        </div>
      )
    }
  </div>
</nav>

<script>
  import { initReviewTabIndicator } from '../../lib/review/reviewTabUi.client.ts';

  function initReviewTabbarChrome() {
    const tabbar = document.querySelector<HTMLElement>('[data-tabbar].review-tabbar');
    if (!tabbar) return;
    initReviewTabIndicator(tabbar);
  }

  /**
   * Sticky state. The bar is `position: sticky` and therefore never moves the
   * page; all we do is notice when it has reached its offset so the affiliate
   * CTA can fade in. A sentinel + IntersectionObserver does that without a
   * scroll listener, so there is nothing to jitter.
   */
  function initReviewTabbarSticky() {
    const tabbar = document.querySelector<HTMLElement>('[data-tabbar].review-tabbar');
    const sentinel = document.querySelector<HTMLElement>('[data-tabbar-sentinel]');
    if (!tabbar || !sentinel || tabbar.dataset.stickyBound === 'true') return;
    tabbar.dataset.stickyBound = 'true';

    const cta = tabbar.querySelector<HTMLElement>('[data-tabbar-cta]');
    const ctaLink = cta?.querySelector<HTMLAnchorElement>('a');

    const setStuck = (stuck: boolean) => {
      if ((tabbar.dataset.stuck === 'true') === stuck) return;
      tabbar.dataset.stuck = stuck ? 'true' : 'false';
      document.body.classList.toggle('review-tabbar-stuck', stuck);
      if (cta) {
        cta.setAttribute('aria-hidden', stuck ? 'false' : 'true');
        // Keep the CTA out of the tab order until it is actually on screen.
        if (ctaLink) ctaLink.tabIndex = stuck ? 0 : -1;
      }
    };

    let observer: IntersectionObserver | null = null;

    const observe = () => {
      observer?.disconnect();
      const offset = Math.round(
        parseFloat(
          getComputedStyle(document.documentElement).getPropertyValue('--site-header-offset'),
        ) || 0,
      );
      observer = new IntersectionObserver(
        ([entry]) => setStuck(!entry?.isIntersecting),
        { rootMargin: `-${offset + 1}px 0px 0px 0px`, threshold: 0 },
      );
      observer.observe(sentinel);
    };

    observe();
    window.addEventListener('resize', observe, { passive: true });
  }

  function initReviewTabbarFades() {
    const tabbar = document.querySelector('[data-tabbar].review-tabbar');
    if (!tabbar || tabbar.dataset.fadeBound === 'true') return;
    tabbar.dataset.fadeBound = 'true';

    const list = tabbar.querySelector('[data-tabbar-list]');
    const fadeStart = tabbar.querySelector('[data-tabbar-fade="start"]');
    const fadeEnd = tabbar.querySelector('[data-tabbar-fade="end"]');

    function updateFades() {
      if (!list || !fadeStart || !fadeEnd) return;
      const maxScroll = list.scrollWidth - list.clientWidth;
      if (maxScroll <= 2) {
        fadeStart.classList.remove('is-visible');
        fadeEnd.classList.remove('is-visible');
        return;
      }
      fadeStart.classList.toggle('is-visible', list.scrollLeft > 4);
      fadeEnd.classList.toggle('is-visible', list.scrollLeft < maxScroll - 4);
    }

    function scrollActiveTabIntoView(smooth = true) {
      if (!list) return;
      const activeBtn = tabbar.querySelector('.review-tabbar__btn[aria-current="true"]');
      if (!activeBtn) return;
      const listRect = list.getBoundingClientRect();
      const btnRect = activeBtn.getBoundingClientRect();
      const offset = btnRect.left - listRect.left - (listRect.width - btnRect.width) / 2;
      list.scrollTo({
        left: Math.max(0, list.scrollLeft + offset),
        behavior: smooth ? 'smooth' : 'auto',
      });
      window.requestAnimationFrame(updateFades);
    }

    list?.addEventListener('scroll', updateFades, { passive: true });

    const observer = new MutationObserver(() => {
      scrollActiveTabIntoView(true);
      updateFades();
    });
    tabbar.querySelectorAll('.review-tabbar__btn').forEach((btn) => {
      observer.observe(btn, { attributes: true, attributeFilter: ['aria-current'] });
    });

    window.addEventListener('resize', updateFades, { passive: true });
    updateFades();
    scrollActiveTabIntoView(false);
  }

  initReviewTabbarChrome();
  initReviewTabbarSticky();
  initReviewTabbarFades();
  document.addEventListener('astro:page-load', () => {
    initReviewTabbarChrome();
    initReviewTabbarSticky();
    initReviewTabbarFades();
  });
</script>

<style>
  /* Figma — Review / Tab Bar (196:1023).
     Desktop: 56 tall, tabs left on the review container, 32px gap, compact
     Visit CTA right. Mobile: 56 tall, scrollable tab viewport with edge fade,
     divider, then a pinned compact Visit pill. */

  .review-tabbar__shell {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .review-tabbar__rail {
    --review-tabbar-fade-bg: var(--rs-canvas, var(--color-background));
    position: relative;
    flex: 1 1 auto;
    min-width: 0;
    min-height: 56px;
  }

  .review-tabbar__list {
    display: flex;
    align-items: stretch;
    gap: 2rem;
    width: 100%;
    min-height: 56px;
    margin: 0;
    padding: 0;
    list-style: none;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .review-tabbar__list::-webkit-scrollbar {
    display: none;
  }

  .review-tabbar__item {
    flex: 0 0 auto;
    display: flex;
    scroll-snap-align: center;
  }

  .review-tabbar__btn {
    appearance: none;
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 56px;
    margin: 0;
    padding: 0 2px;
    border: 0;
    background: transparent;
    color: var(--rs-muted, #55545b);
    font: inherit;
    font-size: 16px;
    font-weight: 600;
    line-height: 24px;
    letter-spacing: -0.048px;
    white-space: nowrap;
    cursor: pointer;
    transition: color 0.15s ease;
  }

  .review-tabbar__btn:hover {
    color: var(--rs-ink, var(--color-on-surface));
  }

  .review-tabbar__btn:focus-visible {
    outline: 2px solid var(--rs-pink, var(--color-accent));
    outline-offset: -2px;
    border-radius: 4px;
  }

  .review-tabbar__btn[aria-current='true'] {
    color: var(--rs-ink, var(--color-on-surface));
  }

  /* Brand-pink active underline — Figma Review / Tab active indicator. */
  .review-tabbar__indicator {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 0;
    height: 2px;
    border-radius: 1px;
    background: var(--rs-pink, var(--color-accent));
    pointer-events: none;
    z-index: 3;
    will-change: transform, width;
    transition:
      transform 200ms ease-out,
      width 200ms ease-out,
      opacity 120ms ease-out;
  }

  @media (prefers-reduced-motion: reduce) {
    .review-tabbar__indicator {
      transition: none;
    }
  }

  /* Affiliate CTA — only once the bar has stuck under the global header. */
  .review-tabbar__cta {
    display: flex;
    align-items: center;
    gap: 12px;
    flex: 0 0 auto;
    opacity: 0;
    transform: translateX(8px);
    pointer-events: none;
    visibility: hidden;
    transition:
      opacity 180ms ease-out,
      transform 180ms ease-out,
      visibility 0s linear 180ms;
  }

  [data-tabbar][data-stuck='true'] .review-tabbar__cta {
    opacity: 1;
    transform: translateX(0);
    pointer-events: auto;
    visibility: visible;
    transition:
      opacity 180ms ease-out,
      transform 180ms ease-out,
      visibility 0s;
  }

  @media (prefers-reduced-motion: reduce) {
    .review-tabbar__cta {
      transition: opacity 120ms linear;
      transform: none;
    }

    [data-tabbar][data-stuck='true'] .review-tabbar__cta {
      transform: none;
    }
  }

  .review-tabbar__cta-divider {
    display: none;
    width: 1px;
    height: 24px;
    background: var(--rs-line, #e6e6e3);
  }

  .review-tabbar__cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    height: 40px;
    padding: 0 18px;
    border-radius: 999px;
    background: var(--rs-pink, var(--color-accent));
    color: #f7f7f6;
    font-size: 14px;
    font-weight: 600;
    line-height: 18px;
    letter-spacing: -0.14px;
    white-space: nowrap;
    text-decoration: none;
    transition: background-color 0.15s ease;
  }

  .review-tabbar__cta-btn:hover {
    background: var(--rs-pink-deep, #be185d);
  }

  .review-tabbar__cta-btn:focus-visible {
    outline: 2px solid var(--rs-pink, var(--color-accent));
    outline-offset: 2px;
  }

  .review-tabbar__cta-btn svg {
    flex-shrink: 0;
  }

  .review-tabbar__cta-label--short {
    display: none;
  }

  .review-tabbar__fade {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 1.75rem;
    z-index: 2;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.18s ease;
  }

  .review-tabbar__fade.is-visible {
    opacity: 1;
  }

  .review-tabbar__fade--start {
    left: 0;
    background: linear-gradient(to right, var(--review-tabbar-fade-bg) 30%, transparent);
  }

  .review-tabbar__fade--end {
    right: 0;
    background: linear-gradient(to left, var(--review-tabbar-fade-bg) 30%, transparent);
  }

  @media (min-width: 768px) {
    .review-tabbar__list {
      justify-content: flex-start;
      overflow: visible;
    }

    .review-tabbar__fade {
      display: none;
    }
  }

  @media (max-width: 767px) {
    .review-tabbar__shell {
      padding-left: 0;
      padding-right: 1rem;
      max-width: none;
      gap: 0;
    }

    .review-tabbar__rail,
    .review-tabbar__list {
      min-height: 56px;
    }

    .review-tabbar__list {
      gap: 1.5rem;
      padding-inline: 1rem;
    }

    .review-tabbar__btn {
      height: 56px;
      font-size: 15px;
    }

    .review-tabbar__fade {
      width: 2rem;
    }

    /* The mobile CTA is pinned beside the scrolling tab viewport (Figma 226:1384). */
    .review-tabbar__cta {
      gap: 12px;
      padding-left: 0;
    }

    .review-tabbar__cta-divider {
      display: block;
    }

    .review-tabbar__cta-label {
      display: none;
    }

    .review-tabbar__cta-label--short {
      display: inline;
    }

    .review-tabbar__cta-btn {
      padding: 0 16px;
    }
  }
</style>
