---
export type Tab = { id: string; label: string; tocLabel?: string };

interface Props {
  tabs: Tab[];
  hiddenTabs?: Tab[];
}

const { tabs, hiddenTabs = [] } = Astro.props;
---

<nav class="review-tabbar" data-tabbar aria-label="Review sections">
  <button
    type="button"
    class="review-tabbar__arrow"
    data-tabbar-arrow="prev"
    aria-label="Show previous tabs"
    hidden
  >
    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
      <path d="M10 3L5 8l5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
    </svg>
  </button>
  <div class="review-tabbar__fade review-tabbar__fade--start" data-tabbar-fade="start" hidden></div>
  <div class="review-tabbar__rail" data-tabbar-rail>
    <div class="review-tabbar__list" data-tabbar-list>
      {tabs.map((tab, i) => (
        <button
          type="button"
          class="review-tabbar__btn"
          data-tab={tab.id}
          aria-current={i === 0 ? 'true' : undefined}
          aria-selected={i === 0 ? 'true' : 'false'}
        >
          {tab.label}
        </button>
      ))}
      {hiddenTabs.map((tab) => (
        <button
          type="button"
          class="review-tabbar__btn"
          data-tab={tab.id}
          aria-selected="false"
          hidden
        >
          {tab.tocLabel ?? tab.label}
        </button>
      ))}
    </div>
  </div>
  <div class="review-tabbar__fade review-tabbar__fade--end" data-tabbar-fade="end" hidden></div>
  <button
    type="button"
    class="review-tabbar__arrow"
    data-tabbar-arrow="next"
    aria-label="Show next tabs"
    hidden
  >
    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
      <path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
    </svg>
  </button>
</nav>
