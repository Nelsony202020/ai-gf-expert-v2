---
import { getScoreChipClass, fmtScore } from '../../lib/scores';

interface Props {
  score: number | null;
  size?: 'xs' | 'sm' | 'md' | 'lg';
  variant?: 'solid' | 'outline';
  class?: string;
}

const { score, size = 'md', variant = 'solid', class: className = '' } = Astro.props;
const chip = getScoreChipClass(score);

const sizeClass =
  size === 'xs'
    ? 'rt-score-chip--xs'
    : size === 'md'
      ? 'rt-score-chip--md'
      : size === 'lg'
        ? 'rt-score-chip--lg'
        : '';
const variantClass = variant === 'outline' ? 'rt-score-chip--outline' : '';
---

<span class={`rt-score-chip ${variantClass} ${sizeClass} ${chip} ${className}`.trim()}>{fmtScore(score)}</span>
