---
import { tooltipCategoryIconsByKey } from '../../../lib/tooltip-category-icons-cdn';

const categoryIcons = tooltipCategoryIconsByKey;
---

<div id="glossary-tooltip-portal" class="glossary-tooltip-portal" aria-live="polite"></div>

<script define:vars={{ categoryIcons }}>
  let activePanel = null;
  let activeTrigger = null;
  let activeBackdrop = null;
  let hideTimer = null;

  function prefersReducedMotion() {
    return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  }

  function isMobileViewport() {
    return window.innerWidth < 768;
  }

  function cancelHide() {
    if (hideTimer) {
      clearTimeout(hideTimer);
      hideTimer = null;
    }
  }

  function hidePanel() {
    cancelHide();
    if (activeTrigger) activeTrigger.setAttribute('aria-expanded', 'false');
    activeBackdrop?.remove();
    activeBackdrop = null;
    if (activePanel) {
      activePanel.remove();
      activePanel = null;
    }
    activeTrigger = null;
    document.body.classList.remove('mobile-sheet-open');
  }

  function scheduleHide() {
    cancelHide();
    hideTimer = setTimeout(hidePanel, 140);
  }

  function escapeHtml(value) {
    return String(value ?? '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function iconForCategory(raw) {
    const key = String(raw || 'General')
      .trim()
      .toLowerCase()
      .replace(/[_/]+/g, '-')
      .replace(/\s+/g, '-');
    const aliases = {
      general: 'general',
      characters: 'characters',
      customization: 'customization',
      chat: 'chat',
      'chat-features': 'chat-features',
      images: 'images',
      video: 'video',
      videos: 'video',
      privacy: 'privacy',
      pricing: 'pricing',
    };
    const resolved = aliases[key] || 'general';
    return categoryIcons[resolved] || categoryIcons.general;
  }

  function positionPanel(trigger, panel) {
    const rect = trigger.getBoundingClientRect();
    const margin = 16;
    const gap = 10;
    const viewportW = window.innerWidth;
    const viewportH = window.innerHeight;
    const mobile = isMobileViewport();

    panel.classList.toggle('glossary-tooltip--mobile', mobile);

    const width = mobile
      ? Math.min(420, viewportW - 32)
      : Math.min(340, viewportW - margin * 2);
    panel.style.width = `${width}px`;
    panel.style.visibility = 'hidden';
    panel.style.display = 'block';
    // Extra top clearance so border badge isn't clipped when measuring.
    const height = panel.offsetHeight || 140;
    panel.style.visibility = '';

    if (mobile) {
      const left = Math.max(16, (viewportW - width) / 2);
      // Prefer below the word; otherwise center in viewport.
      let top = rect.bottom + gap + 12;
      if (top + height + margin > viewportH) {
        top = Math.max(margin + 20, (viewportH - height) / 2);
      }
      top = Math.max(margin + 20, Math.min(top, viewportH - height - margin));
      panel.style.position = 'fixed';
      panel.style.top = `${Math.round(top)}px`;
      panel.style.left = `${Math.round(left)}px`;
      panel.dataset.placement = 'mobile';
      return;
    }

    let top = rect.bottom + gap;
    let placeAbove = false;
    if (top + height + margin > viewportH && rect.top - gap - height > margin) {
      top = rect.top - gap - height;
      placeAbove = true;
    }
    top = Math.max(margin, Math.min(top, viewportH - height - margin));

    let left = rect.left + rect.width / 2 - width / 2;
    left = Math.max(margin, Math.min(left, viewportW - width - margin));

    panel.style.position = 'fixed';
    panel.style.top = `${Math.round(top)}px`;
    panel.style.left = `${Math.round(left)}px`;
    panel.dataset.placement = placeAbove ? 'above' : 'below';
  }

  function withCtaArrow(label) {
    const text = String(label || '').trim() || 'Learn more';
    if (/→\s*$/.test(text) || /->\s*$/.test(text)) return text.replace(/->\s*$/, '→');
    return `${text} →`;
  }

  function buildPanel(trigger) {
    const term = escapeHtml(trigger.dataset.glossaryTerm || 'Term');
    const definition = escapeHtml(trigger.dataset.glossaryDefinition || '');
    const anchor = encodeURIComponent(trigger.dataset.glossaryAnchor || '');
    const cta = escapeHtml(withCtaArrow(trigger.dataset.glossaryCta || 'Learn more'));
    const alsoCalled = String(trigger.dataset.glossaryAlsoCalled || '').trim();
    const iconSrc = escapeHtml(iconForCategory(trigger.dataset.glossaryCategory));
    const alsoHtml = alsoCalled
      ? `<p class="glossary-tooltip__also">Other names: ${escapeHtml(alsoCalled)}</p>`
      : '';
    const panel = document.createElement('div');
    panel.className = 'glossary-tooltip';
    panel.setAttribute('role', 'dialog');
    panel.setAttribute('aria-label', `${trigger.dataset.glossaryTerm || 'Term'} definition`);
    panel.innerHTML =
      `<div class="glossary-tooltip__badge" aria-hidden="true">` +
      `<div class="glossary-tooltip__badge-clip">` +
      `<img src="${iconSrc}" alt="" width="40" height="40" loading="lazy" decoding="async" />` +
      `</div>` +
      `</div>` +
      `<button type="button" class="glossary-tooltip__close" data-glossary-close aria-label="Close">` +
      `<span class="material-symbols-outlined" aria-hidden="true">close</span>` +
      `</button>` +
      `<div class="glossary-tooltip__body">` +
      `<p class="glossary-tooltip__eyebrow">Glossary term</p>` +
      `<p class="glossary-tooltip__term">${term}</p>` +
      alsoHtml +
      `<p class="glossary-tooltip__def">${definition}</p>` +
      `<a class="glossary-tooltip__link" href="/glossary/#${anchor}">${cta}</a>` +
      `</div>`;
    return panel;
  }

  function showPanel(trigger) {
    cancelHide();
    if (activeTrigger === trigger && activePanel) {
      positionPanel(trigger, activePanel);
      return;
    }
    hidePanel();
    const portal = document.getElementById('glossary-tooltip-portal');
    if (!portal) return;

    const panel = buildPanel(trigger);
    portal.appendChild(panel);
    if (isMobileViewport()) {
      const backdrop = document.createElement('div');
      backdrop.className = 'glossary-tooltip-backdrop';
      backdrop.addEventListener('click', hidePanel);
      document.body.appendChild(backdrop);
      activeBackdrop = backdrop;
      document.body.classList.add('mobile-sheet-open');
    }

    panel.querySelector('[data-glossary-close]')?.addEventListener('click', (event) => {
      event.preventDefault();
      event.stopPropagation();
      hidePanel();
    });

    positionPanel(trigger, panel);
    activePanel = panel;
    activeTrigger = trigger;
    trigger.setAttribute('aria-expanded', 'true');

    requestAnimationFrame(() => {
      panel.classList.add('is-open');
      if (prefersReducedMotion()) {
        panel.style.transition = 'none';
      }
    });

    if (!isMobileViewport()) {
      panel.addEventListener('mouseenter', cancelHide);
      panel.addEventListener('mouseleave', scheduleHide);
    }
  }

  function onTriggerEnter(event) {
    const trigger = event.currentTarget;
    if (!(trigger instanceof HTMLElement)) return;
    if (isMobileViewport()) return;
    showPanel(trigger);
  }

  function onTriggerLeave() {
    if (isMobileViewport()) return;
    scheduleHide();
  }

  function onTriggerActivate(event) {
    const trigger = event.currentTarget;
    if (!(trigger instanceof HTMLElement)) return;
    event.preventDefault();
    if (activeTrigger === trigger && activePanel) {
      hidePanel();
      return;
    }
    showPanel(trigger);
  }

  function bindTrigger(trigger) {
    if (trigger.dataset.glossaryBound === 'true') return;
    trigger.dataset.glossaryBound = 'true';
    trigger.addEventListener('mouseenter', onTriggerEnter);
    trigger.addEventListener('mouseleave', onTriggerLeave);
    trigger.addEventListener('focus', onTriggerEnter);
    trigger.addEventListener('blur', onTriggerLeave);
    trigger.addEventListener('click', onTriggerActivate);
  }

  function initGlossaryTooltips() {
    const root = document.querySelector('[data-review-article]');
    if (!root) return;
    for (const trigger of root.querySelectorAll('[data-glossary-trigger]')) {
      if (trigger instanceof HTMLElement) bindTrigger(trigger);
    }

    if (document.body.dataset.glossaryTooltipGlobalBound !== 'true') {
      document.body.dataset.glossaryTooltipGlobalBound = 'true';
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') hidePanel();
      });
      document.addEventListener(
        'pointerdown',
        (event) => {
          const target = event.target;
          if (!(target instanceof Node)) return;
          if (activePanel?.contains(target)) return;
          if (activeTrigger?.contains(target)) return;
          if (activePanel) hidePanel();
        },
        true,
      );
      window.addEventListener(
        'scroll',
        () => {
          if (activePanel) hidePanel();
        },
        { passive: true, capture: true },
      );
      window.addEventListener('resize', () => {
        if (activePanel) hidePanel();
      });
    }
  }

  initGlossaryTooltips();
  document.addEventListener('astro:page-load', initGlossaryTooltips);
</script>
