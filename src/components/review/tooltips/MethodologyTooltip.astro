---
interface Props {
  id: string;
}

const { id } = Astro.props;
---

<span
  role="button"
  tabindex="0"
  class="rt-tooltip-trigger inline-flex cursor-help shrink-0"
  data-ratings-tooltip-trigger={id}
  aria-label="About our rating methodology"
>
  <slot />
</span>

<template id={`tooltip-${id}`}>
  <div class="ratings-tooltip-panel ratings-tooltip-panel--methodology">
    <div class="ratings-tooltip-panel__header">
      <p class="ratings-tooltip-panel__section-title">How we score apps</p>
      <p class="ratings-tooltip-panel__desc">
        We run real tests, turn the results into numbers, and roll those up step by step until we get one overall score.
      </p>
    </div>
    <div class="ratings-tooltip-panel__body">
      <div class="rt-method-rail" aria-label="Scoring process">
        <div class="rt-method-rail__step">
          <div class="rt-method-rail__track" aria-hidden="true">
            <span class="rt-method-rail__node">1</span>
            <span class="rt-method-rail__line"></span>
          </div>
          <div class="rt-method-rail__copy">
            <strong>Evidence</strong>
            <span>Individual things we measure</span>
          </div>
        </div>
        <div class="rt-method-rail__step">
          <div class="rt-method-rail__track" aria-hidden="true">
            <span class="rt-method-rail__node">2</span>
            <span class="rt-method-rail__line"></span>
          </div>
          <div class="rt-method-rail__copy">
            <strong>Subscores</strong>
            <span>Evidence grouped into focused areas like Variety and Quality</span>
          </div>
        </div>
        <div class="rt-method-rail__step">
          <div class="rt-method-rail__track" aria-hidden="true">
            <span class="rt-method-rail__node">3</span>
            <span class="rt-method-rail__line"></span>
          </div>
          <div class="rt-method-rail__copy">
            <strong>Categories</strong>
            <span>Subscores combined into larger areas like Chat and Characters</span>
          </div>
        </div>
        <div class="rt-method-rail__step rt-method-rail__step--final">
          <div class="rt-method-rail__track" aria-hidden="true">
            <span class="rt-method-rail__node">★</span>
          </div>
          <div class="rt-method-rail__copy">
            <strong>Overall score</strong>
            <span>Weighted mix of all categories. Good starts at <strong>7.0</strong>.</span>
          </div>
        </div>
      </div>

      <div class="rt-method-evolution-divider" aria-hidden="true"></div>

      <div class="rt-method-evolution">
        <p class="rt-method-evolution__title">Methodology evolution</p>
        <div class="rt-method-evolution__list">
          <div class="rt-method-evolution__row">
            <span class="rt-method-evolution__ver">V1</span>
            <div class="rt-method-evolution__copy">
              <strong>User survey</strong>
              <span>Asked real users what mattered most — conversation, privacy, NSFW and customization.</span>
            </div>
          </div>
          <div class="rt-method-evolution__row">
            <span class="rt-method-evolution__ver">V2</span>
            <div class="rt-method-evolution__copy">
              <strong>Hands-on testing</strong>
              <span>Structured checklists and expert scores rolled into our review ratings.</span>
            </div>
          </div>
          <div class="rt-method-evolution__row rt-method-evolution__row--current">
            <span class="rt-method-evolution__ver rt-method-evolution__ver--current">V3</span>
            <div class="rt-method-evolution__copy">
              <div class="rt-method-evolution__head">
                <strong>Quantitative</strong>
                <span class="rt-method-evolution__current">Current</span>
              </div>
              <span>Measured evidence, transparent weights and repeatable tests — you can see exactly what we measured.</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</template>
