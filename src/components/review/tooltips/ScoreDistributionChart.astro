---
import type { ScoreBin } from '../../../lib/score-distribution';
import { activeBinIndex, distBarFillRatio } from '../../../lib/score-distribution';
import { reviewRatingsSectionUrl } from '../../../lib/slugs';
import { fmtScore, getScoreVisual } from '../../../lib/scores';

interface Props {
  bins: ScoreBin[];
  /** -1 = nothing selected by default (bar click) */
  activeBinIndex?: number;
  /** Highlight the bin this product score falls into (subtle marker arrow). */
  highlightScore?: number | null;
  /** Category context for cross-app distribution links */
  categoryKey?: string;
  /** Subscore context — slugified in data attributes for client chart updates */
  subscoreName?: string;
}

const { bins, activeBinIndex: selectedBinIndex = -1, highlightScore, categoryKey, subscoreName } =
  Astro.props;
const maxCount = Math.max(1, ...bins.map((b) => b.apps.length));
const highlightBinIndex = activeBinIndex(bins, highlightScore);
const hasSelection = selectedBinIndex >= 0;
const activeBin = hasSelection ? bins[selectedBinIndex] : null;
const distLinkCategory = categoryKey ?? '';
const distLinkSubscore = subscoreName?.trim()
  ? subscoreName.trim().toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '')
  : '';
---

<div
  class="rt-dist-chart"
  data-dist-chart
  data-dist-bins={JSON.stringify(bins)}
  data-dist-active={selectedBinIndex}
  data-dist-highlight={highlightBinIndex}
  data-dist-link-category={distLinkCategory}
  data-dist-link-subscore={distLinkSubscore}
>
  <div class="rt-dist-chart__plot">
    <div class="rt-dist-chart__axis">
      <span class="tabular-nums">{bins[0]?.start.toFixed(1)}</span>
      <span class="tabular-nums">{bins[bins.length - 1]?.end.toFixed(1)}</span>
    </div>

    <div class="rt-dist-chart__bars" role="list">
      {
        bins.map((b, i) => {
          const count = b.apps.length;
          const ratio = distBarFillRatio(count, maxCount);
          const v = getScoreVisual((b.start + b.end) / 2);
          const isActive = hasSelection && i === selectedBinIndex;
          const isHighlighted = highlightBinIndex >= 0 && i === highlightBinIndex;
          return (
            <button
              type="button"
              class:list={['rt-dist-chart__bar', isHighlighted && 'rt-dist-chart__bar--highlighted']}
              data-dist-bin={i}
              aria-label={`${b.start.toFixed(1)}–${b.end.toFixed(1)} (${count})`}
              aria-pressed={isActive ? 'true' : 'false'}
            >
              <span class="rt-dist-chart__bar-stack">
                <span
                  class:list={[
                    'rt-dist-chart__bar-fill',
                    v.bg,
                    count === 0 && 'rt-dist-chart__bar-fill--empty',
                    isActive && 'rt-dist-chart__bar-fill--active',
                  ]}
                  style={count > 0 ? `--dist-bar-ratio:${ratio}` : undefined}
                />
              </span>
            </button>
          );
        })
      }
    </div>

    <div class="rt-dist-chart__baseline">
      <div class="rt-dist-chart__gradient" aria-hidden="true"></div>
      <div class="rt-dist-chart__markers" aria-hidden="true">
        {
          bins.map((b, i) => {
            const isHighlighted = highlightBinIndex >= 0 && i === highlightBinIndex;
            return (
              <span class="rt-dist-chart__marker-slot">
                {isHighlighted && <span class="rt-dist-chart__marker" />}
              </span>
            );
          })
        }
      </div>
    </div>
  </div>

  <div class="rt-dist-chart__footer">
    {
      hasSelection && activeBin ? (
        <>
          <p class="rt-dist-chart__range-label">
            Selected range:{' '}
            <span data-dist-range-label class="tabular-nums">
              {activeBin.start.toFixed(1)}–{activeBin.end.toFixed(1)}
            </span>
          </p>
          <div class="rt-dist-chart__apps" data-dist-apps>
            {
              activeBin.apps.length ? (
                activeBin.apps.map((app) => {
                  const chip = getScoreVisual(app.score);
                  const chipClass =
                    chip.band === 'good'
                      ? 'rt-score-chip--good'
                      : chip.band === 'fair'
                        ? 'rt-score-chip--fair'
                        : 'rt-score-chip--poor';
                  return (
                    <a
                      href={reviewRatingsSectionUrl(app.slug, categoryKey, subscoreName)}
                      class="rt-dist-chart__app"
                    >
                      <span class={`rt-score-chip ${chipClass}`}>{fmtScore(app.score)}</span>
                      <span class="rt-dist-chart__app-name">{app.name}</span>
                    </a>
                  );
                })
              ) : (
                <p class="rt-dist-chart__empty">No apps in this range.</p>
              )
            }
          </div>
        </>
      ) : (
        <>
          <p class="rt-dist-chart__hint" data-dist-hint>Click a bar to see apps in that score range.</p>
          <p class="rt-dist-chart__range-label" data-dist-range-row hidden>
            Selected range: <span data-dist-range-label class="tabular-nums"></span>
          </p>
          <div class="rt-dist-chart__apps" data-dist-apps hidden></div>
        </>
      )
    }
  </div>
</div>
