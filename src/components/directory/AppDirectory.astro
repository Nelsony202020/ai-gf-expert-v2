---
import type { HomeExplorerApp } from '../../data/homepage';
import type { BreadcrumbItem } from '../ui/Breadcrumbs.astro';
import Breadcrumbs from '../ui/Breadcrumbs.astro';
import {
  APPS_PER_PAGE,
  explorerLastUpdated,
  explorerPriorityOptions,
} from '../../data/homepage';
import {
  DEFAULT_RANKING_PRIORITIES,
  DIRECTORY_SORT_OPTIONS,
} from '../../lib/directory/meta';
import { appsPageUrl, totalPages } from '../../lib/app-directory';
import AppDirectoryCard from './AppDirectoryCard.astro';
import DirectoryProductRow from './DirectoryProductRow.astro';
import PriorityPicker from './PriorityPicker.astro';
import RatingsTooltipInit from '../review/tooltips/RatingsTooltipInit.astro';

interface Props {
  apps: HomeExplorerApp[];
  basePath?: string;
  title?: string;
  subtitle?: string;
  breadcrumbs?: BreadcrumbItem[];
}

const {
  apps,
  basePath = '/ai-girlfriend-apps',
  title = 'Explore AI girlfriend apps',
  subtitle = 'Browse every app we have tested. Sort results or customize ranking to match what matters most to you.',
  breadcrumbs,
} = Astro.props;

const priorityByValue = Object.fromEntries(explorerPriorityOptions.map((opt) => [opt.value, opt]));
const pageCount = totalPages(apps.length);
const paginationPages = Array.from({ length: pageCount }, (_, i) => i + 1);

function formatReviewCount(count: number): string {
  if (count >= 1000) return `${(count / 1000).toFixed(1).replace(/\.0$/, '')}K`;
  return String(count);
}
---

<section
  id="explore-apps"
  class="home-section home-section--muted scroll-mt-24 app-directory"
  aria-labelledby="app-directory-title"
  data-app-directory
  data-base-path={basePath}
  data-per-page={APPS_PER_PAGE}
>
  <div class="section-container px-4 md:px-8">
    {breadcrumbs && <Breadcrumbs items={breadcrumbs} />}
    <div class="home-explorer__page-head">
      <div>
        <h1 id="app-directory-title" class="home-section__title">{title}</h1>
        <p class="home-explorer__subtitle">{subtitle}</p>
      </div>
    </div>

    <div class="dir-notice" data-home-prefs-notice hidden>
      <span class="material-symbols-outlined" aria-hidden="true">auto_awesome</span>
      <span>Results personalized using your homepage selections.</span>
      <button type="button" class="dir-notice__reset" data-home-prefs-reset>Reset preferences</button>
    </div>

    <div class="dir-toolbar">
      <p class="dir-toolbar__count" data-home-result-count aria-live="polite">{apps.length} tested apps</p>
      <div class="dir-toolbar__controls">
        <button
          type="button"
          class="dir-btn"
          data-home-customize-toggle
          aria-expanded="false"
          aria-controls="dir-customize-panel"
        >
          <span class="material-symbols-outlined" aria-hidden="true">emoji_events</span>
          Customize ranking
        </button>

        <div class="dir-sort roundup-control-dropdown" data-dir-sort>
          <span class="dir-sort__label">Sort</span>
          <button
            type="button"
            class="roundup-control-dropdown__trigger dir-sort__trigger"
            data-home-sort-open
            aria-haspopup="listbox"
            aria-expanded="false"
          >
            <span data-home-sort-label>Overall rating</span>
            <span class="material-symbols-outlined roundup-control-dropdown__chevron" aria-hidden="true">expand_more</span>
          </button>
          <div class="roundup-control-dropdown__menu dir-sort__menu" data-home-sort-menu role="listbox" hidden>
            {
              DIRECTORY_SORT_OPTIONS.map((opt) => (
                <button
                  type="button"
                  role="option"
                  class:list={['roundup-control-dropdown__option', opt.id === 'overall' && 'is-active']}
                  data-home-sort-option={opt.id}
                  aria-selected={opt.id === 'overall' ? 'true' : 'false'}
                >
                  {opt.label}
                </button>
              ))
            }
          </div>
          <input type="hidden" data-home-sort value="overall" />
        </div>

        <div class="dir-view-switch" role="group" aria-label="Result layout">
          <button type="button" class="dir-view-switch__btn" data-home-view="list" aria-pressed="true">
            <span class="material-symbols-outlined" aria-hidden="true">view_list</span>
            List
          </button>
          <button type="button" class="dir-view-switch__btn" data-home-view="cards" aria-pressed="false">
            <span class="material-symbols-outlined" aria-hidden="true">grid_view</span>
            Cards
          </button>
        </div>

        <button
          type="button"
          class="dir-btn coming-soon-tip coming-soon-muted"
          data-coming-soon="save"
          data-coming-soon-tip="Save is in development"
          aria-label="Saved — in development"
        >
          <span class="material-symbols-outlined" aria-hidden="true">bookmark</span>
          Saved
        </button>
      </div>
    </div>

    <div class="home-explorer" data-home-explorer>
      <div class="home-explorer__main">
        <div class="dir-customize-wrap" id="dir-customize-panel" data-home-customize-panel hidden>
          <div class="dir-customize-wrap__inner">
            <div class="home-explorer__customize" data-home-customize>
              <div class="home-explorer__customize-head">
                <div class="home-explorer__customize-title-wrap">
                  <span class="home-explorer__customize-icon material-symbols-outlined" aria-hidden="true">emoji_events</span>
                  <div>
                    <h2 class="home-explorer__customize-title">Customize your results</h2>
                    <p class="home-explorer__customize-copy">Rank up to 3 factors to personalize the order of results. Your official scores never change.</p>
                  </div>
                </div>
                <button type="button" class="home-explorer__customize-reset" data-home-priorities-reset>
                  <span class="material-symbols-outlined text-[16px]" aria-hidden="true">refresh</span>
                  Reset to default
                </button>
              </div>

              <div class="home-explorer__priority-list" data-home-priority-list>
                {
                  DEFAULT_RANKING_PRIORITIES.map((value, index) => {
                    const option = priorityByValue[value];
                    return (
                      <div class="home-explorer__priority-slot" data-home-priority-slot>
                        <span class="home-explorer__priority-rank">{index + 1}</span>
                        <span
                          class="home-explorer__priority-icon"
                          style={`background:${option?.color ?? '#db2777'}20;color:${option?.color ?? '#db2777'}`}
                          data-home-priority-icon
                        >
                          <span class="material-symbols-outlined" aria-hidden="true">{option?.icon ?? 'star'}</span>
                        </span>
                        <PriorityPicker slotIndex={index} value={value} options={explorerPriorityOptions} />
                      </div>
                    );
                  })
                }
              </div>

              <div class="home-explorer__customize-status" data-home-customize-status hidden>
                <span class="material-symbols-outlined" aria-hidden="true">auto_awesome</span>
                <span>Results are now personalized based on your top priorities.</span>
              </div>
            </div>
          </div>
        </div>

        <div class="home-explorer__grid" data-home-grid data-view="list">
          {
            apps.map((app) => (
              <div
                class="dir-item"
                data-home-app={app.id}
                data-overall-score={app.overallScore}
                data-price={app.priceMonthly}
                data-review-count={app.reviewCount}
                data-category-scores={JSON.stringify(Object.fromEntries(app.categoryScores.map((c) => [c.key, c.score])))}
              >
                <DirectoryProductRow app={app} formatReviewCount={formatReviewCount} />
                <AppDirectoryCard app={app} formatReviewCount={formatReviewCount} />
              </div>
            ))
          }
        </div>

        <div class="home-explorer__pagination-wrap">
          <button type="button" class="home-explorer__load-more" data-home-load-more hidden>
            Load more apps
          </button>

          <nav class="home-explorer__pagination" aria-label="Apps pagination" data-home-pagination>
            <a class="home-explorer__page-link" data-home-page-prev href={basePath} hidden>Previous</a>
            {
              paginationPages.map((page) => (
                <a
                  class="home-explorer__page-link"
                  data-home-page-link={page}
                  href={appsPageUrl(page, basePath)}
                  aria-current={page === 1 ? 'page' : undefined}
                >
                  {page}
                </a>
              ))
            }
            <a class="home-explorer__page-link" data-home-page-next href={appsPageUrl(2, basePath)} hidden>Next</a>
          </nav>
        </div>

        <div class="home-explorer__footer">
          <p class="home-explorer__updated">Last updated: {explorerLastUpdated}</p>
        </div>
      </div>
    </div>
  </div>
</section>

<RatingsTooltipInit />

<script>
  import './app-directory.client.ts';
</script>
