---
import { homeMeta } from '../../data/homepage';
import { buildMegaMenuColumns } from '../../data/nav-mega-menu';
import { buildSearchIndex } from '../../data/site-search';
import { loadComparisonProducts } from '../../lib/content/comparisonProducts';
import { heroImageSrcSet, optimizedHeroImageUrl } from '../../lib/media/optimize';

interface Props {
  heroImage?: string;
  heroImageAlt?: string;
}

const { heroImage = homeMeta.heroImage, heroImageAlt = homeMeta.heroImageAlt } = Astro.props;
const publishedProducts = await loadComparisonProducts();
const megaMenuColumns = buildMegaMenuColumns(publishedProducts);
const searchIndex = buildSearchIndex(publishedProducts, megaMenuColumns);
const heroSrc = optimizedHeroImageUrl(heroImage, 640);
const heroSrcSet = heroImageSrcSet(heroImage, [480, 640, 960, 1280]);
---

<section class="home-hero" aria-labelledby="home-hero-title">
  <div class="section-container px-4 md:px-8 home-hero__inner">
    <div>
      <p class="home-hero__eyebrow">
        <svg class="home-hero__icon" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 2 4.5 5.5v6.1c0 4.7 3.2 9 7.5 10.4 4.3-1.4 7.5-5.7 7.5-10.4V5.5L12 2Zm-1.2 13.3-3.3-3.3 1.4-1.4 1.9 1.9 4.1-4.1 1.4 1.4-5.5 5.5Z" />
        </svg>
        Independent · Unbiased · User-first
      </p>
      <h1 id="home-hero-title" class="home-hero__title">
        Find the best AI girlfriend app for <em>you</em>
      </h1>
      <p class="home-hero__lead">
        We purchase, test, score, and compare AI companion apps so you can choose with confidence — not marketing hype.
      </p>

      <div class="home-hero__search" data-home-search>
        <div class="home-hero__search-wrap">
          <form class="home-hero__search-form" role="search" data-home-search-form>
            <input
              type="search"
              name="q"
              class="home-hero__search-input"
              placeholder="Search reviews, roundups, and guides…"
              autocomplete="off"
              role="combobox"
              aria-autocomplete="list"
              aria-label="Search the site"
              aria-expanded="false"
              aria-controls="home-search-results"
              data-home-search-input
            />
            <button type="submit" class="home-hero__search-btn" aria-label="Search">
              <svg class="home-hero__icon home-hero__icon--lg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M15.5 14h-.8l-.3-.3a6.5 6.5 0 1 0-.7.7l.3.3v.8l5 5 1.5-1.5-5-5Zm-6 0a4.5 4.5 0 1 1 0-9 4.5 4.5 0 0 1 0 9Z" />
              </svg>
              <span class="hidden sm:inline">Search</span>
            </button>
          </form>
          <div
            id="home-search-results"
            class="home-hero__search-panel"
            hidden
            role="listbox"
            aria-label="Search results"
            data-home-search-panel
          ></div>
        </div>
      </div>
    </div>

    <div class="home-hero__visual">
      <div class="home-hero__image-wrap">
        <img
          src={heroSrc}
          srcset={heroSrcSet || undefined}
          sizes="(max-width: 767px) 100vw, 42vw"
          alt={heroImageAlt}
          class="home-hero__image"
          width="800"
          height="640"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>
      <div class="home-hero__trust-card">
        <svg class="home-hero__trust-icon home-hero__icon home-hero__icon--lg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 2 4 5v6.1c0 5 3.4 9.7 8 10.9 4.6-1.2 8-5.9 8-10.9V5l-8-3Z" />
        </svg>
        <p class="home-hero__trust-text">100% paid accounts. No sponsors. Real hands-on testing.</p>
      </div>
    </div>
  </div>
</section>

<script define:vars={{ searchIndex }}>
  function initHomeSearch() {
    const root = document.querySelector('[data-home-search]');
    if (!root || root.dataset.bound === 'true') return;
    root.dataset.bound = 'true';

    const form = root.querySelector('[data-home-search-form]');
    const input = root.querySelector('[data-home-search-input]');
    const panel = root.querySelector('[data-home-search-panel]');
    if (!form || !input || !panel) return;

    let activeIndex = -1;

    function filter(q) {
      const query = q.trim().toLowerCase();
      if (!query) return [];
      return searchIndex
        .filter((item) => `${item.label} ${item.meta ?? ''}`.toLowerCase().includes(query))
        .slice(0, 8);
    }

    function renderResults(results) {
      panel.innerHTML = '';
      if (!results.length) {
        panel.hidden = true;
        input.setAttribute('aria-expanded', 'false');
        return;
      }

      results.forEach((item, i) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'home-hero__search-result';
        btn.dataset.href = item.href;
        btn.setAttribute('role', 'option');
        btn.innerHTML = `<span class="home-hero__search-result-label">${item.label}</span><span class="home-hero__search-result-meta">${item.meta ?? item.type}</span>`;
        btn.addEventListener('click', () => {
          window.location.href = item.href;
        });
        if (i === activeIndex) btn.setAttribute('aria-selected', 'true');
        panel.appendChild(btn);
      });

      panel.hidden = false;
      input.setAttribute('aria-expanded', 'true');
    }

    function navigateToFirst() {
      const first = panel.querySelector('[data-href]');
      if (first instanceof HTMLButtonElement && first.dataset.href) {
        window.location.href = first.dataset.href;
      }
    }

    input.addEventListener('input', () => {
      activeIndex = -1;
      renderResults(filter(input.value));
    });

    input.addEventListener('keydown', (e) => {
      const options = [...panel.querySelectorAll('[data-href]')];
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        activeIndex = Math.min(activeIndex + 1, options.length - 1);
        renderResults(filter(input.value));
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        activeIndex = Math.max(activeIndex - 1, 0);
        renderResults(filter(input.value));
      } else if (e.key === 'Enter' && activeIndex >= 0 && options[activeIndex] instanceof HTMLButtonElement) {
        e.preventDefault();
        window.location.href = options[activeIndex].dataset.href ?? '/';
      } else if (e.key === 'Escape') {
        panel.hidden = true;
        input.setAttribute('aria-expanded', 'false');
      }
    });

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      navigateToFirst();
    });

    document.addEventListener('click', (e) => {
      if (!root.contains(e.target)) {
        panel.hidden = true;
        input.setAttribute('aria-expanded', 'false');
      }
    });
  }

  initHomeSearch();
  document.addEventListener('astro:page-load', initHomeSearch);
</script>
