---
import type { HomeCategoryBar, HomeRankedApp } from '../../../lib/home/loadDesktopHomepage';
import HomeIcon from './HomeIcon.astro';

interface Props {
  winner: HomeRankedApp;
  bars: HomeCategoryBar[];
  rankingHref?: string;
}

const { winner, bars, rankingHref = '/best/ai-girlfriend/' } = Astro.props;
const labelShow = `Show ${winner.name} ranking`;
const labelHide = `Hide ${winner.name} ranking and show Herman`;
---

<div class="home-v2__badge" data-home-badge data-label-show={labelShow} data-label-hide={labelHide}>
  <div class="home-v2__badge-scene">
    <div class="home-v2__badge-flip">
      <div class="home-v2__badge-face home-v2__badge-face--front">
        <img
          class="home-v2__herman"
          src="/home/v2/herman-scientist.png"
          alt=""
          width="400"
          height="400"
        />
      </div>
      <div class="home-v2__badge-face home-v2__badge-face--back" id="home-herman-back">
        <div class="home-v2__badge-app">
          <img src={winner.logo} alt="" width="40" height="40" class="home-v2__app-icon" />
          <p class="home-v2__badge-name">
            {winner.name}
            <span class="home-v2__badge-score-inline">
              <b class={`is-${winner.overall.tone}`}>{winner.overall.value}</b>
            </span>
          </p>
        </div>
        <ul class="home-v2__badge-cats home-v2__badge-cats--compact">
          {bars.map((bar) => (
            <li>
              <b class={`is-${bar.tone}`}>{bar.display}</b>
              <span>{bar.name}</span>
            </li>
          ))}
        </ul>
        <a class="home-v2__badge-link" href={rankingHref} data-home-badge-link>
          View ranking
          <HomeIcon name="arrow-right" size={14} />
        </a>
      </div>
    </div>
  </div>
  <p class="home-v2__badge-hint" data-home-badge-hint hidden>
    Tap to reveal #1
  </p>
  <button
    type="button"
    class="home-v2__badge-toggle"
    data-home-badge-toggle
    aria-expanded="false"
    aria-controls="home-herman-back"
    aria-label={labelShow}
  >
  </button>
</div>
