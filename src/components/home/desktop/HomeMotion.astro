<script>
  function prefersReducedMotion() {
    return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  }

  function canUsePointerGlow() {
    return window.matchMedia('(hover: hover) and (pointer: fine)').matches && !prefersReducedMotion();
  }

  function tweenNumber(el: HTMLElement, from: number, to: number, duration: number) {
    const start = performance.now();
    const step = (now: number) => {
      const t = Math.min(1, (now - start) / duration);
      const eased = 1 - Math.pow(1 - t, 3);
      const value = from + (to - from) * eased;
      el.textContent = value.toFixed(1);
      if (t < 1) requestAnimationFrame(step);
      else el.textContent = to.toFixed(1);
    };
    requestAnimationFrame(step);
  }

  function animateCounts(root: HTMLElement) {
    if (prefersReducedMotion()) return;
    root.querySelectorAll<HTMLElement>('[data-home-count]').forEach((el) => {
      const to = Number(el.dataset.homeCount);
      if (!Number.isFinite(to)) return;
      tweenNumber(el, 0, to, 1350);
    });
  }

  function bindPointerGlow(root: HTMLElement) {
    if (root.dataset.glowBound === 'true') return;
    root.dataset.glowBound = 'true';
    if (!canUsePointerGlow()) return;

    let tx = 0.68;
    let ty = 0.36;
    let cx = tx;
    let cy = ty;
    let visible = false;
    let raf = 0;

    const setVars = () => {
      root.style.setProperty('--mx', `${(cx * 100).toFixed(2)}%`);
      root.style.setProperty('--my', `${(cy * 100).toFixed(2)}%`);
    };

    const tick = () => {
      cx += (tx - cx) * 0.1;
      cy += (ty - cy) * 0.1;
      setVars();
      const still = Math.abs(tx - cx) < 0.0008 && Math.abs(ty - cy) < 0.0008;
      if (!still || visible) raf = requestAnimationFrame(tick);
      else raf = 0;
    };

    const start = () => {
      if (!raf) raf = requestAnimationFrame(tick);
    };

    root.addEventListener('pointermove', (e) => {
      if (e.pointerType !== 'mouse') return;
      const r = root.getBoundingClientRect();
      tx = (e.clientX - r.left) / r.width;
      ty = (e.clientY - r.top) / r.height;
      if (!visible) {
        visible = true;
        root.classList.add('is-glowing');
      }
      start();
    });

    root.addEventListener('pointerleave', () => {
      visible = false;
      root.classList.remove('is-glowing');
    });
  }

  function initPointerGlows() {
    document.querySelectorAll<HTMLElement>('[data-home-glow]').forEach(bindPointerGlow);
  }

  function revealOnce(root: HTMLElement) {
    if (prefersReducedMotion()) {
      root.classList.add('is-inview');
      return;
    }
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const el = entry.target as HTMLElement;
          el.classList.add('is-inview');
          animateCounts(el);
          io.unobserve(el);
        }
      },
      { threshold: 0.32, rootMargin: '0px 0px -6% 0px' },
    );
    io.observe(root);
  }

  function initReveals() {
    document.querySelectorAll<HTMLElement>('[data-home-reveal]').forEach((el) => {
      if (el.dataset.revealBound === 'true') return;
      el.dataset.revealBound = 'true';
      revealOnce(el);
    });
  }

  function initSelectorMotion() {
    const root = document.querySelector<HTMLElement>('[data-home-selector]');
    if (!root || root.dataset.motionBound === 'true') return;
    root.dataset.motionBound = 'true';

    const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-home-priority]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-home-panel]'));
    let currentScore = Number(root.querySelector<HTMLElement>('.is-shown [data-home-metric]')?.textContent) || 0;

    function activate(id: string) {
      buttons.forEach((btn) => {
        const on = btn.dataset.homePriority === id;
        btn.classList.toggle('is-active', on);
        btn.setAttribute('aria-selected', on ? 'true' : 'false');
      });
      panels.forEach((panel) => {
        panel.classList.toggle('is-shown', panel.dataset.homePanel === id);
      });
      const metric = root.querySelector<HTMLElement>('.is-shown [data-home-metric]');
      if (metric) {
        const next = Number(metric.textContent);
        if (Number.isFinite(next) && !prefersReducedMotion()) {
          tweenNumber(metric, currentScore, next, 220);
          currentScore = next;
        } else if (Number.isFinite(next)) {
          currentScore = next;
        }
      }
    }

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.dataset.homePriority;
        if (!id) return;
        activate(id);
      });
    });
  }

  function initMethodVideo() {
    const wrap = document.querySelector<HTMLElement>('[data-home-video-wrap]');
    const video = document.querySelector<HTMLVideoElement>('[data-home-video-el]');
    const fallback = document.querySelector<HTMLImageElement>('[data-home-video-fallback]');
    if (!wrap || !video || wrap.dataset.bound === 'true') return;
    wrap.dataset.bound = 'true';

    let sourceAttached = false;
    const enableFallback = () => {
      video.hidden = true;
      if (fallback) fallback.hidden = false;
    };
    const ensureSource = () => {
      const src = video.dataset.src;
      if (!src || sourceAttached) return;
      const source = document.createElement('source');
      source.src = src;
      source.type = 'video/mp4';
      video.appendChild(source);
      video.load();
      sourceAttached = true;
    };
    const startPlayback = () => {
      ensureSource();
      video.muted = true;
      video.defaultMuted = true;
      video.playsInline = true;
      void video.play().catch(enableFallback);
    };
    video.addEventListener('error', enableFallback);
    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries.some((entry) => entry.isIntersecting);
        if (visible) startPlayback();
        else if (!video.hidden) video.pause();
      },
      { threshold: 0.25, rootMargin: '80px 0px' },
    );
    observer.observe(wrap);
  }

  function initHermanBadge() {
    const root = document.querySelector<HTMLElement>('[data-home-badge]');
    if (!root || root.dataset.badgeBound === 'true') return;
    root.dataset.badgeBound = 'true';

    const toggle = root.querySelector<HTMLButtonElement>('[data-home-badge-toggle]');
    const link = root.querySelector<HTMLAnchorElement>('[data-home-badge-link]');
    const back = root.querySelector<HTMLElement>('.home-v2__badge-face--back');
    if (!toggle) return;

    const fineHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
    const showLabel = root.dataset.labelShow || 'Show current number one ranked app';
    const hideLabel = root.dataset.labelHide || 'Show Herman';
    let nudged = false;
    let lastTouchAt = 0;

    const setOpen = (open: boolean) => {
      root.classList.toggle('is-flipped', open);
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      toggle.setAttribute('aria-label', open ? hideLabel : showLabel);
    };

    toggle.addEventListener('pointerup', (event) => {
      if (event.pointerType === 'touch') lastTouchAt = Date.now();
    });

    toggle.addEventListener('click', (event) => {
      event.preventDefault();
      setOpen(!root.classList.contains('is-flipped'));
    });

    link?.addEventListener('click', (event) => {
      event.stopPropagation();
    });
    link?.addEventListener('pointerdown', (event) => {
      event.stopPropagation();
    });

    root.addEventListener('pointerleave', (event) => {
      if (event.pointerType === 'touch') return;
      if (Date.now() - lastTouchAt < 600) return;
      const next = event.relatedTarget as Node | null;
      if (next && root.contains(next)) return;
      if (root.classList.contains('is-flipped')) setOpen(false);
    });
    root.addEventListener('mouseleave', () => {
      if (Date.now() - lastTouchAt < 600) return;
      if (root.classList.contains('is-flipped')) setOpen(false);
    });

    back?.addEventListener('click', (event) => {
      if (fineHover) return;
      if ((event.target as HTMLElement).closest('[data-home-badge-link]')) return;
      setOpen(false);
    });

    document.addEventListener('pointerdown', (event) => {
      if (event.pointerType === 'mouse') return;
      if (!root.classList.contains('is-flipped')) return;
      if (root.contains(event.target as Node)) return;
      setOpen(false);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && root.classList.contains('is-flipped')) setOpen(false);
    });

    if (prefersReducedMotion() || fineHover) return;

    const io = new IntersectionObserver(
      (entries) => {
        if (nudged || root.classList.contains('is-flipped')) return;
        const visible = entries.some((entry) => entry.isIntersecting && entry.intersectionRatio >= 0.45);
        if (!visible) return;
        nudged = true;
        root.classList.add('is-nudging');
        window.setTimeout(() => root.classList.remove('is-nudging'), 680);
        io.disconnect();
      },
      { threshold: [0.45, 0.7] },
    );
    io.observe(root);
  }

  function init() {
    initPointerGlows();
    initReveals();
    initSelectorMotion();
    initMethodVideo();
    initHermanBadge();
  }

  init();
  document.addEventListener('astro:page-load', init);
</script>
