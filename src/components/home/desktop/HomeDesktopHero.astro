---
import { homeProofFacts } from '../../../data/home-proof';
import type { DesktopHomepageData } from '../../../lib/home/loadDesktopHomepage';
import HomeDesktopHeader from './HomeDesktopHeader.astro';
import HomeEyebrow from './HomeEyebrow.astro';
import HomeIcon from './HomeIcon.astro';
import HomeScore from './HomeScore.astro';

interface Props {
  data: DesktopHomepageData;
}
const { data } = Astro.props;
---

<section class="home-v2__hero" id="home-hero" aria-labelledby="home-v2-title" data-home-glow>
  <div class="home-v2__grid" aria-hidden="true"></div>
  <div class="home-v2__grid-hot" aria-hidden="true"></div>
  <div class="home-v2__cursor-glow" aria-hidden="true"></div>
  <img class="home-v2__glow" src="/home/v2/pink-glow.svg" alt="" />
  <HomeDesktopHeader />
  <div class="home-v2__hero-body">
    <div class="home-v2__hero-copy">
      <HomeEyebrow text="Independent AI companion testing lab" theme="ink" />
      <h1 id="home-v2-title" class="home-v2__display">
        Find the best<br />AI girlfriend app<br />for <em class="home-v2__accent">you.</em>
      </h1>
      <p class="home-v2__lead home-v2__lead--ink">
        We buy, test, score and compare AI companion apps — so you can choose with confidence, not marketing hype.
      </p>
      <div class="home-v2__ctas">
        <a class="home-v2__btn home-v2__btn--primary" href="/best/ai-girlfriend/">
          Best AI Girlfriend Apps
          <HomeIcon name="arrow-right" size={18} />
        </a>
        <a class="home-v2__btn home-v2__btn--on-ink" href="/reviews/">
          AI Girlfriend Reviews
          <HomeIcon name="arrow-right" size={18} />
        </a>
      </div>
      <div class="home-v2__finalists">
        <div class="home-v2__finalist-stack">
          {data.finalists.map((app) => (
            <img src={app.logo} alt="" width="28" height="28" class="home-v2__app-icon home-v2__app-icon--sm" />
          ))}
        </div>
        <p>The {data.finalists.length} finalists in our 2026 rankings</p>
      </div>
    </div>
    <div class="home-v2__hero-art">
      <img
        class="home-v2__herman"
        src="/home/v2/herman-scientist.png"
        alt="Herman Carter, lead reviewer"
        width="400"
        height="400"
      />
      {data.winner && (
        <div class="home-v2__float home-v2__float--winner">
          <p class="home-v2__winner-kicker">Current #1 · Best overall</p>
          <div class="home-v2__winner-head">
            <img src={data.winner.logo} alt="" width="40" height="40" class="home-v2__app-icon" />
            <div>
              <p class="home-v2__winner-name">{data.winner.name}</p>
              <p class="home-v2__award">
                <HomeIcon name="crown" size={16} />
                {data.winner.award ?? 'Best overall'}
              </p>
            </div>
            <HomeScore score={data.winner.overall} size="m" />
          </div>
          <div class="home-v2__bars home-v2__bars--compact">
            {data.winnerHeroBars.map((bar) => (
              <div class="home-v2__bar">
                <span>{bar.name}</span>
                <span class="home-v2__track"><i class={`is-${bar.tone}`} style={`--bar:${bar.width}`}></i></span>
                <b class={`is-${bar.tone}`}>{bar.display}</b>
              </div>
            ))}
          </div>
        </div>
      )}
    </div>
  </div>
</section>

<section class="home-v2__proof-bridge" aria-label="Testing proof">
  <div class="home-v2__proof">
    {homeProofFacts.map((fact, i) => (
      <>
        {i > 0 && <span class="home-v2__proof-div" aria-hidden="true"></span>}
        <div class="home-v2__proof-metric">
          <p class="home-v2__proof-value">{fact.value}</p>
          <p>{fact.label}</p>
        </div>
      </>
    ))}
  </div>
</section>
